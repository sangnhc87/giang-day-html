#import "../template.typ": *

#chapter-open(9, "Khi con là người làm sai với bạn", 9, "Con làm một việc xấu không có nghĩa con là đứa trẻ xấu. Nhưng con chỉ tin điều đó nếu ba mẹ tin trước.", "Nghe tin con mình bị bắt nạt thì đau. Nghe tin con mình đi bắt nạt người khác thì vừa đau vừa xấu hổ, và phản xạ đầu tiên thường là không tin, hoặc trừng phạt thật nặng cho hả. Cả hai đều bỏ lỡ cơ hội. Một đứa trẻ làm bạn tổn thương đang cần được dạy điều khó nhất: nhìn thẳng vào việc mình làm, cảm được nỗi đau của người kia, và tự tay sửa chữa. Chương này cũng nói về bạn xấu và những lần con chạy theo đám đông.", ("Cô báo con cầm đầu trêu chọc một bạn", "Con hùa theo đám đông", "Con chơi với bạn mà mình thấy không ổn", "Con bị bạn rủ làm chuyện sai và đã làm",), en: ("When your child is the one who wronged a friend", "Doing a bad thing does not make your child a bad child. But they will only believe that if you believe it first.", "Hearing that your child is bullied hurts. Hearing that your child bullies others hurts and shames, and the first reflex is disbelief, or a punishment harsh enough to feel satisfying. Both miss the chance. A child who has hurt a friend needs to be taught the hardest thing: to look straight at what they did, to feel the other's pain, and to repair it with their own hands. This chapter also covers doubtful friends and following the crowd.", ("The teacher says your child led the teasing of a classmate", "Your child goes along with the crowd", "Your child's new friends worry you", "A friend dared your child to do wrong, and your child did it",)))

#sec("Cô báo con cầm đầu trêu chọc một bạn", en: "The teacher says your child led the teasing of a classmate")
#boicanh("Cô chủ nhiệm mời mẹ lên: bé Nhi lớp 5, lớp phó học tập, cầm đầu nhóm bạn gái đặt biệt danh, giấu dép, không cho ai chơi với một bạn mới chuyển tới. Bạn kia đã xin chuyển lớp. Mẹ không tin nổi: con mình ngoan vậy mà.", en: "The form teacher asks Mum in: Nhi, in grade 5 and the class study monitor, has led a group of girls in giving a new girl nicknames, hiding her sandals and keeping others from playing with her. The girl has asked to change class. Mum cannot believe it: my child is so well behaved.")
#phanxa("Kiểu một: Chắc cô nhầm, con tôi ở nhà ngoan lắm. Kiểu hai: Mẹ không ngờ con ác vậy. Mẹ thất vọng về con quá.", "Kiểu một: mẹ che cho mình, vậy chuyện đó không nghiêm trọng. Kiểu hai: mình là đứa ác. Mình là ai thì mình cứ vậy thôi.", en: ("Version one: There must be a mistake; my child is very good at home. Version two: I never imagined you could be so cruel. I am so disappointed in you.", "Version one: Mum covers for me, so it can't be serious. Version two: I am a cruel child. That is who I am, so that is how I'll be."))
#scene("Tình huống 9.1 · Thử nói cách khác")[
  #me("(Buổi tối, chỉ có hai mẹ con.) Nhi, hôm nay cô kể mẹ nghe chuyện con với bạn Hiền. Mẹ muốn nghe con nói.", en: "(In the evening, just the two of them.) Nhi, today your teacher told me about you and Hien. I want to hear it from you.")
  #con("Tụi con giỡn thôi mà. Tại nó kỳ lắm, nó ăn mặc quê, nói giọng mắc cười.", en: "We were just joking. She's weird; she dresses funny and talks with a funny accent.")
  #me("Mẹ nghe chữ giỡn. Mẹ hỏi con cái này: giỡn là hai bên cùng cười. Hiền có cười không?", en: "I hear the word joking. Let me ask: a joke is when both sides laugh. Does Hien laugh?")
  #con("...Không. Nó hay ngồi một mình.", en: "...No. She usually sits alone.")
  #me("Cô nói Hiền xin chuyển lớp. Con có biết không?", en: "Your teacher said Hien has asked to change class. Did you know?")
  #con("(Giật mình.) Con không biết. Con đâu có muốn tới mức đó.", en: "(Startled.) I didn't know. I didn't want it to go that far.")
  #me("Mẹ tin là con không muốn tới mức đó. Con nhắm mắt lại, thử làm Hiền một phút: mới chuyển trường, không quen ai, sáng nào tới lớp cũng không tìm thấy dép, cả đám gọi mình bằng cái tên mình ghét. Con thấy trong người sao?", en: "I believe you didn't. Close your eyes and be Hien for a minute: new school, knowing no one, every morning you can't find your sandals, a whole group calling you a name you hate. How does that feel?")
  #con("(Im lâu, mắt đỏ.) Con thấy sợ đi học.", en: "(A long silence, eyes red.) I'd be scared to go to school.")
  #me("Ừ. Đó là điều Hiền thấy suốt hai tháng nay. Mẹ nói rõ: việc con làm là sai, và nó làm một người đau thật. Nhưng mẹ không nghĩ con là đứa ác. Mẹ nghĩ con là đứa có tiếng nói trong lớp, bạn bè nghe con. Cái đó dùng để hại người được thì dùng để giúp người cũng được.", en: "Yes. That is what Hien has felt for two months. Let me be clear: what you did is wrong, and it really hurt someone. But I do not think you are a cruel child. I think you are a child with a voice in your class; others listen to you. What can be used to harm can also be used to help.")
  #con("Giờ con phải làm sao mẹ?", en: "What should I do now, Mum?")
  #me("Con nghĩ Hiền cần gì nhất lúc này?", en: "What do you think Hien needs most right now?")
  #con("Cần có người chơi chung. Con sẽ xin lỗi bạn. Rồi con nói tụi kia thôi đi. Con rủ bạn ngồi ăn chung.", en: "Someone to play with. I'll say sorry to her. Then I'll tell the others to stop. I'll ask her to eat with us.")
  #me("Xin lỗi thì nói riêng, đừng bắt bạn phải trả lời liền. Và làm đều nhiều ngày, không phải một bữa. Mẹ sẽ hỏi thăm con mỗi tuần.", en: "Apologise in private, and don't make her answer straight away. And keep it up for many days, not just one. I'll check in with you every week.")
]
#hieusau1("Trẻ bắt nạt bạn không nhất thiết là trẻ hư hay thiếu thốn tình thương. Nhiều em là đứa được bạn bè nể, dùng việc loại trừ người khác để giữ vị trí, và thật sự chưa hình dung được nỗi đau mình gây ra. Phủ nhận giùm con làm con mất cơ hội sửa. Dán nhãn con là ác làm con mất lý do để sửa. Con đường ở giữa là tách việc làm khỏi con người, giúp con cảm được bằng cách đặt mình vào chỗ bạn, rồi để con tự đề ra việc bù đắp và theo dõi cho tới nơi.", en: "Children who bully are not necessarily badly behaved or starved of love. Many are respected by peers, exclude others to hold their position, and truly have not pictured the pain they cause. Denying it on the child's behalf removes the chance to make amends. Labelling the child cruel removes the reason to. The middle path separates the deed from the person, helps the child feel by standing in the other's place, then lets them propose the repair and follows it through.")
#cotloi("Việc con làm là sai, nói thẳng, không giảm nhẹ. Con người con thì ba mẹ vẫn tin. Hai câu đó phải đi cùng nhau.", en: "What you did is wrong: say it straight, without softening. Who you are, I still believe in. Those two sentences must go together.")
#lamngay1("Trong bữa cơm, kể một lần ngày xưa mình từng làm một người bạn tổn thương và mình ước đã làm khác đi như thế nào. Con học cách nhận lỗi dễ nhất từ một người lớn dám kể lỗi của mình.", en: "At dinner, tell about a time you once hurt a friend and how you wish you had acted. Children learn to own mistakes most easily from an adult who dares to tell their own.")
#caunoi("Việc con làm là sai. Nhưng mẹ không tin con là đứa xấu. Mẹ tin con sửa được.", en: "What you did was wrong. But I do not believe you are a bad child. I believe you can put it right.")
#tusoi(("Khi nghe con mình làm sai, mình bảo vệ con hay bảo vệ hình ảnh con ngoan trong đầu mình?", "Ở nhà, con có thấy người lớn chê bai, giễu cợt người khác vì cách ăn mặc, giọng nói, hoàn cảnh không?",), en: ("When I hear my child did wrong, am I protecting my child or my picture of a good child?", "At home, does my child hear adults mock others for their clothes, accent or circumstances?",))

#sec("Con hùa theo đám đông", en: "Your child goes along with the crowd")
#boicanh("Clip lan trong nhóm phụ huynh: một nhóm học sinh lớp 8 vây quanh giật cặp của một bạn, quăng qua quăng lại. Thằng Hoàng nhà mình không giật, nhưng đứng đó cười và cầm điện thoại quay.", en: "A clip spreads in the parents' group: several grade 8 students surround a boy, snatch his bag and throw it around. Hoang did not snatch it, but he stands there laughing and filming.")
#phanxa("Con đứng đó quay phim mà coi được hả? Con cũng tệ như tụi nó thôi!", "Mình không đụng tay mà cũng bị coi như tụi nó. Vậy lần sau làm luôn cho rồi, đằng nào cũng mang tiếng.", en: ("You stood there filming and could bear to watch? You are as bad as they are!", "I didn't touch him and I'm counted the same. So next time I might as well join in; I get the blame anyway."))
#scene("Tình huống 9.2 · Thử nói cách khác")[
  #ba("Hoàng, ba coi clip rồi. Ba thấy con không giật cặp bạn. Ba cũng thấy con đứng quay và cười. Lúc đó trong đầu con nghĩ gì?", en: "Hoang, I've seen the clip. I saw you did not grab his bag. I also saw you standing, filming and laughing. What was in your head then?")
  #con("Con không nghĩ gì hết. Tụi nó làm, con thấy mắc cười thì con quay. Con đâu có đụng tới nó.", en: "Nothing. They were doing it, it looked funny, so I filmed. I didn't touch him.")
  #ba("Ừ, con không đụng. Ba hỏi thêm: nếu lúc đó con không cười mà nói thôi đủ rồi, thì chuyện gì xảy ra?", en: "True, you didn't. Let me ask: if you hadn't laughed but had said that's enough, what would have happened?")
  #con("Tụi nó quay qua chọc con. Nói con bênh nó, rồi con thành đứa bị chọc.", en: "They'd have turned on me. Said I was taking his side, and then I'd be the one teased.")
  #ba("Vậy là con cũng sợ. Con cười để được đứng bên phía an toàn. Ba hiểu cái sợ đó, người lớn cũng bị. Nhưng con coi lại clip, nhìn mặt bạn Thái thôi, đừng nhìn ai khác.", en: "So you were afraid too. You laughed to stand on the safe side. I understand that fear; adults have it as well. But watch the clip again and look only at Thai's face, nobody else.")
  #con("(Coi lại, im.) Nó sắp khóc.", en: "(Watches, silent.) He's about to cry.")
  #ba("Với Thái lúc đó, năm đứa giật cặp và mười đứa đứng cười là một. Tiếng cười của người đứng coi là thứ làm đám kia hăng thêm. Con không cần làm anh hùng nhảy vô can. Có mấy việc nhỏ hơn mà vẫn đổi được chuyện: không cười, không quay, bỏ đi kêu giám thị, hoặc sau đó lại hỏi thăm Thái một câu.", en: "To Thai in that moment, five boys grabbing the bag and ten standing and laughing were the same thing. The laughter of bystanders is what fires the others up. You don't have to be a hero and jump in. There are smaller things that still change it: don't laugh, don't film, walk off and fetch a supervisor, or afterwards go and ask Thai how he is.")
  #con("Hỏi thăm thì con làm được.", en: "Asking how he is, I can do that.")
  #ba("Vậy bắt đầu từ đó. Còn cái clip, con xóa đi, và nếu con có gửi cho ai thì nhắn người ta xóa.", en: "Then start there. And the clip: delete it, and if you sent it to anyone, message them to delete it too.")
]
#hieusau1("Phần lớn các vụ bắt nạt diễn ra trước mặt người đứng xem, và người đứng xem cười hay im lặng chính là phần thưởng cho kẻ bắt nạt. Trẻ hùa theo thường không ác ý, các em sợ trở thành mục tiêu kế tiếp. Vì vậy đòi con phải dũng cảm can ngăn là quá sức. Điều thực tế hơn là cho con một thang các việc nhỏ dần: không cổ vũ, rời đi, báo người lớn, hỏi thăm bạn bị hại sau đó. Chỉ cần một người không cười, không khí đã khác.", en: "Most bullying happens in front of onlookers, and their laughter or silence is the bully's reward. Children who go along are rarely malicious; they fear becoming the next target. Demanding that a child bravely intervene is too much. More realistic is a ladder of smaller acts: do not cheer, walk away, tell an adult, check on the victim afterwards. One person not laughing already changes the air.")
#cotloi("Con không cần làm anh hùng. Con chỉ cần đừng làm khán giả. Không cười, không quay, và hỏi thăm bạn một câu sau đó đã là đứng về phía đúng.", en: "Your child need not be a hero. They only need not to be the audience. Not laughing, not filming, and checking on the friend afterwards already means standing on the right side.")
#lamngay1("Hỏi con: Nếu thấy một bạn bị cả đám chọc, việc nhỏ nhất con dám làm là gì? Cùng con liệt kê ba việc, từ dễ tới khó. Để con tự chọn mức của mình.", en: "Ask your child: If you saw a classmate being teased by a group, what is the smallest thing you would dare to do? List three together, easy to hard. Let them choose their level.")
#caunoi("Con không cần nhảy vô can. Con chỉ cần đừng cười, rồi hỏi thăm bạn một câu.", en: "You don't have to jump in. Just don't laugh, and afterwards ask the friend how they are.")
#tusoi(("Ở chỗ làm hay trong họ hàng, khi có người bị nói xấu, mình thường lên tiếng, im lặng, hay hùa theo?", "Mình có hay chuyển tiếp, bình luận những clip làm nhục người khác trên mạng không?",), en: ("At work or among relatives, when someone is being run down, do I speak up, stay quiet, or join in?", "Do I forward or comment on clips that humiliate people online?",))

#sec("Con chơi với bạn mà mình thấy không ổn", en: "Your child's new friends worry you")
#boicanh("Con bé My lớp 10 dạo này thân với một nhóm bạn mới: nhuộm tóc, nghỉ học đi cà phê, có đứa đã bị đình chỉ. My bắt đầu đi về trễ, ăn nói khác hẳn. Mẹ lo mất ngủ.", en: "My, in grade 10, has grown close to a new group: dyed hair, skipping class for cafes, one already suspended. My has begun coming home late and talking differently. Mum cannot sleep.")
#phanxa("Mẹ cấm con chơi với tụi đó! Toàn thứ hư hỏng. Còn gặp tụi nó nữa là mẹ cho nghỉ học ở nhà!", "Mẹ chửi bạn mình là chửi mình. Mẹ cấm thì mình giấu. Ít ra tụi nó không phán xét mình như mẹ.", en: ("I forbid you to see them! They are all trouble. See them again and I'll keep you home from school!", "Insulting my friends is insulting me. If Mum forbids it, I'll hide it. At least they don't judge me the way she does."))
#scene("Tình huống 9.3 · Thử nói cách khác")[
  #me("(Lúc chở con đi mua đồ.) Dạo này mẹ thấy con hay đi với nhóm bạn Trinh. Mẹ chưa biết gì về mấy bạn đó hết. Kể mẹ nghe đi, con thích gì ở tụi nó?", en: "(While driving her to the shops.) Lately I see you with Trinh's group a lot. I don't know anything about them yet. Tell me, what do you like about them?")
  #con("Mẹ định cấm chứ gì.", en: "You're going to ban me, aren't you.")
  #me("Mẹ có lo, mẹ không chối. Nhưng mẹ chưa biết gì thì mẹ chưa nói gì. Mẹ hỏi thiệt.", en: "I am worried; I won't deny it. But I know nothing yet, so I'm saying nothing yet. I'm really asking.")
  #con("Tụi nó vui. Tụi nó không soi con học giỏi hay dở. Ở với tụi nó con không phải gồng.", en: "They're fun. They don't judge whether I'm good or bad at school. With them I don't have to hold myself together.")
  #me("Không phải gồng. Vậy ở chỗ khác con đang phải gồng dữ lắm hả? Ở lớp, hay ở nhà?", en: "Don't have to hold yourself together. So elsewhere you're holding very tight? At school, or at home?")
  #con("...Cả hai. Ở lớp thì toàn đua điểm. Ở nhà thì ba mẹ cũng hỏi điểm.", en: "...Both. At school it's all a race for marks. At home you two ask about marks as well.")
  #me("Mẹ nghe rồi. Cái đó mẹ sẽ nghĩ, thiệt. Còn về nhóm bạn, mẹ không cấm con chơi. Mẹ chỉ có ba cái mốc không dời được: không nghỉ học, mười giờ có mặt ở nhà, và đi đâu thì mẹ biết chỗ. Trong ba cái mốc đó, bạn con là con chọn.", en: "I hear that. I will think about it, truly. As for the friends, I'm not banning you. I only have three markers that don't move: no skipping school, home by ten, and I know where you are. Within those three, your friends are your choice.")
  #con("Vậy thôi hả? Mẹ không bắt con nghỉ chơi?", en: "That's it? You're not making me drop them?")
  #me("Mẹ bắt thì con cũng chơi lén, rồi lúc có chuyện con không dám gọi mẹ. Mẹ thà con chơi công khai. Mà cuối tuần rủ tụi nó qua nhà ăn bánh xèo đi, mẹ muốn biết mặt bạn con.", en: "If I did you'd see them in secret, and then when something goes wrong you wouldn't dare call me. I'd rather it be in the open. And invite them over for pancakes this weekend; I want to know your friends' faces.")
  #con("Tụi nó tới nhà mình thiệt hả? Mẹ đừng có hỏi cung tụi nó nha.", en: "They'd really come to our house? Don't interrogate them, okay.")
  #me("Mẹ chỉ hỏi ăn thêm không thôi.", en: "The only thing I'll ask is whether they want seconds.")
]
#hieusau1("Tuổi mới lớn chọn bạn không ngẫu nhiên: các em tìm đến nơi cho mình thứ đang thiếu, được chấp nhận, được thở, được là mình. Cấm đoán chạm vào hành vi mà bỏ qua nhu cầu, và thường đẩy con về phía nhóm bạn mạnh hơn, lần này kèm theo bí mật. Giữ cửa nhà mở cho bạn của con, đặt vài mốc an toàn rõ ràng không thương lượng, và sửa cái thiếu ở nhà là cách giữ được ảnh hưởng. Đứa trẻ có quan hệ ấm với ba mẹ ít bị bạn bè kéo đi xa hơn nhiều.", en: "Teenagers do not choose friends at random: they go where they find what is missing, acceptance, room to breathe, being themselves. A ban touches the behaviour and ignores the need, and usually pushes the child harder towards the group, now with secrecy added. Keeping your door open to your child's friends, setting a few clear non-negotiable safety markers, and repairing what is missing at home is how you keep influence. A child with a warm tie to parents is far harder for friends to pull away.")
#cotloi("Cấm con chơi với bạn là mất cả hai: con vẫn chơi, và con hết kể. Giữ vài mốc an toàn thật chắc, còn lại hãy mời bạn con về nhà.", en: "Forbid the friendship and you lose twice: they still meet, and they stop telling you. Hold a few safety markers firmly, and otherwise invite the friends home.")
#lamngay1("Mời nhóm bạn của con tới nhà một bữa ăn đơn giản. Nhiệm vụ của ba mẹ hôm đó: nhớ tên từng đứa, không hỏi chuyện học hành gia cảnh, và quan sát con mình khi ở giữa bạn bè.", en: "Invite your child's friends for a simple meal. Your tasks that day: learn each name, ask nothing about marks or family background, and watch your own child among friends.")
#caunoi("Bạn con thì con chọn. Mẹ chỉ giữ ba cái mốc an toàn. Và mẹ muốn biết mặt bạn con.", en: "Your friends are your choice. I only keep three safety markers. And I want to know your friends' faces.")
#tusoi(("Nhóm bạn đó đang cho con thứ gì mà ở nhà con chưa có?", "Nếu con gặp rắc rối khi đi với bạn lúc nửa đêm, con có dám gọi cho mình không?",), en: ("What is that group giving my child that they do not yet have at home?", "If my child got into trouble with friends at midnight, would they dare call me?",))

#sec("Con bị bạn rủ làm chuyện sai và đã làm", en: "A friend dared your child to do wrong, and your child did it")
#boicanh("Cửa hàng tiện lợi gần trường gọi cho ba: thằng Sơn lớp 7 cùng hai bạn lấy ba thanh sô cô la không trả tiền, bị camera ghi lại. Quản lý chưa báo công an, mời phụ huynh tới. Sơn đứng trong góc, mặt cắt không còn giọt máu.", en: "The convenience store near school calls Dad: Son, in grade 7, and two friends took three chocolate bars without paying and were caught on camera. The manager has not called the police and asks a parent to come. Son stands in the corner, white as paper.")
#phanxa("Nhà mình có để con thiếu ăn không mà con đi ăn cắp? Ba còn mặt mũi nào nhìn ai! Về nhà con biết tay ba!", "Mình là thằng ăn cắp. Ba sẽ không bao giờ tha. Phải chi lúc đó mình chạy được.", en: ("Do we starve you, that you go stealing? How can I look anyone in the face! Wait till we get home!", "I am a thief. Dad will never forgive me. I wish I had managed to run."))
#scene("Tình huống 9.4 · Thử nói cách khác")[
  #ba("(Tới nơi, nói với quản lý trước.) Tôi xin lỗi anh. Cháu sai, gia đình xin trả tiền và cháu sẽ tự xin lỗi. (Quay qua Sơn, giọng trầm.) Sơn, con nói với chú đi.", en: "(On arriving, speaks to the manager first.) I apologise. My son was wrong; we will pay and he will apologise himself. (Turns to Son, voice low.) Son, speak to him.")
  #con("(Lí nhí.) Con xin lỗi chú. Con lấy đồ mà không trả tiền. Con sai rồi.", en: "(Barely audible.) I'm sorry, sir. I took things without paying. I was wrong.")
  #ba("(Trên đường về, dừng xe ở một quán nước.) Ba nói thật là ba sốc. Nhưng ba thấy con tự xin lỗi được, không đổ cho ai. Giờ kể ba nghe: chuyện xảy ra sao?", en: "(On the way home, stops at a drinks stall.) Honestly, I'm shocked. But I saw you apologise yourself without blaming anyone. Now tell me: what happened?")
  #con("Thằng Lực với thằng Bình nói lấy thử coi có dám không. Tụi nó nói ai không lấy là gà. Con không muốn mà con sợ tụi nó nói con nhát.", en: "Luc and Binh said try taking some and see if you dare. They said whoever doesn't is chicken. I didn't want to, but I was scared they'd call me a coward.")
  #ba("Lúc thò tay lấy, trong bụng con thấy sao?", en: "When you reached out to take it, how did you feel inside?")
  #con("Tim con đập muốn rớt ra. Con biết là sai.", en: "My heart was pounding like it would fall out. I knew it was wrong.")
  #ba("Cái tim đập đó là phần tốt trong con đang la lên. Lần này con không nghe nó. Con nghe hai thằng bạn. Ba hiểu sợ bị nói nhát nó mạnh cỡ nào ở tuổi con. Nhưng con thấy đó: lúc bị bắt, hai đứa nó có đứng ra chịu giùm con không?", en: "That pounding heart was the good part of you shouting. This time you didn't listen to it. You listened to two friends. I know how strong the fear of being called a coward is at your age. But notice: when you were caught, did those two step up to take the blame with you?")
  #con("Không. Tụi nó nói con lấy trước.", en: "No. They said I took it first.")
  #ba("Ừ. Vậy tiền sô cô la ba đã trả, con sẽ trả lại ba bằng tiền tiêu vặt của con, trừ dần bốn tuần. Không phải ba phạt cho hả giận, mà vì ai lấy thì người đó trả. Và mình tập trước một câu để lần sau có đứa thách: tao không chơi trò đó. Nói cho ba nghe coi.", en: "Right. So I have paid for the chocolate, and you will pay me back from your pocket money over four weeks. Not so I can vent, but because whoever takes, pays. And let's rehearse a line for the next dare: I don't play that game. Say it to me.")
  #con("Tao không chơi trò đó.", en: "I don't play that game.")
  #ba("To hơn. Nói như con tin câu đó.", en: "Louder. Say it like you believe it.")
]
#hieusau1("Ăn cắp vặt theo nhóm ở tuổi thiếu niên thường không vì món đồ mà vì phép thử lòng can đảm trước bạn bè. Nỗi sợ bị loại khỏi nhóm ở tuổi này mạnh tới mức át cả hiểu biết đúng sai mà con vốn có. Vì vậy mắng con là đồ ăn cắp vừa sai vừa nguy hiểm: nó trao cho con một danh tính mới. Việc cần làm là để con đối diện hậu quả thật, xin lỗi, bồi hoàn bằng tiền của mình, và trang bị cho con một câu từ chối đã tập sẵn.", en: "Petty group theft in early adolescence is usually not about the item but about a test of nerve in front of friends. Fear of exclusion at this age is strong enough to drown out the sense of right and wrong the child already has. Calling the child a thief is therefore both wrong and dangerous: it hands them a new identity. What is needed is for the child to face real consequences, apologise, repay from their own money, and be equipped with a refusal line rehearsed in advance.")
#cotloi("Để con tự xin lỗi và tự bồi hoàn. Hậu quả thật dạy con nhiều hơn mọi trận đòn. Và đừng bao giờ gọi con bằng tên của lỗi con vừa phạm.", en: "Let your child apologise and repay in person. Real consequences teach more than any beating. And never call your child by the name of the mistake they have just made.")
#lamngay1("Cùng con soạn ba câu từ chối bạn bè mà không mất mặt, bằng giọng của con: Tao không chơi trò đó. Thôi, tao về. Ba tao mà biết là tao tiêu. Tập nói thành tiếng. Câu từ chối phải có sẵn trong miệng trước khi cần tới.", en: "With your child, write three ways to refuse friends without losing face, in their own voice: I don't play that game. Nah, I'm going home. My dad would kill me. Practise aloud. A refusal must already be in the mouth before it is needed.")
#caunoi("Cái tim đập thình thịch lúc đó là phần tốt trong con đang la lên. Lần sau con nghe nó nha.", en: "That pounding heart was the good part of you shouting. Next time, listen to it.")
#tusoi(("Con mình có đủ tự tin để chịu bị bạn chê nhát không? Điều gì giúp con có được sự tự tin đó?", "Khi con làm sai, mình để con tự chịu hậu quả hay mình dàn xếp giùm cho êm?",), en: ("Is my child confident enough to bear being called a coward? What helps build that confidence?", "When my child does wrong, do I let them face the consequence, or do I smooth it over for them?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 9: mang theo bên mình]
#doicau1((("Con tôi ở nhà ngoan lắm, chắc cô nhầm.", "Cô cho tôi biết cụ thể sự việc. Tôi sẽ nói chuyện với cháu và báo lại cô.", "My child is very good at home; there must be a mistake.", "Please tell me exactly what happened. I will talk with my child and get back to you."), ("Mẹ không ngờ con ác vậy.", "Việc con làm khiến bạn đau thật. Mẹ tin con không muốn vậy, giờ mình sửa.", "I never imagined you could be so cruel.", "What you did truly hurt your friend. I believe you didn't want that; now we repair it."), ("Mẹ cấm con chơi với tụi đó.", "Kể mẹ nghe về bạn con đi. Con thích gì ở tụi nó?", "I forbid you to see them.", "Tell me about your friends. What do you like about them?"),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Khi con làm sai với người khác, ba bước không bỏ được: con hiểu người kia đau ra sao, con tự xin lỗi, con làm một việc để bù đắp. Ba mẹ đi theo tới bước cuối.", "Xin lỗi thật có ba phần: con đã làm gì, việc đó làm bạn thấy sao, con sẽ làm gì khác. Câu con xin lỗi được chưa không phải là xin lỗi.", "Trẻ học cách đối xử với người yếu thế từ cách ba mẹ nói về người giúp việc, người bán hàng, người nghèo, người khác mình. Con nghe hết.",), en: ("When a child wrongs someone, three steps cannot be skipped: understand how the other person was hurt, apologise in person, do something to make amends. Parents follow through to the last step.", "A real apology has three parts: what I did, how it made you feel, what I will do differently. I said sorry, is that enough? is not an apology.", "Children learn how to treat the vulnerable from how parents speak about domestic helpers, shop workers, the poor, people who are different. They hear all of it.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày, mỗi ngày cả nhà mỗi người làm một việc tử tế nhỏ cho một người ngoài gia đình và kể lại trong bữa tối. Ba mẹ làm và kể trước.",), mark: sym.star.filled, en: ("For seven days, everyone in the family does one small kindness for someone outside the family and tells about it at dinner. Parents do it and tell first.",))
