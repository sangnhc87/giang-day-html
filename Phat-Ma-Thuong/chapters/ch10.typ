#import "../template.typ": *

#chapter-open(10, "Bỏ tiết, trốn học, đến lớp mà tâm hồn đi vắng", 10, "Em trốn học là em đang bỏ chạy khỏi điều gì đó. Việc của thầy là tìm ra điều đó, không phải là bắt em về.", "Trốn một tiết, nghỉ liền thứ Hai, ngồi trong lớp mà như ở nơi khác, đó là ba dạng bỏ cuộc khác nhau. Phạt theo kiểu đếm số buổi thì sẽ đẩy em đi xa hơn. Chương này gợi những cách giữ em ở lại bằng cách hiểu vì sao em đi, kèm vài chiêu nhẹ để em có lý do muốn quay lại.", ("Em trốn một tiết đi chơi", "Em trốn môn mà em sợ", "Em vắng liên tục vào thứ Hai", "Cả nhóm nhỏ rủ nhau cúp tiết", "Em muốn nghỉ học hẳn",))

#sec("Em trốn một tiết đi chơi")
#tinhhuong("10.1", "Em trốn một tiết đi chơi", "Nhà trường báo Kiên trốn tiết ba sau giờ ra chơi, ra quán nước đầu ngõ cùng hai bạn. Khi về lớp tiết sau, Kiên nói em đau bụng. Thầy biết em nói dối.")
#chieu("Tiết dạy lại", "Thầy không tra hỏi. Thầy nói: tiết ba thầy dạy bài khá quan trọng, em nghỉ mất rồi. Em tự học bài đó từ bạn rồi dạy lại cho thầy trong năm phút, như một thầy giáo. Thầy cảm thấy em hiểu thì cho một điểm cộng, chưa hiểu thì thầy kèm thêm. Thầy cũng hỏi em: điều gì ở tiết đó hoặc ở lớp khiến em muốn ra ngoài? Em nói được thì thầy lắng nghe.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Kiên, thầy biết em không đau bụng, thầy không giận. Tiết em vắng thầy dạy bài quan trọng, em nhờ bạn kể lại, ngày mai dạy lại cho thầy năm phút nhé.")
  #tro("Dạ... em xin lỗi thầy. Em chán tiết đó.")
  #thay("Cảm ơn em nói thật. Em nói thầy nghe chán chỗ nào, thầy muốn biết.")
]
#visao("Phạt trốn học bằng cách cấm đoán chỉ làm em tìm đường trốn kín hơn. Việc dạy lại bắt em tiếp thu bài đã lỡ và biến bài học thành món nợ nhẹ. Việc hỏi lý do mở ra thông tin giúp thầy cô điều chỉnh.")
#ranhgioi("Không dùng với em trốn vì sợ bị bạo lực học đường, hay chuyện gia đình. Không bắt dạy lại trước cả lớp nếu em ngại. Nếu em trốn lặp lại nhiều lần, báo phụ huynh một cách thân thiện.")
#bientau("Cho em dạy lại cho thầy riêng ở bàn thầy thay vì trước cả lớp.")
#caunoi("Tiết em vắng thầy dạy bài quan trọng. Em nhờ bạn kể lại rồi dạy thầy năm phút nhé.")

#sec("Em trốn môn mà em sợ")
#tinhhuong("10.2", "Em trốn môn mà em sợ", "Bạn Thy lần nào cũng nghỉ tiết thể dục, hoặc trốn tiết Toán khi có kiểm tra miệng. Em hay xin phép đi vệ sinh và không quay lại. Em không phải là em hư.")
#chieu("Cửa sau có lý do", "Thầy gặp riêng Thy và nói: thầy nhận thấy có tiết em hay không muốn vào. Thầy không hỏi nguyên nhân, em chỉ cần chọn một trong hai: thầy cho em một lý do nhỏ chính đáng để ở ngoài hoặc đến muộn khi có kiểm tra miệng như một thỏa thuận, và đổi lại em báo thầy trước. Ngoài ra thầy hứa kiểm tra miệng em theo cách em thoải mái hơn như viết hoặc trả lời riêng sau tiết.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thy, thầy thấy có tiết em hay muốn ra ngoài. Thầy không hỏi lý do. Em báo trước với thầy, mình thỏa thuận cách khác để em vẫn học được mà không phải bỏ đi.")
  #tro("Dạ... em sợ bị gọi lên bảng thầy.")
  #thay("Cảm ơn em nói thật. Thầy hứa không gọi em lên bảng bất ngờ, thầy báo trước một ngày nhé.")
]
#visao("Em bỏ tiết vì sợ bị đánh giá hay xấu hổ, không phải lười. Thỏa thuận chủ động báo trước biến việc trốn thành việc thương lượng, và giảm nỗi sợ nhờ cách kiểm tra mềm hơn. Em thấy thầy tin mình.")
#ranhgioi("Không dùng như quyền lợi lâu dài nếu nỗi sợ lớn dần. Nếu em lo âu nặng khi đến lớp, đề nghị gia đình đưa em gặp chuyên viên tâm lý học đường.")
#bientau("Thầy giao trước câu hỏi sẽ hỏi miệng một ngày, em chuẩn bị trước để tự tin.")
#caunoi("Em báo thầy trước khi thấy sợ, mình thỏa thuận cách khác nhé.")

#sec("Em vắng liên tục vào thứ Hai")
#tinhhuong("10.3", "Em vắng liên tục vào thứ Hai", "Ba tuần liên tiếp Giang nghỉ thứ Hai, xin phép mơ hồ. Em còn hơi lúng túng khi thầy hỏi. Thầy nghi có chuyện nhưng chưa biết là gì.")
#chieu("Cuộc gọi Chủ nhật", "Thầy gọi điện cho Giang vào tối Chủ nhật, nói đúng ba câu: thầy gọi để hỏi thăm, thầy không hỏi chuyện nghỉ học, mai thầy mong gặp em. Nếu em không bắt máy, thầy để lại tin nhắn ngắn. Không điều tra, không trách. Khi em quay lại thầy chỉ nói: thầy mừng khi thấy em. Sau vài tuần, em tự kể lý do.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Giang, thầy gọi để hỏi thăm em thôi. Thầy không hỏi chuyện nghỉ học. Mai thầy mong gặp em ở lớp.")
  #tro("Dạ... em cảm ơn thầy. Mai em đi học ạ.")
  #thay("Thầy cảm ơn em. Có chuyện gì cần thầy thì em cứ nhắn nhé.")
]
#visao("Em vắng có quy luật thường mang một lý do mà em chưa dám nói. Việc gọi hỏi thăm không kèm trách móc cho em thấy có người nhớ mình và không phán xét. Cảm giác thuộc về thường kéo em quay lại hơn mọi nhắc nhở.")
#ranhgioi("Không gọi dồn nhiều lần. Nếu nghi ngờ em bị bạo hành hay phải đi làm, tham vấn nhà trường và bộ phận hỗ trợ. Không ép em kể.")
#bientau("Gửi qua lớp trưởng một mẩu ghi chú cho bài hôm đó, kèm lời: thầy để dành cho em.")
#caunoi("Thầy gọi hỏi thăm em thôi. Mai thầy mong gặp em ở lớp.")

#sec("Cả nhóm nhỏ rủ nhau cúp tiết")
#tinhhuong("10.4", "Cả nhóm nhỏ rủ nhau cúp tiết", "Ba em Hùng, Tài, Sơn cùng trốn tiết cuối chiều để đi chơi game. Cả ba bị phát hiện và rất lo lắng, nhưng vẫn cười gượng như không có gì.")
#chieu("Ba vị khách mời", "Thầy mời cả ba em đến một buổi ngắn gọi là Họp tiểu ban quản lý rủi ro. Thầy nói: ba em vừa trải nghiệm một sự kiện, thầy cần ba em giúp thầy biết cách để các bạn khác không cúp tiết nữa. Mỗi em viết ba cách ngăn bạn trốn tiết mà không dùng việc phạt. Ba em suy nghĩ như người xây dựng nội quy, và thường chính các em thấy lý do mình sai.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Ba em ghé thầy một chút. Thầy cần ba em giúp thầy việc này: các em là chuyên gia vừa trốn tiết, hãy viết ba cách để các bạn khác không trốn, không dùng phạt.")
  #tro("Dạ... chuyên gia hả thầy? Tụi em làm được.")
  #thay("Thầy tin. Thầy đọc xong sẽ chọn một cách đem ra lớp, ghi tên ba em.")
]
#visao("Biến người phạm lỗi thành cố vấn giúp em từ phòng thủ sang cộng tác. Khi phải nghĩ cách ngăn trốn, em phải đặt mình vào vị trí người kiểm soát và nhìn lại hành vi của mình. Nội quy do em góp ý cũng dễ được tuân thủ hơn.")
#ranhgioi("Chỉ dùng khi lỗi ở mức nhẹ và là lần đầu. Không công khai danh sách ba em. Vẫn báo phụ huynh nếu quy định yêu cầu.")
#bientau("Chọn một cách do các em đề xuất và thử áp dụng trong một tuần.")
#caunoi("Ba em là chuyên gia vừa trốn tiết, giúp thầy nghĩ ba cách để bạn khác không trốn nhé.")

#sec("Em muốn nghỉ học hẳn")
#tinhhuong("10.5", "Em muốn nghỉ học hẳn", "Minh, lớp 11, nói với thầy: em định nghỉ học đi làm. Em nói bình thản như đã quyết. Điểm em thấp, em thấy mình học không nổi. Thầy lo lắng.")
#chieu("Cửa lớp vẫn có ghế", "Thầy không thuyết giảng. Thầy nói: thầy hiểu em đang nặng nề lắm. Thầy xin em một điều: em đừng quyết trong tuần này. Mình hẹn nhau một buổi ra chơi mỗi ngày trong năm ngày để nói chuyện, em kể thầy nghe, thầy chỉ lắng nghe. Thầy cũng mời gia đình và nhà trường cùng tìm giải pháp như học nghề hoặc điều chỉnh lịch học. Chiếc ghế của em ở lớp vẫn giữ nguyên.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Minh, thầy nghe em. Thầy xin em một điều thôi: đừng quyết trong tuần này. Mỗi ngày ra chơi mình nói chuyện năm phút, thầy chỉ lắng nghe.")
  #tro("Dạ... thầy cho em nghĩ thêm.")
  #thay("Chiếc ghế của em ở lớp vẫn đó. Em cứ nghĩ, thầy chờ.")
]
#visao("Quyết định bỏ học thường đến sau một chuỗi cảm giác thất bại. Kéo dài thời gian quyết định, cho em được lắng nghe, và mở ra các lựa chọn khác như học nghề giúp em thấy mình còn lối đi. Thầy giữ ghế cho em là lời mời quay lại cụ thể.")
#ranhgioi("Không thuyết giảng, không dọa về tương lai. Không hứa những điều thầy không làm được. Phải phối hợp với gia đình và nhà trường, đặc biệt khi em có dấu hiệu trầm cảm hoặc bị ép buộc nghỉ học.")
#bientau("Giới thiệu em với một chuyên viên hướng nghiệp hoặc một anh chị đã đi học nghề thành công.")
#caunoi("Thầy nghe em. Em đừng quyết trong tuần này, mình nói chuyện mỗi ngày năm phút nhé.")

