#import "../template.typ": *

#chapter-open(8, "Làm nhóm: ăn không, giành làm, chia phe", 8, "Làm nhóm là nơi học sinh học cách sống với nhau. Phạt trong nhóm phải làm nhóm tốt hơn, không phải làm nhóm sợ hơn.", "Mỗi lần giao bài nhóm là mỗi lần thầy cô nghe những lời kêu ca quen thuộc: bạn ấy không làm gì hết, bạn ấy giành làm hết, hai bạn kia giận nhau. Điểm chung là em cần học cách cộng tác, và điều đó dạy bằng trải nghiệm tốt hơn bằng lời giảng. Chương này gợi những chiêu cho từng kiểu lỗi nhóm, đều có phần phạt vui và phần học thật.", ("Một bạn ăn không trong nhóm", "Một bạn giành làm hết, không cho ai chen vào", "Hai bạn giận nhau, không chịu làm chung", "Nhóm làm sơ sài, nộp cho xong", "Cả nhóm chia phe, kéo bè",), en: ("Group work: freeloading, taking over, taking sides", "Group work is where students learn to live with one another. Punishment within a group must make the group better, not more afraid.", "Every time group work is set, teachers hear the same complaints: he does nothing, she does it all, those two are not speaking. The common thread is that students must learn to cooperate, and experience teaches that better than lectures. This chapter offers moves for each type of group fault, each with a light penalty and real learning.", ("One student freeloads in the group", "One student takes over and will not let anyone join in", "Two students are angry with each other and will not work together", "A group hands in sloppy work just to finish", "The class splits into rival camps",)))

#sec("Một bạn ăn không trong nhóm", en: "One student freeloads in the group")
#tinhhuong("8.1", "Một bạn ăn không trong nhóm", "Nhóm sáu em, bốn em làm việc, một em đứng nhìn, một em dùng điện thoại. Cả nhóm bực nhưng không dám nói. Cuối buổi nộp sản phẩm tên ai cũng có, trong khi hai em chẳng làm gì.", en: "A group of six: four work, one stands and watches, one uses a phone. The whole group is annoyed but dares not say. At the end the product has everyone's names on it, though two did nothing.")
#chieu("Nhật ký phần của tôi", "Mỗi em trong nhóm có một tờ nhỏ ghi trong bốn mươi phút: tôi đã làm gì, tôi sẽ làm gì tiếp. Cuối buổi thầy đi một vòng và đọc nhẹ từng tờ. Thầy không phạt ai, chỉ đọc cho nhóm nghe những phần đã có. Em nào tờ giấy trống, thầy hỏi rất nhẹ: phần của em là gì để nhóm xếp giúp. Lúc đó em thường tự lên tiếng nhận việc thay vì ngồi lì.", en: ("My part log", "Each member has a small slip on which, during forty minutes, they note: what I have done, what I will do next. At the end you go round and gently read each slip. You punish nobody, you simply read the parts that exist for the group to hear. If a student's slip is blank, you ask very lightly: what is your part, so the group can arrange it? At that point he often speaks up and takes a task instead of sitting stubbornly."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Mỗi em ghi lại phần việc của mình trên tờ này trong buổi học nhé. Cuối buổi thầy đọc cho cả nhóm nghe những phần đã có.", en: "Each of you, note down your own part in this slip during the session. At the end I will read out to the group the parts that are there.")
  #tro("Dạ... em chưa làm gì nhiều thầy.", en: "Um... I have not done much yet, sir.")
  #thay("Không sao. Em chọn một phần nhỏ để làm nốt trong mười phút còn lại, nhóm sẽ chờ em.", en: "That is fine. Pick one small part to finish in the last ten minutes; the group will wait for you.")
]
#visao("Ăn không thường vì em không biết mình làm gì, hoặc sợ làm sai. Một tờ ghi từng phần việc làm rõ ranh giới trách nhiệm mà không cần ai trách ai. Khi việc của mình hiện ra trên giấy, em có áp lực nhẹ nhưng rõ để làm.", en: "Freeloading is often because the student does not know what to do, or fears getting it wrong. A slip listing each part makes the boundaries of responsibility clear without anyone blaming anyone. When his job appears on paper, he feels a light but clear pressure to act.")
#ranhgioi("Không đọc tờ giấy trống của em trước cả lớp. Không phạt cả nhóm vì một người. Nếu em không làm vì không hiểu bài, giúp em trước.", en: "Do not read an empty slip aloud before the class. Do not punish the whole group for one person. If he does not work because he does not understand the material, help him first.")
#bientau("Cho cả nhóm chia việc bằng các thẻ màu, mỗi em bốc một thẻ để ai cũng có nhiệm vụ.", en: "Let the group assign jobs with coloured cards, each student drawing one, so everyone has a task.")
#caunoi("Mỗi em ghi phần việc của mình, cuối buổi thầy cùng cả nhóm xem.", en: "Each of you note your own part, and at the end I will look at it with the whole group.")

#sec("Một bạn giành làm hết, không cho ai chen vào", en: "One student takes over and will not let anyone join in")
#tinhhuong("8.2", "Một bạn giành làm hết, không cho ai chen vào", "Bạn Hạnh học giỏi, luôn tự làm hết bài nhóm vì lo các bạn làm không tốt. Nhóm bực vì không được đóng góp, em thì mệt vì gánh cả nhóm. Sản phẩm đẹp nhưng cả nhóm không học được gì.", en: "Hanh is a strong student who always does the whole group task herself for fear the others will do it poorly. The group is annoyed at not contributing, and she is tired from carrying everyone. The product is beautiful but the group has learned nothing.")
#chieu("Năm phút im lặng của trưởng nhóm", "Thầy nói riêng với Hạnh: thầy thử em một việc khó, năm phút tới em ngồi yên, chỉ quan sát, không được cầm bút, để các bạn làm. Thầy hẹn đến cuối năm phút em kể thầy nghe điều em thấy. Sau đó em chỉ được làm vai người hướng dẫn: hỏi, nhắc, gợi ý, không làm thay. Em thấy sự sai sót của bạn là cơ hội học, và các bạn cuối cùng cũng hiểu bài.", en: ("The team leader's five minutes of silence", "Tell Hanh privately: I set you a harder task. For the next five minutes you sit still and only observe, no pen in hand, while the others work. At the end of five minutes she tells you what she saw. After that she may only act as guide: asking, prompting, suggesting, never doing it for them. She sees that others' errors are chances to learn, and in the end the others understand the lesson."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hạnh, thầy thử em một việc khó hơn làm bài: năm phút tới em không được cầm bút, em chỉ quan sát để các bạn làm. Xong em kể thầy nghe em thấy gì.", en: "Hanh, I am setting you something harder than doing the work: for the next five minutes you may not touch a pen, you only observe while the others do it. Afterwards tell me what you saw.")
  #tro("Dạ... khó quá thầy ơi. Em thấy bạn làm chậm.", en: "Um... that is hard, sir. I saw they were slow.")
  #thay("Chậm cũng là cách học. Em hướng dẫn thôi, đừng làm thay nhé. Thầy tin em làm được.", en: "Slow is also a way of learning. You guide only, do not do it for them. I believe you can.")
]
#visao("Em giành làm vì lo lắng, không phải vì ích kỷ. Bắt em học cách buông giúp em thấy việc nhóm không phải là tự mình làm hết. Các bạn cũng có cơ hội lên tiếng, và sản phẩm là của cả nhóm.", en: "She takes over from anxiety, not selfishness. Making her learn to let go shows that group work is not doing everything yourself. The others get a chance to speak, and the product belongs to the group.")
#ranhgioi("Không chê em là độc đoán. Không giao nhiệm vụ làm giảm tinh thần chủ động của em. Khen sự trách nhiệm của em trước khi thử thách.", en: "Do not call her domineering. Do not assign a task that dampens her initiative. Praise her responsibility before the challenge.")
#bientau("Giao Hạnh vai thư ký ghi lại đóng góp của các bạn khác, em được ngồi cạnh mà không phải làm hộ.", en: "Give Hanh the role of secretary recording the others' contributions, sitting beside them without doing it for them.")
#caunoi("Em giúp thầy thử một việc khó: năm phút tới em chỉ quan sát, để các bạn làm nhé.", en: "Help me try something hard: for the next five minutes you only observe, and let the others do it.")

#sec("Hai bạn giận nhau, không chịu làm chung", en: "Two students are angry with each other and will not work together")
#tinhhuong("8.3", "Hai bạn giận nhau, không chịu làm chung", "Khuê và Ngân từng là bạn thân, giờ giận nhau nên không ai nói với ai. Cùng nhóm nhưng ngồi hai đầu, làm hai phần riêng không khớp. Cả nhóm lúng túng.", en: "Khue and Ngan used to be close friends. Now they are cross and not speaking. They are in the same group but sit at opposite ends, doing two separate parts that do not fit. The group is at a loss.")
#chieu("Cây bút chung", "Thầy đưa hai em một cây bút và một tờ giấy: hai em cùng cầm một cây bút này viết một đoạn ngắn mô tả điều hai em đều thích về nhóm. Thầy bấm giờ mười phút. Không ai được buông bút, mỗi em chỉ được viết một chữ rồi chuyển. Hai em vừa cười vừa trao đổi. Thầy không nhắc chuyện giận, chỉ để trò chơi làm việc của nó.", en: ("The shared pen", "Hand the two one pen and one sheet of paper: the two of you hold this one pen and write a short passage describing what you both like about the group. Time ten minutes. Neither may let go of the pen; each writes just one word and passes it on. They laugh and exchange ideas. You do not mention the quarrel; you simply let the game do its work."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hai em chung một cây bút này nhé. Em viết một chữ, đưa bạn viết một chữ tiếp, cứ thế, mười phút viết một đoạn về điều hai em thích ở nhóm.", en: "You two share this one pen. You write one word, hand it over, your friend writes the next, and so on, ten minutes to write a passage about what you like in your group.")
  #tro("(Khuê, Ngân ngập ngừng.) Dạ... bắt đầu hả thầy?", en: "(Khue and Ngan, hesitantly.) Um... we start now, sir?")
  #thay("Bắt đầu. Thầy không chấm điểm, thầy chỉ muốn xem hai em viết gì.", en: "Start. I do not grade it. I just want to see what you two write.")
]
#visao("Giận nhau thường cần một việc chung để mở cửa mà không phải nói thẳng. Cây bút chung buộc cả hai phối hợp, và phần vui của trò làm tan bớt căng thẳng. Hòa giải xảy ra như phần phụ của việc làm.", en: "Quarrels need a shared task to open the door without anyone having to say it outright. The shared pen forces cooperation, and the fun of the game eases the tension. Reconciliation happens as a side effect of doing something.")
#ranhgioi("Không ép hòa giải. Không nói về chuyện giận trước đám đông. Nếu mâu thuẫn nghiêm trọng, hẹn nói chuyện riêng.", en: "Do not force reconciliation. Do not speak about the quarrel before a crowd. If the conflict is serious, arrange to talk privately.")
#bientau("Cho hai em cùng làm một món thủ công nhỏ cho lớp như một tấm thiệp, mỗi em một nửa.", en: "Have the two make a small craft item for the class together, such as a card, each doing half.")
#caunoi("Hai em chung một cây bút, mỗi người một chữ, viết cho thầy một đoạn nhé.", en: "You two share one pen, one word each, and write me a passage.")

#sec("Nhóm làm sơ sài, nộp cho xong", en: "A group hands in sloppy work just to finish")
#tinhhuong("8.4", "Nhóm làm sơ sài, nộp cho xong", "Sản phẩm của nhóm Bốn trông rõ là làm vội, nội dung thiếu, trình bày cẩu thả. Cả nhóm nói đã cố hết sức. Thầy biết các em có khả năng hơn nhiều.", en: "Group Four's product is obviously rushed: content thin, presentation careless. The group says they did their best. You know they are capable of far more.")
#chieu("Triển lãm bản nháp", "Thầy không chấm điểm ngay mà dán bản nháp của nhóm lên bảng, kèm một mảnh giấy ghi hai điều nhóm tự thấy đã tốt và hai điều tự muốn nâng cấp. Thầy mời các nhóm khác đi một vòng, mỗi nhóm để lại một mảnh giấy gợi ý tử tế. Nhóm có hai ngày nâng cấp, điểm tính ở bản cuối. Cả nhóm thấy sản phẩm mình trong con mắt người khác nên tự nâng tiêu chuẩn.", en: ("A draft exhibition", "Do not grade it at once. Pin the group's draft on the board with a slip listing two things they themselves think good and two things they want to upgrade. Invite other groups to walk round, each leaving a kindly suggestion slip. The group has two days to upgrade; marks count the final version. They see their work through others' eyes and raise their own standard."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy chưa chấm bài này. Nhóm tự ghi hai điều tốt và hai điều muốn nâng cấp, thầy dán lên bảng cho các nhóm khác góp ý. Hai ngày sau mình nộp bản cuối.", en: "I am not grading this yet. The group lists two good things and two things to upgrade, and I pin it up for other groups to comment. Two days from now we hand in the final version.")
  #tro("Dạ... nhóm em làm lại được thầy.", en: "Um... our group can redo it, sir.")
  #thay("Thầy tin các em làm được tốt hơn. Bản nháp này chỉ là bản đầu thôi.", en: "I believe you can do better. This draft is just a first version.")
]
#visao("Nộp sơ sài thường vì không ai nhìn sản phẩm bằng con mắt người ngoài. Triển lãm bản nháp tạo ra người xem và động lực tự nâng chuẩn. Điểm chỉ tính ở bản cuối giúp nhóm thấy cơ hội thay vì áp lực.", en: "Sloppy work usually comes from nobody looking at the product with outside eyes. A draft exhibition creates viewers and the motive to raise their own standard. Marks counted only on the final version give the group opportunity instead of pressure.")
#ranhgioi("Chỉ được góp ý về sản phẩm, không về con người. Không để các nhóm so sánh chê bai. Nếu nhóm yếu do thiếu kỹ năng, hỗ trợ thêm.", en: "Comments may be about the product only, not the people. Do not let groups compare and mock. If the group is weak from lacking skills, give extra support.")
#bientau("Mời một bạn ở nhóm khác đóng vai khách hàng đặt câu hỏi cho sản phẩm.", en: "Invite a student from another group to play customer and ask questions about the product.")
#caunoi("Đây là bản đầu, hai ngày sau mình nộp bản cuối. Nhóm tự ghi hai điều muốn nâng cấp nhé.", en: "This is the first version; in two days we hand in the final one. List two things you want to upgrade.")

#sec("Cả nhóm chia phe, kéo bè", en: "The class splits into rival camps")
#tinhhuong("8.5", "Cả nhóm chia phe, kéo bè", "Trong lớp xuất hiện hai nhóm đối đầu nhau, ra chơi không nói chuyện, trong giờ làm bài nhóm thì từ chối ghép chung. Có em bị cô lập vì thuộc nhóm bên kia.", en: "Two opposing cliques have emerged in the class; they do not speak at break, and in group work they refuse to be put together. One student is isolated for belonging to the other side.")
#chieu("Đổi nhóm theo lá thăm", "Thầy tuyên bố trong tuần này mỗi bài nhóm sẽ bốc thăm chia lại. Thầy đặt luật vui: nhóm mới có một nhiệm vụ nhỏ bắt buộc là tìm ra ba điểm chung giữa các thành viên, không được là điểm chung đã biết. Cuối tiết mỗi nhóm đọc ba điểm chung. Dần dần các ranh giới phe nhóm mờ đi, vì các em phát hiện bạn bên kia cũng thích bóng đá hoặc cũng sợ môn Lý.", en: ("Change groups by lots", "Announce that this week every group task will be redrawn by lots. Set a fun rule: each new group has one small mandatory task of finding three things its members have in common, none already known. At the end of the lesson each group reads its three. Gradually the lines between camps blur, as students discover the one on the other side also likes football or also fears Physics."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Tuần này mình bốc thăm chia nhóm. Mỗi nhóm có một nhiệm vụ nhỏ: tìm ra ba điểm chung giữa các thành viên, những điểm chưa ai biết. Cuối tiết mình nghe.", en: "This week we draw lots for groups. Each group has a small task: find three things the members have in common, things nobody knew yet. At the end of the lesson we listen.")
  #tro("Dạ... bốc thăm luôn hả thầy?", en: "Um... we really draw lots, sir?")
  #thay("Bốc thăm luôn. Thầy tin lớp mình có nhiều điểm chung hơn mình tưởng.", en: "Really. I believe our class has more in common than we think.")
]
#visao("Phe nhóm sinh ra từ việc ít tiếp xúc với nhau. Chia lại ngẫu nhiên cộng nhiệm vụ tìm điểm chung tạo ra tiếp xúc có mục đích, đó là cách giảm định kiến hiệu quả nhất. Thầy không cần công khai nói đến mâu thuẫn.", en: "Camps arise from little contact. Random reshuffling plus a task of finding commonalities creates purposeful contact, the most effective way to reduce prejudice. You do not have to mention the conflict openly.")
#ranhgioi("Không chia nhóm để cố ý xếp hai em đang xích mích ngồi gần nhau mà không chuẩn bị. Nếu có em bị cô lập nặng, theo dõi riêng và có thể nói chuyện với các em liên quan.", en: "Do not shuffle so as to deliberately seat two quarrelling students together without preparation. If one student is badly isolated, watch separately and talk to those involved.")
#bientau("Làm bảng điểm chung của lớp, ai tìm ra điểm chung hay nhất tuần được ghi vào đó.", en: "Make a class chart of commonalities; whoever finds the best of the week gets written on it.")
#caunoi("Tuần này mình bốc thăm chia nhóm, mỗi nhóm tìm ba điểm chung chưa ai biết nhé.", en: "This week we draw lots for groups; each group finds three things in common that nobody yet knows.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 8: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Làm nhóm tốt khi mỗi em nhìn thấy phần của mình. Hãy làm cho phần việc hiện ra bằng tờ giấy, thẻ màu, nhật ký, đừng chỉ bằng lời nhắc.", "Em giành làm hết và em ăn không đều cần được giúp, nhưng cách giúp khác nhau: một em cần học buông, một em cần học bắt đầu.", "Đừng ép hòa giải. Tạo một việc chung để các em tự chạm nhau, hòa giải thường xảy ra như một phần phụ.",), en: ("Group work works when each student sees their part. Make the work visible with slips, coloured cards, logs, not only with reminders.", "The student who takes over and the one who freeloads both need help, but different help: one has to learn to let go, one has to learn to begin.", "Do not force reconciliation. Create a shared task for students to touch each other; reconciliation often happens as a by-product.",))
