#import "../template.typ": *

#chapter-open(6, "Nói tục, biệt danh, đùa dai", 6, "Lời nói là nơi các em thử quyền lực đầu tiên. Dạy các em dùng nó cho tử tế là việc lớn hơn bất kỳ môn nào.", "Tuổi mới lớn thích nói tục để thấy mình trưởng thành, thích đặt biệt danh để thấy mình hài hước, thích đùa dai để thấy mình có chỗ đứng. Phạt nặng thì các em nói lén, nói ở nơi khác. Chương này gợi những chiêu giúp các em tự thấy lời mình nói đi đến đâu, và học cách nói khác mà vẫn là mình.", ("Em nói tục thành thói quen", "Em đặt biệt danh xúc phạm cho bạn", "Em giấu đồ của bạn để trêu", "Em cười nhạo bạn trả lời sai", "Em đùa về ngoại hình bạn",), en: ("Swearing, nicknames, cruel jokes", "Words are where young people first test their power. Teaching them to use words kindly is bigger than any subject.", "Adolescents swear to feel grown up, coin nicknames to feel funny, play cruel jokes to feel they belong. Punish heavily and they swear in secret, elsewhere. This chapter offers moves that help students see where their words land, and learn to speak differently while still being themselves.", ("A student swears as a habit", "A student gives a classmate a cruel nickname", "A student hides a classmate's things as a prank", "A student laughs at a classmate's wrong answer", "A student jokes about a classmate's appearance",)))

#sec("Em nói tục thành thói quen", en: "A student swears as a habit")
#tinhhuong("6.1", "Em nói tục thành thói quen", "Bạn Đạt chêm một từ tục vào gần như mỗi câu. Em nói vô thức, không nhắm vào ai. Nhưng các bạn nữ xung quanh đã bắt đầu né em, và thầy nghe rõ mỗi lần.", en: "Dat drops a swear word into nearly every sentence. He does it without thinking, aimed at no one. But the girls around him have begun to avoid him, and you hear it every time.")
#chieu("Hũ từ thay thế", "Thầy đặt một chiếc hũ nhỏ trên bàn. Mỗi lần Đạt nói tục, thầy chỉ nhìn em, em tự viết từ đó vào một mảnh giấy và bỏ vào hũ, kèm một từ thay thế do em tự sáng tạo, càng hài hước càng tốt, như trời ơi đất hỡi, ôi chao quả cam. Cuối tuần thầy mở hũ đọc riêng với em, chọn từ sáng tạo nhất và tặng một điểm cộng. Cả lớp chỉ thấy cái hũ, không biết bên trong có gì.", en: ("The substitute-word jar", "Put a small jar on your desk. Each time Dat swears, you only look at him; he writes the word on a slip and drops it in the jar, with a substitute he invents himself, the funnier the better, such as good grief, oh my giddy aunt. At the end of the week you open the jar privately with him, pick the most inventive substitute and award a bonus point. The class sees only a jar, not what is inside."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Đạt, thầy không mắng em. Mỗi lần buột miệng, em ghi từ đó vào giấy, bỏ hũ, và nghĩ ra một từ thay thế thật vui. Cuối tuần thầy chọn từ sáng tạo nhất.", en: "Dat, I am not scolding you. Each time one slips out, write the word on a slip, drop it in the jar, and invent a really funny replacement. At week's end I pick the most creative one.")
  #tro("Dạ... em thử xem thầy.", en: "Um... I will try, sir.")
  #thay("Nhớ nhé, từ thay thế càng buồn cười càng tốt. Thầy chờ cuối tuần.", en: "Remember, the funnier the replacement, the better. I will wait for the weekend.")
]
#visao("Nói tục là phản xạ cần có hướng đi khác để thoát. Cho em một từ thay thế sáng tạo vừa giữ cái cảm giác được thoát cảm xúc, vừa bắt em tập đổi từ. Việc tự bỏ giấy vào hũ khiến em tự quan sát chính mình.", en: "Swearing is a reflex that needs another outlet. A creative substitute keeps the emotional release while making him practise changing words. Dropping the slip in the jar himself makes him observe himself.")
#ranhgioi("Không đọc nội dung hũ trước lớp. Không dùng khi từ tục nhắm vào người khác như xúc phạm gia đình hay ngoại hình. Khi đó chuyển sang nói chuyện nghiêm.", en: "Do not read the jar's contents before the class. Do not use it when the swearing targets others, such as insulting family or appearance. Then switch to a serious conversation.")
#bientau("Cả lớp thi nghĩ từ cảm thán sáng tạo nhất tuần, thầy ghi những từ hay lên một góc bảng.", en: "Have the class compete to invent the best exclamation of the week and write the good ones on a corner of the board.")
#caunoi("Mỗi lần buột miệng em ghi vào hũ và nghĩ một từ thay thế thật vui nhé.", en: "Each time one slips out, write it in the jar and think of a really funny replacement.")

#sec("Em đặt biệt danh xúc phạm cho bạn", en: "A student gives a classmate a cruel nickname")
#tinhhuong("6.2", "Em đặt biệt danh xúc phạm cho bạn", "Bạn Minh bị cả lớp gọi bằng một cái biệt danh liên quan đến cân nặng. Em cười gượng cho qua nhưng thầy thấy mắt em tối lại. Người đặt đầu tiên là bạn Hưng, vẫn coi đó là chuyện vui.", en: "Minh is called by the whole class by a nickname about his weight. He laughs it off awkwardly, but you see his eyes darken. The first to use it was Hung, who still thinks it is fun.")
#chieu("Biệt danh tử tế", "Thầy hẹn riêng Hưng. Thầy nói: em có tài đặt tên, thầy khâm phục. Thầy thử em nhé, em hãy đặt cho Minh một biệt danh nói về điểm mạnh của bạn. Thầy chỉ dùng nếu Minh đồng ý. Em viết ra ba ý tưởng, thầy xem và cùng chọn. Sau đó Hưng tự hỏi Minh, nếu Minh gật thì cả hai dùng từ đó. Biệt danh cũ chấm dứt một cách tự nhiên.", en: ("A kind nickname", "Meet Hung privately. Say: you have a gift for naming, I admire it. I challenge you: coin a nickname for Minh that speaks of his strengths. I will use it only if Minh agrees. He writes three ideas and you choose together. Then Hung asks Minh himself; if Minh nods, both use it. The old nickname dies a natural death."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hưng, em có tài đặt tên thật. Thầy thách em: nghĩ cho Minh một biệt danh nói về điểm mạnh của bạn, ba ý tưởng. Rồi hỏi Minh xem bạn có thích không.", en: "Hung, you really have a gift for naming. I challenge you to think up a nickname for Minh about his strengths, three ideas. Then ask Minh whether he likes it.")
  #tro("Dạ... thầy cho em suy nghĩ.", en: "Um... let me think about it, sir.")
  #thay("Thầy chờ. Biệt danh hay là biệt danh người được gọi thấy vui.", en: "I will wait. A good nickname is one that the person called by it finds fun.")
]
#visao("Em đặt biệt danh thường vì muốn được chú ý và hài hước. Chiêu này giữ lại tài đó và đổi hướng nó. Việc xin phép bạn trước khi dùng dạy em tôn trọng sự đồng ý của người khác.", en: "A student who coins nicknames usually wants attention and to be funny. This keeps that talent and redirects it. Asking permission before using teaches respect for another's consent.")
#ranhgioi("Không bắt Minh phải tha thứ hay tham gia. Nếu Minh bị tổn thương sâu, làm việc riêng với Minh trước. Không công khai phạt Hưng để tránh Minh càng bị chú ý.", en: "Do not force Minh to forgive or take part. If Minh is deeply hurt, work with Minh first. Do not publicly punish Hung, to avoid drawing more attention to Minh.")
#bientau("Mở tuần lễ gọi tên thật trong lớp, ai gọi biệt danh thì được nhắc nhẹ bằng một cái nháy mắt.", en: "Open a real-names week in the class; anyone who uses a nickname gets a gentle reminder in the form of a wink.")
#caunoi("Em có tài đặt tên. Thầy thách em đặt cho bạn một biệt danh bạn thấy vui.", en: "You have a talent for names. I challenge you to give a friend a nickname that friend will enjoy.")

#sec("Em giấu đồ của bạn để trêu", en: "A student hides a classmate's things as a prank")
#tinhhuong("6.3", "Em giấu đồ của bạn để trêu", "Mấy em giấu cặp của bạn Thư để trêu, bạn đi tìm khắp lớp, mắt đỏ lên. Cả nhóm cười thích thú. Đến khi thầy hỏi mới mang trả, nói chỉ là đùa.", en: "Several students hid Thu's bag as a prank; she searched the whole room, eyes reddening. The group laughed with delight. They returned it only when you asked, saying it was just a joke.")
#chieu("Đội tìm đồ có nghĩa vụ", "Thầy hỏi nhóm em có biết bạn Thư đã tìm bao nhiêu phút không. Rồi thầy cho cả nhóm một nhiệm vụ: sáng hôm sau đến sớm, mỗi em giúp Thư hoàn thành một việc trong buổi sáng, như xếp sách, mang ba lô, đóng cửa sổ. Thầy nói: giấu đồ làm Thư mất mười phút đời của bạn, các em trả lại mười phút bằng việc tử tế. Cuối buổi, Thư kể cảm giác nếu bạn muốn.", en: ("The search team owes a debt", "Ask the group whether they know how many minutes Thu spent searching. Then give them a task: next morning each comes early and helps Thu with one thing, such as arranging books, carrying her bag, closing windows. Say: hiding her things cost Thu ten minutes of her life; you give it back with kindness. At the end of the day, Thu may tell how it felt, if she wishes."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Các em giấu cặp làm Thư mất mười phút tìm kiếm và lo lắng. Mai các em đến sớm, mỗi em giúp Thư một việc nhỏ để trả lại mười phút đó nhé.", en: "By hiding the bag you made Thu lose ten minutes of searching and worrying. Tomorrow come early and each help Thu with one small thing, to give those ten minutes back.")
  #tro("Dạ... tụi em xin lỗi, tụi em không nghĩ vậy.", en: "Um... we are sorry, we did not think of it that way.")
  #thay("Thầy biết các em không có ý xấu. Nhưng đùa mà người kia không cười thì không phải đùa nữa.", en: "I know you meant no harm. But a joke that the other person does not laugh at is not a joke any more.")
]
#visao("Trò đùa dai hay bỏ qua cảm giác của người bị đùa. Việc trả lại thời gian bằng hành động cụ thể giúp các em hiểu giá trị của điều mình lấy đi, mà vẫn giữ được thể diện.", en: "Pranks tend to overlook the feelings of the one pranked. Giving the time back through concrete action helps them see the value of what they took, while saving their face.")
#ranhgioi("Không bắt Thư phải chấp nhận. Nếu có dấu hiệu bắt nạt kéo dài thì không còn là đùa và cần xử lý theo cách nghiêm túc hơn với nhà trường.", en: "Do not make Thu accept anything. If you see signs of long-term bullying, it is no longer a joke and needs a firmer response with the school.")
#bientau("Cho cả nhóm cùng viết một lời xin lỗi chung, mỗi em một câu, đọc riêng cho Thư.", en: "Have the group write a shared apology, one sentence each, read privately to Thu.")
#caunoi("Đùa mà bạn không cười thì không phải đùa. Mai các em đến sớm giúp Thư mười phút nhé.", en: "A joke the friend does not laugh at is not a joke. Tomorrow come early and help Thu for ten minutes.")

#sec("Em cười nhạo bạn trả lời sai", en: "A student laughs at a classmate's wrong answer")
#tinhhuong("6.4", "Em cười nhạo bạn trả lời sai", "Bạn Hoa giơ tay trả lời, đáp sai. Có tiếng cười ở dưới và một em nói xì. Hoa cúi gằm, sau đó cả tiết không giơ tay lần nào nữa.", en: "Hoa raises her hand and answers wrongly. Someone laughs below and another says tsk. Hoa bows her head, and for the rest of the lesson never raises her hand again.")
#chieu("Cảm ơn người dám sai", "Thầy ghi nhận ngay tại chỗ: cảm ơn Hoa đã dám trả lời, câu trả lời sai giúp lớp thấy chỗ dễ nhầm. Sau tiết, thầy mời em cười nhạo viết một tấm thiệp hai dòng cảm ơn Hoa vì đã giúp cả lớp hiểu bài và đặt lên bàn bạn. Thầy kể thêm lần thầy từng sai ngớ ngẩn nhất. Từ đó lớp bớt cười nhạo vì đã thấy thầy cũng sai.", en: ("Thanking the one who dares to be wrong", "Acknowledge on the spot: thank you, Hoa, for daring to answer; the wrong answer shows the class where the traps are. After the lesson, invite the student who laughed to write a two-line thank-you card to Hoa for helping the whole class understand, and leave it on her desk. Tell a story of the silliest mistake you ever made. After that the class laughs less, having seen you err too."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Cảm ơn Hoa đã dám trả lời. Câu đó sai ở chỗ rất nhiều bạn cũng sẽ nhầm. Nhờ Hoa mà cả lớp thấy chỗ cần cẩn thận.", en: "Thank you, Hoa, for daring to answer. That is exactly where many others would go wrong. Thanks to Hoa the whole class sees where to be careful.")
  #tro("(Em cười nhạo, ra chơi.) Thầy ơi, em xin lỗi vì cười Hoa.", en: "(The student who laughed, at break.) Sir, I am sorry for laughing at Hoa.")
  #thay("Em viết cho Hoa hai dòng cảm ơn, đặt lên bàn bạn nhé. Thầy tin Hoa sẽ vui.", en: "Write Hoa two lines of thanks and leave them on her desk. I think Hoa will be glad.")
]
#visao("Cười nhạo người sai làm cả lớp ngại giơ tay. Khi thầy công nhận người dám sai, chuẩn mực của lớp đổi: dám sai là đáng quý. Tấm thiệp biến người cười thành người ghi nhận.", en: "Laughing at a mistake makes the whole class reluctant to raise a hand. When you honour the one who dares to be wrong, the class norm changes: daring to err is admirable. The card turns the one who laughed into one who acknowledges.")
#ranhgioi("Không bắt em cười nhạo xin lỗi công khai, vì sẽ làm Hoa thêm bối rối. Không so sánh Hoa với bạn trả lời đúng.", en: "Do not make him apologise publicly, as it would embarrass Hoa further. Do not compare Hoa with a student who answered correctly.")
#bientau("Mở mục câu trả lời sai hay nhất tuần, chọn ra một câu trả lời sai giúp cả lớp hiểu sâu.", en: "Open a feature, wrong answer of the week, and pick one wrong answer that helps the class understand more deeply.")
#caunoi("Cảm ơn bạn dám trả lời, câu sai này giúp cả lớp hiểu rõ hơn.", en: "Thank you for daring to answer; this mistake helps the whole class understand better.")

#sec("Em đùa về ngoại hình bạn", en: "A student jokes about a classmate's appearance")
#tinhhuong("6.5", "Em đùa về ngoại hình bạn", "Bạn Sơn nói một câu về làn da của bạn Trang, cả nhóm cười. Trang giả vờ không nghe nhưng thầy thấy em cúi mặt, sau đó em ngồi một mình ở ra chơi.", en: "Son makes a remark about Trang's skin and his group laughs. Trang pretends not to hear but you see her lower her face, and afterwards she sits alone at break.")
#chieu("Ba điều thật sự đẹp", "Thầy hẹn riêng Sơn, không trách. Thầy nói: những câu đùa về ngoại hình thường làm người kia nhớ rất lâu. Thầy giao em một việc: viết ba điều thật sự đẹp ở Trang mà không liên quan ngoại hình, như tính cách, thói quen tốt, tài năng. Em đưa thầy xem, nếu chân thành thì em trao cho Trang kèm một lời xin lỗi ngắn do em tự chọn cách nói. Lần sau còn đùa ngoại hình thì thầy chỉ cần giơ ba ngón tay.", en: ("Three truly beautiful things", "Meet Son privately, without blame. Say: jokes about appearance are remembered for a very long time. Your task: write three things that are truly beautiful about Trang that have nothing to do with looks, such as character, good habits, talents. Show me; if sincere, give it to Trang with a short apology in your own words. Next time he jokes about looks, you only hold up three fingers."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Sơn, thầy tin em không có ý ác, nhưng câu đó có thể ở lại trong lòng Trang rất lâu. Em viết ba điều thật sự đẹp ở bạn, không về ngoại hình, rồi đưa thầy xem trước.", en: "Son, I believe you meant no harm, but that remark could stay in Trang's heart a long time. Write three truly beautiful things about her, nothing about looks, and show me first.")
  #tro("Dạ... em nghĩ được ạ.", en: "Um... I can think of some, sir.")
  #thay("Nếu thật lòng, em trao cho Trang cùng một lời xin lỗi ngắn. Còn nếu chưa nghĩ ra, em cứ nói thầy biết.", en: "If it is sincere, give it to Trang with a short apology. If you cannot think of any yet, just tell me.")
]
#visao("Em đùa về ngoại hình thường chưa ý thức hết sức nặng của lời nói. Phải tìm điều tốt thật ở bạn buộc em nhìn bạn như một con người đầy đủ. Giơ ba ngón tay là mật hiệu kín đáo giữa thầy và em.", en: "A student who jokes about looks has seldom grasped the weight of words. Having to find real good in her forces him to see her as a whole person. Holding up three fingers is a quiet signal between you and him.")
#ranhgioi("Không ép em xin lỗi trước cả lớp. Không để lời khen giả dối, nếu em không tìm được điều thật thì nói chuyện thêm chứ không bắt viết. Nếu đây là bắt nạt kéo dài, xử lý theo cách nghiêm hơn.", en: "Do not make him apologise before the class. Do not allow false praise; if he cannot find anything real, talk more rather than forcing him to write. If it is long-running bullying, respond more seriously.")
#bientau("Cho cả lớp cùng viết một thẻ khen không về ngoại hình cho một bạn bốc thăm, gửi qua hộp thư lớp.", en: "Have the whole class write a compliment card about something other than looks for a classmate drawn by lot, delivered via the class box.")
#caunoi("Thầy tin em không có ý ác. Em viết ba điều thật đẹp ở Trang, không nói về ngoại hình, rồi thầy cùng xem nhé.", en: "I believe you meant no harm. Write three truly lovely things about Trang, none about looks, and we will look at them together.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 6: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Lời nói tổn thương thường xuất phát từ nhu cầu được chú ý. Hãy để em dùng cùng tài năng đó cho một việc tử tế.", "Xin lỗi giả không có giá trị. Đừng ép xin lỗi trước đám đông, hãy để em tự chọn cách sửa.", "Khi đùa thành bắt nạt, đừng cố giữ chiêu nhẹ nhàng. Báo nhà trường và gia đình, bảo vệ người bị tổn thương trước.",), en: ("Hurtful words usually come from a need for attention. Let the student use the same talent for something kind.", "A false apology has no value. Do not force apologies before a crowd; let the student choose how to make amends.", "When a joke becomes bullying, do not cling to the gentle move. Inform the school and family, and protect the hurt student first.",))
