#import "../template.typ": *

#chapter-open(12, "Đồng phục, tóc tai, rác và ăn vặt", 12, "Những lỗi này nhỏ, nhưng nhỏ lặp đi lặp lại thì làm thầy cô mệt hơn lỗi lớn. Hãy phạt bằng sự tử tế, đừng phạt bằng sự cằn nhằn.", "Áo không bỏ vào quần, tóc nhuộm, vứt rác, ăn vặt trong lớp là những lỗi nề nếp thầy cô nhắc mỗi ngày. Nhắc mãi thì chai, phạt nặng thì lố. Chương này gợi những chiêu nhẹ như đổi vai, như thử thách ngắn, và hướng em tự thấy cái giá thật của lỗi nhỏ. Quan trọng nhất là phân biệt em làm sai vì cố tình và em làm sai vì không có điều kiện.", ("Em không mặc đồng phục", "Em nhuộm tóc, sơn móng tay", "Em vứt rác bừa bãi", "Em ăn vặt trong lớp",))

#sec("Em không mặc đồng phục")
#tinhhuong("12.1", "Em không mặc đồng phục", "Bạn Huy đi học nhiều ngày liên tiếp không mặc đồng phục, mặc áo thun thường. Em không giải thích, chỉ nói quên. Thầy chủ nhiệm nhắc, bạn bè cũng thấy.")
#chieu("Hỏi trước, áo sau", "Thầy gặp riêng và hỏi nhẹ: dạo này thầy thấy em hay mặc đồ thường, có chuyện gì khiến em khó mặc áo trường không? Nếu em nói áo hỏng, chật hoặc nhà chưa kịp mua, thầy kín đáo đưa em một chiếc áo trong tủ đồ dự phòng của lớp hoặc nối liên lạc với quỹ hỗ trợ. Nếu em chỉ không thích, thầy thương lượng: em mặc đồng phục trong tuần, cuối tuần em được chọn một ngày đặc biệt do lớp đề xuất.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Huy, dạo này thầy thấy em hay mặc đồ thường. Có chuyện gì khiến em khó mặc áo trường không? Thầy hỏi để giúp, không phải để phạt.")
  #tro("Dạ... áo em bị chật rồi mà nhà chưa mua được.")
  #thay("Cảm ơn em nói thật. Thầy có cách giúp, em đừng ngại nhé.")
]
#visao("Mặc sai đồng phục có thể là lỗi tuân thủ, nhưng nhiều khi là chuyện điều kiện. Hỏi trước giúp tránh phạt oan và cho thầy cơ hội hỗ trợ kín đáo. Em giữ được lòng tự trọng.")
#ranhgioi("Không công khai hoàn cảnh em. Không phạt em vì gia đình khó khăn. Khi em chỉ cố ý chống đối, nói chuyện thẳng nhưng vẫn riêng tư.")
#bientau("Lập tủ đồ dự phòng bằng quyên góp đồng phục cũ của các khóa trước.")
#caunoi("Dạo này thầy thấy em hay mặc đồ thường, có chuyện gì thầy giúp được không?")

#sec("Em nhuộm tóc, sơn móng tay")
#tinhhuong("12.2", "Em nhuộm tóc, sơn móng tay", "Đầu tuần, Nhi đi học với mái tóc nhuộm vàng và móng tay sơn bóng. Nội quy không cho phép. Cả lớp tò mò nhìn em, em ngẩng cao đầu.")
#chieu("Tuần thử thách", "Thầy mời Nhi ở lại và nói nhẹ: tóc em nhìn nổi bật thật. Nhưng trường có quy định, thầy cần em hiểu lý do. Thầy đề nghị một tuần thử thách: em trình bày với thầy ba lý do vì sao em chọn kiểu tóc đó, và thầy kể lý do của nội quy. Cùng nhau xem bên nào thuyết phục hơn. Em có thể đề xuất lên ban cán sự về việc xem xét nội quy hoặc chọn thời điểm nhuộm như kỳ nghỉ hè.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Nhi, màu tóc của em nổi thật. Thầy muốn nghe em nói vì sao em chọn, rồi thầy nói lý do nội quy. Mình xem nói chuyện với nhau có hay không nhé.")
  #tro("Dạ... em chỉ muốn khác một chút thôi thầy.")
  #thay("Thầy hiểu. Muốn khác là chuyện bình thường. Mình tìm cách để em vẫn là mình mà đúng nội quy nhé.")
]
#visao("Nhuộm tóc là cách tuổi mới lớn khẳng định bản thân. Thầy nghe trước rồi giải thích, em cảm thấy được tôn trọng nên dễ hợp tác. Nếu nội quy có vấn đề thì kênh góp ý là bài học công dân.")
#ranhgioi("Không làm nhục ngoại hình em. Không cắt tóc, không buộc gội ngay. Phải theo nội quy nhà trường và thông báo phụ huynh khi quy định yêu cầu. Nếu tóc nhuộm do hoàn cảnh bệnh hay lý do đặc biệt, linh hoạt.")
#bientau("Mời em làm đại diện lớp góp ý với ban giám hiệu về quy định tóc tai.")
#caunoi("Thầy muốn nghe lý do em chọn màu tóc, rồi thầy nói lý do nội quy nhé.")

#sec("Em vứt rác bừa bãi")
#tinhhuong("12.3", "Em vứt rác bừa bãi", "Giờ ra chơi, sàn lớp và sân trường đầy vỏ bánh, vỏ chai. Một em nào đó vừa ăn xong vứt ngay xuống đất rồi đi, cả nhóm thấy nhưng không ai nhặt.")
#chieu("Nhặt ba món", "Thầy không phạt riêng ai. Cả lớp hoặc nhóm em vứt rác nhận một thử thách ngắn: nhặt ba món rác không phải của mình trong ra chơi tiếp theo, và chụp ảnh cho thầy. Thầy kèm một câu hỏi: nhặt rác của người khác cảm giác thế nào? Em nhặt xong được dán một nhãn sticker hình chiếc lá xanh vào vở. Việc nhặt rác của người khác dạy em cảm giác thấy phiền hà thay vì chỉ nghe nói.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thử thách nhỏ cho em: ra chơi tiếp theo nhặt ba món rác không phải của em, chụp ảnh cho thầy xem nhé. Sau đó em kể thầy cảm giác thế nào.")
  #tro("Dạ... em làm. Hơi mệt thầy nhỉ.")
  #thay("Ừ, mệt đúng không. Đó là cảm giác của bác lao công mỗi ngày. Cảm ơn em nhé.")
]
#visao("Em vứt rác vì chưa thấy được hậu quả với người khác. Nhặt rác của người khác cho em trải nghiệm trực tiếp. Chiếc lá xanh biến nghĩa vụ thành sự ghi nhận.")
#ranhgioi("Không bắt nhặt rác nguy hiểm như kim tiêm, thủy tinh vỡ. Không bắt em làm một mình ở nơi vắng. Không dùng việc nhặt rác làm hình phạt thường xuyên.")
#bientau("Cả lớp thi tuần lớp sạch, lớp nào ít rác nhất ngày thứ Sáu được chọn bài hát phát ra chơi.")
#caunoi("Em nhặt giúp thầy ba món rác không phải của em, rồi kể thầy cảm giác nhé.")

#sec("Em ăn vặt trong lớp")
#tinhhuong("12.4", "Em ăn vặt trong lớp", "Giữa tiết, mùi bim bim bay ra từ cuối lớp. Có em lén bỏ vào miệng sau cuốn vở. Thầy nhắc thì em dạ, một lúc sau lại ăn. Các em bên cạnh bắt đầu xì xào.")
#chieu("Tiệc năm phút", "Thầy mỉm cười nói: em đói thật hả? Thầy cho em tiệc năm phút ngay bây giờ, em ra hành lang ăn thật nhanh, không ai thấy. Em quay lại thì thầy nói: vừa rồi là ưu tiên cho cái bụng, giờ là ưu tiên cho cái đầu. Lần sau trước tiết học, em ghi lên tờ giấy nhớ là đã ăn chưa để thầy biết. Có em nào đói thật, thầy bí mật kiểm tra giúp.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Em đói đúng không? Thầy cho em năm phút ra hành lang ăn cho xong, rồi quay lại nhé. Cái bụng xong rồi thì cái đầu cho thầy.")
  #tro("Dạ... em xin lỗi thầy. Sáng em chưa kịp ăn.")
  #thay("Không sao. Cảm ơn em nói thật. Ngày mai em ăn trước giờ học nhé, hoặc thầy giúp tìm cách.")
]
#visao("Ăn vặt trong lớp thường vì đói hoặc thói quen. Cho em ăn có kiểm soát giải quyết nhu cầu thật và bỏ đi cuộc đối đầu. Em hiểu quy tắc không phải để làm khó mà để lớp giữ nhịp.")
#ranhgioi("Nếu em bỏ bữa vì nhà khó khăn, đừng phạt mà hỗ trợ thực tế, như liên hệ bữa ăn bán trú hay quỹ hỗ trợ. Không công khai em đói. Không cho phép ăn thường xuyên trong tiết.")
#bientau("Quy định chung ba phút ăn nhẹ giữa tiết nếu cả lớp thật sự đói buổi sáng.")
#caunoi("Em đói thì thầy cho năm phút ra ngoài ăn, rồi mình quay lại học nhé.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 12: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Trước khi phạt lỗi nề nếp, hãy hỏi một câu: em không làm vì không muốn hay vì không có điều kiện? Câu trả lời đổi cách xử lý hoàn toàn.", "Lỗi nhỏ lặp lại cần thử thách ngắn có hình ảnh rõ, không cần lời quở dài. Nhặt ba món, đổi chỗ, nói ba lý do.", "Nội quy không bao giờ nên được dùng để làm nhục ngoại hình hay hoàn cảnh của em.",))
