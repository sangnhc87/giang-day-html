#import "../template.typ": *

#chapter-open(9, "Quay cóp, chép bài, gian lận", 9, "Một em quay cóp thường không phải vì xấu. Em quay cóp vì sợ. Gỡ nỗi sợ trước, rồi hãy xử lý hành vi.", "Quay cóp là lỗi nặng nhất về đạo đức học đường nhưng cũng là lỗi mà thầy cô dễ xử lý sai nhất, vì phạt nặng khiến em giấu giỏi hơn, còn bỏ qua khiến các em khác thấy gian lận có lợi. Chương này gợi những cách giữ nguyên tắc rất rõ nhưng vẫn đủ nhân văn để em sửa được, và để các bạn trung thực không bị thiệt.", ("Em chép bài bạn trước giờ vào lớp", "Em quay cóp trong bài kiểm tra", "Bạn giỏi cho chép bài rồi nói là giúp bạn", "Em dùng bài mạng chép nguyên văn",))

#sec("Em chép bài bạn trước giờ vào lớp")
#tinhhuong("9.1", "Em chép bài bạn trước giờ vào lớp", "Sáng nào thầy cũng thấy vài em xúm lại chép bài của bạn học giỏi trước giờ vào lớp. Có em chép nguyên văn cả sai chính tả. Bạn cho chép thì cười, nói là giúp bạn.")
#chieu("Chép mà hiểu", "Thầy không bắt chép lại. Thầy gọi riêng em chép và nói: thầy cho em chọn một câu em đã chép, giải thích cho thầy nghe bằng lời của em một bước thôi. Nếu em nói được thì em đã học được từ chép, thầy ghi nhận. Nếu chưa nói được, thầy ngồi cùng em năm phút giảng lại đúng câu đó. Từ đó em hiểu chép là đường vòng mệt hơn học.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Em chọn một câu em chép sáng nay, giải thích cho thầy một bước bằng lời của em. Em không nói được cũng không sao, thầy giảng lại ngay.")
  #tro("Dạ... em chưa hiểu bước này thầy.")
  #thay("Cảm ơn em nói thật. Mình ngồi năm phút làm lại nhé.")
]
#visao("Chép bài thường xảy ra khi em không đủ thời gian hoặc thấy bài khó. Cho em cơ hội chuyển từ chép sang hiểu một câu giúp em nhìn thấy chỗ trống kiến thức. Chiêu này không phạt mà làm hành vi chép mất ý nghĩa.")
#ranhgioi("Không công khai tên em chép. Không dùng khi em chép vì quá tải nặng, vì lúc đó cần hỗ trợ khối lượng bài. Không đổ lỗi cho bạn cho chép trước lớp.")
#bientau("Thiết lập góc làm bài sớm: sáng nào mười phút đầu cho học sinh làm bài cùng nhau có thầy ngồi cùng.")
#caunoi("Em giải thích giúp thầy một bước em đã chép nhé. Chưa hiểu thì thầy giảng lại.")

#sec("Em quay cóp trong bài kiểm tra")
#tinhhuong("9.2", "Em quay cóp trong bài kiểm tra", "Thầy thấy Bảo liếc sang bài bạn bên cạnh hai lần. Đến lần thứ ba, thầy chắc chắn. Em biết mình bị phát hiện, mặt trắng bệch, tay run. Cả lớp không ai nhìn thấy.")
#chieu("Hai lượt bài", "Thầy lặng lẽ úp bài em xuống, nói nhỏ: thầy giữ bài này, em làm tiếp trên tờ khác. Cuối giờ thầy giữ riêng em: lần này em làm, thầy giữ kết quả ở mức bài thật. Ba ngày sau, em làm lại một phần tương đương trong mười phút trước mặt thầy để thầy biết em thật sự hiểu đến đâu. Điểm lần sau là điểm thật. Thầy hỏi: điều gì khiến em muốn nhìn bài bạn? Em nói thật thì thầy cùng em tìm cách.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Bảo, thầy giữ bài này, em làm trên tờ khác. Cuối giờ em ở lại một chút, thầy muốn hỏi em một chuyện, không phải để mắng.")
  #tro("Dạ... em xin lỗi thầy. Em sợ bị điểm thấp, ba mẹ đánh.")
  #thay("Thầy hiểu. Cảm ơn em nói thật. Thầy không để chuyện này lan ra. Mình cùng tìm cách ôn thêm cho em tự tin hơn nhé.")
]
#visao("Gian lận thường là biểu hiện của nỗi sợ, và nỗi sợ sẽ lặp lại nếu chỉ phạt hành vi. Đưa ra cơ hội làm lại có thầy chứng kiến vừa giữ nguyên tắc, vừa cho em lối đi. Em học được rằng nói thật không hủy hoại em.")
#ranhgioi("Nếu nội quy trường quy định mức xử lý, phải làm đúng quy định nhưng vẫn giữ giọng nhân văn. Không cười nhạo, không nói với cả lớp. Nếu nỗi sợ đến từ gia đình bạo hành, thầy cô cần hỗ trợ kín đáo, không nên thông báo gia đình ngay.")
#bientau("Cho em viết một tờ ngắn: nếu em được làm lại, em sẽ chuẩn bị gì và nhờ ai giúp.")
#caunoi("Thầy giữ bài này. Em ở lại một chút, thầy muốn hỏi một chuyện, không phải để mắng.")

#sec("Bạn giỏi cho chép bài rồi nói là giúp bạn")
#tinhhuong("9.3", "Bạn giỏi cho chép bài rồi nói là giúp bạn", "Hiền cho bạn thân chép bài kiểm tra, vì không nỡ từ chối. Cô bạn kia sau đó bị phát hiện và khai ra Hiền. Hiền khóc, nói em chỉ muốn giúp bạn.")
#chieu("Cho cần câu", "Thầy nói riêng với Hiền: tình bạn của em quý, nhưng cho bạn chép là cho cá chứ không cho cần câu. Nhiệm vụ của em: hai buổi sau em ngồi dạy lại bạn đúng phần bài đó, thầy ngồi bên cạnh quan sát. Em dạy xong thì thầy đo kết quả bằng một bài ngắn của bạn, không tính điểm. Hiền thấy giúp thật nghĩa là gì, và bạn kia thật sự học được.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hiền, thầy hiểu em thương bạn. Nhưng cho chép là cho cá. Hai buổi tới em dạy lại bạn đúng phần bài đó nhé, thầy ngồi bên cạnh.")
  #tro("Dạ... em dạy được thầy. Nhưng bạn ấy có giận em không?")
  #thay("Thầy tin bạn hiểu. Mình cùng nói với bạn rằng em giúp theo cách khác.")
]
#visao("Em cho chép thường vì tình bạn, không phải vì gian. Chiêu này giữ lại tình bạn và đổi cách giúp, giúp em hiểu ranh giới giữa giúp thật và giúp sai. Cô bạn kia cũng học thật.")
#ranhgioi("Không công khai chuyện cho chép. Không để Hiền gánh trách nhiệm một mình cho bạn kia. Điểm của bài gian lận vẫn xử lý theo quy chế.")
#bientau("Lập đôi bạn cùng tiến để các em giúp nhau học một cách hợp lệ.")
#caunoi("Cho bạn chép là cho cá. Em dạy lại bạn bài đó, thầy ngồi cùng nhé.")

#sec("Em dùng bài mạng chép nguyên văn")
#tinhhuong("9.4", "Em dùng bài mạng chép nguyên văn", "Bài tập lớn của Phong có đoạn văn rất hay nhưng giọng văn lạ hẳn, không giống em. Thầy nghi em chép từ mạng hoặc dùng công cụ viết hộ. Em nói em tự viết.")
#chieu("Đọc to để hỏi", "Thầy không buộc tội. Thầy mời em đọc to đoạn văn đó trước thầy, riêng. Thầy hỏi ba câu: ý chính đoạn này là gì, vì sao em chọn từ này, nếu viết lại bằng lời em thì em nói thế nào. Chỗ nào em giải thích được thì giữ. Chỗ nào không giải thích được, em viết lại bằng lời mình trong ba ngày. Thầy không hỏi em chép hay không, chỉ hỏi em có hiểu không.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Phong, thầy mời em đọc to đoạn này cho thầy nghe. Rồi thầy hỏi ba câu: ý chính là gì, vì sao em chọn từ này, và em nói lại bằng lời em thì thế nào.")
  #tro("Dạ... đoạn này em có tham khảo thêm, em chưa hiểu hết thầy.")
  #thay("Cảm ơn em nói thật. Em viết lại bằng lời mình trong ba ngày nhé, thầy sẽ đọc.")
]
#visao("Không buộc tội mà để em tự đối diện với hiểu biết của mình. Em thấy khoảng trống mà không cảm thấy bị bắt quả tang. Chuyển trọng tâm từ chép hay không sang hiểu hay không là cách dạy tinh thần học thật.")
#ranhgioi("Nếu quy chế trường cấm nghiêm và em chép nguyên văn, vẫn phải xử lý theo đúng quy định. Không dùng phần hỏi để bẫy em. Tôn trọng giải thích của em nếu hợp lý.")
#bientau("Từ nay thầy đưa thêm bước trình bày miệng hai phút cho bài tập lớn.")
#caunoi("Em đọc to đoạn này cho thầy, rồi nói lại bằng lời của em nhé.")

