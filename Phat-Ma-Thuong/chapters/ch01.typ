#import "../template.typ": *

#chapter-open(1, "Nói chuyện riêng và mất trật tự", 1, "Một hình phạt hay là hình phạt mà học sinh kể lại cho bạn nghe và còn mỉm cười, nhưng lần sau vẫn nhớ không làm.", "Mỗi tiết học thầy cô đều gặp những chuyện rất nhỏ: hai em thì thầm, một em quay xuống, cả lớp rộ lên cười. Phạt nặng thì thấy dư, mà bỏ qua thì lớp trôi mất. Chương này gom những chiêu phạt ngắn, vui, riêng tư, không làm ai mất mặt, và quan trọng nhất là biến lỗi thành một việc có ích. Mỗi chiêu đi kèm lý do vì sao nó có tác dụng và ranh giới để thầy cô biết dừng ở đâu.", ("Hai em thì thầm suốt tiết", "Cả lớp rộ lên cười và không dừng được", "Một bạn quay xuống chọc bạn phía sau", "Một em cứ đứng lên đi lại giữa giờ", "Một em nói leo, chen vào mọi câu",), en: ("Chatting and disruption", "A good punishment is one the student retells to friends with a smile, and still remembers not to repeat.", "Every lesson brings small things: two students whispering, one turning round, the whole class erupting in laughter. Heavy punishment feels excessive, but ignoring it lets the class drift away. This chapter gathers short, funny, private punishments that embarrass no one and, above all, turn the fault into something useful. Each comes with the reason it works and the limit that tells you where to stop.", ("Two students whisper all lesson", "The whole class bursts out laughing and cannot stop", "A student turns round to poke the one behind", "A student keeps getting up and walking around", "A student blurts out answers and cuts in",)))

#sec("Hai em thì thầm suốt tiết", en: "Two students whisper all lesson")
#tinhhuong("1.1", "Hai em thì thầm suốt tiết", "Hai em ngồi cuối lớp nói chuyện riêng gần hết tiết. Thầy nhắc hai lần, em nào cũng dạ rồi năm phút sau lại thì thầm. Hai em không ồn lắm, nhưng cứ lấn dần sự tập trung của những bạn xung quanh.", en: "Two students at the back chat for most of the lesson. You have reminded them twice; each says yes, and five minutes later they are whispering again. They are not loud, but they steadily eat into the concentration of those around them.")
#chieu("Mười phút thả ga", "Cuối tiết, thầy mời hai em ở lại ba phút đầu giờ ra chơi. Thầy nói: hai em có nhiều chuyện để nói như vậy, thầy cho hai em đúng ba phút để nói hết, nói thả ga, thầy bấm giờ. Hết ba phút thì đủ. Hai em vừa được nói, vừa nhận ra mình đang trả một món nợ thời gian mà mình đã lấy của cả lớp. Có thể thêm một dòng: lần sau còn chuyện cần nói thì hai em ghi ra giấy, ra chơi thầy nghe đại diện.", en: ("Ten minutes unleashed", "At the end of the lesson, invite the two to stay for the first three minutes of break. Say: you two have so much to talk about, so I am giving you exactly three minutes to say it all, as freely as you like, and I will time it. When three minutes are up, that is enough. They are being heard, and they notice they are repaying a debt of time taken from the whole class. You may add: next time something cannot wait, write it on paper and at break I will listen to your representative."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hai em ở lại giúp thầy ba phút nha. Thầy không giận, thầy chỉ muốn nghe hai em nói hết chuyện chưa xong. Bắt đầu nhé, ba phút.", en: "Would you two stay with me for three minutes? I am not angry. I just want to hear whatever you have not finished saying. Ready? Three minutes.")
  #tro("Dạ... thầy cho tụi em nói luôn hả thầy?", en: "Um... you are letting us talk, sir?")
  #thay("Nói luôn. Ba phút nói thật nhiều. Hết giờ thầy xin lại sự tập trung của hai em trong tiết sau, được không?", en: "Go ahead. Three minutes, as much as you like. When time is up I will ask for your full attention next lesson. Deal?")
]
#visao("Học sinh nói chuyện riêng vì có chuyện thật muốn nói và không chờ được. Chiêu này công nhận nhu cầu đó, rồi gắn một giới hạn thời gian cụ thể cho nó. Hai em không bị mất mặt trước lớp, và khi được cho phép nói thoải mái, phần lớn các em tự thấy ngượng và dừng lại sớm trước khi hết ba phút.", en: "Students chat because they have something real to say and cannot wait. This move acknowledges that need and then attaches a concrete time limit. The two are not shamed before the class, and when given free rein most feel awkward and stop before the three minutes are up.")
#ranhgioi("Không phạt trước cả lớp. Không hỏi chuyện hai em nói là gì. Nếu hai em nói chuyện vì một chuyện nghiêm trọng như bạn bè xích mích hay có chuyện ở nhà, đừng cho đây là hình phạt nữa mà chuyển thành một cuộc trò chuyện thật.", en: "Do not punish in front of the class. Do not ask what they were saying. If the talk is about something serious, such as a friendship quarrel or trouble at home, stop treating this as punishment and turn it into a real conversation.")
#bientau("Nếu em ngại ở lại, đổi thành: hai em xếp lại ghế và bàn đầu giờ ra chơi, vừa nói vừa làm cũng được. Hoặc cho hai em tự chọn một trong hai: ba phút nói thả ga, hoặc ba phút im lặng đúng nghĩa trong tiết sau.", en: "If they are shy about staying, change it to: stack the chairs and tables at break, talking as they work. Or let them choose: three minutes of free talk, or three minutes of true silence next lesson.")
#caunoi("Thầy hiểu hai em có nhiều chuyện để nói. Thầy cho hai em thời gian để nói hết, rồi tới giờ học thì mình học.", en: "I know you two have plenty to say. I will give you time to say it all, and then when lesson time comes we learn.")

#sec("Cả lớp rộ lên cười và không dừng được", en: "The whole class bursts out laughing and cannot stop")
#tinhhuong("1.2", "Cả lớp rộ lên cười và không dừng được", "Một bạn vô tình nói một câu hài hước giữa tiết, cả lớp cười rộ. Thầy chờ, nhưng tiếng cười cứ kéo dài, có em còn nhắc lại câu đó để cười thêm. Tiết học đang đà tốt bị cắt ngang.", en: "A student accidentally says something funny mid-lesson and the class roars. You wait, but the laughter drags on; a few even repeat the line for another round. A lesson that was going well has been cut in two.")
#chieu("Ba mươi giây cười có kiểm soát", "Thầy mỉm cười: câu đó đúng là buồn cười, thầy cho cả lớp đúng ba mươi giây cười thật to, thầy bấm giờ. Hết giờ, thầy giơ tay: dừng. Lớp sẽ cười thêm nhưng yếu dần. Thầy nói: cảm ơn cả lớp, giờ mình học tiếp. Nếu có em còn cười, thầy chỉ nhắc nhẹ: còn nợ thầy mười giây.", en: ("Thirty seconds of controlled laughter", "Smile and say: that really was funny, so I give the whole class exactly thirty seconds to laugh as loud as you can, and I will time it. When time is up, raise a hand: stop. The class may laugh a little more, but it fades. Say: thank you, now we carry on. If someone is still laughing, just remind them lightly: you still owe me ten seconds."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Câu đó đáng được cười. Ba mươi giây, bắt đầu! ... Hết. Cảm ơn cả lớp, giờ mình trở lại bài.", en: "That line deserved a laugh. Thirty seconds, go! ... Time. Thank you, everyone, now back to the lesson.")
]
#visao("Tiếng cười không dập được bằng lệnh im lặng, càng cấm càng nổ. Cho phép nó trong một khung giờ rõ ràng biến nó thành thứ thầy điều khiển được. Cả lớp cũng thấy thầy là người có khiếu hài, và sẽ hợp tác hơn lần sau.", en: "Laughter cannot be crushed by an order to be quiet; the more you forbid it, the more it explodes. Allowing it within a clear window makes it something you control. The class also sees you as someone with a sense of humour, and cooperates more next time.")
#ranhgioi("Không cho cười nếu tiếng cười nhắm vào một bạn cụ thể với ý chê bai. Khi đó dừng ngay và nói riêng với người bị cười.", en: "Do not allow laughter aimed at one particular student in a mocking way. Stop it at once and speak privately to the one laughed at.")
#bientau("Dùng trò chơi nhỏ để cười xong rồi tập trung: cả lớp hít sâu ba lần, rồi mới đọc tiếp câu đề bài.", en: "Use a small ritual to reset after laughing: the whole class takes three deep breaths before you read the next question.")
#caunoi("Cười một chút cho đã rồi mình học tiếp.", en: "Let us laugh as much as we need, and then we go on with the lesson.")

#sec("Một bạn quay xuống chọc bạn phía sau", en: "A student turns round to poke the one behind")
#tinhhuong("1.3", "Một bạn quay xuống chọc bạn phía sau", "Bạn Nam ngồi bàn trên cứ quay xuống chọc bút, nhéo áo bạn phía sau. Bạn bị chọc đã nhắc nhở nhiều lần mà bạn Nam vẫn cười và tiếp tục. Nhìn thì vui nhưng bạn phía sau bắt đầu bực.", en: "Nam, at the front desk, keeps turning round to poke the pen and tug the shirt of the student behind. The one behind has asked him to stop several times, but Nam laughs and carries on. It looks like fun, yet the student behind is starting to get annoyed.")
#chieu("Đổi vai năm phút", "Cuối tiết thầy gọi riêng Nam: tiết sau thầy cho em một nhiệm vụ đặc biệt, em đóng vai người bị chọc. Em ngồi ở bàn cuối, bạn bên cạnh sẽ làm chính xác điều em đã làm với bạn kia trong năm phút, rồi hai em kể cho thầy nghe cảm giác. Thầy dùng một bạn tình nguyện khác, không phải bạn từng bị chọc, để tránh làm bạn đó thêm ngại.", en: ("Five minutes in their shoes", "At the end of the lesson, call Nam aside: next lesson I am giving you a special mission. You play the one being poked. You sit at the back, and a volunteer beside you will do exactly what you did to the other student for five minutes, then you both tell me how it felt. Use a different volunteer, not the student who was actually poked, so that student is not put on the spot."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Nam, thầy không trách em. Thầy muốn em thử một việc: ngồi vào chỗ bạn bị chọc và kể thầy nghe cảm giác khi bị chọc như vậy liên tục.", en: "Nam, I am not blaming you. I want you to try something: sit in the place of the student you were poking and tell me how it feels to be poked like that, again and again.")
  #tro("Dạ... chắc là khó chịu thầy.", en: "Um... probably annoying, sir.")
  #thay("Khó chịu thế nào? Em tả thầy nghe.", en: "Annoying how? Describe it for me.")
]
#visao("Trò chọc bạn thường xuất phát từ chán và muốn tương tác chứ không từ ác ý. Cho em thử vai ngược giúp em tự thấy tác động, thay vì nghe thầy giảng về sự tôn trọng. Em tự rút ra điều cần sửa nên không phản kháng.", en: "Poking often comes from boredom and a wish for contact, not from malice. Reversing the roles lets the student see the effect for himself instead of hearing a lecture on respect. He draws the lesson himself and so does not resist.")
#ranhgioi("Không dàn dựng để em bị chọc quá mức hay bị chọc đau. Mỗi lần chọc chỉ nhẹ, đúng bằng điều em đã làm. Nếu thấy em chọc vì mâu thuẫn thật với bạn kia, chuyển sang hòa giải.", en: "Do not stage anything that pokes him too hard or hurts. Each poke stays light, exactly as strong as what he did. If you see he is poking because of a real conflict with the other student, switch to mediation.")
#bientau("Thay vì đổi vai, cho Nam viết ba dòng: bạn bị chọc có thể đang cảm thấy gì, và em sẽ làm khác thế nào. Rồi hai em bắt tay.", en: "Instead of the role swap, have Nam write three lines: what the student behind may be feeling, and what he will do differently. Then the two shake hands.")
#caunoi("Thầy muốn em thử ngồi vào chỗ của bạn năm phút rồi kể thầy nghe cảm giác.", en: "I would like you to sit in your classmate's place for five minutes and tell me how it feels.")

#sec("Một em cứ đứng lên đi lại giữa giờ", en: "A student keeps getting up and walking around")
#tinhhuong("1.4", "Một em cứ đứng lên đi lại giữa giờ", "Bạn Hải ngồi không yên, cứ vài phút lại đứng lên lấy cục tẩy, đi mượn bút, ra thùng rác. Thầy nhắc ngồi xuống thì em dạ, một lúc sau lại đứng. Không phải em cố tình phá, em chỉ không chịu được việc ngồi yên.", en: "Hai cannot sit still. Every few minutes he gets up to fetch an eraser, borrow a pen, go to the bin. When told to sit, he says yes, and a moment later he is up again. It is not deliberate mischief; he simply cannot bear to stay seated.")
#chieu("Chức vụ có đi lại", "Thầy giao cho Hải một chức vụ chính thức: Trưởng ban phát và thu. Mỗi tiết em có hai lần được đứng lên đúng việc: phát tờ bài tập đầu giờ và thu bài cuối giờ. Ngoài hai lần đó, em ngồi tại chỗ. Thầy ghi vào sổ cái chức vụ của em kèm tên lớp phó để em thấy mình được tin.", en: ("A post with permission to move", "Give Hai an official job: Head of Handing Out and Collecting. Twice each lesson he is entitled to stand up for a proper reason: handing out the worksheet at the start and collecting work at the end. Outside those two times, he stays in his seat. Write the post in your record book next to the class monitor's name, so he sees he is trusted."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy để ý em cần cử động nhiều hơn người khác. Thầy cho em một chức vụ: phát và thu bài. Hai lần mỗi tiết em được đứng thoải mái. Còn lại em giữ chỗ cho thầy, được không?", en: "I have noticed you need to move more than most people. I am giving you a post: handing out and collecting work. Twice a lesson you may stand freely. The rest of the time you hold your seat for me, all right?")
  #tro("Dạ được thầy! Em làm được.", en: "Yes, sir! I can do that.")
]
#visao("Một số em cần vận động để tập trung, không phải vì hư. Biến nhu cầu đó thành một vai trò chính thức giữ được em trong lớp và đổi cách nhìn của cả lớp về em. Em đi lại có lý do, có giờ, có sự tin tưởng.", en: "Some students need movement in order to concentrate; it is not misbehaviour. Turning that need into an official role keeps him in the class and changes how the class sees him. He moves for a reason, at set times, with trust.")
#ranhgioi("Nếu em liên tục không ngồi yên ở mọi môn, mọi buổi, kéo dài nhiều tháng, hãy gợi ý ba mẹ trao đổi với chuyên viên về khả năng tăng động giảm chú ý. Không phạt thêm cho hành vi đó.", en: "If he cannot sit still in every subject, every day, for months, suggest his parents talk to a specialist about ADHD. Do not add punishment for that behaviour.")
#bientau("Cho em một món nhỏ cầm trong tay khi ngồi, như cục bóp tay hoặc dây chun, miễn không gây ồn.", en: "Give him a small object to hold while seated, like a squeeze ball or a rubber band, as long as it makes no noise.")
#caunoi("Thầy giao em một nhiệm vụ cần đi lại. Em giúp thầy được không?", en: "I am giving you a job that needs walking around. Can you help me with it?")

#sec("Một em nói leo, chen vào mọi câu", en: "A student blurts out answers and cuts in")
#tinhhuong("1.5", "Một em nói leo, chen vào mọi câu", "Bạn Linh lúc nào cũng nói trước khi thầy hỏi xong, cắt lời bạn khác, đôi khi trả lời cả câu hỏi thầy dành cho bạn kia. Em hăng hái thật sự, nhưng các bạn đã bắt đầu ngại giơ tay.", en: "Linh always speaks before you have finished the question, interrupts others, and sometimes answers a question you put to a different student. She is truly eager, but classmates are beginning to hesitate to raise their hands.")
#chieu("Ba cây gậy lời", "Thầy phát cho Linh ba cây que nhỏ đầu tiết. Mỗi lần em nói không giơ tay, thầy lặng lẽ lấy lại một cây. Còn que cuối tiết thì em được một điểm cộng nhỏ cho sự hăng hái. Hết que thì em được thầy mời im lặng mười phút và ghi lại ý định nói của mình ra vở để lát thầy gọi. Em vừa được nói, vừa tập kiên nhẫn.", en: ("Three sticks of speech", "At the start of the lesson, give Linh three small sticks. Each time she speaks without raising her hand, quietly take one back. A stick left at the end earns a small plus for enthusiasm. If all three are gone, invite her to stay silent for ten minutes and write down what she meant to say, and you will call on her later. She is allowed to speak and she practises patience."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy rất quý sự hăng hái của em. Em giúp thầy để các bạn khác cũng có cơ hội nói. Em có ba cây que, mỗi lần nói leo là thầy lấy lại một cây, được không?", en: "I really value your enthusiasm. Help me give the others a chance to speak too. You have three sticks; each time you blurt, I take one back. All right?")
  #tro("Được ạ. Chắc em sẽ cố gắng giữ que.", en: "Yes. I will try to keep my sticks.")
]
#visao("Nói leo là dấu hiệu của sự nhiệt tình, nên cần uốn nắn chứ không dập. Thứ có tác dụng là hệ thống nhìn thấy được, có thể tự theo dõi, và khen nhiều hơn phạt. Em đo được tiến bộ của mình bằng số que còn lại.", en: "Blurting is a sign of enthusiasm, so it should be shaped, not crushed. What works is a visible system she can track herself, with more praise than penalty. She measures her own progress by the sticks she keeps.")
#ranhgioi("Không khen em bằng cách mỉa mai độ hăng. Không cho cả lớp biết số que của em. Đây là thỏa thuận riêng giữa thầy và em.", en: "Do not mock her eagerness. Do not tell the class how many sticks she has. This is a private agreement between you and her.")
#bientau("Cho em quyền gọi bạn khác trả lời trước một lần mỗi tiết, để em học nhường lượt như một kỹ năng, không phải hình phạt.", en: "Give her the right to call on another student first, once a lesson, so that yielding the turn is a skill she is practising, not a punishment.")
#caunoi("Thầy cần em giữ sự hăng hái đó, và để các bạn cũng được nói. Mình thử với ba cây que nhé.", en: "I need you to keep that enthusiasm, and let others speak too. Shall we try it with three sticks?")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 1: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Chiêu phạt hay có bốn điểm chung: ngắn, riêng tư, gắn với đúng lỗi, và kết thúc bằng một việc có ích hoặc một nụ cười.", "Hỏi trước khi phạt: em này đang thiếu gì, mệt gì, muốn gì? Hành vi chỉ là phần nổi.", "Không phạt tập thể cho lỗi của một người. Học sinh tha thứ cho nghiêm khắc nhưng không tha thứ cho bất công.",), en: ("Good punishments share four traits: short, private, tied to the exact fault, and ending in something useful or a smile.", "Ask before you punish: what is this student lacking, tired of, wanting? The behaviour is only the tip.", "Never punish a group for one person's fault. Students forgive strictness but not unfairness.",))
