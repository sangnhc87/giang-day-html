#import "../template.typ": *

#chapter-open(13, "Những lúc không phạt: khi em đang có chuyện", 13, "Có những lúc câu trả lời thông minh nhất của thầy cô là: hôm nay thầy không phạt, thầy hỏi thăm.", "Sau mười hai chương chiêu phạt, chương này nói điều ngược lại. Hành vi sai có khi không đáng bị phạt, mà đáng được hỏi han. Em khóc, em bất thường, em sai vì nhà có chuyện, em tự nhận lỗi, đều là những lúc phạt sẽ làm hỏng nhiều hơn xây. Hơn nữa, có những lúc chính thầy cô là người lỡ nặng lời. Chương này dạy phân biệt khi nào dùng chiêu phạt, khi nào dùng chiêu không phạt.", ("Em đang khóc, đang rất không ổn", "Em tự nhận lỗi trước khi thầy hỏi", "Em liên tục mắc lỗi vì nhà có chuyện", "Em hư để gây chú ý", "Thầy lỡ nặng lời với em",), en: ("When not to punish: when the student is in trouble", "Sometimes the wisest answer a teacher can give is: today I will not punish, I will ask how you are.", "After twelve chapters of punishing moves, this chapter says the opposite. Wrong behaviour is sometimes not worth punishing but worth asking about. A student who is crying, behaving unusually, erring because of trouble at home, or owning up by themselves: these are times when punishment damages more than it builds. Moreover, there are times when the teacher is the one who has spoken too harshly. This chapter teaches when to use a punishing move and when to use a no-punishment move.", ("A student is crying and not coping", "A student owns up before you ask", "A student keeps erring because of trouble at home", "A student misbehaves to get attention", "The teacher said something too harsh",)))

#sec("Em đang khóc, đang rất không ổn", en: "A student is crying and not coping")
#tinhhuong("13.1", "Em đang khóc, đang rất không ổn", "Thầy nhắc Phương mấy lần vì không làm bài, em ngồi im. Thầy tiến lại thì thấy mắt em đỏ và nước mắt rơi xuống tập vở. Em không nói gì. Cả lớp bắt đầu nhìn.", en: "You have reminded Phuong several times for not doing her work; she sits silent. When you approach, her eyes are red and tears are falling on her notebook. She says nothing. The class begins to look.")
#chieu("Phiếu miễn phạt", "Thầy giữ một chồng phiếu miễn phạt, mỗi học sinh có hai phiếu mỗi học kỳ. Thầy đặt nhẹ một tấm lên bàn em và nói thật khẽ: hôm nay em dùng phiếu này, thầy không nhắc chuyện bài nữa. Em ra ngoài rửa mặt nếu muốn. Cuối giờ thầy hỏi thăm riêng. Phiếu này không cần giải thích, không cần xin. Em biết rằng khi hôm nay không ổn thì có một lối thoát.", en: ("The exemption slip", "Keep a stack of exemption slips; each student has two per term. Lay one gently on her desk and say very softly: today you use this slip; I will not mention the work again. She may step out to wash her face if she likes. At the end of the lesson you ask privately how she is. The slip needs no explanation and no asking. She knows that when today is not okay there is a way out."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Khẽ.) Phương, hôm nay em dùng phiếu miễn phạt này nhé. Thầy không nhắc bài nữa. Em ra rửa mặt nếu muốn, thầy chờ.", en: "(Softly.) Phuong, today you use this exemption slip. I will not mention the work any more. Go and wash your face if you wish, I will wait.")
  #tro("(Gật đầu, nước mắt rơi.) Dạ...", en: "(Nods, tears falling.) Yes...")
  #thay("Cuối giờ nếu em muốn nói, thầy ở đó. Không muốn cũng không sao.", en: "At the end of the lesson, if you want to talk, I am there. If not, that is fine too.")
]
#visao("Phạt một em đang khóc là dùng đòn trên người đã ngã. Phiếu miễn phạt cho em một quyền hợp pháp để không ổn mà không mất mặt. Em nhớ sự tử tế này lâu hơn mọi bài học trong tiết đó.", en: "Punishing a student who is crying is striking one who has fallen. The exemption slip gives her a legitimate right to be not okay without losing face. She will remember this kindness far longer than anything in that lesson.")
#ranhgioi("Phiếu không phải để lạm dụng, nhưng nếu em dùng sạch phiếu sớm, đó là dấu hiệu em cần được quan tâm nhiều hơn. Không hỏi dồn nguyên nhân khi em đang khóc. Nếu có dấu hiệu em nguy cơ tự hại, báo gia đình và nhà trường ngay.", en: "The slip is not to be abused, but if she uses up her slips early, that is a sign she needs more attention. Do not press for the cause while she is crying. If there are signs of risk of self-harm, tell family and school immediately.")
#bientau("Đặt trên bàn thầy một hộp khăn giấy mà ai cần thì lấy, không cần hỏi.", en: "Keep a box of tissues on your desk that anyone may take from without asking.")
#caunoi("Hôm nay em dùng phiếu miễn phạt nhé. Thầy không nhắc bài, em cần gì thầy ở đây.", en: "Today you use the exemption slip. I will not mention the work, and I am here if you need me.")

#sec("Em tự nhận lỗi trước khi thầy hỏi", en: "A student owns up before you ask")
#tinhhuong("13.2", "Em tự nhận lỗi trước khi thầy hỏi", "Sau giờ ra chơi, Tấn bước lên bàn thầy: thầy ơi, em làm vỡ cái bình hoa ở cuối lớp. Em đứng đó, tay run. Thầy biết em dũng cảm lắm mới nói ra.", en: "After break, Tan steps up to your desk: sir, I broke the vase at the back of the room. He stands there, hands trembling. You know it took great courage to say it.")
#chieu("Thưởng người dám nói", "Thầy dừng việc đang làm, nhìn em, nói chậm: cảm ơn em đã nói. Để thầy nói thật, thầy vui vì em trung thực nhiều hơn là tiếc cái bình. Thầy hỏi: em có bị đứt tay không? Cái bình thầy xử lý, em chỉ cần cùng thầy dọn mảnh vỡ. Thầy không phạt thêm. Thầy giữ một cái nháy mắt riêng: lần sau em cứ nói thật như vậy.", en: ("Rewarding the one who dares to speak", "Stop what you are doing, look at him and say slowly: thank you for telling me. To be honest, I am more glad of your honesty than sorry for the vase. Ask: did you cut yourself? You deal with the vase; he only helps you sweep up the pieces. No extra punishment. Keep a private wink: next time just tell the truth like that."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Cảm ơn em đã nói. Thầy vui vì em trung thực nhiều hơn tiếc cái bình. Em có bị đứt tay không? Mình cùng dọn nhé, không phạt gì thêm.", en: "Thank you for telling me. I am more glad of your honesty than sorry for the vase. Did you cut your hand? Let us sweep up together, no further punishment.")
  #tro("Dạ... em tưởng thầy sẽ giận.", en: "Um... I thought you would be angry.")
  #thay("Thầy không giận. Người dám nhận lỗi là người thầy tin.", en: "I am not angry. One who dares own up is one I trust.")
]
#visao("Phạt người nhận lỗi là dạy em lần sau giấu. Khen sự trung thực và bỏ hình phạt dạy em rằng nói thật không đau. Một em được trọng khi nhận lỗi sẽ nhận lỗi cả đời.", en: "Punishing the one who owns up teaches him to hide next time. Praising honesty and dropping the penalty teaches that telling the truth does not hurt. A student respected for owning up will own up for life.")
#ranhgioi("Phải nhất quán, không phạt em này mà phạt em khác cho lỗi tương tự khi họ không tự nhận. Nếu lỗi lớn, vẫn xử lý theo quy định nhưng giảm nhẹ theo thái độ. Không khen quá nhiều làm em thấy cần làm sai để được khen.", en: "Be consistent: do not punish this student while not punishing another for a similar fault when they did not own up. If the fault is large, still follow regulations but reduce the penalty according to attitude. Do not praise so much that he feels he must err to be praised.")
#bientau("Mở sổ ghi những lần em nhận lỗi trung thực, cuối năm trao thiệp cảm ơn.", en: "Keep a record of honest admissions and at the end of the year hand out thank-you cards.")
#caunoi("Cảm ơn em đã nói, thầy vui vì sự trung thực nhiều hơn tiếc cái bình.", en: "Thank you for telling me; I am more glad of your honesty than sorry for the vase.")

#sec("Em liên tục mắc lỗi vì nhà có chuyện", en: "A student keeps erring because of trouble at home")
#tinhhuong("13.3", "Em liên tục mắc lỗi vì nhà có chuyện", "Thầy để ý Bình dạo này trễ bài, hay ngủ gật, cáu gắt với bạn. Một em khác kể nhỏ rằng ba mẹ em đang chuyển ra ở riêng. Em chưa nói gì với thầy.", en: "You notice Binh lately is behind with work, often dozes, snaps at friends. Another student quietly says his parents are moving out of the family home. He has not said anything to you.")
#chieu("Sổ ba dòng", "Thầy không hỏi thẳng chuyện nhà. Thầy đặt trước mặt em một cuốn sổ nhỏ và nói: mỗi sáng em có thể viết ba dòng: hôm nay em thế nào, điều gì khó, điều gì thầy có thể giúp. Chỉ có thầy đọc. Thầy trả lời bằng một dòng, không bình luận nhiều. Những lỗi nhỏ trong thời gian này thầy lặng lẽ không tính và theo dõi. Khi em sẵn sàng, em tự mở lời.", en: ("The three-line notebook", "Do not ask directly about home. Put a small notebook in front of him and say: each morning you may write three lines: how you are today, what is hard, what I can help with. Only I read it. I reply with one line, not much comment. Small faults in this period you quietly do not count, and keep watching. When he is ready, he opens up himself."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Bình, thầy có một cuốn sổ nhỏ cho em. Mỗi sáng em có thể viết ba dòng: hôm nay em thế nào, điều gì khó, điều gì thầy giúp được. Chỉ thầy đọc.", en: "Binh, I have a small notebook for you. Each morning you can write three lines: how you are today, what is hard, what I can help with. Only I read it.")
  #tro("Dạ... em cầm được ạ.", en: "Um... I can take it, sir.")
  #thay("Em viết gì cũng được. Thầy chỉ đọc và trả lời một dòng thôi.", en: "Write whatever you like. I just read it and answer in one line.")
]
#visao("Em đang gánh chuyện lớn nên các lỗi nhỏ chỉ là dấu hiệu. Phạt thêm là thêm gánh nặng. Cuốn sổ cho em một cách nói khi miệng chưa nói được, và thầy giữ vai trò người nghe an toàn.", en: "He is carrying something big, so small faults are only signs. More punishment is more weight. The notebook gives him a way to speak when the mouth cannot yet, and you play the role of a safe listener.")
#ranhgioi("Không ép em kể chuyện gia đình. Không bàn tán với đồng nghiệp ngoài những người cần biết như nhà trường và bộ phận tâm lý. Nếu có dấu hiệu em gặp nguy hiểm hay bạo hành, báo ngay cho những người có trách nhiệm.", en: "Do not press him to talk about home. Do not gossip with colleagues beyond those who need to know, such as the school and psychological support. If there are signs he is in danger or abused, tell those responsible at once.")
#bientau("Khi em chưa muốn viết, đổi thành ba biểu tượng mặt cười, mặt buồn, mặt bình thường.", en: "When he does not want to write, change it to three symbols: a smiling face, a sad face, a flat face.")
#caunoi("Em viết cho thầy ba dòng mỗi sáng nhé. Chỉ thầy đọc, thầy ở đây.", en: "Write me three lines each morning. Only I read them, and I am here.")

#sec("Em hư để gây chú ý", en: "A student misbehaves to get attention")
#tinhhuong("13.4", "Em hư để gây chú ý", "Cường luôn là em nghịch nhất lớp: nói lớn, trêu bạn, chọc thầy. Phạt đủ cách đều không giảm. Có vẻ em càng bị phạt càng nghịch. Thầy chợt nghĩ em đang thiếu điều gì.", en: "Cuong is always the naughtiest in the class: loud, teasing friends, provoking you. Every kind of punishment has failed to reduce it; the more he is punished, the naughtier he gets. You suddenly wonder what he is lacking.")
#chieu("Bắt gặp em làm tốt", "Thầy đảo ngược chiến lược. Thầy đặt một mục tiêu bí mật: mỗi ngày bắt gặp Cường làm một điều tốt và nói riêng cho em biết. Có thể là em đưa bút cho bạn, em đến đúng giờ, em trả lời đúng. Thầy chỉ nói riêng, một câu ngắn: thầy thấy em vừa làm việc tốt. Sau vài tuần, em được chú ý qua việc tốt nên giảm hẳn việc nghịch để gây chú ý.", en: ("Catch him doing good", "Reverse the strategy. Set a secret goal: each day catch Cuong doing one good thing and tell him privately. It might be handing a pen to a friend, arriving on time, answering correctly. Say it privately, one short line: I saw you do something good. After a few weeks, he gets attention through good deeds, and acting up for attention fades."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Riêng, sau tiết.) Cường, hôm nay thầy thấy em đưa bút cho bạn mà không ai bảo. Thầy thấy em tốt bụng.", en: "(Privately, after the lesson.) Cuong, today I saw you hand your pen to a friend without being asked. I think you are kind.")
  #tro("Dạ... thầy thấy thật hả thầy?", en: "Um... you really saw that, sir?")
  #thay("Thấy thật. Thầy thấy nhiều lắm, chỉ là chưa nói thôi.", en: "I really did. I see a lot of things; I just have not said so.")
]
#visao("Em nghịch để được chú ý, và nếu việc xấu là cách duy nhất được chú ý, em sẽ làm tiếp. Chuyển sự chú ý sang việc tốt cho em con đường tốt hơn để đạt cùng mục tiêu. Sự khen riêng tư cũng làm em tin vào lời khen.", en: "He misbehaves for attention, and if bad behaviour is the only way to get it, he will keep doing it. Redirecting attention to good deeds gives him a better road to the same goal. Private praise is also more believable.")
#ranhgioi("Khen phải thật, không bịa. Không dùng khen như giải thưởng khiến em diễn. Vẫn giữ giới hạn rõ cho hành vi sai, không bỏ phạt hoàn toàn.", en: "Praise must be real, not invented. Do not use praise as a prize that makes him perform. Keep clear limits on wrong behaviour; do not drop punishment altogether.")
#bientau("Mời em làm trợ lý cho một việc nhỏ của thầy, để việc tốt có chỗ thể hiện.", en: "Invite him to be your assistant for some small task, so good deeds have an outlet.")
#caunoi("Hôm nay thầy thấy em làm một việc tốt, thầy muốn em biết là thầy thấy.", en: "Today I saw you do something good, and I want you to know I saw it.")

#sec("Thầy lỡ nặng lời với em", en: "The teacher said something too harsh")
#tinhhuong("13.5", "Thầy lỡ nặng lời với em", "Giữa tiết, vì quá mệt và nóng, thầy quát Dũng: em có biết điều không hả! Cả lớp im. Dũng cúi đầu, mắt đỏ. Thầy nhận ra mình vừa nói quá. Sau tiết, thầy ngồi một mình nghĩ lại.", en: "In the middle of the lesson, because he is tired and hot, you snap at Dung: do you have any manners? The class falls silent. Dung bows his head, eyes red. You realise you went too far. After the lesson, you sit alone thinking it over.")
#chieu("Thầy tự nhận phạt", "Hôm sau, đầu giờ, thầy xin phép cả lớp nói một điều. Thầy nói thẳng: hôm qua thầy nặng lời với một bạn, thầy sai. Thầy xin lỗi bạn ấy trước lớp, hoặc riêng nếu bạn thích. Thầy tự phạt mình: thầy làm giúp bạn trực nhật một hôm hay kể một chuyện thầy từng sai. Cả lớp thấy thầy cũng sai, thầy dám nhận, và uy tín thầy tăng chứ không giảm.", en: ("The teacher takes his own punishment", "Next morning at the start of class, ask the class's permission to say something. Say directly: yesterday I spoke harshly to a student, and I was wrong. I apologise to him before the class, or in private if he prefers. Punish yourself: do the cleaning duty for him for a day or tell a story of a time you were wrong. The class sees that you too err, that you dare own it, and your standing rises, not falls."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Dũng, hôm qua thầy nặng lời với em. Thầy sai. Thầy xin lỗi em. Thầy không biện hộ, chỉ muốn em biết thầy không nghĩ như câu thầy đã nói.", en: "Dung, yesterday I spoke harshly to you. I was wrong. I am sorry. I will not excuse myself; I only want you to know I do not think what I said.")
  #tro("(Im một lúc.) Dạ... em cảm ơn thầy.", en: "(Silent a moment.) Um... thank you, sir.")
  #thay("Thầy nợ em một điều. Em nói thầy muốn thầy làm gì để bù, thầy sẽ làm.", en: "I owe you something. Tell me what I can do to make up for it, and I will do it.")
]
#visao("Học sinh nhớ cách thầy cô nhận lỗi lâu hơn nhớ lỗi của thầy cô. Một lời xin lỗi thật dạy cả lớp về trách nhiệm, và đem lại cho Dũng sự công bằng. Thầy cô cũng cần quyền được sai và sửa.", en: "Students remember how a teacher owns a fault longer than they remember the fault. A genuine apology teaches the whole class about responsibility and gives Dung fairness. Teachers too need the right to err and mend.")
#ranhgioi("Không xin lỗi cho xong rồi lặp lại. Không đổ lỗi gián tiếp như thầy xin lỗi nhưng em cũng có phần. Không để lời xin lỗi thành gánh nặng bắt em phải tha thứ ngay.", en: "Do not apologise just to be done and then repeat it. Do not shift blame indirectly, such as I apologise but you had a part too. Do not make the apology a burden requiring him to forgive at once.")
#bientau("Giữ thói quen tự đánh giá cuối tuần: tuần này thầy có lúc nào nặng lời không, và sửa thế nào.", en: "Keep a weekly habit of self-review: this week, did I speak harshly at any moment, and how did I mend it.")
#caunoi("Hôm qua thầy nặng lời, thầy sai. Thầy xin lỗi em.", en: "Yesterday I spoke harshly. I was wrong. I am sorry.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 13: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Trước khi chọn chiêu phạt, tự hỏi ba câu: hôm nay em có ổn không, lỗi này có thật sự cần phạt không, và nếu phạt thì em học được gì.", "Phiếu miễn phạt, sổ ba dòng, câu bắt gặp em làm tốt là những chiêu không phạt mạnh hơn hầu hết các chiêu phạt.", "Thầy cô xin lỗi em đúng cách là bài học đạo đức lớn nhất trong năm. Đừng bỏ cơ hội đó.",), en: ("Before choosing a punishing move, ask three questions: is the student okay today, does this fault really need punishment, and if I punish, what will they learn?", "The exemption slip, the three-line notebook, and catching a student doing good are no-punishment moves that are stronger than most punishing ones.", "A teacher who apologises to a student properly gives the biggest lesson in ethics of the year. Do not miss the chance.",))
