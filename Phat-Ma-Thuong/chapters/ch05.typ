#import "../template.typ": *

#chapter-open(5, "Điện thoại, game và màn hình trong lớp", 5, "Cấm thì các em giấu. Hiểu thì các em tự cất.", "Điện thoại là cuộc đấu mà thầy cô không thể thắng bằng cách cấm tuyệt đối, vì nó nằm trong túi của chính các em và trong đời sống của chính chúng ta. Chương này gợi những chiêu giữ điện thoại ở đúng chỗ trong giờ học mà vẫn giữ quan hệ, kèm ranh giới rõ cho những chuyện nặng hơn như quay chụp lén.", ("Em lén dùng điện thoại dưới bàn", "Cả nhóm cuối lớp chơi game", "Em chụp hay quay lén thầy và bạn", "Em cứ mười phút lại sờ điện thoại", "Em dùng điện thoại tra đáp án trong giờ kiểm tra",), en: ("Phones, games and screens in class", "Ban phones and students hide them. Understand them and students put them away themselves.", "The phone is a contest teachers cannot win by absolute prohibition, because it sits in the students' pockets and in our own lives. This chapter offers ways to keep the phone in its place during lessons while keeping the relationship, with clear limits for heavier matters such as secret filming.", ("A student uses a phone under the desk", "A group at the back plays games", "A student secretly films or photographs the teacher or classmates", "A student checks the phone every ten minutes", "A student uses a phone to look up answers during a test",)))

#sec("Em lén dùng điện thoại dưới bàn", en: "A student uses a phone under the desk")
#tinhhuong("5.1", "Em lén dùng điện thoại dưới bàn", "Bạn Quân cúi đầu xuống ngăn bàn gần như cả tiết, ngón tay lướt liên tục. Thầy nhắc hai lần, em cất đi rồi vài phút sau lại lấy ra. Các bạn xung quanh đã thấy hết.", en: "Quan bends over his desk drawer for most of the lesson, thumb scrolling constantly. You have reminded him twice; he puts it away, and a few minutes later takes it out again. Those around him have seen it all.")
#chieu("Điện thoại đi nghỉ", "Thầy mang theo một chiếc hộp lót khăn gọi là khách sạn điện thoại. Thầy nói: điện thoại của em có vẻ mệt rồi, cho nó nghỉ trong khách sạn đến hết tiết nhé. Em tự đặt máy vào hộp, thầy phát cho em một cái thẻ phòng. Cuối tiết em đổi thẻ lấy máy. Lần thứ ba trong một tuần thì khách sạn giữ máy đến cuối ngày và em tự nhắn mẹ rằng mình cần lên lấy máy.", en: ("The phone goes to rest", "Bring a box lined with a cloth, called the phone hotel. Say: your phone looks tired, let it rest in the hotel until the end of the lesson. He puts the phone in the box himself and you give him a room card. At the end of the lesson he swaps the card for his phone. On the third time in a week, the hotel keeps the phone until the end of the day and he himself messages his mother that he needs to collect it."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Quân, điện thoại của em có vẻ cần nghỉ ngơi. Em cho nó vào khách sạn của thầy đến hết tiết nhé, thầy cho em thẻ phòng. Cuối tiết em đổi lại.", en: "Quan, your phone looks as if it needs a rest. Put it in my hotel until the end of the lesson, I give you a room card. At the end you swap it back.")
  #tro("Dạ... em cho vào ạ.", en: "Um... I will put it in.")
  #thay("Cảm ơn em. Nó nghỉ ngơi xong sẽ khỏe lại.", en: "Thank you. It will feel refreshed after resting.")
]
#visao("Em tự đặt điện thoại vào hộp nên không có cảm giác bị tịch thu. Chút hài hước làm giảm căng thẳng, và cái thẻ phòng cho em thấy việc đó là có quy trình rõ ràng, công bằng. Lần thứ ba em tự nhắn mẹ để tự chịu trách nhiệm.", en: "He places the phone in the box himself, so it does not feel like confiscation. A touch of humour lowers the tension, and the room card shows it is a fair, clear process. By messaging his mother on the third time he takes responsibility himself.")
#ranhgioi("Không tự ý xem nội dung điện thoại. Không giữ qua đêm. Không để máy rơi hay hỏng khi giữ, nên đặt trong hộp có lót.", en: "Do not look at the phone's content. Do not keep it overnight. Do not let the phone fall or break; keep it in a lined box.")
#bientau("Cho cả lớp một ngày khách sạn đầu tuần, ai muốn gửi máy tự nguyện thì nhận một dấu mộc.", en: "Give the whole class a hotel day at the start of the week; anyone who deposits voluntarily receives a stamp.")
#caunoi("Điện thoại của em cần nghỉ một chút. Mình gửi vào khách sạn của thầy nhé.", en: "Your phone needs a short rest. Let us put it in my hotel.")

#sec("Cả nhóm cuối lớp chơi game", en: "A group at the back plays games")
#tinhhuong("5.2", "Cả nhóm cuối lớp chơi game", "Cuối lớp có bốn em ngồi sát nhau, vừa che vừa nghiêng đầu, rõ ràng đang chơi game cùng nhau. Chúng ném mắt về phía bảng rồi lại cúi xuống. Thầy không muốn gọi tên cả nhóm trước lớp.", en: "Four students at the back sit close, heads tilted and hands covering, clearly playing a game together. They glance toward the board and then bend down again. You do not want to name the whole group before the class.")
#chieu("Thi game bằng lời", "Giờ ra chơi, thầy mời cả nhóm ghé. Thầy nói: thầy không biết chơi, các em dạy thầy nhé. Mỗi em dạy thầy một kỹ năng trong game trong hai phút. Sau đó thầy nhờ cả nhóm chuẩn bị bài thuyết trình hai phút cho lớp vào cuối tuần về một điều có thể học được từ game: phối hợp nhóm, chiến lược, quản lý tài nguyên. Các em bị cuốn vào việc chuẩn bị nên trong giờ học không còn chơi.", en: ("A game quiz in words", "At break, invite the group over. Say: I do not know how to play, so teach me. Each student teaches you one skill from the game in two minutes. Then ask the group to prepare a two-minute talk for the class at the end of the week on something that can be learned from games: teamwork, strategy, managing resources. Caught up in the preparation, they no longer play during lessons."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Các em chơi game cùng nhau thật hay. Thầy muốn học. Ra chơi các em dạy thầy hai phút nhé, rồi cuối tuần các em thuyết trình cho lớp một điều game dạy các em.", en: "You play together really well. I want to learn. At break teach me for two minutes each, and by the weekend give the class a talk on one thing games teach you.")
  #tro("Thầy cho tụi em thuyết trình về game thật hả thầy?", en: "You will really let us give a talk about games, sir?")
  #thay("Thật. Nhưng phải có điều học được và nói trong hai phút. Thầy chờ.", en: "Really. But it must contain something learned, and last two minutes. I am waiting.")
]
#visao("Cấm game thì các em chơi lén. Biến game thành đề tài học giúp các em thấy sự quan tâm của mình có giá trị và đồng thời tự thấy mình cần quản lý việc chơi trong giờ học. Thầy còn được bước vào thế giới của các em.", en: "Ban games and students play secretly. Making games a topic of study shows them their interest has value and at the same time makes them see they must manage their playing in lessons. You also step into their world.")
#ranhgioi("Không chọn game bạo lực nặng làm đề tài. Không để phần thuyết trình trở thành quảng cáo game. Chỉ làm một lần mỗi nhóm, không biến thành thưởng cho việc chơi.", en: "Do not choose a heavily violent game as the topic. Do not let the talk turn into an advertisement. Do it once per group only, not as a reward for playing.")
#bientau("Cho cả nhóm đóng vai huấn luyện viên dạy một bạn khác chơi game trong năm phút ra chơi.", en: "Have the group act as coaches teaching a classmate to play within five minutes of break.")
#caunoi("Thầy muốn học game từ các em. Ra chơi các em dạy thầy hai phút nhé.", en: "I want to learn games from you. Teach me for two minutes at break.")

#sec("Em chụp hay quay lén thầy và bạn", en: "A student secretly films or photographs the teacher or classmates")
#tinhhuong("5.3", "Em chụp hay quay lén thầy và bạn", "Thầy phát hiện Tuấn giơ điện thoại quay clip thầy đang giảng, hoặc chụp lén một bạn đang ngủ gật. Em cười, nói chỉ đùa thôi. Nhưng clip có thể bị đăng lên mạng.", en: "You notice Tuan holding up his phone, filming you teaching, or secretly photographing a classmate dozing off. He laughs and says it is just a joke. But the clip could be posted online.")
#chieu("Xóa cùng nhau", "Thầy yêu cầu em đưa máy, và cùng em xóa clip ngay trước mặt, kiểm tra cả thùng rác. Thầy nói thẳng không đùa: thầy hiểu em chỉ nghĩ là vui, nhưng clip bị quay lén có thể làm người trong đó tổn thương và khó rút lại khi đã đăng. Em viết một trang ngắn về người bị quay có thể cảm thấy thế nào. Nếu clip là của bạn thì em trực tiếp xin lỗi bạn đó, không ép bạn tha thứ.", en: ("Delete it together", "Ask him to hand over the phone, and delete the clip together right in front of you, checking the trash too. Say plainly, with no joking: I understand you only thought it was fun, but a secretly filmed clip can hurt the person in it and is hard to pull back once posted. He writes a short page on how the filmed person might feel. If the clip was of a classmate, he apologises to that classmate in person, without pressing the classmate to forgive."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Tuấn, thầy hiểu em chỉ đùa. Nhưng clip đó có thể làm người trong đó tổn thương và rất khó rút lại. Mình xóa cùng nhau ngay bây giờ, em đưa thầy xem thùng rác nhé.", en: "Tuan, I understand you meant it as a joke. But that clip could hurt the person in it, and it is very hard to take back. Let us delete it together right now, show me the trash as well.")
  #tro("Dạ... em xin lỗi thầy.", en: "Um... I am sorry, sir.")
  #thay("Em viết cho thầy một trang ngắn về cảm giác của người bị quay, và nếu là bạn nào đó thì em nói với bạn ấy riêng nhé.", en: "Write me one short page about how the person in the clip might feel, and if it is a classmate, tell them privately.")
]
#visao("Quay lén là chuyện nghiêm trọng hơn nhiều so với tưởng tượng của em. Xóa ngay giúp loại bỏ nguy cơ, trang viết giúp em đặt mình vào vị trí người kia. Thầy giữ giọng nghiêm nhưng không làm em mất mặt, nên em nghe được.", en: "Secret filming is much more serious than he imagines. Deleting at once removes the risk, and the page helps him put himself in the other's place. You keep a serious tone without shaming him, so he can listen.")
#ranhgioi("Nếu clip đã đăng tải hay đã lan truyền, phải báo ngay nhà trường và gia đình, không tự xử lý một mình. Không công khai tên em. Không ép bạn bị quay phải tha thứ.", en: "If the clip has already been posted or has spread, report to the school and family at once, do not handle it alone. Do not publicise his name. Do not press the filmed classmate to forgive.")
#bientau("Mời em và cả lớp cùng làm một tờ nội quy ngắn về quay chụp trong lớp do chính các em soạn.", en: "Invite him and the whole class to draft together a short set of rules on filming in class, written by the students themselves.")
#caunoi("Mình xóa cùng nhau bây giờ. Rồi em viết thầy một trang về cảm giác của người trong clip nhé.", en: "We delete it together now. Then write me a page on how the person in the clip might feel.")

#sec("Em cứ mười phút lại sờ điện thoại", en: "A student checks the phone every ten minutes")
#tinhhuong("5.4", "Em cứ mười phút lại sờ điện thoại", "Bạn Vy không chơi game, không nhắn tin nhiều, nhưng mỗi mười phút lại cầm điện thoại lên xem một cái rồi cất. Em nói không hiểu sao mình làm thế. Cả buổi học bị đứt quãng.", en: "Vy does not play games or text much, but every ten minutes she picks up her phone, glances, and puts it away. She says she does not know why she does it. The whole lesson is broken up.")
#chieu("Bảng đếm lần chạm", "Thầy phát cho Vy một thẻ nhỏ có các ô vuông. Mỗi lần em chạm điện thoại trong tiết, em tự đánh một dấu vào ô, không ai kiểm tra. Cuối ngày em đếm và ghi số. Ba ngày sau thầy hỏi: số nào thấy nhiều nhất, và em nghĩ điều gì kéo tay em đi. Thầy cùng em thử đặt mục tiêu giảm dần, ví dụ bớt hai lần mỗi ngày.", en: ("The touch counter", "Give Vy a small card with squares. Each time she touches the phone during a lesson, she marks a square herself; nobody checks. At day's end she counts and writes the number. Three days later ask: which number was highest, and what do you think pulls your hand? Together set a goal of cutting down gradually, say two fewer a day."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Vy, thầy không bắt em bỏ điện thoại. Em thử đánh dấu mỗi lần chạm vào thẻ này trong ba ngày nhé, không cần ai kiểm tra. Rồi mình xem con số nói gì.", en: "Vy, I am not asking you to give up your phone. Try marking this card each time you touch it for three days, nobody will check. Then we see what the numbers say.")
  #tro("Dạ... em đếm được không thầy?", en: "Um... I can just count, sir?")
  #thay("Được. Em đếm thật, thầy chỉ muốn biết em có thấy số đó là nhiều hay ít.", en: "You can. Count honestly; I only want to know whether you find that number high or low.")
]
#visao("Thói quen cầm máy là phản xạ chứ không phải ý định. Đếm biến phản xạ thành ý thức, nên chỉ riêng việc đếm đã giảm số lần. Em tự đặt mục tiêu nên không thấy bị ép.", en: "Reaching for the phone is a reflex, not an intention. Counting turns the reflex into awareness, so counting alone lowers the number. She sets her own goal, so she does not feel forced.")
#ranhgioi("Không đòi xem thẻ đếm nếu em không muốn. Không cho là em nghiện điện thoại. Nếu số lần quá cao và ảnh hưởng đến học tập lẫn cảm xúc, trao đổi với gia đình về việc nhờ chuyên gia tư vấn.", en: "Do not demand to see the card if she does not want to. Do not label her addicted. If the number is very high and affects study and mood, talk to the family about seeing a counsellor.")
#bientau("Cùng làm với em một tuần, thầy cũng đếm lần chạm điện thoại của mình và chia sẻ.", en: "Do it with her for a week: you also count your phone touches and share.")
#caunoi("Em thử đếm số lần chạm điện thoại trong ba ngày, rồi mình cùng nhìn con số nhé.", en: "Try counting how many times you touch your phone over three days, then we will look at the number together.")

#sec("Em dùng điện thoại tra đáp án trong giờ kiểm tra", en: "A student uses a phone to look up answers during a test")
#tinhhuong("5.5", "Em dùng điện thoại tra đáp án trong giờ kiểm tra", "Giữa bài kiểm tra mười lăm phút, thầy thấy Lâm lén lấy điện thoại ra dưới bàn. Em cúi đầu rất thấp. Khi thầy đến gần, em cất đi, mặt đỏ bừng.", en: "In the middle of a fifteen-minute test, you see Lam sneak his phone out under the desk. He bends very low. When you approach, he puts it away, his face bright red.")
#chieu("Hai bài, một lời nói thật", "Thầy không công khai gì. Cuối tiết, thầy giữ riêng em lại. Thầy nói: bài của em thầy giữ. Ngày mai em làm lại một bài khác tương đương trong mười phút trước mặt thầy, điểm lần này thầy ghi nhận cả hai bài. Thầy hỏi em một câu: điều gì khiến em muốn tra đáp án, sợ điểm thấp hay chưa ôn kịp? Em nói thật thì thầy cùng em lập kế hoạch ôn.", en: ("Two papers and one honest word", "Say nothing publicly. At the end of the lesson, keep him back privately. Say: I am holding your paper. Tomorrow you redo an equivalent paper in ten minutes in front of me, and both marks are recorded. Ask one question: what made you want to look up the answers, fear of a low mark, or not having revised in time? If he is honest, help him plan revision."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Lâm, thầy thấy em đã tra điện thoại. Thầy không nói với cả lớp. Mai em làm lại một bài tương đương trước mặt thầy. Còn bây giờ thầy muốn hỏi: em sợ điểm thấp hay chưa ôn kịp?", en: "Lam, I saw you use your phone. I will not tell the class. Tomorrow redo an equivalent paper in front of me. Right now I want to ask: were you afraid of a low mark, or had you not had time to revise?")
  #tro("Dạ... em sợ ba mẹ la, thầy.", en: "Um... I was afraid my parents would shout at me, sir.")
  #thay("Cảm ơn em đã nói thật. Mình cùng tìm cách ôn cho đỡ áp lực nhé.", en: "Thank you for telling the truth. Let us find a way to revise with less pressure.")
]
#visao("Gian lận trong kiểm tra thường là nỗi sợ hơn là sự cố tình. Cho em làm lại có thầy và hỏi nguyên nhân thật giúp em thấy thầy giúp chứ không phạt. Giữ kín giúp em còn danh dự và muốn sửa.", en: "Cheating in a test is often fear more than intent. Letting him redo it in front of you and asking the real cause shows you help rather than punish. Keeping it quiet leaves his dignity intact and his wish to mend.")
#ranhgioi("Không tuyên bố công khai. Nếu quy chế trường yêu cầu xử lý chính thức thì làm đúng quy chế nhưng vẫn nói chuyện riêng với em. Không dùng điểm làm vũ khí.", en: "Do not announce it. If school rules demand a formal procedure, follow them, but still talk to him privately. Do not use marks as a weapon.")
#bientau("Cho em một cơ hội tự chấm lại bài làm cũ và ghi nhận những chỗ mình thiếu.", en: "Give him a chance to mark his own earlier paper and note where he is weak.")
#caunoi("Thầy giữ bài của em và không nói với ai. Mai em làm lại, thầy muốn biết em có điều gì lo lắng.", en: "I am holding your paper and telling no one. Redo it tomorrow, and I want to know what you were worried about.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 5: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Người cầm điện thoại mỗi mười phút thường không cố ý. Đo được thì giảm được, bắt đầu từ việc để em tự đếm.", "Chuyện quay chụp lén là ranh giới thật. Hãy nghiêm với hành vi nhưng nhẹ với người, và luôn báo gia đình nếu đã lan truyền.", "Học cách đặt điện thoại vào đúng chỗ là một kỹ năng sống. Thầy cô dạy bằng gương của mình, cất điện thoại khi giảng cũng là một bài học.",), en: ("A student who touches the phone every ten minutes seldom does it on purpose. What can be measured can be reduced; begin by letting the student count.", "Secret filming is a true limit. Be firm about the act and gentle toward the person, and always tell the family if it has spread.", "Learning to put the phone in its place is a life skill. Teachers teach it by example; putting your own phone away while teaching is also a lesson.",))
