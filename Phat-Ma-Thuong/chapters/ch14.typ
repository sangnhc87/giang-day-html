#import "../template.typ": *

#chapter-open(14, "Đồng phục, tóc tai, rác và ăn vặt", 14, "Những lỗi này nhỏ, nhưng nhỏ lặp đi lặp lại thì làm thầy cô mệt hơn lỗi lớn. Hãy phạt bằng sự tử tế, đừng phạt bằng sự cằn nhằn.", "Áo không bỏ vào quần, tóc nhuộm, vứt rác, ăn vặt trong lớp là những lỗi nề nếp thầy cô nhắc mỗi ngày. Nhắc mãi thì chai, phạt nặng thì lố. Chương này gợi những chiêu nhẹ như đổi vai, như thử thách ngắn, và hướng em tự thấy cái giá thật của lỗi nhỏ. Quan trọng nhất là phân biệt em làm sai vì cố tình và em làm sai vì không có điều kiện.", ("Em không mặc đồng phục", "Em nhuộm tóc, sơn móng tay", "Em vứt rác bừa bãi", "Em ăn vặt trong lớp",), en: ("Uniform, hair, litter and snacking", "These faults are small, but small and repeated wear a teacher out more than big ones. Punish with kindness, not with nagging.", "Shirts untucked, dyed hair, littering, snacking in class are routine faults you remind about every day. Nag and it goes stale, punish heavily and it is excessive. This chapter offers light moves, like role changes and short challenges, that lead the student to feel the real cost of small faults. Most important is telling apart the student who errs deliberately from the one who errs for lack of means.", ("A student does not wear the uniform", "A student dyes her hair and paints her nails", "A student litters", "A student snacks in class",)))

#sec("Em không mặc đồng phục", en: "A student does not wear the uniform")
#tinhhuong("14.1", "Em không mặc đồng phục", "Bạn Huy đi học nhiều ngày liên tiếp không mặc đồng phục, mặc áo thun thường. Em không giải thích, chỉ nói quên. Thầy chủ nhiệm nhắc, bạn bè cũng thấy.", en: "Huy has come to school for several days running without uniform, in an ordinary T-shirt. He gives no explanation, only says he forgot. The homeroom teacher has reminded him, and friends have noticed.")
#chieu("Hỏi trước, áo sau", "Thầy gặp riêng và hỏi nhẹ: dạo này thầy thấy em hay mặc đồ thường, có chuyện gì khiến em khó mặc áo trường không? Nếu em nói áo hỏng, chật hoặc nhà chưa kịp mua, thầy kín đáo đưa em một chiếc áo trong tủ đồ dự phòng của lớp hoặc nối liên lạc với quỹ hỗ trợ. Nếu em chỉ không thích, thầy thương lượng: em mặc đồng phục trong tuần, cuối tuần em được chọn một ngày đặc biệt do lớp đề xuất.", en: ("Ask first, shirt after", "Meet him privately and ask gently: lately you often wear ordinary clothes; is something making it hard to wear the school shirt? If he says it is torn, too small, or the family has not had time to buy one, you discreetly hand him a shirt from the class spare wardrobe or connect him with a support fund. If he simply does not like it, you negotiate: wear the uniform during the week, and at the weekend he picks a special day suggested by the class."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Huy, dạo này thầy thấy em hay mặc đồ thường. Có chuyện gì khiến em khó mặc áo trường không? Thầy hỏi để giúp, không phải để phạt.", en: "Huy, lately I see you often wear ordinary clothes. Is there something making it hard to wear the school shirt? I ask to help, not to punish.")
  #tro("Dạ... áo em bị chật rồi mà nhà chưa mua được.", en: "Um... my shirt has got too small and we have not been able to buy one.")
  #thay("Cảm ơn em nói thật. Thầy có cách giúp, em đừng ngại nhé.", en: "Thank you for telling the truth. I have a way to help; do not feel shy.")
]
#visao("Mặc sai đồng phục có thể là lỗi tuân thủ, nhưng nhiều khi là chuyện điều kiện. Hỏi trước giúp tránh phạt oan và cho thầy cơ hội hỗ trợ kín đáo. Em giữ được lòng tự trọng.", en: "Wearing the wrong uniform may be disobedience, but often it is a matter of circumstances. Asking first avoids punishing unfairly and gives you a chance to help discreetly. He keeps his self-respect.")
#ranhgioi("Không công khai hoàn cảnh em. Không phạt em vì gia đình khó khăn. Khi em chỉ cố ý chống đối, nói chuyện thẳng nhưng vẫn riêng tư.", en: "Do not reveal his circumstances. Do not punish him because his family is poor. When he is merely defying the rule, speak frankly but still privately.")
#bientau("Lập tủ đồ dự phòng bằng quyên góp đồng phục cũ của các khóa trước.", en: "Set up a spare uniform closet from donations of old uniforms from previous years.")
#caunoi("Dạo này thầy thấy em hay mặc đồ thường, có chuyện gì thầy giúp được không?", en: "Lately I see you in ordinary clothes. Is there something I can help with?")

#sec("Em nhuộm tóc, sơn móng tay", en: "A student dyes her hair and paints her nails")
#tinhhuong("14.2", "Em nhuộm tóc, sơn móng tay", "Đầu tuần, Nhi đi học với mái tóc nhuộm vàng và móng tay sơn bóng. Nội quy không cho phép. Cả lớp tò mò nhìn em, em ngẩng cao đầu.", en: "At the start of the week, Nhi comes to school with bleached blond hair and glossy nails. The rules do not allow it. The whole class looks at her curiously and she holds her head high.")
#chieu("Tuần thử thách", "Thầy mời Nhi ở lại và nói nhẹ: tóc em nhìn nổi bật thật. Nhưng trường có quy định, thầy cần em hiểu lý do. Thầy đề nghị một tuần thử thách: em trình bày với thầy ba lý do vì sao em chọn kiểu tóc đó, và thầy kể lý do của nội quy. Cùng nhau xem bên nào thuyết phục hơn. Em có thể đề xuất lên ban cán sự về việc xem xét nội quy hoặc chọn thời điểm nhuộm như kỳ nghỉ hè.", en: ("A week of challenge", "Invite Nhi to stay and say gently: your hair stands out, really. But the school has a rule, and I need you to understand the reason. Propose a week of challenge: she gives you three reasons why she chose that hairstyle, and you tell her the reasons behind the rule. Together see which is more convincing. She may suggest to the class committee that the rule be reconsidered, or choose to dye at a time like the summer holiday."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Nhi, màu tóc của em nổi thật. Thầy muốn nghe em nói vì sao em chọn, rồi thầy nói lý do nội quy. Mình xem nói chuyện với nhau có hay không nhé.", en: "Nhi, your hair colour does stand out. I would like to hear why you chose it, and then I will tell you the reasons for the rule. Let us see whether talking helps.")
  #tro("Dạ... em chỉ muốn khác một chút thôi thầy.", en: "Um... I just wanted to look a little different, sir.")
  #thay("Thầy hiểu. Muốn khác là chuyện bình thường. Mình tìm cách để em vẫn là mình mà đúng nội quy nhé.", en: "I understand. Wanting to be different is normal. Let us find a way for you to stay yourself and still follow the rules.")
]
#visao("Nhuộm tóc là cách tuổi mới lớn khẳng định bản thân. Thầy nghe trước rồi giải thích, em cảm thấy được tôn trọng nên dễ hợp tác. Nếu nội quy có vấn đề thì kênh góp ý là bài học công dân.", en: "Dyeing hair is how adolescents assert themselves. You listen first and then explain, so she feels respected and cooperates more easily. If the rule itself has problems, the feedback channel is a civics lesson.")
#ranhgioi("Không làm nhục ngoại hình em. Không cắt tóc, không buộc gội ngay. Phải theo nội quy nhà trường và thông báo phụ huynh khi quy định yêu cầu. Nếu tóc nhuộm do hoàn cảnh bệnh hay lý do đặc biệt, linh hoạt.", en: "Do not humiliate her appearance. Do not cut her hair or make her wash it out at once. You must follow school rules and notify parents where regulations require. If the dye is for a special reason, such as illness, be flexible.")
#bientau("Mời em làm đại diện lớp góp ý với ban giám hiệu về quy định tóc tai.", en: "Invite her to be the class representative giving feedback to the headteacher about the hair and grooming rules.")
#caunoi("Thầy muốn nghe lý do em chọn màu tóc, rồi thầy nói lý do nội quy nhé.", en: "I would like to hear why you chose this colour, and then tell you the reasons for the rule.")

#sec("Em vứt rác bừa bãi", en: "A student litters")
#tinhhuong("14.3", "Em vứt rác bừa bãi", "Giờ ra chơi, sàn lớp và sân trường đầy vỏ bánh, vỏ chai. Một em nào đó vừa ăn xong vứt ngay xuống đất rồi đi, cả nhóm thấy nhưng không ai nhặt.", en: "At break, floors and yard are full of snack wrappers and bottles. One student has just finished eating and dropped it on the ground and walked away; the whole group saw it and no one picked it up.")
#chieu("Nhặt ba món", "Thầy không phạt riêng ai. Cả lớp hoặc nhóm em vứt rác nhận một thử thách ngắn: nhặt ba món rác không phải của mình trong ra chơi tiếp theo, và chụp ảnh cho thầy. Thầy kèm một câu hỏi: nhặt rác của người khác cảm giác thế nào? Em nhặt xong được dán một nhãn sticker hình chiếc lá xanh vào vở. Việc nhặt rác của người khác dạy em cảm giác thấy phiền hà thay vì chỉ nghe nói.", en: ("Pick up three", "Do not punish any one student. The whole class or the group that littered gets a short challenge: in the next break, pick up three pieces of litter that are not theirs and photograph them for you. Add one question: how did it feel to pick up someone else's litter? After picking up, they get a green-leaf sticker in their exercise book. Picking up other people's litter teaches the feeling of being put out, instead of only hearing about it."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thử thách nhỏ cho em: ra chơi tiếp theo nhặt ba món rác không phải của em, chụp ảnh cho thầy xem nhé. Sau đó em kể thầy cảm giác thế nào.", en: "A small challenge for you: next break pick up three pieces of litter that are not yours and photograph them for me. Afterwards tell me how it felt.")
  #tro("Dạ... em làm. Hơi mệt thầy nhỉ.", en: "Um... I will do it. A bit tiring, sir.")
  #thay("Ừ, mệt đúng không. Đó là cảm giác của bác lao công mỗi ngày. Cảm ơn em nhé.", en: "Yes, tiring, right? That is how the cleaner feels every day. Thank you.")
]
#visao("Em vứt rác vì chưa thấy được hậu quả với người khác. Nhặt rác của người khác cho em trải nghiệm trực tiếp. Chiếc lá xanh biến nghĩa vụ thành sự ghi nhận.", en: "Students litter because they have not seen the consequences for others. Picking up others' litter gives direct experience. The green leaf turns duty into recognition.")
#ranhgioi("Không bắt nhặt rác nguy hiểm như kim tiêm, thủy tinh vỡ. Không bắt em làm một mình ở nơi vắng. Không dùng việc nhặt rác làm hình phạt thường xuyên.", en: "Do not make them pick up dangerous things like needles or broken glass. Do not make a student do it alone in a deserted spot. Do not use litter picking as a routine punishment.")
#bientau("Cả lớp thi tuần lớp sạch, lớp nào ít rác nhất ngày thứ Sáu được chọn bài hát phát ra chơi.", en: "Hold a clean-class week; the cleanest class by Friday picks the song played at break.")
#caunoi("Em nhặt giúp thầy ba món rác không phải của em, rồi kể thầy cảm giác nhé.", en: "Please pick up three pieces of litter that are not yours, then tell me how it felt.")

#sec("Em ăn vặt trong lớp", en: "A student snacks in class")
#tinhhuong("14.4", "Em ăn vặt trong lớp", "Giữa tiết, mùi bim bim bay ra từ cuối lớp. Có em lén bỏ vào miệng sau cuốn vở. Thầy nhắc thì em dạ, một lúc sau lại ăn. Các em bên cạnh bắt đầu xì xào.", en: "In the middle of a lesson, the smell of crisps drifts from the back. A student sneaks bites behind his notebook. You remind him and he says yes; a while later he is eating again. Those beside him begin to whisper.")
#chieu("Tiệc năm phút", "Thầy mỉm cười nói: em đói thật hả? Thầy cho em tiệc năm phút ngay bây giờ, em ra hành lang ăn thật nhanh, không ai thấy. Em quay lại thì thầy nói: vừa rồi là ưu tiên cho cái bụng, giờ là ưu tiên cho cái đầu. Lần sau trước tiết học, em ghi lên tờ giấy nhớ là đã ăn chưa để thầy biết. Có em nào đói thật, thầy bí mật kiểm tra giúp.", en: ("A five-minute feast", "Smile and say: you are hungry, really? I give you a five-minute feast right now; step out to the corridor and eat quickly, nobody sees. When he comes back say: just now was priority for the stomach, now it is priority for the head. Before lessons from now on, he writes on a sticky note whether he has eaten so you know. If a student is truly hungry, you check on him quietly."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Em đói đúng không? Thầy cho em năm phút ra hành lang ăn cho xong, rồi quay lại nhé. Cái bụng xong rồi thì cái đầu cho thầy.", en: "You are hungry, right? I give you five minutes to eat in the corridor, then come back. Once the stomach is done, the head belongs to me.")
  #tro("Dạ... em xin lỗi thầy. Sáng em chưa kịp ăn.", en: "Um... I am sorry, sir. I did not have time for breakfast.")
  #thay("Không sao. Cảm ơn em nói thật. Ngày mai em ăn trước giờ học nhé, hoặc thầy giúp tìm cách.", en: "That is fine. Thank you for telling me honestly. Tomorrow eat before class, or I will help you find a way.")
]
#visao("Ăn vặt trong lớp thường vì đói hoặc thói quen. Cho em ăn có kiểm soát giải quyết nhu cầu thật và bỏ đi cuộc đối đầu. Em hiểu quy tắc không phải để làm khó mà để lớp giữ nhịp.", en: "Snacking in class is usually hunger or habit. Letting him eat in a controlled way answers the real need and drops the confrontation. He understands that the rule is not there to make things hard but to keep the class in rhythm.")
#ranhgioi("Nếu em bỏ bữa vì nhà khó khăn, đừng phạt mà hỗ trợ thực tế, như liên hệ bữa ăn bán trú hay quỹ hỗ trợ. Không công khai em đói. Không cho phép ăn thường xuyên trong tiết.", en: "If he skips meals because the family is struggling, do not punish; give practical support, such as contacting school meals or a support fund. Do not publicise that he is hungry. Do not allow regular eating in lessons.")
#bientau("Quy định chung ba phút ăn nhẹ giữa tiết nếu cả lớp thật sự đói buổi sáng.", en: "A general rule of three minutes for a light snack mid-lesson if the whole class is truly hungry in the morning.")
#caunoi("Em đói thì thầy cho năm phút ra ngoài ăn, rồi mình quay lại học nhé.", en: "If you are hungry I give you five minutes to eat outside and then we study.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 14: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Trước khi phạt lỗi nề nếp, hãy hỏi một câu: em không làm vì không muốn hay vì không có điều kiện? Câu trả lời đổi cách xử lý hoàn toàn.", "Lỗi nhỏ lặp lại cần thử thách ngắn có hình ảnh rõ, không cần lời quở dài. Nhặt ba món, đổi chỗ, nói ba lý do.", "Nội quy không bao giờ nên được dùng để làm nhục ngoại hình hay hoàn cảnh của em.",), en: ("Before punishing a routine fault, ask one question: is the student not doing it because he does not want to or because he lacks the means? The answer changes everything.", "Small repeated faults need a short challenge with a clear image, not a long scolding. Pick up three, change seats, state three reasons.", "Rules must never be used to humiliate a student's appearance or circumstances.",))
