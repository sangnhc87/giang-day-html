#import "../template.typ": *

#chapter-open(11, "Nói dối, giả mạo, lấy đồ, viện cớ", 11, "Em nói dối là em đang sợ. Gỡ nỗi sợ trước, sự thật sẽ tự đến.", "Nói dối để trốn lỗi, ký giả chữ ký phụ huynh, lấy đồ của bạn, giả bệnh để ra ngoài là những lỗi chạm đến sự trung thực. Thầy cô dễ nổi giận nhất ở đây, vì cảm thấy bị lừa. Nhưng phạt nặng chỉ dạy em nói dối giỏi hơn. Chương này gợi những chiêu tạo đường lùi an toàn để em dám nói thật, mà vẫn giữ nguyên tắc rõ ràng.", ("Em nói dối để chối lỗi", "Em giả chữ ký phụ huynh", "Em lấy đồ của bạn", "Em giả bệnh, xin ra ngoài liên tục", "Em viện cớ xin nghỉ, đổ lỗi cho người khác",), en: ("Lying, forgery, taking things, excuses", "A student who lies is afraid. Remove the fear first and the truth will come by itself.", "Lying to dodge blame, forging a parent's signature, taking a classmate's things, faking illness to get out: faults that touch honesty. Teachers get angriest here, feeling deceived. But heavy punishment only teaches the student to lie better. This chapter offers moves that create a safe way back so the student dares to tell the truth, while keeping the principle clear.", ("A student lies to deny a fault", "A student forges a parent's signature", "A student takes a classmate's things", "A student fakes illness or keeps asking to leave", "A student makes excuses and blames others",)))

#sec("Em nói dối để chối lỗi", en: "A student lies to deny a fault")
#tinhhuong("11.1", "Em nói dối để chối lỗi", "Thầy thấy rõ Việt xé quyển vở của bạn, nhưng em nhất quyết nói em không làm. Em nhìn thẳng vào mắt thầy, mặt tỉnh bơ. Cả lớp cũng biết.", en: "You clearly saw Viet tear a classmate's notebook, but he insists he did not. He looks straight into your eyes, perfectly composed. The class knows too.")
#chieu("Hai cơ hội nói lại", "Thầy không vạch mặt. Thầy nói riêng: thầy đã thấy chuyện này, nhưng thầy muốn cho em hai cơ hội nói lại. Cơ hội thứ nhất là ngay bây giờ. Cơ hội thứ hai là đến hết ngày hôm nay, em ghé thầy nói riêng. Nếu em nói lại, thầy chỉ cần em sửa việc đã làm và không phạt thêm vì đã nói dối lần đầu. Nếu em không nói, thầy sẽ xử lý theo cách khác. Em được tự chọn.", en: ("Two chances to retell", "Do not expose him. Say privately: I saw this, but I want to give you two chances to say it again. The first is right now. The second is until the end of today, when you come and tell me privately. If you retell it, I only need you to mend what you did and I will not punish you more for the first lie. If you do not, I will deal with it another way. The choice is yours."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Việt, thầy đã thấy chuyện này. Thầy cho em hai cơ hội nói lại: bây giờ, hoặc trước khi hết ngày, em ghé thầy. Nói lại thì thầy chỉ cần em sửa việc đã làm, không phạt thêm vì nói dối.", en: "Viet, I saw this. I give you two chances to say it again: now, or before the end of the day, come to me. If you retell it, I only need you to mend what you did, with no extra punishment for lying.")
  #tro("(Im lặng, rồi cuối ngày ghé.) Dạ... thầy, là em xé. Em xin lỗi.", en: "(Silent, then at day's end, comes.) Um... sir, it was me who tore it. I am sorry.")
  #thay("Cảm ơn em đã quay lại. Em nói thật rồi, giờ mình cùng nghĩ cách đền cho bạn.", en: "Thank you for coming back. You have told the truth; now let us think how to make it up to your classmate.")
]
#visao("Em nói dối vì sợ hậu quả. Cho đường lùi an toàn khiến nói thật rẻ hơn nói dối. Em tự quay lại được thì nhớ lâu hơn bị vạch mặt. Việc thầy không phạt thêm vì nói dối dạy em rằng thật thà có giá trị.", en: "He lies because he fears the consequence. A safe way back makes telling the truth cheaper than lying. A student who comes back himself remembers it longer than being exposed. Not punishing extra for the lie teaches that honesty has value.")
#ranhgioi("Phải giữ lời: nếu em nói lại thì không phạt thêm. Nếu em không nói, xử lý theo quy định mà không mỉa mai. Không đặt bẫy để em nói dối thêm. Khi lỗi nặng hoặc có người bị hại, không dùng chiêu này để bỏ qua việc báo cáo.", en: "You must keep your word: if he retells it, no extra punishment. If he does not, deal with it under regulations without sarcasm. Do not set traps for him to lie more. When the fault is serious or someone is hurt, do not use this move to skip reporting.")
#bientau("Dành sẵn một mẩu giấy nhỏ ghi: tôi muốn nói lại, em chỉ cần để lên bàn thầy mà không cần mở lời.", en: "Keep a small slip reading: I want to retell it, which he can simply leave on your desk without speaking.")
#caunoi("Thầy cho em hai cơ hội nói lại, bây giờ hoặc trước khi hết ngày. Nói lại thì không phạt thêm vì nói dối.", en: "I give you two chances to retell it, now or before the end of the day. Retell it and no extra punishment for lying.")

#sec("Em giả chữ ký phụ huynh", en: "A student forges a parent's signature")
#tinhhuong("11.2", "Em giả chữ ký phụ huynh", "Thầy so sánh chữ ký trong sổ liên lạc với những lần trước và thấy khác hẳn. Thầy hỏi nhẹ, Khang ấp úng, rồi nhận là em tự ký vì sợ ba mẹ biết điểm kém.", en: "You compare the signature in the contact book with earlier ones and it looks completely different. You ask gently; Khang stammers, then admits he signed it himself for fear his parents would see his poor mark.")
#chieu("Chữ ký của chính em", "Thầy không la. Thầy nói: em đã giả chữ ký, và đó là việc nghiêm trọng, thầy phải nói rõ. Nhưng thầy muốn hiểu vì sao em sợ. Thầy giao hai việc: một, em tự nói với ba mẹ chuyện này và chuyện điểm, thầy đứng bên cạnh nếu em muốn; hai, em ký một dòng của chính em dưới sổ: em hứa lần sau sẽ nói thật về điểm. Chữ ký của em thay cho chữ ký giả.", en: ("A signature of his own", "Do not shout. Say: you forged a signature, and that is serious, so I must say so plainly. But I want to understand why you were afraid. Give two tasks: one, tell your parents about this and the mark yourself, with you standing beside him if he wishes; two, he signs a line of his own below in the book: I promise to tell the truth about marks next time. His own signature replaces the forged one."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Khang, giả chữ ký là việc nghiêm trọng, thầy phải nói rõ. Nhưng thầy muốn hiểu vì sao em sợ. Em tự nói với ba mẹ nhé, thầy đứng bên cạnh nếu em cần.", en: "Khang, forging a signature is serious and I must say so clearly. But I want to understand why you were afraid. You tell your parents yourself, and I will stand beside you if you need.")
  #tro("Dạ... em sợ ba mẹ la, nên em ký đại.", en: "Um... I was afraid they would shout, so I just signed.")
  #thay("Thầy hiểu. Mình cùng tìm cách để lần sau em dám nói. Thầy sẽ giúp em nói với ba mẹ.", en: "I understand. Let us find a way for you to dare to tell next time. I will help you speak to your parents.")
]
#visao("Giả chữ ký gần như luôn xuất phát từ nỗi sợ điểm số hoặc sợ phản ứng của người lớn. Bắt em tự nói với ba mẹ có thầy cùng giúp em đối diện nỗi sợ gốc. Chữ ký tự cam kết của em thay cho chữ ký giả có sức dạy hơn bất kỳ hình phạt nào.", en: "Forging a signature almost always comes from fear of marks or of adults' reactions. Having him tell his parents with you helping lets him face the root fear. His own pledge signature in place of the forged one teaches more than any punishment.")
#ranhgioi("Nếu em sợ bị bạo hành khi ba mẹ biết, đừng bắt em nói với ba mẹ ngay; hãy làm việc với nhà trường để đảm bảo an toàn cho em. Phải thông báo gia đình theo quy định, nhưng nên chuẩn bị cách nói. Không công khai chuyện giả chữ ký.", en: "If he fears violence when his parents know, do not make him tell them at once; work with the school to ensure his safety. You must inform the family as regulations require, but prepare how to say it. Do not publicise the forgery.")
#bientau("Lập một khung giờ cuối tháng để các em tự báo điểm cho gia đình qua thầy hỗ trợ, thay vì chờ sổ liên lạc.", en: "Set a time at the end of each month for students to report marks to their families with your support, rather than waiting for the contact book.")
#caunoi("Giả chữ ký là việc nghiêm trọng, nhưng thầy muốn hiểu vì sao em sợ. Mình cùng nói với ba mẹ nhé.", en: "Forging a signature is serious, but I want to understand why you were afraid. Let us tell your parents together.")

#sec("Em lấy đồ của bạn", en: "A student takes a classmate's things")
#tinhhuong("11.3", "Em lấy đồ của bạn", "Bạn Mai mất mười lăm nghìn đồng và một cây bút đẹp. Thầy tinh ý để ý một em ngồi gần, Thành, mới có cây bút giống y thế. Em đỏ mặt, nói bạn tặng.", en: "Mai has lost fifteen thousand dong and a nice pen. You notice that Thanh, sitting nearby, has an identical pen. He goes red and says a friend gave it to him.")
#chieu("Cửa trả lại không ai thấy", "Thầy không truy hỏi, không khám cặp. Thầy nói với cả lớp, nhẹ nhàng: có những lúc người ta cầm nhầm đồ của người khác. Thầy mở một hộp trả lại ở góc lớp, ai muốn trả thứ gì cứ bỏ vào ban đêm, thầy không hỏi tên, và thầy hứa không tìm xem ai. Riêng với Thành, thầy nói nhỏ: thầy không tin em là người xấu. Nếu có chuyện gì cần giúp, em ghé thầy. Rất nhiều trường hợp, đồ được trả lại trong hai ngày.", en: ("A door for returning, unseen", "Do not interrogate or search bags. Tell the whole class gently: sometimes people pick up another's things by mistake. Open a returns box in a corner of the room; anyone who wishes to return something can put it in overnight, you will not ask names, and promise not to find out who. Privately to Thanh, say quietly: I do not believe you are a bad person. If there is something you need help with, come to me. In very many cases the item comes back within two days."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Với cả lớp.) Đôi khi người ta cầm nhầm đồ của người khác. Thầy để một hộp ở góc lớp, ai muốn trả gì cứ bỏ vào. Thầy không hỏi tên và không tìm ai.", en: "(To the whole class.) Sometimes people take another's things by mistake. I am putting a box in the corner; anyone who wants to return something can put it in. I will not ask names and I will not look for anyone.")
  #tro("(Thành, riêng.) Dạ... thầy, em trả bút cho bạn Mai được không ạ?", en: "(Thanh, privately.) Um... sir, may I return the pen to Mai?")
  #thay("Được. Thầy cảm ơn em. Em muốn nói thêm điều gì thì thầy nghe.", en: "You may. Thank you. If you want to tell me more, I am listening.")
]
#visao("Lấy đồ thường từ thiếu thốn, ganh tị hoặc nhất thời. Cho em lối trả lại không bị lộ mặt giúp em sửa mà không bị gắn mác là kẻ cắp. Em tự trả lại thì nhớ giá trị của lòng trung thực lâu hơn bị phát hiện.", en: "Taking things often comes from need, envy or impulse. A way to return unseen lets him mend without being branded a thief. A student who returns of his own accord remembers the value of honesty longer than being caught.")
#ranhgioi("Không khám xét, không nói tên em trước lớp, không gán tội khi chưa chắc. Nếu em lấy vì túng thiếu, hỗ trợ kín đáo. Nếu số tiền lớn hoặc lặp lại, báo nhà trường và gia đình, nhưng vẫn giữ phẩm giá cho em.", en: "Do not search, do not name him before the class, do not accuse without certainty. If he took because of poverty, support him discreetly. If the sum is large or it repeats, tell the school and family, while preserving his dignity.")
#bientau("Thiết lập thùng đồ thất lạc có người phụ trách, để các em có nơi đưa đồ nhặt được mà không bị nghi ngờ.", en: "Set up a lost-property box with someone in charge, so students have a place to hand in found items without being suspected.")
#caunoi("Đôi khi người ta cầm nhầm. Có hộp trả lại ở góc lớp, thầy không hỏi tên.", en: "Sometimes people pick things up by mistake. There is a returns box in the corner, and I will not ask names.")

#sec("Em giả bệnh, xin ra ngoài liên tục", en: "A student fakes illness or keeps asking to leave")
#tinhhuong("11.4", "Em giả bệnh, xin ra ngoài liên tục", "Linh xin đi vệ sinh gần như mỗi tiết, mỗi lần mười lăm phút. Hay xin lên phòng y tế vì đau đầu đúng giờ kiểm tra. Thầy nghi ngờ nhưng sợ em thật sự đau.", en: "Linh asks to go to the toilet almost every lesson, fifteen minutes each time. She often asks to go to the infirmary with a headache right at test time. You are suspicious but afraid she is truly in pain.")
#chieu("Thẻ ra ngoài", "Thầy phát cho mỗi em ba tấm thẻ ra ngoài mỗi tuần, ai cần đi vệ sinh, uống nước, rửa mặt thì đặt thẻ lên bàn, không cần hỏi. Hết thẻ thì xin thầy phép, và thầy xem xét riêng. Với Linh, thầy hỏi riêng một lần: em hay thấy mệt vào giờ kiểm tra, có phải em lo lắng điều gì không? Nếu em lo kiểm tra, thầy cùng em tìm cách bình tĩnh trước giờ thi.", en: ("Exit cards", "Give each student three exit cards a week; anyone needing the toilet, a drink or to wash their face places a card on the desk without asking. When the cards run out they ask your permission, which you consider privately. With Linh, ask once privately: you often feel unwell around tests; are you worried about something? If she is anxious about tests, help her find ways to stay calm before an exam."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Mỗi em có ba thẻ ra ngoài mỗi tuần. Cần đi đâu cứ đặt thẻ lên bàn, thầy không hỏi. Hết thẻ thì xin thầy, thầy xem xét.", en: "Each of you has three exit cards a week. When you need to go anywhere, put a card on the desk, I will not ask. When they run out, ask me and I will consider it.")
  #tro("(Linh, riêng.) Dạ... thật ra em lo kiểm tra lắm thầy, nên em hay đau bụng.", en: "(Linh, privately.) Um... actually I am very worried about tests, sir, so I often get stomach aches.")
  #thay("Cảm ơn em nói thật. Mình cùng tìm cách để em đỡ lo nhé.", en: "Thank you for telling me honestly. Let us find a way to make you less anxious.")
]
#visao("Giả bệnh thường là cách thoát khỏi nỗi lo. Thẻ ra ngoài cho em quyền chính đáng nên giảm xin xỏ lạm dụng, và biến chuyện đi ra thành chuyện có kiểm soát. Hỏi riêng về giờ kiểm tra chạm đến gốc vấn đề.", en: "Faking illness is often a way to escape anxiety. Exit cards give a legitimate right, so abuse of requests falls, and going out becomes controlled. Asking privately about test times touches the root.")
#ranhgioi("Không từ chối em thật sự ốm hay có vấn đề sức khỏe. Không nghi ngờ công khai. Nếu em lo âu kéo dài, đề nghị gia đình và chuyên viên tâm lý. Nếu em có bệnh nền cần đi nhiều, linh hoạt và ghi nhận.", en: "Do not refuse a student who is truly ill or has a health issue. Do not voice suspicion publicly. If anxiety is long-lasting, suggest the family and a counsellor. If a student has an underlying condition requiring frequent breaks, be flexible and note it.")
#bientau("Đổi thẻ thành vòng tay màu nhỏ, để thầy nhìn là biết, không cần hỏi trước lớp.", en: "Replace the cards with small coloured wristbands, so you know at a glance without asking before the class.")
#caunoi("Mỗi em có ba thẻ ra ngoài mỗi tuần. Cần đi đâu cứ đặt thẻ lên bàn.", en: "Each of you has three exit cards a week. Whenever you need to go, put one on the desk.")

#sec("Em viện cớ xin nghỉ, đổ lỗi cho người khác", en: "A student makes excuses and blames others")
#tinhhuong("11.5", "Em viện cớ xin nghỉ, đổ lỗi cho người khác", "Hòa không nộp bài và nói bạn làm mất bài của em. Hôm sau lại nói máy tính hỏng. Hôm sau nữa nói ba mẹ bắt đi đám giỗ. Mỗi lý do nghe có lý, nhưng ba lý do trong một tuần.", en: "Hoa does not hand in work and says a classmate lost it. Next day, the computer broke. The day after, her parents made her attend a memorial meal. Each reason sounds plausible, but that is three in a week.")
#chieu("Ba chữ tôi đã làm", "Thầy không bác bỏ từng lý do. Thầy đưa em một tờ giấy, nói: thầy tin em có những khó khăn thật. Thầy xin em viết ba chữ vào đầu mỗi lý do: tôi đã làm. Tôi đã quên làm, tôi đã chưa kịp làm, tôi đã chọn không làm. Em chọn đúng với sự thật nhất, không ai chấm điểm. Thầy dùng câu trả lời để cùng em đặt kế hoạch. Dần dần em quen chịu trách nhiệm thay vì đổ ra ngoài.", en: ("Three words: I did", "Do not rebut each reason. Hand her a sheet and say: I believe you have real difficulties. I ask you to write one of three phrases at the head of each reason: I forgot to do it, I did not get round to it, I chose not to. She chooses what is truest, and nobody grades it. You use the answer to make a plan together. Gradually she grows used to taking responsibility instead of pushing it outward."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hòa, thầy tin em có khó khăn thật. Em chọn giúp thầy một câu đúng nhất: tôi đã quên làm, tôi chưa kịp làm, hay tôi đã chọn không làm. Không ai chấm điểm cả.", en: "Hoa, I believe you have real difficulties. Choose for me the most honest phrase: I forgot, I did not get round to it, or I chose not to. Nobody is grading this.")
  #tro("Dạ... em chưa kịp làm, vì em ham chơi.", en: "Um... I did not get round to it, because I was playing.")
  #thay("Cảm ơn em nói thật. Mình lên kế hoạch để em kịp nộp ngày mai nhé.", en: "Thank you for telling the truth. Let us make a plan so you can hand it in tomorrow.")
]
#visao("Đổ lỗi là cơ chế tự vệ. Ba lựa chọn đặt em vào vị trí chủ thể mà không bị buộc tội, và biến sự thật thành điều nói ra được. Thầy dùng câu trả lời để giúp thay vì phạt.", en: "Blame is a defence mechanism. Three options put her in the position of agent without being accused, and make the truth sayable. You use her answer to help rather than punish.")
#ranhgioi("Không dùng như bẫy bắt em nhận lỗi. Tôn trọng câu trả lời của em. Nếu lý do thực sự là chuyện gia đình, chuyển sang hỗ trợ. Không công khai câu trả lời.", en: "Do not use it as a trap to make her admit fault. Respect her answer. If the real reason is family matters, switch to support. Do not make her answer public.")
#bientau("Cho em tự đặt tên cho kiểu lý do hay dùng của mình, như lý do số một, để em nhận ra thói quen.", en: "Let her give a name to her favourite kind of excuse, like excuse number one, so she recognises the habit.")
#caunoi("Em chọn giúp thầy một câu đúng nhất: tôi quên, tôi chưa kịp, hay tôi chọn không làm?", en: "Choose for me the most honest phrase: I forgot, I did not get round to it, or I chose not to.")

