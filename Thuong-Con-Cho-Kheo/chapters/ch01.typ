#import "../template.typ": *

#chapter-open(1, "Khi ba mẹ đang nóng: giữ mình trước đã", 1, "Con không nhớ hết những gì ba mẹ nói lúc giận. Con chỉ nhớ gương mặt ba mẹ lúc đó.", "Hầu hết những câu làm con đau nhất đều được nói ra trong chín mươi giây đầu của cơn giận. Không phải vì ba mẹ không thương, mà vì lúc đó phần đầu óc biết cân nhắc đã tạm nhường chỗ cho phần chỉ biết phản ứng. Chương này không dạy ba mẹ đừng giận. Giận là chuyện của con người. Chương này chỉ bàn một việc: làm sao để cơn giận đi qua mà không để lại câu nào phải hối hận.", ("Con làm bể bình hoa kỷ niệm của mẹ", "Ba đi làm về mệt, con mè nheo đúng lúc", "Lỡ quát con trước mặt người khác", "Cơn giận lên tới cổ, tay đã giơ lên",), en: ("When you are the one boiling over: steady yourself first", "Children do not remember everything we say when we are angry. They remember our face.", "Most of the sentences that hurt a child deepest are spoken in the first ninety seconds of anger. Not because parents do not love, but because in those seconds the thinking part of the mind steps aside for the part that only reacts. This chapter does not tell you never to be angry. Anger is human. It deals with one thing: how to let anger pass without leaving behind a sentence you will regret.", ("Your child breaks the vase you treasured", "Dad comes home exhausted and the whining starts", "You shouted at your child in front of others", "The anger is at your throat and your hand is raised",)))

#sec("Con làm bể bình hoa kỷ niệm của mẹ", en: "Your child breaks the vase you treasured")
#boicanh("Bé Na lớp 3 chạy giỡn trong phòng khách, quơ tay trúng cái bình gốm mẹ mang về từ chuyến đi cuối cùng với bà ngoại. Bình vỡ làm ba. Na đứng chết trân, mắt nhìn mẹ, môi mím lại.", en: "Na, in grade 3, is running around the living room and knocks over the ceramic vase her mother brought back from her last trip with Grandma. It breaks into three pieces. Na freezes, eyes on her mother, lips pressed tight.")
#phanxa("Mẹ nói bao nhiêu lần rồi! Sao con hậu đậu vậy hả?", "Mình là đứa hậu đậu. Cái bình quan trọng hơn mình. Lần sau lỡ làm hư cái gì thì giấu đi cho yên.", en: ("How many times have I told you! Why are you so clumsy?", "I am a clumsy child. The vase matters more than I do. Next time I break something, I had better hide it."))
#scene("Tình huống 1.1 · Thử nói cách khác")[
  #me("(Hít một hơi, ngồi xuống ngang tầm con.) Con có bị đứt tay chỗ nào không? Đưa mẹ coi.", en: "(Takes a breath, kneels to her level.) Did you cut your hand anywhere? Let me see.")
  #con("Dạ không... Con xin lỗi mẹ. Con không cố ý.", en: "No... I'm sorry, Mum. I didn't mean to.")
  #me("Mẹ biết con không cố ý. Mẹ nói thật là mẹ đang buồn lắm, vì cái bình này mẹ mua lúc đi với bà ngoại. Cho mẹ một phút nha.", en: "I know you didn't. I'll be honest, I feel very sad, because I bought this vase when I was with Grandma. Give me a minute.")
  #con("(Bật khóc.) Con làm hư đồ của bà ngoại rồi...", en: "(Bursts into tears.) I broke Grandma's thing...")
  #me("Con khóc vì con cũng thương cái bình, mẹ thấy mà. Bình vỡ thì mẹ buồn, nhưng mẹ không hết thương con. Giờ mình cùng dọn, con lấy cái chổi, mảnh lớn để mẹ lượm.", en: "You are crying because you care about the vase too; I can see that. I am sad that it broke, but I have not stopped loving you. Let's clean up together. You get the broom; I'll pick up the big pieces.")
  #con("Mẹ ơi, mình dán lại được không?", en: "Mum, can we glue it back?")
  #me("Mình thử. Dán không đẹp như cũ đâu, nhưng mẹ sẽ để nó trên kệ. Còn chuyện chạy giỡn trong phòng khách, theo con thì từ mai mình nên làm sao?", en: "We can try. It won't look as good as before, but I'll keep it on the shelf. Now, about running in the living room: what do you think we should do from tomorrow?")
  #con("Con ra sân chơi. Trong nhà con đi chậm.", en: "I'll play outside. Inside, I'll walk slowly.")
]
#hieusau1("Lúc vừa gây ra chuyện, đứa trẻ đã sợ sẵn. Nếu người lớn quát thêm, nỗi sợ chiếm hết chỗ và con không còn sức đâu để nghĩ về việc mình làm. Con chỉ lo tự vệ: chối, đổ thừa, hoặc đứng trơ ra. Khi ba mẹ hỏi con có sao không trước, con hiểu rằng mình vẫn an toàn, và lúc đó sự hối lỗi thật mới có chỗ để xuất hiện.", en: "A child who has just caused an accident is already frightened. If an adult shouts on top of that, fear takes up all the room and there is nothing left for thinking about what happened. The child only defends: denies, blames, or stands frozen. When a parent first asks whether the child is hurt, the child understands she is still safe, and only then can real remorse appear.")
#cotloi("Đồ vỡ thì đã vỡ. Việc của ba mẹ trong phút đó là đừng để thêm một thứ nữa vỡ theo.", en: "What is broken is broken. Your job in that minute is to make sure nothing else breaks with it.")
#lamngay1("Chọn sẵn một câu để nói khi con làm hư, làm đổ thứ gì đó, ví dụ: Con có sao không? Tập nói thành tiếng ba lần. Câu nào tập trước thì lúc nóng mới bật ra được.", en: "Choose one sentence to say whenever your child breaks or spills something, such as: Are you all right? Say it aloud three times. Only a sentence practised in advance will come out when you are hot.")
#caunoi("Đồ hư thì mình sửa hoặc mua lại được. Con thì chỉ có một.", en: "Things can be fixed or bought again. There is only one of you.")
#tusoi(("Hồi nhỏ mình làm bể đồ, người lớn đã nói gì? Mình còn nhớ cảm giác đó không?", "Con mình khi lỡ làm sai thường chạy tới nói với mình, hay tìm cách giấu?",), en: ("When I broke something as a child, what did the adults say? Do I still remember how that felt?", "When my child does something wrong, do they run to tell me, or try to hide it?",))

#sec("Ba đi làm về mệt, con mè nheo đúng lúc", en: "Dad comes home exhausted and the whining starts")
#boicanh("Ba vừa bị sếp nói nặng, kẹt xe gần một tiếng. Vừa mở cửa, thằng Bin lớp 2 đã níu áo đòi ba coi cái mô hình nó ráp, rồi mè nheo đòi mua thêm bộ mới. Ba thấy máu dồn lên mặt.", en: "Dad has just been told off by his boss and sat in traffic for nearly an hour. The moment he opens the door, Bin, in grade 2, tugs his shirt to show a model he built, then whines for a new set. Dad feels the blood rush to his face.")
#phanxa("Im! Ba mệt muốn chết mà còn lải nhải. Đi chỗ khác chơi!", "Ba không muốn thấy mình. Mình chờ ba cả buổi chiều là mình sai.", en: ("Quiet! I'm dead tired and you keep nagging. Go play somewhere else!", "Dad does not want to see me. I waited for him all afternoon, and that was wrong."))
#scene("Tình huống 1.2 · Thử nói cách khác")[
  #ba("Bin ơi, ba thấy con chờ ba nãy giờ. Ba nói thật: hôm nay ba mệt lắm, đầu ba đang nóng. Không phải tại con.", en: "Bin, I can see you've been waiting for me. I'll tell you the truth: I am very tired today and my head is hot. It is not because of you.")
  #con("Nhưng ba coi cái này đi, con ráp cả buổi đó!", en: "But look at this, I spent the whole afternoon building it!")
  #ba("Ba muốn coi cho đàng hoàng chứ không coi qua loa. Con cho ba mười lăm phút tắm rửa, uống ly nước. Kim dài chỉ số 6 là ba ra, con để nguyên trên bàn nha.", en: "I want to look at it properly, not in a rush. Give me fifteen minutes to shower and drink some water. When the long hand reaches 6, I'll come out. Leave it right there on the table.")
  #con("Mười lăm phút lâu lắm.", en: "Fifteen minutes is so long.")
  #ba("Ừ, chờ thì lâu thật. Con bấm đồng hồ giùm ba đi. Hết giờ mà ba chưa ra thì con vô gõ cửa.", en: "Yes, waiting does feel long. Can you watch the clock for me? If time is up and I'm not out, come and knock.")
  #con("(Mười lăm phút sau.) Ba, hết giờ rồi!", en: "(Fifteen minutes later.) Dad, time's up!")
  #ba("Ba đây. Nào, kể ba nghe con ráp cái cánh này kiểu gì mà nó không rớt?", en: "Here I am. Now tell me, how did you attach this wing so it doesn't fall off?")
]
#hieusau1("Trẻ nhỏ không đọc được lý do phía sau nét mặt người lớn. Thấy ba cau có, con tự kết luận là tại mình. Khi ba mẹ nói rõ ba đang mệt, không phải tại con, con được gỡ khỏi cảm giác có lỗi. Hẹn một giờ cụ thể rồi giữ đúng hẹn còn dạy con một điều lớn: chờ được, vì lời ba mẹ là tin được.", en: "Small children cannot read the reason behind an adult's face. Seeing Dad scowl, the child concludes it is his fault. When a parent says plainly, I am tired and it is not because of you, the child is released from guilt. Naming a specific time and then keeping it teaches something large: waiting is possible, because a parent's word can be trusted.")
#cotloi("Ba mẹ không cần lúc nào cũng sẵn sàng. Ba mẹ chỉ cần nói thật là mình chưa sẵn sàng, và hẹn con một lúc mình sẽ có mặt trọn vẹn.", en: "You do not have to be available every moment. You only have to say honestly that you are not ready yet, and name a time when you will be fully there.")
#lamngay1("Hôm nay trước khi mở cửa vào nhà, đứng lại ngoài cửa một phút. Thở ba hơi dài. Tự hỏi: chuyện bực này là của ai? Rồi để nó lại ngoài cửa được chừng nào hay chừng đó.", en: "Today, before you walk in the door, stand outside for one minute. Take three long breaths. Ask: whose problem is this bad mood? Then leave as much of it outside as you can.")
#caunoi("Ba đang mệt, không phải tại con. Cho ba mười lăm phút rồi ba là của con.", en: "I'm tired, and it is not because of you. Give me fifteen minutes and then I'm all yours.")
#tusoi(("Mình thường mang cơn bực ở chỗ làm về trút lên ai trong nhà trước tiên?", "Lần gần nhất mình hẹn con lát nữa rồi quên luôn là khi nào?",), en: ("Who at home usually receives the frustration I bring back from work?", "When did I last tell my child in a minute and then forget?",))

#sec("Lỡ quát con trước mặt người khác", en: "You shouted at your child in front of others")
#boicanh("Đám giỗ bên nội, đông đủ họ hàng. Con bé Vy lớp 7 cắm mặt vào điện thoại, bác Hai hỏi hai lần không trả lời. Mẹ thấy mất mặt, quát lớn giữa bàn ăn. Vy đứng dậy bỏ ra sau nhà. Tối về, cửa phòng đóng kín.", en: "A family memorial gathering, relatives everywhere. Vy, in grade 7, is buried in her phone and does not answer when her uncle asks twice. Mum, embarrassed, scolds her loudly at the table. Vy gets up and walks out. That evening her door stays shut.")
#phanxa("Mẹ la vậy là còn nhẹ đó. Ai biểu con làm mẹ xấu hổ với cả họ.", "Mặt mũi của mẹ quan trọng hơn mình. Mình bị làm nhục mà còn phải là người có lỗi.", en: ("That was mild. You brought it on yourself by embarrassing me in front of the whole family.", "Mum's reputation matters more than I do. I was humiliated and I am still the one at fault."))
#scene("Tình huống 1.3 · Thử nói cách khác")[
  #me("(Gõ cửa.) Vy ơi, mẹ vô được không? Mẹ không vô để la tiếp đâu.", en: "(Knocks.) Vy, may I come in? I'm not here to scold you more.")
  #con("...Mẹ vô đi.", en: "...Come in.")
  #me("Mẹ xin lỗi con chuyện lúc trưa. Mẹ quát con trước mặt cả nhà. Chuyện đó mẹ sai.", en: "I am sorry about lunchtime. I shouted at you in front of everyone. That was wrong of me.")
  #con("Mẹ làm con quê muốn chết. Mấy đứa em họ nó nhìn con cười.", en: "I was so embarrassed. My cousins were looking at me and laughing.")
  #me("Mẹ mà bị vậy chắc mẹ cũng muốn độn thổ. Lúc đó mẹ thấy ngại với bác Hai nên mẹ nổi nóng, rồi mẹ trút lên con. Lẽ ra mẹ phải kéo con ra nói riêng.", en: "If that happened to me I would want to disappear too. I felt awkward in front of your uncle, I got angry, and I took it out on you. I should have taken you aside.")
  #con("Con cũng sai. Bác hỏi mà con không nghe thiệt, tại con đang nhắn dở với bạn.", en: "I was wrong too. I really didn't hear him; I was in the middle of texting a friend.")
  #me("Cảm ơn con nói ra. Vậy mình thỏa thuận: lần sau mẹ thấy chưa ổn, mẹ chạm vai con một cái, không nói gì hết. Con hiểu ý mẹ được không?", en: "Thank you for saying that. So let's agree: next time something isn't right, I'll touch your shoulder once and say nothing. Will you understand?")
  #con("Dạ được. Mà mẹ đừng chạm kiểu nhéo nha.", en: "Okay. Just don't make it a pinch.")
]
#hieusau1("Với tuổi mới lớn, thể diện trước người khác gần như là chuyện sống còn. Bị la riêng, con nghe được nội dung. Bị la trước đám đông, con chỉ còn nghe thấy nỗi nhục, và nỗi nhục thì biến rất nhanh thành oán giận. Khi ba mẹ xin lỗi về cách mình nói, ba mẹ không mất uy. Ba mẹ đang cho con xem tận mắt một người lớn nhận lỗi trông ra sao.", en: "For young teenagers, saving face in front of others feels almost like survival. Corrected in private, a child hears the content. Corrected in public, the child hears only shame, and shame turns quickly into resentment. A parent who apologises for the way they spoke loses no authority. They are showing, live, what an adult owning a mistake looks like.")
#cotloi("Nhắc con thì nhắc riêng. Còn lỡ làm con mất mặt trước người khác thì xin lỗi cho đàng hoàng, đừng kèm chữ nhưng.", en: "Correct in private. And if you have shamed your child in front of others, apologise properly, with no but attached.")
#lamngay1("Hẹn với con một ám hiệu kín cho những lúc ở chỗ đông người: một cái chạm vai, một câu vô thưởng vô phạt. Để con tự chọn ám hiệu, con sẽ nhớ hơn.", en: "Agree on a private signal for crowded places: a touch on the shoulder, a harmless phrase. Let your child choose the signal; they will remember it better.")
#caunoi("Chuyện mẹ quát con trước mặt mọi người là mẹ sai. Mẹ xin lỗi con.", en: "Shouting at you in front of everyone was my mistake. I am sorry.")
#tusoi(("Khi con làm mình mất mặt, mình đang lo cho con hay lo cho hình ảnh của mình?", "Mình đã bao giờ xin lỗi con mà không thêm vế tại con chưa?",), en: ("When my child embarrasses me, am I worried about my child or about my image?", "Have I ever apologised to my child without adding because you...?",))

#sec("Cơn giận lên tới cổ, tay đã giơ lên", en: "The anger is at your throat and your hand is raised")
#boicanh("Thằng Khoa lớp 5 nói dối là đã làm bài, cô giáo nhắn về mới lộ. Hỏi tới, nó còn cãi tay đôi. Ba giơ tay lên. Khoa co người lại, nhắm mắt. Chính cái co người đó làm ba khựng lại.", en: "Khoa, in grade 5, said his homework was done; a message from the teacher reveals it was not. Questioned, he argues back. Dad raises his hand. Khoa shrinks and shuts his eyes. That flinch is what stops Dad.")
#phanxa("Không đánh thì mày không sợ! Hồi xưa ông nội đánh ba còn dữ hơn, giờ ba mới nên người.", "Ai mạnh hơn thì người đó đúng. Lần sau phải nói dối cho khéo hơn để khỏi bị đòn.", en: ("You won't learn unless you're hit! My father beat me harder than this, and I turned out fine.", "Whoever is stronger is right. Next time I must lie more cleverly so I don't get hit."))
#scene("Tình huống 1.4 · Thử nói cách khác")[
  #ba("(Hạ tay xuống, lùi một bước.) Ba đang giận quá. Giờ mà nói tiếp là ba nói bậy, làm bậy. Ba ra ngoài mười phút. Con ngồi đây, ba quay lại rồi mình nói chuyện.", en: "(Lowers his hand, steps back.) I am too angry. If I keep talking now I will say and do the wrong thing. I'm going out for ten minutes. Stay here; when I come back we will talk.")
  #con("(Im lặng, mắt đỏ.)", en: "(Silent, eyes red.)")
  #ba("(Quay lại, kéo ghế ngồi.) Lúc nãy ba giơ tay làm con sợ. Chuyện đó ba không muốn lặp lại. Còn chuyện bài vở với chuyện nói dối thì ba vẫn phải nói, nhưng nói kiểu khác.", en: "(Returns, pulls up a chair.) I raised my hand just now and scared you. I do not want that to happen again. The homework and the lie still have to be talked about, but in a different way.")
  #con("Con tưởng ba đánh con.", en: "I thought you were going to hit me.")
  #ba("Ba suýt đánh. Ba không tự hào chuyện đó. Giờ ba hỏi thiệt, không phải hỏi để bắt lỗi: sao con nói làm rồi trong khi chưa làm?", en: "I nearly did. I am not proud of that. Now I am asking for real, not to catch you out: why did you say it was done when it wasn't?")
  #con("Tại con không biết làm. Bài phân số. Con sợ nói ra ba la con ngu.", en: "Because I don't know how to do it. Fractions. I was scared you'd call me stupid if I told you.")
  #ba("Vậy là con sợ ba hơn sợ bài. Cái đó ba phải sửa. Con lấy vở ra, mình coi bài đầu tiên. Còn với cô, sáng mai con tự nói thật với cô, ba đứng kế bên.", en: "So you are more afraid of me than of the homework. That is mine to fix. Get your notebook and we'll look at the first problem. And tomorrow morning you'll tell your teacher the truth yourself; I'll stand beside you.")
]
#hieusau1("Đòn roi dừng được hành vi ngay tức khắc, nên người lớn dễ tin là nó có tác dụng. Nhưng thứ con học được không phải là đừng nói dối, mà là đừng để bị bắt. Nhiều nghiên cứu theo dõi trẻ bị đánh cho thấy các em không ngoan hơn về lâu dài, mà dễ hung hăng, hay lo âu và giấu giếm nhiều hơn. Rời khỏi chỗ đó vài phút không phải là thua con. Đó là người lớn dùng tới cái thắng của mình.", en: "Hitting stops behaviour instantly, which is why adults believe it works. But what the child learns is not do not lie; it is do not get caught. Many long-term studies find that children who are hit do not behave better over time; they tend to be more aggressive, more anxious and more secretive. Leaving the room for a few minutes is not losing to your child. It is an adult using the brakes.")
#cotloi("Lúc tay muốn giơ lên là lúc chân phải bước ra. Dạy con để sau, khi mình đã là mình.", en: "The moment your hand wants to rise is the moment your feet should walk out. Teach later, when you are yourself again.")
#lamngay1("Nói trước với cả nhà một quy ước: khi ba hoặc mẹ nói câu ba cần mười phút thì không ai níu lại, và người nói bắt buộc phải quay lại nói chuyện tiếp trong ngày. Viết quy ước đó dán ở tủ lạnh.", en: "Tell the family a rule in advance: when Mum or Dad says I need ten minutes, nobody holds them back, and the one who said it must return to finish the conversation that same day. Write it down and stick it on the fridge.")
#caunoi("Ba đang giận quá nên ba ra ngoài một chút. Ba sẽ quay lại, mình nói chuyện đàng hoàng.", en: "I am too angry, so I am stepping out for a moment. I will come back and we will talk properly.")
#tusoi(("Dấu hiệu nào trên cơ thể báo cho mình biết sắp mất kiểm soát: nóng mặt, nghiến răng, nói lớn dần?", "Trận đòn hồi nhỏ mình nhớ nhất, mình nhớ bài học hay nhớ nỗi sợ?",), en: ("What sign in my body tells me I am about to lose control: a hot face, clenched teeth, a rising voice?", "The beating I remember best from childhood: do I remember the lesson or the fear?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 1: mang theo bên mình]
#doicau1((("Con làm mẹ tức chết đi được!", "Mẹ đang tức. Mẹ cần vài phút rồi mình nói tiếp.", "You are driving me mad!", "I am angry. I need a few minutes, then we'll continue."), ("Nín ngay! Khóc cái gì mà khóc!", "Con cứ khóc đi, mẹ ngồi đây. Khóc xong mình nói chuyện.", "Stop crying right now!", "Go ahead and cry; I'm sitting right here. We'll talk when you're done."), ("Ba nói một lần nữa là ăn đòn!", "Ba nói lần thứ hai rồi. Lần này ba sẽ tới cầm tay con dắt đi.", "One more word and you'll get a smack!", "I've said it twice. This time I'll come and take your hand and walk you there."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Giận là cảm xúc, quát và đánh là lựa chọn. Ba mẹ không chọn được chuyện có giận hay không, nhưng chọn được chín mươi giây sau đó mình làm gì.", "Thứ tự xử lý khi con gây chuyện: con có an toàn không, ba mẹ đã bình tĩnh chưa, rồi mới tới chuyện đúng sai. Đảo thứ tự là hỏng.", "Đói, thiếu ngủ và mệt làm cơn giận của người lớn tới nhanh gấp mấy lần. Chăm mình cũng là một cách chăm con.",), en: ("Anger is a feeling; shouting and hitting are choices. You cannot choose whether you get angry, but you can choose what you do in the ninety seconds after.", "The order when a child causes trouble: is my child safe, am I calm, and only then right and wrong. Reverse the order and it fails.", "Hunger, lack of sleep and exhaustion bring adult anger several times faster. Looking after yourself is also a way of looking after your child.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày, mỗi tối ghi một dòng: hôm nay lúc nào mình suýt quát, và mình đã làm gì thay vào đó. Không cần hoàn hảo. Bảy dòng là bảy lần mình kịp nhìn thấy cơn giận trước khi nó nhìn thấy con.",), mark: sym.star.filled, en: ("For seven days, write one line each night: when did I almost shout today, and what did I do instead? It need not be perfect. Seven lines are seven times you saw the anger before it saw your child.",))
