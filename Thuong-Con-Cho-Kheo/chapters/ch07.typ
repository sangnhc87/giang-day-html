#import "../template.typ": *

#chapter-open(7, "Khi nhà trường gọi điện", 7, "Giữa con và thầy cô, ba mẹ không cần chọn phe. Ba mẹ đứng về phía sự thật, và đứng cạnh con.", "Điện thoại hiện số cô chủ nhiệm, tim ba mẹ đã đập nhanh hơn. Con bị phạt, con gian lận, con hỗn với cô, hoặc con về kể cô xử ép. Lúc đó ba mẹ dễ ngả về một trong hai phía: bênh con chằm chặp, hoặc hùa với nhà trường la con thêm một trận. Cả hai đều làm hỏng việc. Chương này tìm lối thứ ba: nghe đủ hai bên, giữ thể diện cho con, và để con tự đứng ra sửa.", ("Cô giáo gọi báo con quay cóp", "Con về kể cô xử ép con", "Nhà trường mời phụ huynh vì con đánh bạn", "Cô nói con hỗn, con nói cô ghét con",), en: ("When the school calls", "Between your child and the teacher you need not pick a side. Stand on the side of the truth, and stand next to your child.", "The form teacher's number lights up and a parent's heart is already racing. Your child has been punished, has cheated, has been rude to a teacher, or comes home saying the teacher was unfair. Parents tend to lean one of two ways: defend the child fiercely, or join the school and scold the child a second time. Both spoil things. This chapter looks for a third way: hear both sides, protect your child's dignity, and let them step up to put it right.", ("The teacher calls to say your child cheated", "Your child comes home saying the teacher was unfair", "The school summons you because your child hit a classmate", "The teacher says your child is rude; your child says the teacher hates her",)))

#sec("Cô giáo gọi báo con quay cóp", en: "The teacher calls to say your child cheated")
#boicanh("Sáu giờ chiều, cô chủ nhiệm gọi: bài kiểm tra Sử, bé Hà lớp 8 bị bắt gặp mở tài liệu trong hộc bàn. Cô đã lập biên bản, cho không điểm. Hà về nhà như không có chuyện gì.", en: "At six in the evening the form teacher calls: during a history test Ha, in grade 8, was caught with notes open under her desk. A report was filed and she was given zero. Ha comes home as if nothing happened.")
#phanxa("Con làm ba mẹ nhục quá! Nhà mình trước giờ nghèo nhưng không ai gian dối. Con học cái thói đó ở đâu?", "Mình là nỗi nhục của nhà. Mình là đứa gian dối. Điều ba mẹ đau là danh dự của ba mẹ.", en: ("You have shamed us! This family may be poor but nobody has ever been dishonest. Where did you learn that?", "I am the family's shame. I am a dishonest child. What hurts my parents is their own honour."))
#scene("Tình huống 7.1 · Thử nói cách khác")[
  #me("(Chờ con ăn xong.) Hà, chiều nay cô gọi cho mẹ. Mẹ muốn nghe con kể trước, đầu đuôi theo lời con.", en: "(Waits until she has eaten.) Ha, your teacher called me this afternoon. I want to hear it from you first, start to finish, in your own words.")
  #con("(Mặt tái đi.) ...Con có mở vở. Cô bắt được.", en: "(Turns pale.) ...I opened my notebook. The teacher caught me.")
  #me("Cảm ơn con nói thật ngay, không chối. Lúc bị cô bắt, con thấy sao?", en: "Thank you for telling the truth straight away, without denying. How did you feel when she caught you?")
  #con("Con muốn chui xuống đất. Cả lớp quay lại nhìn.", en: "I wanted to sink into the floor. The whole class turned to look.")
  #me("Chắc từ lúc đó tới giờ con cũng không dễ chịu gì. Mẹ hỏi cái này không phải để tìm cớ cho con: sao hôm đó con mở vở?", en: "It can't have been easy since then either. I'm asking this not to find you an excuse: why did you open the notebook that day?")
  #con("Con không thuộc bài. Tối trước con học Toán tới khuya, không kịp học Sử. Con sợ điểm kém mẹ la.", en: "I hadn't learned the lesson. The night before I did maths until late and had no time for history. I was scared you'd scold me for a bad mark.")
  #me("Vậy là con chọn gian lận vì sợ điểm kém hơn sợ gian lận. Mẹ phải coi lại cách mẹ phản ứng với điểm. Còn phần con, mẹ nói rõ: không điểm là xứng đáng, mẹ không xin cô. Một con điểm kém thật thà đáng giá hơn mười con điểm chín mượn.", en: "So you chose to cheat because you feared a bad mark more than you feared cheating. I need to look at how I react to marks. As for your part, let me be clear: the zero is deserved and I will not ask the teacher to change it. One honest bad mark is worth more than ten borrowed nines.")
  #con("Con biết rồi mẹ.", en: "I know, Mum.")
  #me("Theo con, mai con nên làm gì với cô?", en: "What do you think you should do with your teacher tomorrow?")
  #con("Con xin lỗi cô. Với con xin cô cho kiểm tra lại, điểm nào cũng được.", en: "Apologise. And ask if I can retake the test, whatever mark I get.")
  #me("Con tự nghĩ ra thì con tự làm nha. Mẹ tin con làm được.", en: "You thought of it yourself, so you do it yourself. I trust you can.")
]
#hieusau1("Phần lớn học sinh gian lận không phải vì coi thường sự trung thực. Các em gian lận khi áp lực phải có điểm lớn hơn niềm tin rằng mình tự làm được. Hậu quả từ nhà trường là cần thiết và ba mẹ không nên xin xỏ. Nhưng thêm một trận sỉ nhục ở nhà chỉ dạy con gian lận kín hơn. Câu hỏi sao hôm đó con mở vở dẫn tới gốc rễ, và để con tự đề xuất cách sửa cho con cơ hội lấy lại lòng tự trọng bằng hành động.", en: "Most students who cheat do not despise honesty. They cheat when the pressure to have a mark is greater than their belief that they can manage alone. Consequences from the school are necessary and parents should not plead for leniency. But another round of humiliation at home only teaches a child to cheat more discreetly. Why did you open the notebook that day leads to the root, and letting the child propose the repair lets them win back self-respect through action.")
#cotloi("Đừng xin giảm hậu quả cho con, và cũng đừng chất thêm sự sỉ nhục. Hậu quả dạy con trách nhiệm. Sỉ nhục chỉ dạy con che giấu.", en: "Do not ask for the consequence to be reduced, and do not add humiliation. Consequences teach responsibility. Humiliation only teaches concealment.")
#lamngay1("Nói với con câu này vào một lúc bình thường, khi chưa có chuyện gì: Ba mẹ thà nhận một con điểm ba thật còn hơn một con điểm chín giả. Rồi chứng minh bằng phản ứng của mình ở lần điểm kém kế tiếp.", en: "Say this at an ordinary time, before anything has happened: We would rather receive an honest three than a fake nine. Then prove it by how you react to the next bad mark.")
#caunoi("Một con điểm kém thật thà quý hơn mười con điểm chín mượn.", en: "One honest bad mark is worth more than ten borrowed nines.")
#tusoi(("Áp lực điểm số trong nhà mình có lớn tới mức con thấy gian lận là lối thoát không?", "Bản thân mình có gian lận những việc nhỏ trước mặt con không: khai gian tuổi con để khỏi mua vé, vượt đèn đỏ khi vắng?",), en: ("Is the pressure for marks at home strong enough that cheating looks like a way out?", "Do I cheat in small ways in front of my child: lying about their age to avoid a ticket, running a red light when the road is empty?",))

#sec("Con về kể cô xử ép con", en: "Your child comes home saying the teacher was unfair")
#boicanh("Thằng Phong lớp 7 về nhà mặt đỏ gay: cô phạt con đứng cuối lớp cả tiết mà con có làm gì đâu! Thằng Đức ngồi sau chọc con trước, con quay xuống thì cô chỉ thấy con.", en: "Phong, in grade 7, comes home red in the face: the teacher made me stand at the back for the whole lesson and I didn't do anything! Duc behind me poked me first, I turned around, and she only saw me.")
#phanxa("Kiểu một: Cô phạt là đúng, thầy cô không bao giờ sai, con phải có lỗi cô mới phạt. Kiểu hai: Cô giáo gì kỳ vậy, để mai mẹ lên làm cho ra lẽ!", "Kiểu một: ba mẹ không bao giờ tin mình. Kiểu hai: cứ có chuyện là mẹ lên trường lo, mình khỏi phải tự xử lý gì.", en: ("Version one: If the teacher punished you she was right; teachers are never wrong; you must have done something. Version two: What kind of teacher is that? Tomorrow I'm going in to sort this out!", "Version one: my parents never believe me. Version two: whenever something happens Mum goes to school, so I never need to handle anything myself."))
#scene("Tình huống 7.2 · Thử nói cách khác")[
  #ba("Đứng cả tiết mà thấy mình bị oan thì ức lắm. Kể ba nghe từ đầu, chậm chậm.", en: "Standing a whole lesson when you feel wronged is infuriating. Tell me from the beginning, slowly.")
  #con("Thằng Đức lấy bút chọc lưng con ba lần. Lần thứ ba con quay xuống nói nó ngưng đi. Đúng lúc cô nhìn. Cô nói con mất trật tự rồi bắt đứng luôn, không cho con giải thích.", en: "Duc poked my back with a pen three times. The third time I turned and told him to stop. Right then she looked. She said I was disrupting the class and made me stand, and wouldn't let me explain.")
  #ba("Không được giải thích, cái đó khó chịu nhất. Ba tin lời con kể. Ba cũng nghĩ thêm: từ chỗ cô đứng, cô thấy được cái gì?", en: "Not being allowed to explain is the worst part. I believe your account. I'm also wondering: from where she stood, what could she see?")
  #con("...Cô chỉ thấy con quay xuống nói chuyện.", en: "...She only saw me turned around talking.")
  #ba("Ừ. Vậy cô phạt theo cái cô thấy. Cô thiếu một nửa câu chuyện chứ chưa chắc cô ghét con. Giờ con muốn chuyện này kết thúc ra sao?", en: "Yes. So she punished what she saw. She was missing half the story; that doesn't mean she dislikes you. How would you like this to end?")
  #con("Con muốn cô biết là con không tự nhiên mất trật tự.", en: "I want her to know I wasn't being disruptive for no reason.")
  #ba("Hợp lý. Con nghĩ nói với cô lúc nào, nói sao thì cô nghe?", en: "That's fair. When and how do you think she would listen?")
  #con("Chắc cuối giờ, lúc cô không bận. Con nói: thưa cô, hôm qua con quay xuống vì bạn chọc con, lần sau con sẽ giơ tay báo cô thay vì quay xuống.", en: "Probably after class, when she isn't busy. I'd say: Miss, yesterday I turned around because my classmate was poking me. Next time I'll raise my hand and tell you instead.")
  #ba("Câu đó hay, vừa nói được phần oan vừa nhận phần mình làm chưa khéo. Con tự nói trước. Nếu con nói rồi mà vẫn không ổn thì ba mới gặp cô.", en: "That's a good sentence; it covers what was unfair and owns what you could have done better. You speak to her first. If you've done that and it's still not right, then I'll meet her.")
]
#hieusau1("Khi con kể chuyện bị oan ở trường, ba mẹ chỉ có một nửa câu chuyện, và cô giáo cũng vậy. Phán ngay cô đúng làm con mất chỗ dựa. Phán ngay cô sai làm con mất sự tôn trọng với người dạy mình, và mất luôn cơ hội tập tự lên tiếng. Tin cảm xúc của con, rồi giúp con nhìn từ chỗ đứng của cô, và để con tự đi nói là bài tập quý: con học cách bảo vệ mình một cách lễ độ. Ba mẹ chỉ nên vào cuộc trực tiếp khi con đã thử mà không được, hoặc khi sự việc nghiêm trọng như xúc phạm, bạo lực.", en: "When a child reports being wronged at school, the parent holds half the story, and so does the teacher. Declaring the teacher right leaves the child without support. Declaring the teacher wrong costs the child respect for the person teaching them and the chance to practise speaking up. Believing the child's feelings, then helping them see from the teacher's position, then letting them go and speak, is valuable practice in defending oneself politely. Step in directly only when the child has tried and failed, or when the matter is serious, such as insults or violence.")
#cotloi("Tin cảm xúc của con, nhưng đừng vội kết luận thay tòa. Dạy con tự lên tiếng một cách lễ độ thì có ích hơn là lên tiếng giùm con.", en: "Believe your child's feelings, but do not hurry to give the verdict. Teaching a child to speak up politely serves them better than speaking for them.")
#lamngay1("Lần tới con than phiền về thầy cô, hỏi ba câu theo thứ tự: Chuyện gì đã xảy ra? Từ chỗ cô đứng, cô thấy gì? Con muốn chuyện này kết thúc ra sao? Rồi cùng con tập trước câu sẽ nói.", en: "Next time your child complains about a teacher, ask three questions in order: What happened? From where the teacher stood, what did she see? How would you like this to end? Then rehearse together what they will say.")
#caunoi("Ba tin con. Giờ mình thử nhìn từ chỗ cô đứng coi cô thấy được cái gì.", en: "I believe you. Now let's look from where the teacher stood and see what she could see.")
#tusoi(("Mình thuộc kiểu luôn bênh thầy cô hay luôn bênh con? Kiểu đó tới từ đâu?", "Con mình có biết cách tự trình bày khi bị hiểu lầm không, hay luôn chờ ba mẹ can thiệp?",), en: ("Am I the type who always sides with teachers, or always with my child? Where does that come from?", "Can my child explain themselves when misunderstood, or do they always wait for us to step in?",))

#sec("Nhà trường mời phụ huynh vì con đánh bạn", en: "The school summons you because your child hit a classmate")
#boicanh("Thầy giám thị gọi: thằng Kiệt lớp 9 đấm một bạn chảy máu mũi trong giờ ra chơi. Mời phụ huynh ngày mai. Ba chạy xe về mà tay run vì giận. Kiệt ngồi sẵn ở phòng khách, mặt lì.", en: "The discipline master calls: Kiet, in grade 9, punched a boy at break and made his nose bleed. Parents are to come in tomorrow. Dad rides home with shaking hands. Kiet is already sitting in the living room, face set hard.")
#phanxa("Ba cho mày đi học để mày đi đánh người hả? Mai lên trường quỳ xuống xin lỗi người ta! Thứ côn đồ!", "Ba không cần biết vì sao. Mình là côn đồ. Trên đời không ai đứng về phía mình.", en: ("Did I send you to school to hit people? Tomorrow you will kneel and apologise! Thug!", "Dad doesn't care why. I am a thug. Nobody in the world is on my side."))
#scene("Tình huống 7.3 · Thử nói cách khác")[
  #ba("(Ngồi xuống đối diện, thở ra.) Ba nghe thầy báo rồi. Ba đang giận, ba không giấu. Nhưng ba chưa nghe con. Chuyện gì đã xảy ra?", en: "(Sits down opposite, breathes out.) I've heard from the school. I am angry; I won't hide it. But I haven't heard you yet. What happened?")
  #con("Con đấm nó. Vậy thôi. Ba la đi.", en: "I punched him. That's all. Go on, shout.")
  #ba("Ba không la. Ba biết con mười bốn năm nay, con không phải đứa tự nhiên đi đấm người. Phải có chuyện gì đó.", en: "I'm not going to shout. I've known you for fourteen years; you are not a boy who punches people for nothing. Something must have happened.")
  #con("(Im lâu, giọng nghẹn.) Nó đem chuyện mẹ bỏ đi ra nói. Trước mặt cả đám. Nó nói mẹ con theo trai.", en: "(A long silence, voice thick.) He brought up Mum leaving. In front of everyone. He said my mum ran off with a man.")
  #ba("...Ba hiểu rồi. Nghe câu đó thì ba cũng sôi máu. Con đau chỗ đó, ba biết, vì ba cũng đau chỗ đó.", en: "...I understand now. Hearing that would make my blood boil too. It hurts you there, I know, because it hurts me there too.")
  #con("Con chịu hết nổi ba ơi. Nó nói cả tuần rồi.", en: "I couldn't take any more, Dad. He's been saying it all week.")
  #ba("Cả tuần mà con ráng nhịn một mình. Ba ước gì con nói ba sớm. Nghe ba nói hai chuyện, cả hai đều thật. Một: nó sai, nó xúc phạm nhà mình, mai ba sẽ nói rõ chuyện đó với thầy, chuyện đó phải được xử lý. Hai: cú đấm vẫn là của con, và bạn chảy máu thiệt. Phần đó con phải nhận.", en: "A whole week and you bore it alone. I wish you had told me sooner. Listen to two things, both true. One: he was wrong, he insulted our family, and tomorrow I will say so clearly to the school; that has to be dealt with. Two: the punch was still yours, and he really bled. That part you must own.")
  #con("Con nhận. Con xin lỗi vụ đánh. Nhưng con không xin lỗi vì con tức.", en: "I own it. I'm sorry for hitting him. But I'm not sorry for being angry.")
  #ba("Đúng. Tức thì không sai, đánh mới sai. Mai con nói y vậy. Ba ngồi kế bên.", en: "Right. Being angry is not wrong; hitting is. Tomorrow say it exactly like that. I'll be sitting next to you.")
]
#hieusau1("Hành vi bạo lực của một đứa trẻ vốn không hung hăng gần như luôn có một ngòi nổ, thường là bị chạm vào chỗ đau nhất. Hỏi chuyện gì đã xảy ra trước khi phán xét không phải là dung túng, mà là tìm cho đủ sự thật. Con cần nghe hai điều cùng lúc: cảm xúc của con chính đáng, và hành động của con có hậu quả con phải chịu. Thiếu vế đầu con thấy bị bỏ rơi. Thiếu vế sau con học rằng cứ đau là được phép đánh.", en: "Violence from a child who is not usually aggressive almost always has a trigger, often being struck where it hurts most. Asking what happened before judging is not indulgence; it is looking for the whole truth. The child needs to hear two things together: your feeling is legitimate, and your action has consequences you must bear. Without the first the child feels abandoned. Without the second the child learns that pain is a licence to hit.")
#cotloi("Cảm xúc nào cũng được phép có. Không phải hành động nào cũng được phép làm. Con cần nghe cả hai vế đó từ ba mẹ.", en: "Every feeling is allowed. Not every action is. Your child needs to hear both halves from you.")
#lamngay1("Dạy con một câu thoát hiểm để dùng khi bị khiêu khích tới giới hạn: Tao không nói chuyện này. Rồi quay lưng đi tìm một người lớn. Tập với con như tập võ, nói thành tiếng vài lần.", en: "Teach your child an exit line for when they are provoked to the limit: I'm not discussing this. Then turn and find an adult. Practise it like a martial arts drill, aloud, several times.")
#caunoi("Con tức là không sai. Đánh bạn mới là sai. Phần sai đó mình cùng đi sửa.", en: "Being angry is not wrong. Hitting is. That part we will go and repair together.")
#tusoi(("Khi nghe tin con gây chuyện, câu đầu tiên bật ra trong đầu mình là con có sao không, vì sao con làm vậy, hay mặt mũi mình để đâu?", "Con mình có đang phải nhịn một mình chuyện gì đó ở trường mà mình chưa biết không?",), en: ("When I hear my child has caused trouble, what is my first thought: are they all right, why did they do it, or what will people think of me?", "Is my child silently putting up with something at school that I do not know about?",))

#sec("Cô nói con hỗn, con nói cô ghét con", en: "The teacher says your child is rude; your child says the teacher hates her")
#boicanh("Cô dạy Văn nhắn cho mẹ: em Trang lớp 10 trả lời trống không, liếc xéo, cô nhắc thì bỏ ra khỏi lớp. Hỏi Trang, nó nói: bả ghét con từ đầu năm, con làm gì bả cũng bắt bẻ.", en: "The literature teacher messages Mum: Trang, in grade 10, answers curtly, gives sideways looks, and walked out when corrected. Asked about it, Trang says: that woman has hated me since the start of the year; whatever I do she picks at.")
#phanxa("Con ăn nói với cô vậy đó hả? Ai dạy con gọi cô là bả? Con hỗn với cô là hỗn với mẹ!", "Mẹ chỉ nghe chữ bả, không nghe chuyện của mình. Lại thêm một người lớn nữa không chịu nghe.", en: ("Is that how you speak about your teacher? Who taught you to call her that woman? Being rude to her is being rude to me!", "Mum only heard that woman; she didn't hear what happened to me. One more adult who won't listen."))
#scene("Tình huống 7.4 · Thử nói cách khác")[
  #me("Mẹ nghe con nói cô ghét con từ đầu năm. Chắc là có chuyện gì đó làm con thấy vậy. Kể mẹ nghe chuyện đầu tiên con nhớ.", en: "I hear you say she has disliked you since the start of the year. Something must have made you feel that. Tell me the first thing you remember.")
  #con("Tuần thứ hai, cô đọc bài văn của con trước lớp làm ví dụ bài lạc đề. Cả lớp cười. Từ đó tiết cô con không muốn nói gì nữa.", en: "In the second week she read my essay to the class as an example of going off topic. Everyone laughed. Since then I haven't wanted to say anything in her lessons.")
  #me("Bị đọc bài trước lớp kiểu đó thì quê lắm. Mẹ hiểu vì sao con khép lại. Rồi hôm qua thì sao?", en: "Having your essay read out like that is really humiliating. I see why you closed up. And yesterday?")
  #con("Cô hỏi con sao không ghi bài. Con nói con ghi rồi. Cô nói thái độ gì đó. Con tức quá nên đi ra.", en: "She asked why I wasn't taking notes. I said I had. She said what attitude is that. I got so angry I walked out.")
  #me("Mẹ hỏi thêm một câu, không phải để bắt lỗi: lúc con trả lời cô, giọng con với ánh mắt con ra sao?", en: "One more question, not to catch you out: when you answered her, what were your voice and your eyes like?")
  #con("...Chắc cũng hơi khó ưa. Con liếc.", en: "...Probably not very nice. I gave her a look.")
  #me("Ừ. Vậy là có hai lớp chuyện. Lớp cũ: cô làm con quê, con chưa hết đau. Lớp mới: con đáp lại bằng thái độ, cô thấy bị coi thường. Hai người cứ vậy đẩy nhau ra. Một trong hai phải dừng trước.", en: "Yes. So there are two layers. The old one: she embarrassed you and it still hurts. The new one: you answer with attitude and she feels disrespected. The two of you keep pushing each other away. One of you has to stop first.")
  #con("Sao không phải là cô?", en: "Why can't it be her?")
  #me("Tại cô không biết chuyện bài văn làm con đau cỡ nào. Con mà không nói, cô sẽ không bao giờ biết. Mẹ không ép. Nhưng con nghĩ thử: con muốn hai năm nữa mỗi tiết Văn là một trận chiến, hay muốn thử nói với cô một lần?", en: "Because she doesn't know how much that essay hurt you. If you don't tell her, she never will. I won't force you. But think: do you want every literature lesson for the next two years to be a battle, or would you try telling her once?")
  #con("...Để con nghĩ. Mà chuyện con bỏ ra khỏi lớp thì con sai, con biết.", en: "...Let me think. But walking out of class was wrong, I know.")
  #me("Chuyện đó thì con xin lỗi cô trước, không cần chờ nghĩ xong chuyện kia. Và trong nhà mình, mẹ xin con một điều: gọi là cô.", en: "For that, apologise to her first; it needn't wait until you've thought through the rest. And at home I ask one thing: call her your teacher.")
]
#hieusau1("Xung đột kéo dài giữa học sinh và giáo viên thường bắt đầu từ một lần tổn thương nhỏ không được nói ra, sau đó hai bên diễn giải mọi hành vi của nhau theo hướng xấu nhất. Nếu ba mẹ chỉ bắt lỗi cách con xưng hô, cuộc trò chuyện chết ngay ở câu đầu. Nghe hết câu chuyện gốc trước, rồi mới giúp con thấy phần mình góp vào, và cuối cùng mới đặt lại ranh giới về sự lễ độ thì con nghe được cả ba.", en: "Long conflicts between a student and a teacher often begin with a small hurt that was never spoken, after which each reads everything the other does in the worst light. If parents only correct the way the child refers to the teacher, the conversation dies at the first line. Hear the original story first, then help the child see their own contribution, and only then restate the boundary about courtesy; that way the child can take in all three.")
#cotloi("Nghe trước, giới hạn sau. Đứa trẻ đã được nghe hết sẽ dễ nhận phần sai của mình hơn nhiều.", en: "Listen first, limits after. A child who has been fully heard finds it much easier to admit their own part.")
#lamngay1("Nếu con đang có khúc mắc với một thầy cô, giúp con viết ra ba dòng: chuyện gì làm con buồn, con mong điều gì, phần nào con sẽ làm khác. Con có thể đưa cho cô hoặc chỉ giữ cho mình. Viết ra đã là gỡ được một nửa.", en: "If your child has a grievance with a teacher, help them write three lines: what upset me, what I hope for, what I will do differently. They may give it to the teacher or keep it. Writing it down is already half the untangling.")
#caunoi("Mẹ nghe chuyện của con trước. Rồi mình nói tới cách con trả lời cô sau.", en: "I'll hear your side first. Then we'll talk about how you answered your teacher.")
#tusoi(("Khi con nói xấu thầy cô, mình phản ứng với thái độ của con trước hay với nỗi đau của con trước?", "Lần gần nhất mình trao đổi với giáo viên của con không phải vì có sự cố là khi nào?",), en: ("When my child speaks badly of a teacher, do I respond to the attitude first or the hurt first?", "When did I last speak with my child's teacher when there was no incident?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 7: mang theo bên mình]
#doicau1((("Con làm ba mẹ xấu hổ với nhà trường.", "Chuyện này mình sửa được. Con tính làm gì trước?", "You have embarrassed us in front of the school.", "This can be put right. What will you do first?"), ("Thầy cô phạt là đúng, không được cãi.", "Ba tin con thấy oan. Mình tìm cách nói cho cô hiểu một cách lễ độ.", "If the teacher punished you she was right; no arguing.", "I believe it felt unfair. Let's find a polite way to help her understand."), ("Để mai mẹ lên trường làm cho ra lẽ.", "Con thử tự nói với cô trước. Không ổn thì mẹ đi cùng con.", "Tomorrow I'm going to that school to sort this out.", "Try speaking to her yourself first. If that doesn't work, I'll come with you."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Khi nhà trường gọi, nghe hết, cảm ơn, và nói: tôi sẽ nói chuyện với cháu rồi trao đổi lại với cô. Đừng hứa hình phạt ngay trong cuộc gọi.", "Không bao giờ la con, đánh con trước mặt thầy cô và bạn bè trong buổi làm việc ở trường. Con cần thấy ba mẹ nghiêm túc và vẫn ngồi về phía ghế của con.", "Ba mẹ cần trực tiếp can thiệp ngay, không chờ con tự xử, khi có dấu hiệu con bị xúc phạm thân thể, bị làm nhục kéo dài, hoặc bị xâm hại. Ghi lại sự việc, gặp ban giám hiệu, và có thể gọi 111.",), en: ("When the school calls, hear it all, say thank you, and say: I will talk with my child and get back to you. Do not promise a punishment during the call.", "Never scold or hit your child in front of teachers and classmates at a school meeting. Your child needs to see you serious and still sitting on their side of the table.", "Step in directly at once, without waiting for your child to handle it, if there are signs of physical abuse, prolonged humiliation or sexual harm. Record the facts, meet the school leadership, and you may call 111.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày, mỗi tối hỏi con một câu về một thầy cô khác nhau: thầy cô nào dạy con thấy dễ hiểu nhất, vì sao? Nghe để biết con học được với kiểu người nào, và để con quen nhìn thầy cô như những con người.",), mark: sym.star.filled, en: ("For seven days, ask each evening about a different teacher: which teacher explains things most clearly for you, and why? Listen to learn what kind of person your child learns well with, and to help them see teachers as human beings.",))
