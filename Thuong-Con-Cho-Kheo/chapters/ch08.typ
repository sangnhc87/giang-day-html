#import "../template.typ": *

#chapter-open(8, "Khi con bị bắt nạt, bị ra rìa", 8, "Đứa trẻ bị bắt nạt hiếm khi nói con bị bắt nạt. Nó nói con đau bụng, con không muốn đi học.", "Phần lớn trẻ bị bắt nạt không kể với ba mẹ. Các em sợ bị cho là yếu, sợ ba mẹ làm lớn chuyện khiến mình bị trả đũa, hoặc đã tin luôn rằng mình đáng bị như vậy. Ba mẹ thường chỉ thấy dấu vết: cái áo rách, hộp bút mất, những cơn đau bụng sáng thứ hai. Chương này bàn cách nhận ra, cách hỏi để con dám nói, và cách bảo vệ con mà không làm con khổ thêm.", ("Con không muốn đi học, sáng nào cũng đau bụng", "Ba muốn dạy con đánh lại", "Con bị cả nhóm tẩy chay trên mạng", "Con không có bạn",), en: ("When your child is bullied or left out", "A bullied child rarely says I am being bullied. They say my tummy hurts, I don't want to go to school.", "Most bullied children do not tell their parents. They fear being seen as weak, fear that parents will make a scene and bring revenge, or have come to believe they deserve it. Parents usually see only traces: a torn shirt, a missing pencil case, stomach aches every Monday morning. This chapter is about noticing, asking in a way that lets a child speak, and protecting them without making things worse.", ("Your child does not want to go to school and has a stomach ache every morning", "Dad wants to teach his son to hit back", "Your child is shut out and mocked online", "Your child has no friends",)))

#sec("Con không muốn đi học, sáng nào cũng đau bụng", en: "Your child does not want to go to school and has a stomach ache every morning")
#boicanh("Ba tuần nay, cứ sáng thứ hai là bé Bông lớp 4 ôm bụng. Đi khám bác sĩ nói không sao. Hộp bút mới mua mất hai lần. Tối chủ nhật con hay khóc vô cớ.", en: "For three weeks, every Monday morning, Bong, in grade 4, has clutched her tummy. The doctor finds nothing. A new pencil case has gone missing twice. On Sunday evenings she cries for no clear reason.")
#phanxa("Con giả bộ để trốn học phải không? Bác sĩ nói không bệnh gì hết. Dậy đi học!", "Mình nói đau mà ba mẹ không tin. Chuyện thật còn khó nói hơn, chắc ba mẹ cũng không tin luôn.", en: ("Are you pretending so you can skip school? The doctor says nothing is wrong. Get up and go!", "I say it hurts and they don't believe me. The real thing is even harder to say; they probably won't believe that either."))
#scene("Tình huống 8.1 · Thử nói cách khác")[
  #me("(Tối thứ bảy, lúc nằm cạnh con.) Bông ơi, mẹ để ý mấy tuần nay sáng thứ hai con hay đau bụng. Mẹ tin là con đau thiệt.", en: "(Saturday night, lying beside her.) Bong, I've noticed that for a few weeks your tummy has hurt on Monday mornings. I believe it really hurts.")
  #con("Con đau thiệt mà mẹ.", en: "It really does, Mum.")
  #me("Ừ. Mẹ đọc sách thấy nói có khi cái bụng nó đau thay cho cái lòng. Lúc mình sợ hay buồn chuyện gì đó mà chưa nói ra được, cái bụng nó nói giùm. Ở trường có chuyện gì làm con sợ không?", en: "Yes. I read that sometimes the tummy hurts on behalf of the heart. When we are scared or sad about something we can't yet say, the tummy says it for us. Is anything at school scaring you?")
  #con("(Im lặng, quay mặt vô tường.)", en: "(Silent, turns to face the wall.)")
  #me("Con chưa muốn nói cũng được. Mẹ chỉ muốn con biết: chuyện gì xảy ra ở trường cũng không phải lỗi của con, và mẹ sẽ không la con, không làm gì mà chưa hỏi ý con.", en: "You don't have to tell me yet. I just want you to know: whatever happens at school is not your fault, and I will not scold you, and I won't do anything without asking you first.")
  #con("(Rất nhỏ.) Bạn Thy với mấy bạn không cho con chơi chung. Tụi nó giấu hộp bút của con. Tụi nó kêu con là đồ ở dơ.", en: "(Very quietly.) Thy and the others won't let me play with them. They hide my pencil case. They call me dirty.")
  #me("(Ôm con.) Cảm ơn con nói cho mẹ nghe. Con chịu chuyện đó một mình ba tuần nay. Con can đảm lắm. Con không ở dơ, và con không làm gì sai hết.", en: "(Holds her.) Thank you for telling me. You have carried this alone for three weeks. You are very brave. You are not dirty, and you did nothing wrong.")
  #con("Mẹ đừng nói với cô nha. Tụi nó biết con mách là tụi nó ghét con thêm.", en: "Don't tell the teacher. If they know I told, they'll hate me more.")
  #me("Mẹ hiểu con sợ gì. Mẹ hứa mẹ sẽ không làm gì sau lưng con. Mai hai mẹ con mình cùng nghĩ coi nói với cô cách nào để con được an toàn. Tối nay con ngủ với mẹ.", en: "I understand what you're afraid of. I promise I won't do anything behind your back. Tomorrow we'll think together about how to tell the teacher in a way that keeps you safe. Tonight you sleep with me.")
]
#hieusau1("Ở trẻ nhỏ, căng thẳng kéo dài rất hay biến thành triệu chứng cơ thể có thật: đau bụng, nhức đầu, buồn nôn, nhất là vào buổi sáng ngày đi học. Con không giả vờ. Trẻ bị bắt nạt im lặng vì hai nỗi sợ: không được tin và bị trả đũa. Vì vậy hai lời hứa mở được cửa là mẹ tin con và mẹ không làm gì khi chưa hỏi con. Câu đầu tiên con cần nghe sau khi kể là đó không phải lỗi của con, vì kẻ bắt nạt đã làm con tin điều ngược lại.", en: "In young children, prolonged stress very often becomes real physical symptoms: stomach aches, headaches, nausea, especially on school mornings. The child is not faking. Bullied children stay silent because of two fears: not being believed and being punished for telling. So the two promises that open the door are I believe you and I won't act without asking you. The first thing a child needs to hear after telling is it is not your fault, because the bully has convinced them of the opposite.")
#cotloi("Khi cái bụng đau mà bác sĩ nói không sao, hãy hỏi thăm cái lòng. Và trước khi hỏi, hứa với con hai điều: mẹ tin, và mẹ không làm gì sau lưng con.", en: "When the tummy hurts and the doctor finds nothing, ask after the heart. And before asking, promise two things: I believe you, and I will do nothing behind your back.")
#lamngay1("Rà lại bốn dấu hiệu trong tháng qua: con sợ đi học vào ngày cụ thể, đồ đạc hay mất hoặc hư, con xin thêm tiền không rõ lý do, con thay đổi giấc ngủ và ăn uống. Có từ hai dấu hiệu, tìm một lúc yên tĩnh để hỏi nhẹ.", en: "Check four signs over the past month: fear of school on particular days, belongings often lost or damaged, asking for extra money without a clear reason, changes in sleep and eating. With two or more, find a quiet moment to ask gently.")
#caunoi("Chuyện gì xảy ra ở trường cũng không phải lỗi của con. Mẹ tin con.", en: "Whatever happens at school is not your fault. I believe you.")
#tusoi(("Nếu con bị bắt nạt, con sẽ kể với ai đầu tiên? Mình có trong danh sách đó không?", "Mình đã bao giờ gạt đi một lời than đau của con vì nghĩ con làm biếng chưa?",), en: ("If my child were bullied, who would they tell first? Am I on that list?", "Have I ever brushed off my child's complaint of pain as laziness?",))

#sec("Ba muốn dạy con đánh lại", en: "Dad wants to teach his son to hit back")
#boicanh("Thằng Tí lớp 6, nhỏ con nhất lớp, về nhà với cái áo đứt nút. Ba gặng mãi nó mới nói: hai đứa lớp trên chặn nó ở cầu thang, xô vô tường, lấy tiền ăn sáng. Lần thứ ba rồi. Ba nghe mà nóng mặt.", en: "Ti, in grade 6 and the smallest in his class, comes home with a button torn off. After much coaxing he says two older boys stopped him on the stairs, shoved him against the wall and took his breakfast money. The third time. Dad's face burns.")
#phanxa("Con trai gì mà hèn vậy? Nó đánh thì đánh lại cho ba! Mai nó đụng tới con cứ đấm thẳng mặt, có gì ba chịu!", "Mình bị đánh, giờ còn bị ba chê hèn. Mình không dám đánh lại, vậy mình vừa là nạn nhân vừa là đứa làm ba xấu hổ.", en: ("What kind of boy is such a coward? If they hit you, hit back! Tomorrow if they touch you, punch them in the face; I'll answer for it!", "I was beaten and now Dad calls me a coward. I daren't hit back, so I am both the victim and the one who shames him."))
#scene("Tình huống 8.2 · Thử nói cách khác")[
  #ba("(Kìm lại, ngồi xuống.) Ba lần rồi mà giờ ba mới biết. Hai đứa lớn hơn chặn một mình con. Con sợ không?", en: "(Holds himself back, sits down.) Three times and I'm only hearing now. Two bigger boys against you alone. Were you scared?")
  #con("Sợ. Con đưa tiền cho xong.", en: "Yes. I gave them the money to get it over with.")
  #ba("Một chọi hai mà tụi nó lớn hơn, đưa tiền để không bị đánh là con tính đúng, không phải hèn. Tiền thì kiếm lại được.", en: "One against two, both bigger: giving the money so you wouldn't be beaten was good judgement, not cowardice. Money can be earned again.")
  #con("Ba không giận con hả?", en: "You're not angry with me?")
  #ba("Ba giận tụi kia, không giận con. Và ba giận là giờ ba mới biết. Sao con không nói ba từ lần đầu?", en: "I'm angry with them, not you. And angry that I'm only finding out now. Why didn't you tell me the first time?")
  #con("Con sợ ba nói con yếu. Với tụi nó dọa nếu mách thì đánh nặng hơn.", en: "I was scared you'd say I'm weak. And they said if I told, they'd hit me harder.")
  #ba("Tụi nó dọa vậy vì tụi nó sợ nhất là người lớn biết. Chuyện này vượt quá sức một đứa lớp 6 tự lo, nên giờ là việc của người lớn. Mai ba lên gặp thầy hiệu phó, ba sẽ đề nghị thầy xử lý mà không nêu là con mách: có camera cầu thang, có giám thị.", en: "They threaten that because what they fear most is adults knowing. This is more than a grade 6 boy can handle alone, so now it's the adults' job. Tomorrow I'll see the deputy head and ask him to deal with it without naming you: there's a camera on the stairs, and there are supervisors.")
  #con("Lỡ tụi nó vẫn chặn con thì sao?", en: "What if they still stop me?")
  #ba("Trong lúc chờ nhà trường làm, mình có ba chiêu. Giờ ra chơi con luôn đi với ít nhất một bạn. Tránh cầu thang đó, đi cầu thang gần phòng giám thị. Và nếu bị chặn, con la thật to: bỏ tao ra, rồi chạy về phía có người lớn. Giờ đứng dậy, la thử cho ba nghe coi.", en: "While the school acts, we have three moves. At break you always walk with at least one friend. Avoid that staircase; use the one near the supervisors' room. And if they stop you, shout very loudly: let go of me, then run towards an adult. Stand up and shout it for me now.")
]
#hieusau1("Lời khuyên đánh lại nghe có vẻ dạy con mạnh mẽ, nhưng với một đứa trẻ yếu thế hơn về số lượng và vóc dáng, nó vừa nguy hiểm vừa chất thêm sự xấu hổ. Bắt nạt là sự chênh lệch sức mạnh có chủ ý, nên trẻ hiếm khi tự mình chấm dứt được. Cần người lớn vào cuộc. Điều ba mẹ cho con được là các chiến thuật an toàn có thể tập trước: đi cùng bạn, tránh điểm khuất, nói to và rời đi. Tập thành tiếng ở nhà giúp cơ thể con nhớ để làm được khi đang sợ.", en: "Hit back sounds like teaching strength, but for a child outnumbered and outsized it is both dangerous and one more load of shame. Bullying is a deliberate imbalance of power, so children can rarely end it alone. Adults must step in. What parents can give are safety tactics that can be rehearsed: stay with a friend, avoid hidden spots, speak loudly and leave. Practising aloud at home helps the body remember what to do when frightened.")
#cotloi("Con đưa tiền để khỏi bị đánh là khôn, không phải hèn. Bắt nạt là việc người lớn phải vào cuộc, không phải bài kiểm tra bản lĩnh của đứa trẻ.", en: "Handing over money to avoid a beating is smart, not cowardly. Bullying is a job for adults, not a test of a child's courage.")
#lamngay1("Tập với con ba câu nói to, đứng thẳng, nhìn thẳng: Dừng lại. Tao không thích. Bỏ tao ra. Mỗi câu nói ba lần cho tới khi con nói được bằng giọng chắc. Sau đó hỏi con: ở trường, người lớn nào con dễ tìm tới nhất?", en: "Practise three lines with your child, standing straight, eyes forward, voice loud: Stop. I don't like that. Let go of me. Three times each until the voice is steady. Then ask: which adult at school is easiest for you to reach?")
#caunoi("Con không hèn. Chuyện này vượt quá sức một mình con, nên giờ là việc của ba.", en: "You are not a coward. This is too much for you alone, so now it is my job.")
#tusoi(("Mình đang muốn con đánh lại vì đó là cách tốt nhất cho con, hay vì mình thấy mất mặt?", "Mình có biết quy trình xử lý bắt nạt ở trường con, và nên gặp ai trước không?",), en: ("Do I want my child to hit back because it is best for them, or because I feel ashamed?", "Do I know my child's school's procedure for bullying and whom to see first?",))

#sec("Con bị cả nhóm tẩy chay trên mạng", en: "Your child is shut out and mocked online")
#boicanh("Con bé Quyên lớp 9 dạo này cứ cầm điện thoại là mặt tái đi. Mẹ tình cờ thấy màn hình: một nhóm chat lớp không có nó, ai đó chụp lại gửi cho nó xem. Trong đó là ảnh nó bị ghép, kèm những dòng chế giễu.", en: "Lately Quyen, in grade 9, turns pale whenever she picks up her phone. Mum happens to see the screen: a class group chat that excludes her, screenshots sent to her by someone. In it is an edited photo of her with mocking captions.")
#phanxa("Thì con đừng coi nữa, xóa hết mạng đi là xong. Mà chắc con cũng phải làm sao tụi nó mới vậy chứ.", "Mẹ nghĩ là tại mình. Và mẹ sẽ lấy điện thoại, tức là mình vừa bị tẩy chay vừa mất luôn mấy đứa bạn còn lại.", en: ("Then stop looking; delete your accounts and it's over. And you must have done something for them to act like that.", "Mum thinks it's my fault. And she will take my phone, so I am shut out and I lose the few friends I have left."))
#scene("Tình huống 8.3 · Thử nói cách khác")[
  #me("Quyên, mẹ lỡ thấy màn hình của con. Mẹ xin lỗi vì đã nhìn. Nhưng thấy rồi thì mẹ không giả bộ như chưa thấy được. Mẹ đau giùm con.", en: "Quyen, I accidentally saw your screen. I'm sorry I looked. But having seen it, I can't pretend I didn't. My heart hurts for you.")
  #con("(Bật khóc.) Tụi nó ghép hình con vô đủ thứ. Cả lớp coi hết rồi. Con không muốn đi học nữa.", en: "(Bursts into tears.) They edit my photo into all kinds of things. The whole class has seen it. I don't want to go to school any more.")
  #me("(Ôm con.) Mẹ ở đây. Bị cả đám xúm vô như vậy, ai cũng sụp chứ không riêng con.", en: "(Holds her.) I'm here. Anyone ganged up on like that would crumble, not just you.")
  #con("Mẹ đừng lấy điện thoại của con nha.", en: "Please don't take my phone.")
  #me("Mẹ không lấy. Con không làm gì sai để bị phạt hết. Nhưng mẹ cần con giúp mẹ một việc, khó chút: mình chụp màn hình lại hết mấy cái đó, lưu vô một chỗ, rồi con khỏi phải mở ra coi nữa. Mẹ giữ giùm.", en: "I won't. You've done nothing to be punished for. But I need your help with one hard thing: let's screenshot all of it and save it in one place, and then you never have to open it again. I'll keep it for you.")
  #con("Chụp lại chi vậy mẹ? Con muốn xóa hết.", en: "Why screenshot it? I want to delete everything.")
  #me("Mẹ hiểu. Nhưng đó là bằng chứng. Ghép ảnh bôi nhọ người khác là chuyện nghiêm trọng, nhà trường phải xử lý, và có bằng chứng thì người ta mới làm tới nơi. Con đừng trả lời lại tụi nó câu nào, cũng đừng nhờ bạn chửi giùm.", en: "I understand. But that is evidence. Editing photos to smear someone is serious; the school must deal with it, and they act properly when there's evidence. Don't reply to them at all, and don't ask friends to insult them back.")
  #con("Con sợ lên trường ai cũng nhìn con.", en: "I'm scared everyone will stare at me at school.")
  #me("Mai mẹ xin cho con nghỉ một ngày, mẹ lên gặp cô chủ nhiệm với thầy hiệu trưởng trước. Còn tối nay, trong lớp có đứa nào con vẫn tin không?", en: "I'll ask for a day off for you tomorrow and go to see your form teacher and the principal first. For tonight: is there anyone in the class you still trust?")
  #con("Có nhỏ Vân. Nó là đứa chụp gửi cho con biết.", en: "Van. She's the one who sent me the screenshots so I'd know.")
  #me("Vậy con còn một người bạn thật. Mời Vân qua nhà chơi cuối tuần đi, mẹ nấu.", en: "Then you still have one real friend. Invite Van over this weekend; I'll cook.")
]
#hieusau1("Bắt nạt trên mạng khác bắt nạt trực tiếp ở chỗ nó không có giờ tan học: nó theo con vào tận giường ngủ, có khán giả đông, và để lại dấu vết lâu. Tịch thu điện thoại là phản xạ dễ hiểu nhưng với con, đó là bị phạt vì đã bị hại, và chính nỗi sợ bị thu máy là lý do nhiều em giấu ba mẹ. Thứ tự đúng là: đứng về phía con, lưu bằng chứng, không đáp trả, báo nhà trường và nền tảng, rồi giúp con giữ lấy ít nhất một mối quan hệ thật ngoài đời.", en: "Online bullying differs from bullying in person because it has no end of the school day: it follows the child into bed, has a large audience, and leaves lasting traces. Confiscating the phone is an understandable reflex, but to the child it is punishment for being a victim, and fear of losing the phone is exactly why many hide things from parents. The right order: stand with your child, save evidence, do not retaliate, report to the school and the platform, and help your child keep at least one real-life friendship.")
#cotloi("Con bị bắt nạt trên mạng thì đừng thu điện thoại. Lưu bằng chứng, không đáp trả, báo người có trách nhiệm, và giữ cho con một người bạn thật.", en: "If your child is bullied online, do not take the phone. Save the evidence, do not hit back, report to those responsible, and keep one real friend close.")
#lamngay1("Nói trước với con, khi chưa có chuyện gì: Nếu có ai làm gì con trên mạng, kể cả khi con có lỡ làm gì đó sai trước, con cứ nói với ba mẹ. Ba mẹ sẽ không lấy điện thoại của con vì con nói thật.", en: "Tell your child in advance, before anything happens: If anyone ever does something to you online, even if you did something wrong first, tell us. We will not take your phone away for telling the truth.")
#caunoi("Con không làm gì sai để bị phạt hết. Mẹ không lấy điện thoại, mẹ đứng về phía con.", en: "You have done nothing to be punished for. I won't take your phone; I am on your side.")
#tusoi(("Nếu có chuyện trên mạng, con mình sợ kẻ bắt nạt hơn hay sợ bị ba mẹ thu máy hơn?", "Mình có biết con đang dùng những ứng dụng nào và chơi trong những nhóm nào không?",), en: ("If something happened online, would my child fear the bully more, or fear losing the phone more?", "Do I know which apps my child uses and which groups they are in?",))

#sec("Con không có bạn", en: "Your child has no friends")
#boicanh("Sinh nhật mười hai tuổi, thằng Duy không mời ai. Giờ ra chơi nó ngồi trong lớp đọc truyện. Cô nói con ngoan, ít nói. Mẹ hỏi sao con không chơi với bạn, nó đáp: con không biết nói gì với tụi nó.", en: "For his twelfth birthday Duy invites nobody. At break he stays in the classroom reading comics. The teacher says he is well behaved and quiet. When Mum asks why he doesn't play with the others he says: I don't know what to say to them.")
#phanxa("Con phải hòa đồng lên chứ. Cứ lầm lì vậy ai mà chơi. Ra ngoài rủ bạn chơi đi, có gì đâu mà khó!", "Mình có gì đó hỏng. Ai cũng thấy dễ, chỉ mình thấy khó. Mẹ cũng thất vọng về mình chuyện này.", en: ("You have to be more sociable. Who would play with someone so withdrawn? Go out and ask them to play; what's so hard about that!", "Something is broken in me. Everyone finds it easy and only I find it hard. Mum is disappointed in me about this too."))
#scene("Tình huống 8.4 · Thử nói cách khác")[
  #me("Con nói không biết nói gì với các bạn. Mẹ nghe là hiểu liền, vì hồi nhỏ mẹ cũng y vậy. Đứng giữa một đám mà không biết chen vô câu nào.", en: "You said you don't know what to say to them. I understood at once, because I was exactly like that as a child. Standing in a group with no idea how to join in.")
  #con("Mẹ cũng vậy hả? Rồi mẹ làm sao?", en: "You too? What did you do?")
  #me("Mẹ chơi với đúng một đứa, tên Hạnh, tại hai đứa cùng thích sưu tập tem. Tới giờ vẫn là bạn. Mẹ nghĩ con cũng không cần cả đám. Con cần một hai đứa hợp gu thôi.", en: "I played with exactly one girl, Hanh, because we both collected stamps. We're still friends. I don't think you need the whole crowd either. You need one or two who suit you.")
  #con("Tụi lớp con toàn nói chuyện đá banh với game bắn súng. Con không thích mấy cái đó.", en: "The kids in my class only talk about football and shooting games. I don't like those.")
  #me("Ừ, không thích thì khỏi giả bộ thích, mệt lắm. Vậy con thích gì thì mình đi tìm chỗ có những đứa giống con. Con mê cờ vua với vẽ truyện tranh mà. Nhà văn hóa quận có lớp cờ sáng chủ nhật, con muốn tới coi thử một buổi không? Không thích thì về.", en: "Then don't pretend to; that's exhausting. Let's go and find places with kids like you. You love chess and drawing comics. The district culture house has a chess class on Sunday mornings; want to come and watch one session? If you don't like it we go home.")
  #con("Lỡ tới đó con cũng không nói chuyện được với ai?", en: "What if I can't talk to anyone there either?")
  #me("Thì con đánh cờ. Đánh cờ đâu cần nói nhiều. Chơi xong một ván, tự nhiên có chuyện để nói: nước đó sao mày đi vậy. Bạn bè nhiều khi bắt đầu từ làm chung một việc chứ không phải từ nói chuyện.", en: "Then you play chess. Chess doesn't need much talking. After a game there's suddenly something to say: why did you move there? Friendship often starts with doing something together, not with talking.")
  #con("...Con đi thử một buổi.", en: "...I'll try one session.")
]
#hieusau1("Có đứa trẻ hướng nội, thích ít bạn và hoàn toàn ổn với điều đó. Có đứa muốn có bạn mà không biết cách, và đau vì điều đó. Hai trường hợp nhìn giống nhau nhưng cần ứng xử khác nhau, và chỉ có hỏi con mới biết. Ép con hòa đồng làm con thấy mình khiếm khuyết. Điều giúp được là đưa con tới môi trường nhỏ, xoay quanh một sở thích chung, nơi tình bạn nảy ra từ việc làm cùng nhau. Chỉ cần một người bạn thân đã đủ che chắn cho đứa trẻ khỏi phần lớn tác hại của sự cô đơn.", en: "Some children are introverted, prefer few friends and are perfectly fine. Others want friends, do not know how, and hurt because of it. The two look alike but need different responses, and only asking tells you which. Pushing a child to be sociable makes them feel defective. What helps is a small setting built around a shared interest, where friendship grows from doing things together. A single close friend is enough to shield a child from most of the harm of loneliness.")
#cotloi("Con không cần được nhiều người thích. Con cần một hai người bạn thật. Đừng sửa tính con, hãy tìm cho con đúng chỗ.", en: "Your child does not need to be liked by many. They need one or two real friends. Do not fix their nature; find them the right place.")
#lamngay1("Hỏi con: Trong lớp có bạn nào con thấy dễ chịu khi ngồi gần không? Nếu có, tạo một dịp rất nhỏ: mời bạn đó qua nhà làm chung một việc cụ thể, ráp mô hình, làm bánh, chơi cờ. Một bạn, một việc, hai tiếng.", en: "Ask your child: Is there anyone in class you feel comfortable sitting near? If so, create one small occasion: invite that child over to do one specific thing together, build a model, bake, play chess. One friend, one activity, two hours.")
#caunoi("Con không cần cả đám. Con chỉ cần một hai đứa hợp với con thôi.", en: "You don't need the whole crowd. You only need one or two who suit you.")
#tusoi(("Con mình ít bạn và thấy ổn, hay ít bạn và thấy buồn? Mình đã hỏi con chưa?", "Mình có đang đo con bằng cây thước hoạt bát, lanh lợi của nhà người khác không?",), en: ("Does my child have few friends and feel fine, or few friends and feel sad? Have I asked?", "Am I measuring my child with another family's ruler of lively and outgoing?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 8: mang theo bên mình]
#doicau1((("Kệ tụi nó, đừng thèm để ý.", "Chuyện đó làm con tổn thương thiệt. Mình cùng tính coi làm gì.", "Ignore them, don't let it bother you.", "That really hurt you. Let's work out together what to do."), ("Chắc con phải làm sao người ta mới vậy.", "Không ai đáng bị đối xử như vậy hết. Đó không phải lỗi của con.", "You must have done something for them to do that.", "Nobody deserves to be treated like that. It is not your fault."), ("Nó đánh thì đánh lại.", "Con nói to dừng lại, rồi đi về phía có người lớn. Phần còn lại để ba lo.", "If they hit you, hit back.", "Say stop loudly, then walk towards an adult. Leave the rest to me."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Khi con kể mình bị bắt nạt, thứ tự là: tin con, cảm ơn con đã nói, khẳng định không phải lỗi của con, rồi mới bàn cách. Đừng hỏi con đã làm gì trước.", "Làm việc với nhà trường bằng sự việc cụ thể: ngày, giờ, chỗ, ai, bằng chứng. Đề nghị kế hoạch bảo vệ con và hẹn ngày trao đổi lại. Tránh tự tìm phụ huynh bên kia để đôi co.", "Đừng tự ý xử lý đứa trẻ bắt nạt con mình. Việc đó dễ làm tình hình tệ hơn và đặt ba mẹ vào thế sai.",), en: ("When your child tells you they are being bullied, the order is: believe them, thank them for telling, state that it is not their fault, and only then discuss what to do. Do not ask what they did first.", "Work with the school using specifics: date, time, place, who, evidence. Ask for a plan to protect your child and set a date to follow up. Avoid confronting the other parents yourself.", "Do not deal with the bullying child yourself. It easily makes things worse and puts you in the wrong.",))
#listbox1("KHI NÀO CẦN TÌM NGƯỜI GIÚP  ·  WHEN TO SEEK HELP", crimson, rgb("FFF5F5"), ("Con có vết thương không giải thích được, đồ đạc và tiền bạc mất nhiều lần.", "Con sợ đi học rõ rệt, sụt cân, mất ngủ, hay nói con không muốn sống, con biến mất cho rồi.", "Có ảnh nhạy cảm, lời đe dọa, tống tiền trên mạng. Khi đó lưu bằng chứng và gọi 111 (tổng đài quốc gia bảo vệ trẻ em, miễn phí) hoặc báo công an.",), mark: sym.triangle.filled.small.r, en: ("Your child has unexplained injuries, or belongings and money go missing repeatedly.", "Your child is clearly afraid of school, is losing weight or sleep, or says things like I don't want to live, I wish I would disappear.", "There are intimate images, threats or blackmail online. Save the evidence and call 111 (Vietnam's free national child protection hotline) or the police.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày, mỗi tối hỏi con hai câu: Hôm nay ai tử tế với con? Hôm nay con tử tế với ai? Câu trả lời dần dần vẽ ra bản đồ bạn bè của con mà không cần tra hỏi.",), mark: sym.star.filled, en: ("For seven days, ask two questions each evening: Who was kind to you today? Who were you kind to today? The answers gradually draw a map of your child's friendships with no interrogation.",))
