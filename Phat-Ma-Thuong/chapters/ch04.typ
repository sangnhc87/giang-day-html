#import "../template.typ": *

#chapter-open(4, "Ngủ gật, uể oải, mệt đầu giờ", 4, "Trước khi gọi một em là lười, hãy hỏi đêm qua em đã ngủ được mấy tiếng.", "Ngủ gật là lỗi mà thầy cô dễ nóng nhất, và cũng là lỗi có nhiều nguyên nhân thật nhất: thức khuya học bài, chơi game, phụ giúp gia đình, đi làm thêm, hay đơn giản là tuổi dậy thì cần ngủ nhiều hơn người lớn. Chương này gợi những cách đánh thức nhẹ, vui, và quan trọng hơn là cách tìm ra lý do thật.", ("Em gục đầu xuống bàn giữa tiết", "Em ngủ gật vì thức khuya chơi game", "Em ngủ gật vì đêm làm việc phụ gia đình", "Cả lớp ngáp dây chuyền", "Em buồn ngủ ngay sau giờ thể dục",))

#sec("Em gục đầu xuống bàn giữa tiết")
#tinhhuong("4.1", "Em gục đầu xuống bàn giữa tiết", "Bạn Long gục đầu xuống bàn từ phút thứ mười lăm. Thầy gọi một lần thì em ngẩng lên, vài phút sau lại gục. Cả lớp bắt đầu liếc nhìn.")
#chieu("Bàn đứng cuối lớp", "Thầy nói nhẹ nhàng: Long ơi, em đang buồn ngủ lắm. Thầy cho em xuống cuối lớp học đứng năm phút. Có một bàn cao ở cuối lớp mà thầy dành sẵn. Em đứng học ở đó, tay cầm vở. Năm phút sau em quay lại chỗ cũ. Không ai bị gọi tên, không ai bị cười, vì thầy đã nói đó là chỗ riêng cho ai cần tỉnh táo. Cuối tiết thầy hỏi riêng hôm qua em ngủ lúc mấy giờ.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Long, thầy thấy em đang rất mệt. Em xuống bàn đứng cuối lớp học vài phút cho tỉnh nhé. Không phải phạt đâu, đó là chỗ thầy dành cho ai cần.")
  #tro("Dạ... em cảm ơn thầy.")
  #thay("Cuối tiết thầy hỏi em một chuyện nhỏ, em ghé thầy nhé.")
]
#visao("Gọi em dậy trước lớp làm em xấu hổ và vẫn buồn ngủ. Cho em đứng học thay đổi tư thế, làm máu lên não, và biến chỗ đứng thành quyền chứ không phải bị phạt. Việc hỏi riêng cuối tiết mới là chỗ thầy chạm vào nguyên nhân.")
#ranhgioi("Không dùng cho em có bệnh hoặc hoa mắt. Không đặt bàn đứng như chỗ phạt cố định. Nếu em gục mỗi tiết, mỗi ngày, nghĩ tới vấn đề sức khỏe hoặc gia đình.")
#bientau("Cho cả lớp một phút vươn vai mỗi khi thầy thấy cả lớp rũ rượi, để bàn đứng không trở thành dấu hiệu riêng của em nào.")
#caunoi("Em xuống cuối lớp đứng học vài phút cho tỉnh nhé. Cuối tiết thầy hỏi em một chút.")

#sec("Em ngủ gật vì thức khuya chơi game")
#tinhhuong("4.2", "Em ngủ gật vì thức khuya chơi game", "Nhìn quầng thâm là thầy đoán ra. Bạn Kiệt thừa nhận hôm qua chơi game đến hai giờ sáng. Em ngủ gật gần như mỗi tiết đầu. Ba mẹ đã nhắc mà em không nghe.")
#chieu("Nhật ký giờ ngủ ba ngày", "Thầy cho Kiệt một thử thách nhỏ: ba ngày liên tiếp ghi lại giờ ngủ thật vào một tờ giấy nhỏ, rồi sáng hôm sau ghi mức tỉnh táo từ một đến mười. Thầy chỉ xem, không bình luận. Sau ba ngày, thầy hỏi em thấy gì. Thường em tự thấy mối liên hệ giữa giờ ngủ và độ tỉnh táo. Nếu em giữ được giờ ngủ trước mười một giờ hai ngày, thầy có một món thưởng nhỏ như đổi chỗ ngồi.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Kiệt, thầy không bắt em bỏ game. Thầy chỉ xin em thử ghi lại giờ ngủ ba ngày, sáng ghi mức tỉnh táo từ một đến mười. Rồi mình xem nó nói gì.")
  #tro("Dạ... chỉ ghi thôi hả thầy?")
  #thay("Chỉ ghi thôi. Thầy không chấm điểm, thầy chỉ tò mò xem con số kể chuyện gì.")
]
#visao("Bắt em bỏ game thì em chống. Ghi lại giờ ngủ giúp em tự nhìn thấy mối quan hệ nguyên nhân kết quả. Học sinh tuổi này nghe tự mình tìm ra điều gì thì nhớ lâu hơn nghe người lớn nói.")
#ranhgioi("Không tịch thu máy hay cấm chơi game thay phụ huynh. Không đọc nhật ký trước lớp. Nếu em chơi game cả đêm liên tục, rủ phụ huynh cùng trao đổi.")
#bientau("Cho em thêm cột ghi tâm trạng, để em thấy giấc ngủ ảnh hưởng cả cảm xúc.")
#caunoi("Thầy không bắt em bỏ game. Em thử ghi giờ ngủ ba ngày, rồi mình xem nó nói gì.")

#sec("Em ngủ gật vì đêm làm việc phụ gia đình")
#tinhhuong("4.3", "Em ngủ gật vì đêm làm việc phụ gia đình", "Bạn Mai ngủ gật gần như mỗi sáng. Thầy biết nhà em bán hàng đêm, em phụ ba mẹ đến khuya. Em không bao giờ than, chỉ xin lỗi mỗi khi bị gọi dậy.")
#chieu("Góc nghỉ mười phút", "Đây là chiêu không phạt. Thầy nói riêng với Mai: nếu em thấy quá mệt, em ra ngoài rửa mặt mười phút, không cần xin phép, chỉ cần gật đầu với thầy. Thầy đặt một chiếc ghế nhỏ ở cuối hành lang gần phòng học cho em ngồi nghỉ. Thầy cũng gọi riêng em lớp trưởng nhờ không ghi tên em khi em ra ngoài. Thầy ghi âm thầm vào sổ tay để lúc cần nói chuyện với nhà trường hay gia đình.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Mai, thầy biết nhà em vất vả. Khi em quá mệt, em chỉ cần gật đầu với thầy rồi ra rửa mặt mười phút. Thầy không hỏi lý do.")
  #tro("(Mắt đỏ.) Dạ... em cảm ơn thầy.")
  #thay("Em không có lỗi gì hết. Thầy chỉ muốn em học được nhiều nhất trong khả năng của em.")
]
#visao("Phạt em vì mệt do gánh việc gia đình là bất công và làm em thấy xấu hổ vì hoàn cảnh. Cho em một cách xử lý kín đáo giúp em giữ lòng tự trọng và vẫn theo kịp bài.")
#ranhgioi("Không công khai hoàn cảnh em với lớp. Không ép em kể thêm nếu em chưa muốn. Nếu em cần hỗ trợ thật, liên hệ nhà trường và các quỹ hỗ trợ một cách kín đáo.")
#bientau("Tặng em một bản tóm tắt bài cuối tiết để em không lỡ nội dung khi ra ngoài.")
#caunoi("Khi quá mệt em cứ gật đầu với thầy rồi ra rửa mặt. Thầy không hỏi lý do.")

#sec("Cả lớp ngáp dây chuyền")
#tinhhuong("4.4", "Cả lớp ngáp dây chuyền", "Tiết thứ ba buổi sáng, một em ngáp, rồi cả dãy ngáp theo như dây chuyền. Thầy đang giảng mà thấy cả lớp đờ đẫn. Nhắc nhở thì không có em nào cố ý, chỉ là mệt.")
#chieu("Một phút tỉnh dậy", "Thầy dừng giảng, mỉm cười: cả lớp đang ngáp theo thầy phải không? Thầy phát lệnh: đứng dậy, vươn vai thật to, ngáp thật to một lần cho đã, rồi ngồi xuống uống một ngụm nước. Sau một phút, thầy hỏi ai thấy tỉnh hơn thì giơ tay. Thầy ghi nhận con số. Chiêu này không phạt ai, nhưng biến cơn buồn ngủ thành hoạt động tập thể ngắn và vui.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Cả lớp đứng dậy nào! Vươn vai thật to, ngáp thật to một lần cho đã. Xong rồi ngồi xuống uống nước. Ai thấy tỉnh hơn thì giơ tay.")
  #tro("(Cười, cả lớp làm theo.) Dạ!")
  #thay("Tốt. Giờ mình học tiếp, lần này tỉnh hơn rồi nhé.")
]
#visao("Ngáp dây chuyền là phản xạ xã hội. Cho cả lớp làm điều đó có kiểm soát thì cơn buồn ngủ vơi bớt, và lớp cười nên thoải mái hơn. Thầy được coi là người hiểu lớp thay vì người cấm.")
#ranhgioi("Không ép những em thật sự không khỏe phải đứng. Không kéo dài quá hai phút.")
#bientau("Thêm bài tập thở bốn nhịp, hít bốn giây giữ bốn giây thở bốn giây.")
#caunoi("Cả lớp đứng dậy ngáp thật to một lần cho đã rồi mình học tiếp.")

#sec("Em buồn ngủ ngay sau giờ thể dục")
#tinhhuong("4.5", "Em buồn ngủ ngay sau giờ thể dục", "Tiết sau thể dục, Nam ngồi đờ đẫn, mắt lờ đờ, mồ hôi còn ướt áo. Em không chú ý bài. Cả lớp cũng uể oải theo.")
#chieu("Cốc nước của thầy", "Thầy chuẩn bị sẵn một bình nước lọc trên bàn. Đầu tiết sau thể dục, thầy rót cho mỗi em một ngụm nhỏ, vừa rót vừa hỏi một câu hỏi vui: em vừa chơi môn gì, thắng hay thua. Cả lớp nói chuyện chừng ba phút. Sau đó cùng hít thở sâu ba lần rồi vào bài. Hình phạt nằm ở chỗ thầy không để cơ thể các em bị bỏ quên: thầy phạt sự lơ đãng bằng chăm sóc.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Mời cả lớp một ngụm nước. Ai vừa chơi gì, thắng thua thế nào, kể thầy nghe ba phút. Rồi mình hít thở sâu và vào bài.")
  #tro("Dạ, tụi em đá bóng, lớp mình thắng ạ!")
  #thay("Hay lắm. Giờ cho phần thắng nghỉ ngơi, mình trở lại bài toán nào.")
]
#visao("Cơ thể sau vận động cần thời gian hạ nhịp. Gọi các em chú ý ngay là lấy phần cơ thể chưa sẵn sàng. Một ngụm nước và vài phút trò chuyện giúp cả lớp chuyển trạng thái nhẹ nhàng.")
#ranhgioi("Không dùng nước khi có em bị bệnh phải kiêng. Không để phần trò chuyện kéo dài thành ồn ào.")
#bientau("Dùng hai phút ngồi nhắm mắt nghe nhạc nhẹ thay cho trò chuyện.")
#caunoi("Mình uống một ngụm nước, nghỉ ba phút rồi vào bài nhé.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 4: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Đừng gọi tên em ngủ gật trước lớp. Chạm vai nhẹ, hoặc đi ngang bàn gõ nhẹ, hoặc cho cả lớp vận động trước.", "Mỗi em ngủ gật có một lý do riêng. Hỏi riêng sau tiết giá trị hơn mười lần nhắc công khai.", "Một em ngủ gật liên tục kéo dài thường là tín hiệu cho thầy cô, không phải lỗi của em. Hãy ghi lại và nói chuyện với gia đình khi cần.",))
