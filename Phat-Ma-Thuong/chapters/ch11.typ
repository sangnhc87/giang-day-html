#import "../template.typ": *

#chapter-open(11, "Nghịch phá đồ đạc, viết vẽ bậy", 11, "Một cái bàn bị vẽ bậy là một lời nhắn của em. Đọc lời nhắn trước, lau bàn sau.", "Vẽ lên bàn, khắc lên ghế, làm hỏng quạt, ném giấy khắp lớp là những lỗi thầy cô nhìn thấy ngay vì chúng để lại vết. Phạt bằng tiền hay bắt chép phạt thường không dạy được điều gì. Điều có tác dụng là để em sửa chính cái mình làm hỏng, bằng cách có ý nghĩa và có sự tự hào ở cuối. Chương này gợi những chiêu như thế.", ("Em vẽ bậy lên bàn", "Em làm hỏng đồ dùng của lớp", "Cả lớp ném giấy, phi tiêu giấy", "Em viết bậy ở nhà vệ sinh", "Em khắc tên lên cây trong sân trường",))

#sec("Em vẽ bậy lên bàn")
#tinhhuong("11.1", "Em vẽ bậy lên bàn", "Thầy phát hiện một mặt bàn đầy hình vẽ nguệch ngoạc và vài câu chữ. Qua vài ngày, thầy biết là của Lâm. Em không nhận ngay nhưng khi thầy hỏi nhẹ thì cúi đầu.")
#chieu("Họa sĩ trả bàn", "Thầy khen trước: nét vẽ của em có hồn. Rồi thầy giao việc: em dùng nước tẩy lau sạch mặt bàn, trong giờ ra chơi có thầy ngồi cùng. Xong rồi, em được thầy mời vẽ một bức tranh nhỏ hoặc một câu thơ ngắn lên tấm bảng tin của lớp, cho phép vẽ thoải mái. Em sửa lỗi và đồng thời có nơi để thể hiện, nên không còn nhu cầu vẽ lên bàn.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Lâm, nét vẽ của em có hồn thật. Nhưng bàn là của cả lớp. Em lau sạch trong giờ ra chơi, thầy ngồi cùng. Xong rồi thầy giao em vẽ lên bảng tin lớp, vẽ thoải mái.")
  #tro("Dạ... em lau ngay thầy. Em xin lỗi.")
  #thay("Cảm ơn em. Thầy mong thấy bức vẽ của em trên bảng tin.")
]
#visao("Em vẽ lên bàn vì cần chỗ thể hiện. Bắt em tự lau là trả giá cho hành vi. Cho em một nơi vẽ hợp lệ là đáp ứng nhu cầu gốc. Khen trước giúp em nghe lời sau mà không phòng thủ.")
#ranhgioi("Không dùng nội dung bậy hay xúc phạm làm trò đùa. Nếu hình vẽ chứa lời đe dọa hay xúc phạm cụ thể một người, phải xử lý nghiêm hơn và bảo vệ người bị nhắm tới.")
#bientau("Mở bức tường sáng tạo của lớp, mỗi tuần một em được phụ trách trang trí.")
#caunoi("Nét vẽ của em có hồn. Em lau bàn rồi mình tìm cho em một chỗ vẽ thoải mái nhé.")

#sec("Em làm hỏng đồ dùng của lớp")
#tinhhuong("11.2", "Em làm hỏng đồ dùng của lớp", "Cái quạt trần kêu lạ, hóa ra có em tò mò nghịch công tắc làm hỏng. Cái bảng bị trầy do một nhóm chơi đùa. Không ai nhận, nhưng vài em có vẻ hiểu chuyện.")
#chieu("Phiếu bảo trì", "Thầy nói với cả lớp: đồ hỏng không phải để tìm người đáng trách mà để tìm cách sửa. Thầy viết lên bảng một phiếu bảo trì nhỏ, ghi món hỏng và cách sửa. Em nào biết điều gì thì ghi tên và hướng giúp sửa, thầy chưa hỏi ai làm hỏng. Cuối tuần các em cùng nhân viên bảo trì làm công việc sửa chữa nhỏ, học cách vặn ốc. Nếu có em nhận, thầy ghi nhận sự trung thực hơn hành vi.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Đồ hỏng thì mình lo sửa, thầy chưa hỏi ai làm. Em nào muốn giúp sửa thì ghi tên vào phiếu này, cuối tuần mình cùng bác bảo trì học vặn ốc.")
  #tro("Dạ... em xin giúp thầy. Thật ra em có nghịch công tắc.")
  #thay("Cảm ơn em nhận. Thầy ghi nhận sự trung thực của em, và em giúp bác bảo trì nhé.")
]
#visao("Gặng hỏi thủ phạm làm em sợ và giấu. Chuyển trọng tâm sang sửa chữa thì người làm hỏng dễ lên tiếng vì được trọng vọng như người giúp. Học việc sửa chữa cũng cho các em hiểu giá trị của đồ vật.")
#ranhgioi("Không áp mức đền bù tiền cho học sinh nếu quy định không cho phép. Không cho em làm việc nguy hiểm như thang cao hay điện. Nếu thiệt hại lớn, báo phụ huynh theo quy định.")
#bientau("Cuối học kỳ tặng lớp một biển tự hào đã giữ đồ dùng tốt.")
#caunoi("Đồ hỏng thì mình cùng sửa. Em nào muốn giúp bác bảo trì thì ghi tên nhé.")

#sec("Cả lớp ném giấy, phi tiêu giấy")
#tinhhuong("11.3", "Cả lớp ném giấy, phi tiêu giấy", "Giờ ra chơi vừa hết, sàn lớp ngập giấy vo tròn và máy bay giấy. Một em ném trúng đầu một bạn. Cả lớp cười ồn. Thầy vào lớp thấy cảnh hỗn độn.")
#chieu("Sân bóng giấy", "Thầy mỉm cười, lấy một cái thùng carton đặt giữa lớp và nói: cả lớp ném giỏi như vậy thì thi luôn, mỗi em ném một tờ giấy vào thùng từ chỗ mình ngồi. Ai ném vào là ghi một điểm cho lớp. Sau đó cả lớp gom giấy còn lại, thầy mời cả lớp thi gấp nhanh máy bay giấy từ giấy sạch, nộp cho thầy để làm trang trí. Cả lớp đổi từ phá sang chơi có luật rồi dọn sạch.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Lớp mình ném giỏi thế thì thi luôn! Mỗi em ném một tờ vào thùng này từ chỗ ngồi, vào được thì ghi điểm cho lớp. Xong rồi cả lớp gom giấy nhé.")
  #tro("(Cười.) Dạ, thầy cho thi thật hả thầy?")
  #thay("Thi thật. Nhưng ném xong thì dọn sạch trong hai phút.")
]
#visao("Nghịch phá giấy là năng lượng chưa có chỗ đi. Cho thi có luật biến phá thành chơi, nên các em tự thấy điểm dừng. Kết thúc bằng việc dọn giúp các em thấy mình chịu trách nhiệm.")
#ranhgioi("Không cho ném vật nhọn hay nặng. Không để trò thi kéo dài thành cuộc ồn ào. Nếu có em bị ném đau, dừng lại và chăm sóc em đó trước.")
#bientau("Dùng giấy gom được làm sản phẩm tái chế như hộp bút của lớp.")
#caunoi("Ném giỏi thế thì mình thi có luật, rồi cả lớp cùng dọn sạch nhé.")

#sec("Em viết bậy ở nhà vệ sinh")
#tinhhuong("11.4", "Em viết bậy ở nhà vệ sinh", "Bảo vệ báo có dòng chữ xúc phạm về một bạn trong lớp được viết trên tường nhà vệ sinh. Cả lớp xì xào. Bạn bị nhắc đến rất buồn, nhưng không muốn nói.")
#chieu("Lau tường, viết lại lời", "Chiêu này nghiêm hơn và chỉ làm riêng. Thầy xóa dòng chữ cùng nhà trường ngay để bảo vệ bạn. Thầy không điều tra trước lớp, mà đặt một tờ giấy nhỏ lên bàn mỗi em: ai có thông tin xin nói với thầy riêng, ai đã viết có thể ghé thầy. Em nhận lỗi thì ngoài việc lau tường, em viết một lá thư không tên xin lỗi bạn bị nhắc đến, thầy chuyển thư và giữ kín.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Với cả lớp, nhẹ.) Thầy đã xóa dòng chữ trên tường. Ai biết điều gì hoặc đã viết, xin ghé thầy riêng. Thầy sẽ giữ kín và cùng em sửa.")
  #tro("(Một em ghé riêng.) Thầy, là em viết... em xin lỗi.")
  #thay("Cảm ơn em đến. Em viết một lá thư không tên xin lỗi bạn đó, thầy chuyển giúp. Còn ai đã nghe chuyện này, thầy cũng cần em giúp bạn.")
]
#visao("Bảo vệ người bị nhắm tới là việc đầu tiên, nên xóa ngay. Giữ kín cho người nhận lỗi giúp em dám bước ra mà không sợ bị cả lớp cười. Lá thư không tên cho phép sửa lỗi mà không công khai nhục.")
#ranhgioi("Nếu nội dung nặng như đe dọa, quấy rối hay nhắm vào giới tính, phải báo nhà trường và xử lý theo quy định. Không bắt bạn bị nhắm tới phải gặp em viết. Không đoán mò thủ phạm.")
#bientau("Thêm một buổi sinh hoạt nói về lời nói làm tổn thương bạn, không nêu tên ai.")
#caunoi("Thầy đã xóa dòng chữ. Em nào biết hoặc đã viết thì ghé thầy riêng, thầy giữ kín.")

#sec("Em khắc tên lên cây trong sân trường")
#tinhhuong("11.5", "Em khắc tên lên cây trong sân trường", "Giờ ra chơi, một nhóm em dùng bút bi khắc tên lên thân cây phượng, rồi khoe với nhau. Cây có vết dài. Bác bảo vệ rất tiếc, thầy cũng tiếc.")
#chieu("Bảo mẫu của cây", "Thầy hỏi nhóm: các em có biết cây phượng này bao nhiêu tuổi không? Thầy giao nhiệm vụ: nhóm trở thành bảo mẫu của cây trong một tháng. Mỗi tuần tưới nước hai lần, nhặt lá quanh gốc, chụp ảnh ghi lại sự thay đổi. Cuối tháng viết một bản tin nhỏ về cây. Cây có tên nhóm gắn bảng nhỏ ghi: Cây này được nhóm chăm sóc. Chữ tên vẫn ở đó, nhưng giờ là tên người chăm.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Các em khắc tên lên cây, vậy từ giờ các em là bảo mẫu của cây một tháng nhé. Tưới nước, nhặt lá, chụp ảnh ghi lại. Cuối tháng viết bản tin về cây cho lớp.")
  #tro("Dạ... bọn em làm được thầy.")
  #thay("Thầy tin. Tên các em sẽ được ghi lại trên bảng nhỏ ở gốc cây, nhưng với tư cách người chăm.")
]
#visao("Em khắc tên để được ghi dấu. Thầy giữ lại nhu cầu được ghi dấu và đổi bằng một cách tích cực. Chăm sóc tạo gắn bó, nên các em tự không muốn làm đau cây nữa.")
#ranhgioi("Không bắt em làm việc dưới nắng gắt. Không dùng cây như phương tiện hạ nhục em. Nếu cây bị hại nặng, báo nhà trường để xử lý đúng cách.")
#bientau("Cả lớp cùng đặt tên cho cây và vẽ bản đồ cây xanh của trường.")
#caunoi("Các em khắc tên lên cây thì từ nay các em là bảo mẫu của cây nhé.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 11: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Em phá đồ vì cần được ghi dấu, được vận động hoặc được chú ý. Cho em một nơi hợp lệ để làm điều đó, em sẽ không phá nữa.", "Hỏi ai làm trước cả lớp thường đẩy người làm vào chỗ giấu. Hỏi ai giúp sửa, người làm tự bước ra.", "Những dòng chữ nhắm vào một người cụ thể không còn là nghịch phá. Hãy bảo vệ người đó trước rồi mới tính chuyện người viết.",))
