#import "../template.typ": *

#chapter-open(8, "Làm nhóm: ăn không, giành làm, chia phe", 8, "Làm nhóm là nơi học sinh học cách sống với nhau. Phạt trong nhóm phải làm nhóm tốt hơn, không phải làm nhóm sợ hơn.", "Mỗi lần giao bài nhóm là mỗi lần thầy cô nghe những lời kêu ca quen thuộc: bạn ấy không làm gì hết, bạn ấy giành làm hết, hai bạn kia giận nhau. Điểm chung là em cần học cách cộng tác, và điều đó dạy bằng trải nghiệm tốt hơn bằng lời giảng. Chương này gợi những chiêu cho từng kiểu lỗi nhóm, đều có phần phạt vui và phần học thật.", ("Một bạn ăn không trong nhóm", "Một bạn giành làm hết, không cho ai chen vào", "Hai bạn giận nhau, không chịu làm chung", "Nhóm làm sơ sài, nộp cho xong", "Cả nhóm chia phe, kéo bè",))

#sec("Một bạn ăn không trong nhóm")
#tinhhuong("8.1", "Một bạn ăn không trong nhóm", "Nhóm sáu em, bốn em làm việc, một em đứng nhìn, một em dùng điện thoại. Cả nhóm bực nhưng không dám nói. Cuối buổi nộp sản phẩm tên ai cũng có, trong khi hai em chẳng làm gì.")
#chieu("Nhật ký phần của tôi", "Mỗi em trong nhóm có một tờ nhỏ ghi trong bốn mươi phút: tôi đã làm gì, tôi sẽ làm gì tiếp. Cuối buổi thầy đi một vòng và đọc nhẹ từng tờ. Thầy không phạt ai, chỉ đọc cho nhóm nghe những phần đã có. Em nào tờ giấy trống, thầy hỏi rất nhẹ: phần của em là gì để nhóm xếp giúp. Lúc đó em thường tự lên tiếng nhận việc thay vì ngồi lì.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Mỗi em ghi lại phần việc của mình trên tờ này trong buổi học nhé. Cuối buổi thầy đọc cho cả nhóm nghe những phần đã có.")
  #tro("Dạ... em chưa làm gì nhiều thầy.")
  #thay("Không sao. Em chọn một phần nhỏ để làm nốt trong mười phút còn lại, nhóm sẽ chờ em.")
]
#visao("Ăn không thường vì em không biết mình làm gì, hoặc sợ làm sai. Một tờ ghi từng phần việc làm rõ ranh giới trách nhiệm mà không cần ai trách ai. Khi việc của mình hiện ra trên giấy, em có áp lực nhẹ nhưng rõ để làm.")
#ranhgioi("Không đọc tờ giấy trống của em trước cả lớp. Không phạt cả nhóm vì một người. Nếu em không làm vì không hiểu bài, giúp em trước.")
#bientau("Cho cả nhóm chia việc bằng các thẻ màu, mỗi em bốc một thẻ để ai cũng có nhiệm vụ.")
#caunoi("Mỗi em ghi phần việc của mình, cuối buổi thầy cùng cả nhóm xem.")

#sec("Một bạn giành làm hết, không cho ai chen vào")
#tinhhuong("8.2", "Một bạn giành làm hết, không cho ai chen vào", "Bạn Hạnh học giỏi, luôn tự làm hết bài nhóm vì lo các bạn làm không tốt. Nhóm bực vì không được đóng góp, em thì mệt vì gánh cả nhóm. Sản phẩm đẹp nhưng cả nhóm không học được gì.")
#chieu("Năm phút im lặng của trưởng nhóm", "Thầy nói riêng với Hạnh: thầy thử em một việc khó, năm phút tới em ngồi yên, chỉ quan sát, không được cầm bút, để các bạn làm. Thầy hẹn đến cuối năm phút em kể thầy nghe điều em thấy. Sau đó em chỉ được làm vai người hướng dẫn: hỏi, nhắc, gợi ý, không làm thay. Em thấy sự sai sót của bạn là cơ hội học, và các bạn cuối cùng cũng hiểu bài.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hạnh, thầy thử em một việc khó hơn làm bài: năm phút tới em không được cầm bút, em chỉ quan sát để các bạn làm. Xong em kể thầy nghe em thấy gì.")
  #tro("Dạ... khó quá thầy ơi. Em thấy bạn làm chậm.")
  #thay("Chậm cũng là cách học. Em hướng dẫn thôi, đừng làm thay nhé. Thầy tin em làm được.")
]
#visao("Em giành làm vì lo lắng, không phải vì ích kỷ. Bắt em học cách buông giúp em thấy việc nhóm không phải là tự mình làm hết. Các bạn cũng có cơ hội lên tiếng, và sản phẩm là của cả nhóm.")
#ranhgioi("Không chê em là độc đoán. Không giao nhiệm vụ làm giảm tinh thần chủ động của em. Khen sự trách nhiệm của em trước khi thử thách.")
#bientau("Giao Hạnh vai thư ký ghi lại đóng góp của các bạn khác, em được ngồi cạnh mà không phải làm hộ.")
#caunoi("Em giúp thầy thử một việc khó: năm phút tới em chỉ quan sát, để các bạn làm nhé.")

#sec("Hai bạn giận nhau, không chịu làm chung")
#tinhhuong("8.3", "Hai bạn giận nhau, không chịu làm chung", "Khuê và Ngân từng là bạn thân, giờ giận nhau nên không ai nói với ai. Cùng nhóm nhưng ngồi hai đầu, làm hai phần riêng không khớp. Cả nhóm lúng túng.")
#chieu("Cây bút chung", "Thầy đưa hai em một cây bút và một tờ giấy: hai em cùng cầm một cây bút này viết một đoạn ngắn mô tả điều hai em đều thích về nhóm. Thầy bấm giờ mười phút. Không ai được buông bút, mỗi em chỉ được viết một chữ rồi chuyển. Hai em vừa cười vừa trao đổi. Thầy không nhắc chuyện giận, chỉ để trò chơi làm việc của nó.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hai em chung một cây bút này nhé. Em viết một chữ, đưa bạn viết một chữ tiếp, cứ thế, mười phút viết một đoạn về điều hai em thích ở nhóm.")
  #tro("(Khuê, Ngân ngập ngừng.) Dạ... bắt đầu hả thầy?")
  #thay("Bắt đầu. Thầy không chấm điểm, thầy chỉ muốn xem hai em viết gì.")
]
#visao("Giận nhau thường cần một việc chung để mở cửa mà không phải nói thẳng. Cây bút chung buộc cả hai phối hợp, và phần vui của trò làm tan bớt căng thẳng. Hòa giải xảy ra như phần phụ của việc làm.")
#ranhgioi("Không ép hòa giải. Không nói về chuyện giận trước đám đông. Nếu mâu thuẫn nghiêm trọng, hẹn nói chuyện riêng.")
#bientau("Cho hai em cùng làm một món thủ công nhỏ cho lớp như một tấm thiệp, mỗi em một nửa.")
#caunoi("Hai em chung một cây bút, mỗi người một chữ, viết cho thầy một đoạn nhé.")

#sec("Nhóm làm sơ sài, nộp cho xong")
#tinhhuong("8.4", "Nhóm làm sơ sài, nộp cho xong", "Sản phẩm của nhóm Bốn trông rõ là làm vội, nội dung thiếu, trình bày cẩu thả. Cả nhóm nói đã cố hết sức. Thầy biết các em có khả năng hơn nhiều.")
#chieu("Triển lãm bản nháp", "Thầy không chấm điểm ngay mà dán bản nháp của nhóm lên bảng, kèm một mảnh giấy ghi hai điều nhóm tự thấy đã tốt và hai điều tự muốn nâng cấp. Thầy mời các nhóm khác đi một vòng, mỗi nhóm để lại một mảnh giấy gợi ý tử tế. Nhóm có hai ngày nâng cấp, điểm tính ở bản cuối. Cả nhóm thấy sản phẩm mình trong con mắt người khác nên tự nâng tiêu chuẩn.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy chưa chấm bài này. Nhóm tự ghi hai điều tốt và hai điều muốn nâng cấp, thầy dán lên bảng cho các nhóm khác góp ý. Hai ngày sau mình nộp bản cuối.")
  #tro("Dạ... nhóm em làm lại được thầy.")
  #thay("Thầy tin các em làm được tốt hơn. Bản nháp này chỉ là bản đầu thôi.")
]
#visao("Nộp sơ sài thường vì không ai nhìn sản phẩm bằng con mắt người ngoài. Triển lãm bản nháp tạo ra người xem và động lực tự nâng chuẩn. Điểm chỉ tính ở bản cuối giúp nhóm thấy cơ hội thay vì áp lực.")
#ranhgioi("Chỉ được góp ý về sản phẩm, không về con người. Không để các nhóm so sánh chê bai. Nếu nhóm yếu do thiếu kỹ năng, hỗ trợ thêm.")
#bientau("Mời một bạn ở nhóm khác đóng vai khách hàng đặt câu hỏi cho sản phẩm.")
#caunoi("Đây là bản đầu, hai ngày sau mình nộp bản cuối. Nhóm tự ghi hai điều muốn nâng cấp nhé.")

#sec("Cả nhóm chia phe, kéo bè")
#tinhhuong("8.5", "Cả nhóm chia phe, kéo bè", "Trong lớp xuất hiện hai nhóm đối đầu nhau, ra chơi không nói chuyện, trong giờ làm bài nhóm thì từ chối ghép chung. Có em bị cô lập vì thuộc nhóm bên kia.")
#chieu("Đổi nhóm theo lá thăm", "Thầy tuyên bố trong tuần này mỗi bài nhóm sẽ bốc thăm chia lại. Thầy đặt luật vui: nhóm mới có một nhiệm vụ nhỏ bắt buộc là tìm ra ba điểm chung giữa các thành viên, không được là điểm chung đã biết. Cuối tiết mỗi nhóm đọc ba điểm chung. Dần dần các ranh giới phe nhóm mờ đi, vì các em phát hiện bạn bên kia cũng thích bóng đá hoặc cũng sợ môn Lý.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Tuần này mình bốc thăm chia nhóm. Mỗi nhóm có một nhiệm vụ nhỏ: tìm ra ba điểm chung giữa các thành viên, những điểm chưa ai biết. Cuối tiết mình nghe.")
  #tro("Dạ... bốc thăm luôn hả thầy?")
  #thay("Bốc thăm luôn. Thầy tin lớp mình có nhiều điểm chung hơn mình tưởng.")
]
#visao("Phe nhóm sinh ra từ việc ít tiếp xúc với nhau. Chia lại ngẫu nhiên cộng nhiệm vụ tìm điểm chung tạo ra tiếp xúc có mục đích, đó là cách giảm định kiến hiệu quả nhất. Thầy không cần công khai nói đến mâu thuẫn.")
#ranhgioi("Không chia nhóm để cố ý xếp hai em đang xích mích ngồi gần nhau mà không chuẩn bị. Nếu có em bị cô lập nặng, theo dõi riêng và có thể nói chuyện với các em liên quan.")
#bientau("Làm bảng điểm chung của lớp, ai tìm ra điểm chung hay nhất tuần được ghi vào đó.")
#caunoi("Tuần này mình bốc thăm chia nhóm, mỗi nhóm tìm ba điểm chung chưa ai biết nhé.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 8: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Làm nhóm tốt khi mỗi em nhìn thấy phần của mình. Hãy làm cho phần việc hiện ra bằng tờ giấy, thẻ màu, nhật ký, đừng chỉ bằng lời nhắc.", "Em giành làm hết và em ăn không đều cần được giúp, nhưng cách giúp khác nhau: một em cần học buông, một em cần học bắt đầu.", "Đừng ép hòa giải. Tạo một việc chung để các em tự chạm nhau, hòa giải thường xảy ra như một phần phụ.",))
