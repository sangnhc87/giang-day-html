#import "../template.typ": *

#chapter-open(4, "Ngủ gật, uể oải, mệt đầu giờ", 4, "Trước khi gọi một em là lười, hãy hỏi đêm qua em đã ngủ được mấy tiếng.", "Ngủ gật là lỗi mà thầy cô dễ nóng nhất, và cũng là lỗi có nhiều nguyên nhân thật nhất: thức khuya học bài, chơi game, phụ giúp gia đình, đi làm thêm, hay đơn giản là tuổi dậy thì cần ngủ nhiều hơn người lớn. Chương này gợi những cách đánh thức nhẹ, vui, và quan trọng hơn là cách tìm ra lý do thật.", ("Em gục đầu xuống bàn giữa tiết", "Em ngủ gật vì thức khuya chơi game", "Em ngủ gật vì đêm làm việc phụ gia đình", "Cả lớp ngáp dây chuyền", "Em buồn ngủ ngay sau giờ thể dục",), en: ("Dozing, drowsy, tired at the start of the day", "Before calling a student lazy, ask how many hours he slept last night.", "Dozing is the fault that makes teachers angriest, and also the one with the most real causes: late-night study, gaming, helping at home, part-time work, or simply an adolescence that needs more sleep than an adult. This chapter offers gentle, light ways to wake a student, and, more importantly, ways to find the real reason.", ("A student drops his head on the desk mid-lesson", "A student dozes from gaming late at night", "A student dozes because of work at home", "The whole class yawns in a chain", "A student is sleepy straight after PE",)))

#sec("Em gục đầu xuống bàn giữa tiết", en: "A student drops his head on the desk mid-lesson")
#tinhhuong("4.1", "Em gục đầu xuống bàn giữa tiết", "Bạn Long gục đầu xuống bàn từ phút thứ mười lăm. Thầy gọi một lần thì em ngẩng lên, vài phút sau lại gục. Cả lớp bắt đầu liếc nhìn.", en: "Long has had his head on the desk since the fifteenth minute. You call once and he lifts it; a few minutes later it is down again. The class is starting to glance over.")
#chieu("Bàn đứng cuối lớp", "Thầy nói nhẹ nhàng: Long ơi, em đang buồn ngủ lắm. Thầy cho em xuống cuối lớp học đứng năm phút. Có một bàn cao ở cuối lớp mà thầy dành sẵn. Em đứng học ở đó, tay cầm vở. Năm phút sau em quay lại chỗ cũ. Không ai bị gọi tên, không ai bị cười, vì thầy đã nói đó là chỗ riêng cho ai cần tỉnh táo. Cuối tiết thầy hỏi riêng hôm qua em ngủ lúc mấy giờ.", en: ("The standing desk at the back", "Say gently: Long, you are very sleepy. I will let you go to the back and study standing for five minutes. A tall desk is kept ready at the back. He stands there holding his notebook. Five minutes later he returns to his seat. Nobody is named or laughed at, because you have said it is a place for anyone who needs to stay alert. At the end of the lesson ask him privately what time he went to sleep last night."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Long, thầy thấy em đang rất mệt. Em xuống bàn đứng cuối lớp học vài phút cho tỉnh nhé. Không phải phạt đâu, đó là chỗ thầy dành cho ai cần.", en: "Long, I can see you are very tired. Go to the standing desk at the back and study there for a few minutes to wake up. It is not a punishment, it is a place I keep for whoever needs it.")
  #tro("Dạ... em cảm ơn thầy.", en: "Um... thank you, sir.")
  #thay("Cuối tiết thầy hỏi em một chuyện nhỏ, em ghé thầy nhé.", en: "At the end of the lesson I will ask you something small; see me then.")
]
#visao("Gọi em dậy trước lớp làm em xấu hổ và vẫn buồn ngủ. Cho em đứng học thay đổi tư thế, làm máu lên não, và biến chỗ đứng thành quyền chứ không phải bị phạt. Việc hỏi riêng cuối tiết mới là chỗ thầy chạm vào nguyên nhân.", en: "Waking him in front of the class shames him and he is still sleepy. Standing changes his posture, sends blood to the brain, and makes the spot a right, not a penalty. The private question afterwards is what touches the cause.")
#ranhgioi("Không dùng cho em có bệnh hoặc hoa mắt. Không đặt bàn đứng như chỗ phạt cố định. Nếu em gục mỗi tiết, mỗi ngày, nghĩ tới vấn đề sức khỏe hoặc gia đình.", en: "Do not use it for a student who is ill or faint. Do not keep the standing desk as a fixed place of punishment. If he sleeps every lesson, every day, think of health or family problems.")
#bientau("Cho cả lớp một phút vươn vai mỗi khi thầy thấy cả lớp rũ rượi, để bàn đứng không trở thành dấu hiệu riêng của em nào.", en: "Give the whole class a one-minute stretch whenever you see everyone slumping, so the standing desk is not a signal for one student.")
#caunoi("Em xuống cuối lớp đứng học vài phút cho tỉnh nhé. Cuối tiết thầy hỏi em một chút.", en: "Go and stand at the back for a few minutes to wake up. At the end of the lesson I will ask you something.")

#sec("Em ngủ gật vì thức khuya chơi game", en: "A student dozes from gaming late at night")
#tinhhuong("4.2", "Em ngủ gật vì thức khuya chơi game", "Nhìn quầng thâm là thầy đoán ra. Bạn Kiệt thừa nhận hôm qua chơi game đến hai giờ sáng. Em ngủ gật gần như mỗi tiết đầu. Ba mẹ đã nhắc mà em không nghe.", en: "The dark circles say it all. Kiet admits he played until two in the morning. He dozes almost every first lesson. His parents have told him and he does not listen.")
#chieu("Nhật ký giờ ngủ ba ngày", "Thầy cho Kiệt một thử thách nhỏ: ba ngày liên tiếp ghi lại giờ ngủ thật vào một tờ giấy nhỏ, rồi sáng hôm sau ghi mức tỉnh táo từ một đến mười. Thầy chỉ xem, không bình luận. Sau ba ngày, thầy hỏi em thấy gì. Thường em tự thấy mối liên hệ giữa giờ ngủ và độ tỉnh táo. Nếu em giữ được giờ ngủ trước mười một giờ hai ngày, thầy có một món thưởng nhỏ như đổi chỗ ngồi.", en: ("Three-day sleep log", "Give Kiet a small challenge: for three days in a row, write his real bedtime on a slip, and next morning rate his alertness from one to ten. You only look; you do not comment. After three days ask what he sees. Usually he finds the link between sleep and alertness himself. If he keeps to bed before eleven for two days, you give a small reward, like changing his seat."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Kiệt, thầy không bắt em bỏ game. Thầy chỉ xin em thử ghi lại giờ ngủ ba ngày, sáng ghi mức tỉnh táo từ một đến mười. Rồi mình xem nó nói gì.", en: "Kiet, I am not asking you to quit gaming. I only ask you to log your bedtime for three days, and in the morning rate your alertness one to ten. Then we see what it says.")
  #tro("Dạ... chỉ ghi thôi hả thầy?", en: "Um... just write it down, sir?")
  #thay("Chỉ ghi thôi. Thầy không chấm điểm, thầy chỉ tò mò xem con số kể chuyện gì.", en: "Just write it down. I do not grade it, I am only curious what the numbers will tell.")
]
#visao("Bắt em bỏ game thì em chống. Ghi lại giờ ngủ giúp em tự nhìn thấy mối quan hệ nguyên nhân kết quả. Học sinh tuổi này nghe tự mình tìm ra điều gì thì nhớ lâu hơn nghe người lớn nói.", en: "Tell him to quit gaming and he resists. Recording his sleep lets him see cause and effect for himself. Students of this age remember what they discover themselves far longer than what adults tell them.")
#ranhgioi("Không tịch thu máy hay cấm chơi game thay phụ huynh. Không đọc nhật ký trước lớp. Nếu em chơi game cả đêm liên tục, rủ phụ huynh cùng trao đổi.", en: "Do not confiscate his device or ban gaming in place of his parents. Do not read the log aloud. If he games through the night repeatedly, invite his parents to talk it through together.")
#bientau("Cho em thêm cột ghi tâm trạng, để em thấy giấc ngủ ảnh hưởng cả cảm xúc.", en: "Add a mood column so he sees sleep affecting his feelings too.")
#caunoi("Thầy không bắt em bỏ game. Em thử ghi giờ ngủ ba ngày, rồi mình xem nó nói gì.", en: "I am not asking you to quit gaming. Log your bedtime for three days and we will see what it tells us.")

#sec("Em ngủ gật vì đêm làm việc phụ gia đình", en: "A student dozes because of work at home")
#tinhhuong("4.3", "Em ngủ gật vì đêm làm việc phụ gia đình", "Bạn Mai ngủ gật gần như mỗi sáng. Thầy biết nhà em bán hàng đêm, em phụ ba mẹ đến khuya. Em không bao giờ than, chỉ xin lỗi mỗi khi bị gọi dậy.", en: "Mai dozes almost every morning. You know her family sells food at night and she helps until late. She never complains, only apologises whenever she is woken.")
#chieu("Góc nghỉ mười phút", "Đây là chiêu không phạt. Thầy nói riêng với Mai: nếu em thấy quá mệt, em ra ngoài rửa mặt mười phút, không cần xin phép, chỉ cần gật đầu với thầy. Thầy đặt một chiếc ghế nhỏ ở cuối hành lang gần phòng học cho em ngồi nghỉ. Thầy cũng gọi riêng em lớp trưởng nhờ không ghi tên em khi em ra ngoài. Thầy ghi âm thầm vào sổ tay để lúc cần nói chuyện với nhà trường hay gia đình.", en: ("The ten-minute rest corner", "This is a no-punishment move. Tell Mai privately: if you are too tired, go out and wash your face for ten minutes; you need no permission, just nod to me. Put a small chair at the end of the corridor near the room for her to sit. Quietly ask the class monitor not to note her name when she steps out. Write a private note in your own notebook for when a talk with the school or family is needed."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Mai, thầy biết nhà em vất vả. Khi em quá mệt, em chỉ cần gật đầu với thầy rồi ra rửa mặt mười phút. Thầy không hỏi lý do.", en: "Mai, I know your family works hard. When you are too tired, just nod to me and go and wash your face for ten minutes. I will not ask why.")
  #tro("(Mắt đỏ.) Dạ... em cảm ơn thầy.", en: "(Eyes red.) Um... thank you, sir.")
  #thay("Em không có lỗi gì hết. Thầy chỉ muốn em học được nhiều nhất trong khả năng của em.", en: "You have done nothing wrong. I only want you to learn as much as you can within what you are able to.")
]
#visao("Phạt em vì mệt do gánh việc gia đình là bất công và làm em thấy xấu hổ vì hoàn cảnh. Cho em một cách xử lý kín đáo giúp em giữ lòng tự trọng và vẫn theo kịp bài.", en: "Punishing her for tiredness caused by family work is unjust and shames her for her circumstances. A discreet arrangement lets her keep her dignity and still keep up with the lesson.")
#ranhgioi("Không công khai hoàn cảnh em với lớp. Không ép em kể thêm nếu em chưa muốn. Nếu em cần hỗ trợ thật, liên hệ nhà trường và các quỹ hỗ trợ một cách kín đáo.", en: "Do not reveal her circumstances to the class. Do not press her to tell more if she is not ready. If she truly needs support, quietly contact the school and support funds.")
#bientau("Tặng em một bản tóm tắt bài cuối tiết để em không lỡ nội dung khi ra ngoài.", en: "Give her a summary of the lesson at the end so she does not miss content when she steps out.")
#caunoi("Khi quá mệt em cứ gật đầu với thầy rồi ra rửa mặt. Thầy không hỏi lý do.", en: "When you are too tired, just nod to me and go and wash your face. I will not ask why.")

#sec("Cả lớp ngáp dây chuyền", en: "The whole class yawns in a chain")
#tinhhuong("4.4", "Cả lớp ngáp dây chuyền", "Tiết thứ ba buổi sáng, một em ngáp, rồi cả dãy ngáp theo như dây chuyền. Thầy đang giảng mà thấy cả lớp đờ đẫn. Nhắc nhở thì không có em nào cố ý, chỉ là mệt.", en: "Third lesson of the morning; one student yawns, then the whole row follows like a chain. You are mid-explanation and see a glazed class. Nobody yawns on purpose; they are simply tired.")
#chieu("Một phút tỉnh dậy", "Thầy dừng giảng, mỉm cười: cả lớp đang ngáp theo thầy phải không? Thầy phát lệnh: đứng dậy, vươn vai thật to, ngáp thật to một lần cho đã, rồi ngồi xuống uống một ngụm nước. Sau một phút, thầy hỏi ai thấy tỉnh hơn thì giơ tay. Thầy ghi nhận con số. Chiêu này không phạt ai, nhưng biến cơn buồn ngủ thành hoạt động tập thể ngắn và vui.", en: ("One minute to wake up", "Stop teaching and smile: is the whole class yawning with me? Give the command: stand up, stretch as wide as you can, yawn as big as you like once, then sit and take a sip of water. After a minute, ask who feels more awake to raise a hand. Note the number. This punishes no one but turns drowsiness into a short, fun group activity."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Cả lớp đứng dậy nào! Vươn vai thật to, ngáp thật to một lần cho đã. Xong rồi ngồi xuống uống nước. Ai thấy tỉnh hơn thì giơ tay.", en: "Everyone stand up! Stretch wide, yawn as big as you can once, as much as you like. Then sit and drink water. Who feels more awake, raise your hand.")
  #tro("(Cười, cả lớp làm theo.) Dạ!", en: "(Laughing, the class does it.) Yes!")
  #thay("Tốt. Giờ mình học tiếp, lần này tỉnh hơn rồi nhé.", en: "Good. Now we carry on, and this time more awake.")
]
#visao("Ngáp dây chuyền là phản xạ xã hội. Cho cả lớp làm điều đó có kiểm soát thì cơn buồn ngủ vơi bớt, và lớp cười nên thoải mái hơn. Thầy được coi là người hiểu lớp thay vì người cấm.", en: "A chain of yawns is a social reflex. Letting the class do it in a controlled way eases the drowsiness, and laughing helps them relax. You are seen as someone who understands the class instead of someone who forbids.")
#ranhgioi("Không ép những em thật sự không khỏe phải đứng. Không kéo dài quá hai phút.", en: "Do not force anyone who is truly unwell to stand. Do not let it run beyond two minutes.")
#bientau("Thêm bài tập thở bốn nhịp, hít bốn giây giữ bốn giây thở bốn giây.", en: "Add a four-count breathing exercise: in for four, hold four, out four.")
#caunoi("Cả lớp đứng dậy ngáp thật to một lần cho đã rồi mình học tiếp.", en: "Everyone stand and yawn as big as you like once, and then we go on with the lesson.")

#sec("Em buồn ngủ ngay sau giờ thể dục", en: "A student is sleepy straight after PE")
#tinhhuong("4.5", "Em buồn ngủ ngay sau giờ thể dục", "Tiết sau thể dục, Nam ngồi đờ đẫn, mắt lờ đờ, mồ hôi còn ướt áo. Em không chú ý bài. Cả lớp cũng uể oải theo.", en: "In the lesson after PE, Nam sits dazed, eyes dull, shirt still damp with sweat. He is not following the lesson. The class is sluggish with him.")
#chieu("Cốc nước của thầy", "Thầy chuẩn bị sẵn một bình nước lọc trên bàn. Đầu tiết sau thể dục, thầy rót cho mỗi em một ngụm nhỏ, vừa rót vừa hỏi một câu hỏi vui: em vừa chơi môn gì, thắng hay thua. Cả lớp nói chuyện chừng ba phút. Sau đó cùng hít thở sâu ba lần rồi vào bài. Hình phạt nằm ở chỗ thầy không để cơ thể các em bị bỏ quên: thầy phạt sự lơ đãng bằng chăm sóc.", en: ("The teacher's cup of water", "Keep a jug of water ready on your desk. At the start of the lesson after PE, pour each student a small sip while asking a fun question: what did you play, did you win or lose? The class chats for about three minutes. Then all take three deep breaths and start the lesson. The punishment lies in not letting their bodies be forgotten: you answer inattention with care."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Mời cả lớp một ngụm nước. Ai vừa chơi gì, thắng thua thế nào, kể thầy nghe ba phút. Rồi mình hít thở sâu và vào bài.", en: "A sip of water for everyone. Who played what, who won, tell me in three minutes. Then we take deep breaths and begin.")
  #tro("Dạ, tụi em đá bóng, lớp mình thắng ạ!", en: "Yes, we played football, our class won!")
  #thay("Hay lắm. Giờ cho phần thắng nghỉ ngơi, mình trở lại bài toán nào.", en: "Very good. Let the winners rest now, and we return to the maths problem.")
]
#visao("Cơ thể sau vận động cần thời gian hạ nhịp. Gọi các em chú ý ngay là lấy phần cơ thể chưa sẵn sàng. Một ngụm nước và vài phút trò chuyện giúp cả lớp chuyển trạng thái nhẹ nhàng.", en: "After exercise the body needs time to settle. Demanding attention at once asks for what is not ready. A sip of water and a few minutes of chat help the whole class change state gently.")
#ranhgioi("Không dùng nước khi có em bị bệnh phải kiêng. Không để phần trò chuyện kéo dài thành ồn ào.", en: "Do not offer water to students who must avoid it for health reasons. Do not let the chat grow into noise.")
#bientau("Dùng hai phút ngồi nhắm mắt nghe nhạc nhẹ thay cho trò chuyện.", en: "Use two minutes of sitting with eyes closed to quiet music in place of the chat.")
#caunoi("Mình uống một ngụm nước, nghỉ ba phút rồi vào bài nhé.", en: "Let us drink some water, rest three minutes and then begin.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 4: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Đừng gọi tên em ngủ gật trước lớp. Chạm vai nhẹ, hoặc đi ngang bàn gõ nhẹ, hoặc cho cả lớp vận động trước.", "Mỗi em ngủ gật có một lý do riêng. Hỏi riêng sau tiết giá trị hơn mười lần nhắc công khai.", "Một em ngủ gật liên tục kéo dài thường là tín hiệu cho thầy cô, không phải lỗi của em. Hãy ghi lại và nói chuyện với gia đình khi cần.",), en: ("Do not call out a dozing student in front of the class. A light touch on the shoulder, a tap on the desk as you pass, or a class stretch first.", "Every dozing student has a reason of their own. One private question after the lesson is worth ten public reminders.", "A student who keeps dozing for a long time is usually a signal to the teacher, not a fault in the student. Note it and speak to the family when needed.",))
