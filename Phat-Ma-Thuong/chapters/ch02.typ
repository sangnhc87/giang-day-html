#import "../template.typ": *

#chapter-open(2, "Cả lớp ồn: khi lỗi là của tập thể", 2, "Lớp ồn không phải kẻ thù. Lớp ồn là một nguồn năng lượng chưa có chỗ đi.", "Phạt một em thì dễ. Phạt cả lớp mới khó, vì phạt tập thể rất dễ thành bất công với những em ngoan. Chương này gom những chiêu để thầy cô đưa cả lớp về nhịp học mà không phải la, không phải đập bàn, và không bắt em nào gánh lỗi thay người khác. Điểm chung: lớp tự điều chỉnh, thầy chỉ giữ nhịp.", ("Cả lớp ồn lên sau giờ ra chơi", "Chiều muộn, lớp rã rời và rộn ràng", "Cả lớp đồng loạt gõ bàn trêu thầy", "Giờ tự học, thầy ra ngoài là lớp ồn", "Có tiếng động lạ mà không biết ai làm",), en: ("A noisy class: when the fault is collective", "A noisy class is not the enemy. It is energy that has not yet found somewhere to go.", "Punishing one student is easy. Punishing the whole class is hard, because collective punishment so easily becomes unfair to the well-behaved. This chapter gathers moves that bring the whole class back to its rhythm without shouting or slamming the desk, and without making any one student carry the blame for others. What they share: the class adjusts itself, and you only keep the beat.", ("The class erupts after break", "Late afternoon: tired and restless at once", "The whole class drums on the desks to tease you", "Study period: the teacher steps out and the class gets loud", "A strange noise and nobody owns up",)))

#sec("Cả lớp ồn lên sau giờ ra chơi", en: "The class erupts after break")
#tinhhuong("2.1", "Cả lớp ồn lên sau giờ ra chơi", "Chuông vào lớp đã reo, mà lớp vẫn như cái chợ. Thầy bước vào, nhiều em vẫn đứng nói, có em chạy từ cuối lớp lên. Mỗi lần thầy phải mất năm bảy phút mới ổn định được lớp, trong khi tiết học chỉ có bốn lăm phút.", en: "The bell for class has rung, yet the room is like a market. You walk in and many are still standing and talking, one is running up from the back. Each time it takes five or seven minutes to settle them, out of a forty-five-minute lesson.")
#chieu("Tài khoản giây", "Thầy bước vào, không nói gì, lặng lẽ viết lên góc bảng chữ T và bắt đầu ghi số giây lớp chưa yên. Khi lớp ngồi xuống và im, thầy chốt con số, ví dụ 74 giây. Thầy nói: lớp đang nợ thầy 74 giây. Cuối tiết, thầy không giữ lớp lại, mà đổi: số giây đó được trả bằng cách lớp đứng im đọc to một câu thơ hoặc một công thức của bài hôm nay. Số giây ngày hôm sau thường giảm hẳn vì cả lớp tự nhìn thấy con số của mình.", en: ("The seconds account", "Walk in without a word and quietly write a T on the corner of the board, then start recording the seconds the class takes to settle. When all are seated and quiet, fix the number, say 74 seconds. Say: the class owes me 74 seconds. At the end of the lesson do not keep them in; instead they repay by standing quietly and reading aloud a line of poetry or a formula from today. The next day the number usually drops sharply, because the class has seen its own figure."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy không la. Thầy chỉ ghi lại. Lớp mình đang nợ thầy bảy mươi bốn giây. Cuối tiết mình trả nhé, trả bằng cách đọc to công thức hôm nay.", en: "I am not shouting. I am only recording. The class owes me seventy-four seconds. At the end of the lesson we repay it by reading today's formula aloud.")
  #tro("Dạ, tụi em trả ạ.", en: "Yes, we will repay it.")
  #thay("Mai thầy ghi lại. Thầy đoán con số sẽ nhỏ hơn.", en: "Tomorrow I will record again. I expect the number to be smaller.")
]
#visao("Lớp ồn vì không có ai đo được nó. Một con số đứng trên bảng khiến cả lớp thấy mình đang bị đo, mà không có ai bị mắng. Việc trả nợ bằng đọc lại kiến thức biến hình phạt thành một lần ôn bài.", en: "A class gets loud because nobody can measure it. A figure on the board makes everyone feel measured, while no one is scolded. Repaying the debt by recalling knowledge turns the punishment into a review.")
#ranhgioi("Không ghi tên từng em lên bảng. Không kéo dài quá ba phút khi trả nợ. Nếu có em lớp nhiều lần nhắc mà vẫn ồn, làm riêng với em đó thay vì để cả lớp gánh.", en: "Do not write individual names on the board. Do not stretch the repayment beyond three minutes. If one student repeatedly ignores reminders, deal with that student privately instead of making the class carry it.")
#bientau("Đổi thành đồng hồ cát lật ngược đặt trên bàn thầy, cát chảy hết mà lớp chưa im thì cuối tiết lớp tặng thầy một tràng pháo tay cho thầy kiên nhẫn.", en: "Change it to an hourglass on your desk: if the sand runs out before the class is quiet, at the end of the lesson the class gives you a round of applause for your patience.")
#caunoi("Thầy không giận, thầy chỉ đang đếm. Lớp mình tự trả nhé.", en: "I am not angry, I am only counting. Let us repay it ourselves.")

#sec("Chiều muộn, lớp rã rời và rộn ràng", en: "Late afternoon: tired and restless at once")
#tinhhuong("2.2", "Chiều muộn, lớp rã rời và rộn ràng", "Tiết cuối buổi chiều, trời nóng, cả lớp vừa mệt vừa rộn. Thầy nói lớn thì ồn thêm, thầy nói nhỏ thì không ai nghe. Đưa ra chuông, đập bàn đều không còn tác dụng.", en: "Last lesson of the afternoon, hot weather, the class both worn out and fidgety. Speak loudly and it gets noisier, speak softly and nobody hears. The bell and the thumping of the desk no longer work.")
#chieu("Thầy thì thầm", "Thầy ngừng giảng, bước đến giữa lớp, nói thật nhỏ gần như thì thầm. Em nào nghe được thì chăm chú, những em không nghe được sẽ phải im để nghe. Thầy giảng liên tục năm phút như thế, sau đó hỏi một câu nhỏ cũng bằng giọng thì thầm. Nếu lớp vẫn ồn, thầy dừng hẳn, mỉm cười, chờ. Cả lớp tự im vì tò mò thầy sắp nói gì.", en: ("The teacher whispers", "Stop teaching, walk to the middle of the room and speak very softly, almost whispering. Those who can hear will concentrate; those who cannot will have to be quiet to hear. Teach like this for five minutes, then ask a small question, also whispered. If the class stays noisy, stop completely, smile and wait. The class quiets down out of curiosity about what you are about to say."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Rất nhỏ, mỉm cười.) Từ giờ thầy nói nhỏ thôi. Em nào muốn nghe thì im giúp thầy nhé. Đây là phần quan trọng nhất của tiết.", en: "(Very softly, smiling.) From now on I will speak quietly. Whoever wants to hear, please be quiet for me. This is the most important part of the lesson.")
  #tro("(Thì thầm lại.) Dạ.", en: "(Whispering back.) Yes.")
  #thay("Tốt. Câu hỏi thứ nhất, nhỏ thôi, thầy hỏi: đường tròn có bao nhiêu trục đối xứng?", en: "Good. First question, quietly: how many axes of symmetry does a circle have?")
]
#visao("Âm thanh lớn khiến cả lớp tự động nâng giọng theo. Hạ giọng thì cả lớp hạ theo. Chiêu này không phạt ai, nhưng làm cho sự ồn tự mất ý nghĩa vì không còn cuộc cạnh tranh về âm lượng.", en: "Loud sound makes the whole class raise its voice. Lowering yours makes them lower theirs. This move punishes no one, but it removes the point of the noise because there is no contest of volume.")
#ranhgioi("Không dùng khi lớp ồn vì xô xát hay mâu thuẫn thật. Lúc đó cần dừng hẳn và giải quyết chuyện đó trước.", en: "Do not use it when the noise comes from a scuffle or real conflict. Then stop completely and deal with that first.")
#bientau("Dùng một biển nhỏ ghi chữ SHHH đặt lên bảng, khi nào lớp im thì thầy mới lật mặt sau có chữ Cảm ơn.", en: "Put a small sign reading SHHH on the board; when the class is quiet you turn it round to show Thank you.")
#caunoi("Thầy nói nhỏ để dành cho những ai thật sự muốn nghe.", en: "I speak softly for those who truly want to hear.")

#sec("Cả lớp đồng loạt gõ bàn trêu thầy", en: "The whole class drums on the desks to tease you")
#tinhhuong("2.3", "Cả lớp đồng loạt gõ bàn trêu thầy", "Thầy vừa bước vào, cả lớp gõ bàn theo nhịp. Có vẻ là một trò đùa đã bàn trước. Nhìn thì vui nhưng thầy thấy đó là một thử thách quyền lực nho nhỏ.", en: "As you walk in, the whole class drums on the desks in rhythm. It looks like a joke planned in advance. It seems fun, but you sense it is a small test of authority.")
#chieu("Nhạc trưởng", "Thầy đứng yên, mỉm cười, rồi giơ tay như nhạc trưởng chuyên nghiệp và chỉ huy chính tiếng gõ đó: nhanh dần, chậm dần, to dần, nhỏ dần, rồi dừng đột ngột bằng nắm tay. Sau một phút, thầy cúi chào: cảm ơn dàn nhạc, tiết mục kết thúc. Cả lớp hiểu thầy biết trò đùa, thầy chơi cùng, nhưng thầy là người cầm đũa nhạc.", en: ("The conductor", "Stand still and smile, then raise your hand like a professional conductor and conduct that very drumming: faster, slower, louder, softer, then stop abruptly with a closed fist. After a minute bow: thank you, orchestra, the performance is over. The class understands that you know the joke, play along, but hold the baton."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Ồ, lớp mình có dàn nhạc à? Để thầy chỉ huy cho chuyên nghiệp nhé. Nhanh dần... chậm dần... và dừng!", en: "Oh, does our class have an orchestra? Let me conduct it properly. Faster... slower... and stop!")
  #tro("(Cười rộ.) Thầy chơi luôn hả thầy!", en: "(Laughing.) The teacher is joining in!")
  #thay("Cảm ơn dàn nhạc. Giờ mình sang bản nhạc tiếp theo: bài Hàm số.", en: "Thank you, orchestra. Now on to the next piece: Functions.")
]
#visao("Một trò thử thách thường chờ phản ứng giận dữ. Khi thầy tiếp nhận và cầm quyền điều khiển, trò chơi mất đi phần kịch tính vì không còn gì để chống lại. Học sinh nhớ thầy là người biết đùa mà vẫn giữ nhịp.", en: "A test of nerve usually waits for an angry reaction. When you absorb it and take the baton, the game loses its drama because there is nothing left to push against. Students remember you as someone who can joke and still keep the beat.")
#ranhgioi("Chỉ áp dụng khi tiếng gõ là một trò đùa chung, không nhắm xúc phạm. Nếu nhịp gõ kèm lời chế nhạo thầy hay bạn, dừng và nói thẳng thắn, bình tĩnh.", en: "Use only when the drumming is a shared joke, not meant to insult. If the beat comes with mockery of you or a classmate, stop and speak plainly and calmly.")
#bientau("Mời một học sinh khéo tay lên làm nhạc trưởng lần sau, thầy làm khán giả.", en: "Invite a skilled student to be conductor next time while you sit as audience.")
#caunoi("Thầy rất thích dàn nhạc này. Thầy chỉ huy một chút rồi mình vào bài nhé.", en: "I love this orchestra. Let me conduct a little and then we start the lesson.")

#sec("Giờ tự học, thầy ra ngoài là lớp ồn", en: "Study period: the teacher steps out and the class gets loud")
#tinhhuong("2.4", "Giờ tự học, thầy ra ngoài là lớp ồn", "Thầy ra khỏi lớp năm phút để nghe điện thoại hay lấy tài liệu, quay lại thì lớp ồn như họp chợ. Em lớp trưởng ghi tên mấy bạn nói chuyện, nhưng các bạn đó bị ghét lại.", en: "You leave the room for five minutes to take a call or fetch papers, and come back to a class as noisy as a market. The class monitor wrote down the names of some who talked, but those students now resent him.")
#chieu("Chấm xanh yên tĩnh", "Thầy đưa ra một bảng lớn có mười ô vuông nhỏ. Mỗi lần thầy vắng mà lớp giữ được yên tĩnh, cả lớp tự tô một chấm xanh. Khi đủ mười chấm xanh, lớp được thầy chọn một phần thưởng nhỏ do chính lớp đề xuất, như mười phút nghe nhạc hay thầy kể một câu chuyện. Nếu lớp ồn, không có chấm xanh nhưng cũng không trừ, chỉ chờ lần sau. Lớp trưởng không ghi tên ai, chỉ báo có hay không có chấm.", en: ("Quiet green dots", "Put up a big chart with ten small squares. Each time you are out and the class stays quiet, the class itself colours one green dot. With ten green dots, the class gets a small reward you choose from the class's own proposals, such as ten minutes of music or a story from you. If the class is noisy, there is no dot but no deduction either; just wait for next time. The monitor writes no names, only reports yes or no."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Từ giờ mỗi lần thầy ra ngoài mà lớp tự giữ yên thì được một chấm xanh. Mười chấm xanh, lớp mình chọn một phần thưởng. Thầy không cần ai ghi tên ai, chỉ cần lớp tự giữ.", en: "From now on, each time I step out and the class keeps quiet by itself, you earn a green dot. Ten green dots and the class chooses a reward. I do not need anyone to write down names. I only need the class to hold itself.")
  #tro("Dạ. Phần thưởng gì cũng được ạ?", en: "Yes. Any reward at all?")
  #thay("Do lớp bàn, thầy duyệt, miễn là vui và lành mạnh.", en: "The class discusses, I approve, as long as it is fun and wholesome.")
]
#visao("Giao trách nhiệm cho tập thể mà không đẩy một em ra làm cảnh sát. Phần thưởng nhỏ nhưng có tiến độ nhìn thấy được, nên lớp tự có áp lực tích cực. Không trừ chấm khi hỏng giúp lớp không nản.", en: "It gives responsibility to the group without pushing one student into the role of police. The reward is small but progress is visible, so the class feels positive peer pressure. Not deducting dots keeps the class from losing heart.")
#ranhgioi("Không để lớp trưởng bị biến thành người tố cáo. Không dùng phần thưởng đắt hay tốn nhiều giờ học.", en: "Do not turn the monitor into an informer. Do not use costly rewards or ones that eat into lesson time.")
#bientau("Thay chấm xanh bằng mảnh ghép tranh, đủ mười mảnh ghép thì hiện ra bức hình cả lớp.", en: "Replace dots with puzzle pieces; ten pieces and a picture of the whole class appears.")
#caunoi("Thầy tin lớp mình tự giữ được. Mười chấm xanh, lớp chọn phần thưởng.", en: "I trust our class to hold itself. Ten green dots and the class chooses the reward.")

#sec("Có tiếng động lạ mà không biết ai làm", en: "A strange noise and nobody owns up")
#tinhhuong("2.5", "Có tiếng động lạ mà không biết ai làm", "Giữa tiết yên tĩnh, có tiếng như tiếng mèo kêu vang lên từ cuối lớp. Cả lớp cười rộ. Thầy nhìn quanh nhưng không ai nhận. Em nào cũng nhìn đi chỗ khác.", en: "In the middle of a silent lesson, a sound like a cat meowing comes from the back. The whole class laughs. You look round but nobody admits it. Every student looks the other way.")
#chieu("Mời tấu ở giờ ra chơi", "Thầy không truy tìm. Thầy mỉm cười nói: tiếng đó rất giống thật, thầy khâm phục. Ai làm thì ra chơi ghé thầy, tấu lại thật hay cho thầy nghe đúng một lần, rồi lần sau để dành tài năng đó cho văn nghệ lớp. Không gọi tên, không điều tra. Thường sẽ có một em ghé, hoặc cả hai em cùng ghé vì đã bị cả lớp nhìn.", en: ("Invited to perform at break", "Do not hunt for the culprit. Smile and say: that sounded so real I am impressed. Whoever did it, come to me at break and perform it once more for me, then next time save the talent for the school show. No naming, no investigation. Usually one student, or two, will come, having already been stared at by the class."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Tiếng đó giống thật đến nỗi thầy giật mình. Em nào làm xong thì ra chơi ghé thầy tấu thêm một lần, thầy muốn nghe cho kỹ. Còn bây giờ mình học tiếp.", en: "That sounded so real it startled me. Whoever did it, come at break and do it once more for me, I want to hear it properly. For now, back to the lesson.")
  #tro("(Ra chơi, ngượng ngùng.) Dạ... thầy, là em ạ.", en: "(At break, embarrassed.) Um... sir, it was me.")
  #thay("Cảm ơn em đã ghé. Tiếng rất hay. Lần sau, em để dành cho giờ văn nghệ nhé.", en: "Thank you for coming. It was a very good sound. Next time, save it for the show.")
]
#visao("Học sinh nhận lỗi dễ hơn khi không phải nhận trước cả lớp và khi thầy không tỏ ra đã bị xúc phạm. Chiêu này lấy mất phần thử thách của hành vi, đồng thời dẫn em tới chỗ gặp riêng, nơi nói chuyện nhẹ nhàng nhất.", en: "Students own up more easily when they do not have to do it before the class and when you do not seem offended. This takes away the challenge in the act, and leads the student to a private meeting, where the gentlest talk happens.")
#ranhgioi("Không ép em phải nhận. Nếu không ai ghé, thầy cười cho qua. Không phạt cả lớp để tìm ra thủ phạm.", en: "Do not force anyone to confess. If nobody comes, laugh it off. Do not punish the whole class to find the culprit.")
#bientau("Mở một ô tài năng nhỏ ở cuối tuần, ai có tài lẻ như bắt chước tiếng, ảo thuật thì diễn hai phút.", en: "Open a small talent slot at the end of the week: anyone with an odd gift, like mimicry or magic, performs for two minutes.")
#caunoi("Tiếng đó rất tài. Em nào làm thì ra chơi tấu cho thầy nghe riêng nhé.", en: "That was quite a talent. Whoever did it, come at break and perform it for me privately.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 2: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Lớp là một tập thể, nhưng phạt thì phải đến từng người. Phạt tập thể chỉ nên là một trò chơi, không bao giờ là sự trừng phạt có thật.", "Đưa cho lớp một con số, một biểu đồ, một dàn nhạc. Học sinh chịu tự điều chỉnh khi các em nhìn thấy chính mình.", "Thầy cô giữ bình tĩnh là hình phạt lớn nhất với sự ồn ào. Lớp thường lặng đi khi thấy thầy không nổi giận.",), en: ("A class is a group, but punishment must reach individuals. Collective punishment should only ever be a game, never a real penalty.", "Give the class a number, a chart, an orchestra. Students adjust themselves when they can see themselves.", "A calm teacher is the biggest punishment for noise. Classes often quieten when they see you do not rise to it.",))
