#import "../template.typ": *

#chapter-open(4, "Khi con mang điểm kém về nhà", 4, "Tờ bài điểm kém nói cho ba mẹ biết con đang kẹt ở đâu. Nó không nói con là ai.", "Không có buổi tối nào dài bằng buổi tối con cầm bài kiểm tra điểm thấp về nhà. Con đã tự mắng mình suốt đường về, đã tập trước mấy câu chống chế, và đã đoán sẵn ba mẹ sẽ nói gì. Điều con chưa đoán được là ba mẹ có thể phản ứng khác đi. Chương này dành cho bốn kiểu điểm kém khác nhau, vì mỗi kiểu là một căn bệnh riêng, không thể chữa chung một toa.", ("Con đưa bài kiểm tra ba điểm", "Con học hết sức mà điểm vẫn thấp", "Con giấu điểm, sửa điểm", "Con rớt kỳ thi quan trọng",), en: ("When your child brings home a bad mark", "A poor test paper tells you where your child is stuck. It does not tell you who your child is.", "No evening is longer than the one when a child carries home a low mark. They have scolded themselves all the way, rehearsed excuses, and already guessed what their parents will say. What they have not guessed is that parents might respond differently. This chapter covers four kinds of bad marks, because each is its own illness and cannot be treated with one prescription.", ("Your child hands you a three out of ten", "Your child tried their hardest and still scored low", "Your child hides marks or changes them", "Your child fails an important exam",)))

#sec("Con đưa bài kiểm tra ba điểm", en: "Your child hands you a three out of ten")
#boicanh("Thằng Long lớp 6 đứng xớ rớ ở cửa bếp cả mười phút mới rút trong cặp ra tờ bài Toán. Ba điểm. Nó đưa mẹ mà mắt nhìn xuống nền gạch.", en: "Long, in grade 6, hovers at the kitchen door for ten minutes before pulling a maths paper from his bag. Three. He hands it to Mum with his eyes on the floor tiles.")
#phanxa("Ba điểm! Học hành kiểu gì vậy? Cho ăn học đàng hoàng mà đem về ba điểm. Cắt hết điện thoại từ hôm nay!", "Điểm thấp là mẹ hết thương. Lần sau giấu bài đi, hoặc sửa điểm, miễn đừng để mẹ thấy.", en: ("Three! What kind of studying is this? We give you everything and you bring home a three. No phone from today!", "A low mark means Mum stops loving me. Next time hide the paper, or change the mark, anything so she doesn't see."))
#scene("Tình huống 4.1 · Thử nói cách khác")[
  #me("(Cầm bài, nhìn một lúc.) Con tự đưa mẹ coi. Chắc con phải lấy can đảm dữ lắm mới đưa.", en: "(Takes the paper, looks for a moment.) You gave this to me yourself. That must have taken a lot of courage.")
  #con("Con sợ mẹ la.", en: "I was scared you'd shout.")
  #me("Mẹ nói thật là mẹ có lo. Nhưng mẹ thấy con còn buồn hơn mẹ. Lúc cô phát bài ra con thấy sao?", en: "Honestly, I am worried. But I can see you are sadder than I am. How did you feel when the teacher handed it back?")
  #con("Con muốn khóc. Cả lớp có mình con với thằng Tú dưới trung bình.", en: "I wanted to cry. Only Tu and I were below average in the whole class.")
  #me("Vậy là con quê từ lúc đó tới giờ. Thôi, điểm thì nó nằm đó rồi. Mình coi nó nói gì. Con chỉ mẹ: câu nào con biết làm mà sai, câu nào con không biết làm luôn?", en: "So you've been embarrassed since then. Well, the mark is what it is. Let's see what it says. Show me: which questions did you know how to do but got wrong, and which did you not know at all?")
  #con("Câu 1, câu 2 con biết mà tính lộn dấu. Từ câu 3 trở đi con không hiểu đề.", en: "Questions 1 and 2 I knew, but I mixed up the signs. From question 3 on I didn't understand what was being asked.")
  #me("Vậy là có hai chuyện khác nhau. Tính lộn dấu thì tập cẩn thận. Còn không hiểu đề từ câu 3 là mình đang hổng một khúc. Khúc đó cô dạy tuần nào con nhớ không?", en: "Then there are two different things. Mixing up signs means practising care. Not understanding from question 3 means we have a gap. Do you remember which week that part was taught?")
  #con("Tuần con bị sốt nghỉ ba ngày.", en: "The week I had a fever and missed three days.")
  #me("À. Vậy là có lý do hẳn hoi, không phải con dốt. Cuối tuần này mình gỡ lại khúc đó, mẹ hỏi cô xin bài.", en: "Ah. So there is a real reason, and it isn't that you're stupid. This weekend we'll catch up on that part; I'll ask your teacher for the material.")
]
#hieusau1("Trẻ đem bài điểm kém về đã ở sẵn trong trạng thái sợ và xấu hổ. Trong trạng thái đó, não chỉ lo đối phó, không học thêm được gì từ lời mắng. Việc ba mẹ ghi nhận sự can đảm đưa bài ra giúp con giữ lại thói quen quý nhất: nói thật. Sau đó tách bài ra thành câu biết mà sai và câu không biết làm sẽ biến một con số đáng sợ thành những việc cụ thể làm được.", en: "A child bringing home a poor mark is already afraid and ashamed. In that state the brain only copes; it learns nothing more from scolding. Acknowledging the courage it took to hand over the paper protects the most precious habit: telling the truth. Then splitting the paper into knew it but slipped and did not know turns a frightening number into concrete things that can be done.")
#cotloi("Phạt vì điểm kém chỉ dạy con giấu điểm. Cùng con mổ xẻ tờ bài mới dạy con học.", en: "Punishing a bad mark only teaches a child to hide marks. Going through the paper together teaches them to learn.")
#lamngay1("Lấy một bài kiểm tra gần đây của con, cùng con dùng hai cây bút màu: một màu khoanh câu biết làm mà sai, một màu khoanh câu chưa biết làm. Chỉ lên kế hoạch cho màu thứ hai.", en: "Take a recent test and go through it with your child using two coloured pens: one colour for questions they knew but got wrong, another for those they did not know. Make a plan only for the second colour.")
#caunoi("Con dám đưa bài cho mẹ coi, mẹ quý chuyện đó. Giờ mình coi tờ bài này muốn nói gì.", en: "You dared to show me this paper, and I value that. Now let's see what it is trying to tell us.")
#tusoi(("Ở nhà mình, đưa điểm kém ra thì an toàn hơn hay giấu đi thì an toàn hơn?", "Mình có biết môn nào con đang hổng kiến thức từ thời điểm nào không?",), en: ("In our home, is it safer to show a bad mark or to hide it?", "Do I know in which subject, and since when, my child has gaps?",))

#sec("Con học hết sức mà điểm vẫn thấp", en: "Your child tried their hardest and still scored low")
#boicanh("Con bé Ngọc lớp 9 tuần rồi ba đêm liền thức tới mười hai giờ để ôn Văn. Bài về năm rưỡi. Nó quăng cặp, đóng cửa phòng. Mẹ nghe tiếng khóc.", en: "Last week Ngoc, in grade 9, stayed up until midnight three nights in a row revising literature. The paper comes back: five and a half. She throws down her bag and shuts her door. Mum hears crying.")
#phanxa("Thôi nín đi con, có gì đâu mà khóc. Lần sau cố lên là được.", "Mẹ không hiểu. Mình đã cố hết sức rồi, cố nữa là cố kiểu gì? Chắc mình dốt thật.", en: ("Stop crying, it's nothing to cry about. Just try harder next time.", "Mum does not understand. I already tried as hard as I can; how could I try more? I must really be stupid."))
#scene("Tình huống 4.2 · Thử nói cách khác")[
  #me("(Gõ cửa, mang vô ly nước.) Mẹ ngồi đây được không? Mẹ không nói gì đâu.", en: "(Knocks, brings in a glass of water.) May I sit here? I won't say anything.")
  #con("(Khóc.) Con học ba đêm mẹ ơi. Ba đêm! Con thuộc hết rồi mà.", en: "(Crying.) I studied three nights, Mum. Three nights! I knew all of it.")
  #me("Mẹ thấy con thức. Bỏ công nhiều vậy mà kết quả ra vầy thì ức lắm.", en: "I saw you stay up. Putting in that much and getting this result must feel so unfair.")
  #con("Con ngu thiệt rồi. Mấy đứa kia nó chơi mà nó còn bảy tám điểm.", en: "I really am stupid. The others play around and still get seven or eight.")
  #me("Mẹ không nghĩ vậy. Người ngu là người không chịu ngồi vô bàn, con thì ngồi ba đêm. Mẹ đoán là sức con bỏ ra đủ rồi, mà đặt chưa đúng chỗ. Khi nào con hết ức, mình coi lời cô phê nha, không gấp.", en: "I don't think so. A stupid person is one who won't sit down at the desk; you sat there three nights. My guess is you put in enough effort, but in the wrong place. When the sting eases, we'll look at the teacher's comments. No hurry.")
  #con("(Một lúc sau.) Cô phê là con chép văn mẫu, không có ý riêng. Mà con học thuộc văn mẫu là để cho chắc...", en: "(After a while.) The teacher wrote that I copied model essays and had no ideas of my own. But I memorised model essays to be safe...")
  #me("Vậy là con học thuộc rất giỏi, nhưng cô lại chấm cái khác. Đề hỏi một đằng mà mình luyện một nẻo. Cái đó sửa được, và không cần thức khuya hơn.", en: "So you are very good at memorising, but the teacher is marking something else. The question asked for one thing and we trained for another. That can be fixed, and it does not need later nights.")
]
#hieusau1("Đứa trẻ cố hết sức mà vẫn thất bại đang đứng trước một ngã rẽ nguy hiểm: kết luận rằng cố gắng là vô ích. Câu cố lên vô tình xác nhận nỗi sợ đó, vì nó ngầm nói con chưa cố đủ. Điều con cần nghe là công sức của con có thật và được nhìn thấy, còn thứ cần đổi là cách làm. Tách sức ra khỏi cách giữ cho con niềm tin rằng mình vẫn điều khiển được kết quả.", en: "A child who gives everything and still fails stands at a dangerous fork: concluding that effort is useless. Try harder accidentally confirms that fear, because it implies the effort was not enough. What the child needs to hear is that the effort was real and was seen, and that what must change is the method. Separating effort from method preserves the belief that the result is still within their control.")
#cotloi("Với đứa trẻ đã cố hết sức, đừng nói cố lên. Hãy nói: sức con đủ rồi, mình tìm cách khác.", en: "To a child who has already given everything, do not say try harder. Say: your effort is enough; let's find another way.")
#lamngay1("Hỏi con về cách con ôn một môn cụ thể: con làm gì trước, làm gì sau, làm sao biết mình thuộc. Chỉ hỏi và nghe. Nhiều khi nói ra thành lời là con tự thấy chỗ lệch.", en: "Ask your child how they revise one particular subject: what they do first, what next, how they know they have learned it. Only ask and listen. Often, saying it aloud lets them see where it went off course.")
#caunoi("Mẹ thấy con đã bỏ công nhiều lắm. Sức con đủ rồi, giờ mình đổi cách.", en: "I can see how much work you put in. Your effort is enough; now we change the method.")
#tusoi(("Mình có biết con học bài bằng cách nào không, hay chỉ biết con ngồi bao lâu?", "Khi mình cố hết sức mà thất bại, câu nào của người khác làm mình thấy dễ chịu nhất?",), en: ("Do I know how my child studies, or only how long they sit?", "When I give everything and fail, what words from others comfort me most?",))

#sec("Con giấu điểm, sửa điểm", en: "Your child hides marks or changes them")
#boicanh("Ba mở ứng dụng sổ liên lạc mới thấy con trai lớp 7 có ba con điểm dưới trung bình trong tháng. Hỏi tuần trước, thằng Quân nói chưa có bài kiểm tra nào. Trong cặp nó còn một tờ bài bị sửa số 4 thành số 9.", en: "Dad opens the school app and finds three below-average marks this month for his grade 7 son. Asked last week, Quan said there had been no tests. In his bag is a paper on which a 4 has been altered to a 9.")
#phanxa("Mày dám lừa cả ba à? Điểm kém ba còn tha, chứ gian dối là ba không tha. Mới bây lớn đã lưu manh!", "Mình là đứa lưu manh. Và ba nói tha điểm kém là nói xạo, vì lần trước điểm kém ba cũng đâu có tha.", en: ("You dare to deceive your own father? A bad mark I could forgive, but dishonesty I will not. So young and already a crook!", "I am a crook. And Dad saying he forgives bad marks is a lie, because last time he did not."))
#scene("Tình huống 4.3 · Thử nói cách khác")[
  #ba("(Đợi tới sau bữa cơm, gọi con ra ban công.) Quân, ba coi sổ liên lạc rồi. Ba cũng thấy tờ bài trong cặp. Ba chưa hỏi gì hết, ba cho con nói trước.", en: "(Waits until after dinner, calls him out to the balcony.) Quan, I've looked at the school app. I've also seen the paper in your bag. I haven't asked anything yet; you speak first.")
  #con("(Im lặng rất lâu.) ...Con xin lỗi ba.", en: "(A very long silence.) ...I'm sorry, Dad.")
  #ba("Ba nhận lời xin lỗi. Ba không vui chuyện con sửa điểm, cái đó ba nói thẳng. Nhưng ba muốn hiểu một chuyện trước: lúc cầm bút sửa số 4, con sợ cái gì nhất?", en: "I accept the apology. I am not happy that you changed the mark; I'll say that plainly. But first I want to understand one thing: when you picked up the pen to change that 4, what were you most afraid of?")
  #con("Con sợ ba thất vọng. Lần trước con được 5 điểm ba không nói chuyện với con hai ngày.", en: "That you'd be disappointed. Last time I got a 5 you didn't speak to me for two days.")
  #ba("...Hai ngày đó ba tưởng ba đang dạy con. Giờ nghe con nói ba mới biết là ba đang dạy con sợ ba. Phần đó là lỗi của ba.", en: "...In those two days I thought I was teaching you. Hearing you now, I see I was teaching you to be afraid of me. That part is my fault.")
  #con("Con không muốn lừa ba đâu. Mà con không biết làm sao.", en: "I didn't want to trick you. I just didn't know what to do.")
  #ba("Vậy mình làm lại từ đầu, cả hai. Phần ba: từ nay điểm nào ba cũng ngồi nghe, không im lặng kiểu đó nữa. Phần con: tờ bài này con tự đem lên nói thật với cô. Còn điểm thật thì từ giờ nói thật với ba. Được không?", en: "Then we both start again. My part: from now on I will sit and listen to any mark, without that kind of silence. Your part: you take this paper to your teacher and tell the truth yourself. And real marks, from now on, you tell me truthfully. Agreed?")
  #con("Dạ được. Ba đi với con lên gặp cô nha?", en: "Yes. Will you come with me to see the teacher?")
  #ba("Ba đứng ngoài cửa. Con tự nói.", en: "I'll stand outside the door. You do the talking.")
]
#hieusau1("Trẻ nói dối về điểm số hầu như không bao giờ vì bản chất gian dối. Các em nói dối khi cái giá của sự thật ở nhà cao hơn cái giá của lời nói dối. Ba mẹ im lặng, lạnh nhạt, hay nổi trận lôi đình đều là những cái giá rất cao với một đứa trẻ. Muốn con nói thật thì phải làm cho sự thật rẻ hơn: nói thật thì được giúp, còn hậu quả của việc gian dối thì con tự đi sửa, có ba mẹ đứng gần.", en: "Children almost never lie about marks because they are dishonest by nature. They lie when the price of the truth at home is higher than the price of a lie. Silence, coldness and explosions are all very high prices for a child. If you want the truth, make it cheaper: telling the truth brings help, while the consequences of the dishonesty are for the child to repair, with a parent standing close.")
#cotloi("Con nói dối khi sự thật quá đắt. Việc của ba mẹ là hạ giá sự thật xuống, không phải tăng mức phạt lời nói dối lên.", en: "Children lie when the truth costs too much. Your task is to lower the price of the truth, not to raise the penalty for lying.")
#lamngay1("Nói với con một lời hứa rõ ràng và giữ cho bằng được: Điểm nào con nói thật, ba mẹ sẽ không la, chỉ ngồi coi lại với con. Lần đầu con đem điểm kém ra thử lời hứa này chính là lúc quyết định.", en: "Make one clear promise and keep it at all costs: Whatever mark you tell me honestly, I will not shout; we will just go over it together. The first time your child tests that promise with a bad mark is the moment that decides everything.")
#caunoi("Lúc con sửa điểm, con đang sợ điều gì nhất?", en: "When you changed that mark, what were you most afraid of?")
#tusoi(("Lần gần nhất con nói thật một chuyện xấu, mình đã phản ứng ra sao?", "Mình có từng phạt con bằng cách im lặng, không nhìn mặt không?",), en: ("The last time my child told me an unpleasant truth, how did I react?", "Have I ever punished my child with silence, refusing to look at them?",))

#sec("Con rớt kỳ thi quan trọng", en: "Your child fails an important exam")
#boicanh("Mười giờ sáng có điểm tuyển sinh lớp 10. Con bé Thư thiếu nửa điểm vào trường nguyện vọng một. Cả nhà đã chắc mẩm con đậu. Nó ngồi trước màn hình, không khóc, không nói. Điện thoại của mẹ bắt đầu reo: họ hàng hỏi thăm.", en: "At ten in the morning the grade 10 entrance results appear. Thu is half a mark short of her first-choice school. The whole family had been sure she would pass. She sits in front of the screen, not crying, not speaking. Mum's phone begins to ring: relatives asking.")
#phanxa("Mẹ đã nói ôn kỹ môn Toán mà không nghe. Giờ ăn nói sao với nội ngoại đây.", "Mình làm cả nhà mất mặt. Mẹ đang đau cho mẹ, không phải cho mình.", en: ("I told you to revise maths properly and you didn't listen. What am I supposed to tell your grandparents now?", "I have shamed the family. Mum is hurting for herself, not for me."))
#scene("Tình huống 4.4 · Thử nói cách khác")[
  #me("(Tắt chuông điện thoại, úp xuống. Ngồi xuống cạnh con, choàng vai.) Mẹ ở đây.", en: "(Silences the phone, turns it face down. Sits beside her, arm around her shoulders.) I'm here.")
  #con("(Rất nhỏ.) Con xin lỗi ba mẹ.", en: "(Very quietly.) I'm sorry, Mum and Dad.")
  #me("Con không có gì phải xin lỗi hết. Con đã học cả năm trời, mẹ thấy từng đêm. Thiếu nửa điểm, đau lắm, mẹ biết.", en: "You have nothing to apologise for. You studied all year; I saw every night of it. Half a mark short hurts so much, I know.")
  #con("Mấy đứa bạn con đậu hết rồi. Con không dám mở nhóm lớp.", en: "All my friends passed. I can't even open the class chat.")
  #me("Vậy hôm nay khỏi mở. Điện thoại ai gọi mẹ lo, con không phải trả lời ai hết. Hôm nay con chỉ cần buồn thôi, buồn cho đã.", en: "Then don't open it today. I'll handle whoever calls; you don't have to answer anyone. Today you only need to be sad, as sad as you need.")
  #con("Rồi giờ con học ở đâu hả mẹ?", en: "So where will I go to school now?")
  #me("Mình còn nguyện vọng hai, còn mấy đường nữa, ba mẹ đã coi rồi, không đường nào là đường cùng. Nhưng chuyện đó để ngày mốt tính. Giờ mẹ nấu cho con tô mì, con ăn được chút nào hay chút đó.", en: "We still have the second choice and several other routes; Dad and I have looked, and none of them is a dead end. But that is for the day after tomorrow. Right now I'll make you a bowl of noodles; eat whatever you can.")
  #con("Mẹ có thất vọng về con không?", en: "Are you disappointed in me?")
  #me("Mẹ buồn vì con buồn. Còn thất vọng về con thì không. Nửa điểm không đổi được chuyện con là con của mẹ.", en: "I am sad because you are sad. Disappointed in you, no. Half a mark cannot change the fact that you are my child.")
]
#hieusau1("Sau một thất bại lớn, đứa trẻ có ba nỗi đau chồng lên nhau: tiếc cho mình, xấu hổ với bạn bè, và sợ làm ba mẹ thất vọng. Nỗi thứ ba thường nặng nhất và là nỗi duy nhất ba mẹ gỡ được ngay. Hai ngày đầu không phải lúc phân tích nguyên nhân hay bàn phương án. Đó là lúc che chắn cho con khỏi những câu hỏi thăm, cho con ăn, ngủ, và được buồn. Kế hoạch chỉ vào đầu khi cảm xúc đã có chỗ đi ra.", en: "After a big failure a child carries three layers of pain: regret for themselves, shame before friends, and fear of having let their parents down. The third is often the heaviest and the only one parents can lift at once. The first two days are not for analysing causes or discussing options. They are for shielding the child from well-meaning questions, feeding them, letting them sleep and letting them grieve. Plans only go in once the feelings have somewhere to go.")
#cotloi("Ngày con rớt, con không cần ba mẹ phân tích. Con cần biết mình vẫn còn nguyên chỗ trong lòng ba mẹ.", en: "On the day your child fails, they do not need your analysis. They need to know their place in your heart is intact.")
#lamngay1("Nếu nhà đang có con sắp thi, ngay tối nay nói trước với con: Đậu hay rớt thì bữa cơm nhà mình vẫn vậy. Ba mẹ đã tính sẵn mấy đường rồi, con cứ thi cho thoải mái. Nói trước kỳ thi thì có giá gấp mười nói sau.", en: "If you have a child with an exam coming, tell them tonight: Pass or fail, dinner at our house stays the same. We have other routes ready; just sit the exam with a free mind. Said before the exam, it is worth ten times more than after.")
#caunoi("Mẹ buồn vì con buồn. Còn thất vọng về con thì không.", en: "I am sad because you are sad. Disappointed in you, no.")
#tusoi(("Nếu con rớt, điều mình sợ nhất là gì: tương lai của con, hay lời bàn tán của người quen?", "Mình đã chuẩn bị phương án hai, phương án ba cùng con chưa, hay cả nhà chỉ dồn vào một cửa?",), en: ("If my child fails, what do I fear most: their future, or what people will say?", "Have we prepared a second and third option together, or is the whole family staked on one door?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 4: mang theo bên mình]
#doicau1((("Sao có mấy điểm vậy? Bạn con được mấy?", "Con thấy bài này mình kẹt ở đâu?", "Why so low? What did your friends get?", "Where do you think you got stuck in this paper?"), ("Lần sau mà còn vậy nữa là biết tay mẹ.", "Từ giờ tới bài sau, con cần mẹ giúp gì?", "If this happens again you'll be sorry.", "Between now and the next test, what help do you need from me?"), ("Thi rớt thì chỉ có nước đi làm công nhân.", "Đường này chưa được thì mình đi đường khác. Ba mẹ đi với con.", "Fail and you'll end up a factory hand.", "If this road is closed we take another. We'll walk it with you."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Điểm số là thông tin về một bài làm trong một ngày. Dùng nó để tìm chỗ hổng, đừng dùng nó để định giá đứa con.", "Hỏi cô giáo đúng câu: thay vì con tôi học có tệ không, hãy hỏi con tôi đang hổng phần nào và ở nhà tôi nên làm gì trong hai tuần tới.", "Điểm kém kéo dài ở nhiều môn cùng lúc, kèm mất ngủ, chán ăn, bỏ sở thích thì không còn là chuyện học. Xem thêm chương 17.",), en: ("A mark is information about one piece of work on one day. Use it to find gaps, not to price your child.", "Ask the teacher the right question: instead of is my child doing badly, ask where are the gaps and what should we do at home over the next two weeks.", "Low marks across many subjects at once, together with poor sleep, loss of appetite and dropped interests, are no longer about studying. See chapter 17.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày, mỗi tối dành mười phút ngồi cạnh con lúc con học, không kiểm tra, không giảng. Chỉ hỏi một câu khi con xong: hôm nay bài nào khó nhất? Nghe con giải thích lại bài đó cho mình.",), mark: sym.star.filled, en: ("For seven days, sit near your child for ten minutes while they study, without checking or explaining. When they finish, ask one question: which problem was hardest today? Then listen as they explain it back to you.",))
