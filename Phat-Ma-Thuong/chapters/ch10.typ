#import "../template.typ": *

#chapter-open(10, "Bỏ tiết, trốn học, đến lớp mà tâm hồn đi vắng", 10, "Em trốn học là em đang bỏ chạy khỏi điều gì đó. Việc của thầy là tìm ra điều đó, không phải là bắt em về.", "Trốn một tiết, nghỉ liền thứ Hai, ngồi trong lớp mà như ở nơi khác, đó là ba dạng bỏ cuộc khác nhau. Phạt theo kiểu đếm số buổi thì sẽ đẩy em đi xa hơn. Chương này gợi những cách giữ em ở lại bằng cách hiểu vì sao em đi, kèm vài chiêu nhẹ để em có lý do muốn quay lại.", ("Em trốn một tiết đi chơi", "Em trốn môn mà em sợ", "Em vắng liên tục vào thứ Hai", "Cả nhóm nhỏ rủ nhau cúp tiết", "Em muốn nghỉ học hẳn",), en: ("Skipping class, truancy, present in body only", "A student who skips school is running from something. Your job is to find out what, not to haul him back.", "Skipping a lesson, missing every Monday, sitting in class as if elsewhere: three different ways of giving up. Punishing by counting sessions pushes the student further away. This chapter offers ways to keep students by understanding why they leave, with a few light moves to give them a reason to return.", ("A student skips one lesson to go out", "A student skips the subject he fears", "A student is absent every Monday", "A small group skips class together", "A student wants to quit school altogether",)))

#sec("Em trốn một tiết đi chơi", en: "A student skips one lesson to go out")
#tinhhuong("10.1", "Em trốn một tiết đi chơi", "Nhà trường báo Kiên trốn tiết ba sau giờ ra chơi, ra quán nước đầu ngõ cùng hai bạn. Khi về lớp tiết sau, Kiên nói em đau bụng. Thầy biết em nói dối.", en: "The school reports Kien skipped third period, slipping out after break to the drink stall at the end of the lane with two friends. Back in the next lesson he says he had a stomach ache. You know he is lying.")
#chieu("Tiết dạy lại", "Thầy không tra hỏi. Thầy nói: tiết ba thầy dạy bài khá quan trọng, em nghỉ mất rồi. Em tự học bài đó từ bạn rồi dạy lại cho thầy trong năm phút, như một thầy giáo. Thầy cảm thấy em hiểu thì cho một điểm cộng, chưa hiểu thì thầy kèm thêm. Thầy cũng hỏi em: điều gì ở tiết đó hoặc ở lớp khiến em muốn ra ngoài? Em nói được thì thầy lắng nghe.", en: ("The lesson taught back", "Do not interrogate. Say: in third period I taught something fairly important and you missed it. Learn it from a friend and teach it back to me in five minutes, like a teacher. If he understood, add a point; if not, coach him further. Also ask: what about that lesson or the class made you want to be outside? If he can say, listen."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Kiên, thầy biết em không đau bụng, thầy không giận. Tiết em vắng thầy dạy bài quan trọng, em nhờ bạn kể lại, ngày mai dạy lại cho thầy năm phút nhé.", en: "Kien, I know you did not have a stomach ache, and I am not angry. In the lesson you missed I taught something important; ask a friend to tell you and tomorrow teach it back to me for five minutes.")
  #tro("Dạ... em xin lỗi thầy. Em chán tiết đó.", en: "Um... I am sorry, sir. I found that lesson boring.")
  #thay("Cảm ơn em nói thật. Em nói thầy nghe chán chỗ nào, thầy muốn biết.", en: "Thank you for being honest. Tell me where it felt boring, I want to know.")
]
#visao("Phạt trốn học bằng cách cấm đoán chỉ làm em tìm đường trốn kín hơn. Việc dạy lại bắt em tiếp thu bài đã lỡ và biến bài học thành món nợ nhẹ. Việc hỏi lý do mở ra thông tin giúp thầy cô điều chỉnh.", en: "Punishing skipping by prohibition only makes him find better hiding places. Teaching it back makes him absorb the missed lesson and turns it into a light debt. Asking the reason opens information that helps you adjust.")
#ranhgioi("Không dùng với em trốn vì sợ bị bạo lực học đường, hay chuyện gia đình. Không bắt dạy lại trước cả lớp nếu em ngại. Nếu em trốn lặp lại nhiều lần, báo phụ huynh một cách thân thiện.", en: "Do not use it with a student who skips from fear of bullying or trouble at home. Do not make him teach before the class if he is shy. If he skips repeatedly, tell parents in a friendly way.")
#bientau("Cho em dạy lại cho thầy riêng ở bàn thầy thay vì trước cả lớp.", en: "Let him teach it back to you privately at your desk instead of before the class.")
#caunoi("Tiết em vắng thầy dạy bài quan trọng. Em nhờ bạn kể lại rồi dạy thầy năm phút nhé.", en: "In the lesson you missed I taught something important. Learn it from a friend and teach me for five minutes.")

#sec("Em trốn môn mà em sợ", en: "A student skips the subject he fears")
#tinhhuong("10.2", "Em trốn môn mà em sợ", "Bạn Thy lần nào cũng nghỉ tiết thể dục, hoặc trốn tiết Toán khi có kiểm tra miệng. Em hay xin phép đi vệ sinh và không quay lại. Em không phải là em hư.", en: "Thy always skips PE, or escapes Maths when there is oral testing. She often asks to go to the toilet and does not come back. She is not a bad student.")
#chieu("Cửa sau có lý do", "Thầy gặp riêng Thy và nói: thầy nhận thấy có tiết em hay không muốn vào. Thầy không hỏi nguyên nhân, em chỉ cần chọn một trong hai: thầy cho em một lý do nhỏ chính đáng để ở ngoài hoặc đến muộn khi có kiểm tra miệng như một thỏa thuận, và đổi lại em báo thầy trước. Ngoài ra thầy hứa kiểm tra miệng em theo cách em thoải mái hơn như viết hoặc trả lời riêng sau tiết.", en: ("A back door with a reason", "Meet Thy privately and say: I notice there are lessons you often do not want to enter. I will not ask the reason. You just choose: I give you a small legitimate reason to stay out or arrive late during oral tests, as an agreement, and in return you tell me beforehand. I also promise to test you orally in a way you are comfortable with, such as in writing or privately after the lesson."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thy, thầy thấy có tiết em hay muốn ra ngoài. Thầy không hỏi lý do. Em báo trước với thầy, mình thỏa thuận cách khác để em vẫn học được mà không phải bỏ đi.", en: "Thy, I see there are lessons you often want to step out of. I will not ask why. You tell me beforehand and we agree on another way, so you still learn without leaving.")
  #tro("Dạ... em sợ bị gọi lên bảng thầy.", en: "Um... I am afraid of being called to the board, sir.")
  #thay("Cảm ơn em nói thật. Thầy hứa không gọi em lên bảng bất ngờ, thầy báo trước một ngày nhé.", en: "Thank you for telling me. I promise not to call you up suddenly; I will tell you a day ahead.")
]
#visao("Em bỏ tiết vì sợ bị đánh giá hay xấu hổ, không phải lười. Thỏa thuận chủ động báo trước biến việc trốn thành việc thương lượng, và giảm nỗi sợ nhờ cách kiểm tra mềm hơn. Em thấy thầy tin mình.", en: "She skips from fear of being judged or embarrassed, not laziness. The agreement to tell you beforehand turns skipping into negotiation, and the gentler testing reduces her fear. She sees you trust her.")
#ranhgioi("Không dùng như quyền lợi lâu dài nếu nỗi sợ lớn dần. Nếu em lo âu nặng khi đến lớp, đề nghị gia đình đưa em gặp chuyên viên tâm lý học đường.", en: "Do not use it as a lasting entitlement if the fear grows. If she is badly anxious about coming to class, suggest the family take her to a school counsellor.")
#bientau("Thầy giao trước câu hỏi sẽ hỏi miệng một ngày, em chuẩn bị trước để tự tin.", en: "Give the oral question a day ahead so she can prepare and feel confident.")
#caunoi("Em báo thầy trước khi thấy sợ, mình thỏa thuận cách khác nhé.", en: "Tell me before you feel afraid and we will agree another way.")

#sec("Em vắng liên tục vào thứ Hai", en: "A student is absent every Monday")
#tinhhuong("10.3", "Em vắng liên tục vào thứ Hai", "Ba tuần liên tiếp Giang nghỉ thứ Hai, xin phép mơ hồ. Em còn hơi lúng túng khi thầy hỏi. Thầy nghi có chuyện nhưng chưa biết là gì.", en: "For three weeks in a row Giang has missed Monday, with vague excuses. She still seems flustered when you ask. You suspect something but do not know what.")
#chieu("Cuộc gọi Chủ nhật", "Thầy gọi điện cho Giang vào tối Chủ nhật, nói đúng ba câu: thầy gọi để hỏi thăm, thầy không hỏi chuyện nghỉ học, mai thầy mong gặp em. Nếu em không bắt máy, thầy để lại tin nhắn ngắn. Không điều tra, không trách. Khi em quay lại thầy chỉ nói: thầy mừng khi thấy em. Sau vài tuần, em tự kể lý do.", en: ("The Sunday call", "Phone Giang on Sunday evening and say exactly three things: I called to ask how you are, I am not asking about your absence, I hope to see you tomorrow. If she does not pick up, leave a short message. No investigation, no blame. When she returns, say only: I am glad to see you. After a few weeks she tells the reason herself."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Giang, thầy gọi để hỏi thăm em thôi. Thầy không hỏi chuyện nghỉ học. Mai thầy mong gặp em ở lớp.", en: "Giang, I just called to ask how you are. I am not asking about absences. I hope to see you in class tomorrow.")
  #tro("Dạ... em cảm ơn thầy. Mai em đi học ạ.", en: "Um... thank you, sir. I will come tomorrow.")
  #thay("Thầy cảm ơn em. Có chuyện gì cần thầy thì em cứ nhắn nhé.", en: "Thank you. If there is anything you need, just message me.")
]
#visao("Em vắng có quy luật thường mang một lý do mà em chưa dám nói. Việc gọi hỏi thăm không kèm trách móc cho em thấy có người nhớ mình và không phán xét. Cảm giác thuộc về thường kéo em quay lại hơn mọi nhắc nhở.", en: "A pattern of absence often carries a reason she is not yet ready to say. A check-in call with no blame shows her someone remembers her and does not judge. The feeling of belonging often draws a student back more than any reminder.")
#ranhgioi("Không gọi dồn nhiều lần. Nếu nghi ngờ em bị bạo hành hay phải đi làm, tham vấn nhà trường và bộ phận hỗ trợ. Không ép em kể.", en: "Do not call repeatedly. If you suspect abuse or that she has to work, consult the school and its support staff. Do not press her to tell.")
#bientau("Gửi qua lớp trưởng một mẩu ghi chú cho bài hôm đó, kèm lời: thầy để dành cho em.", en: "Send a note via the class monitor about that day's lesson, with the words: I kept this for you.")
#caunoi("Thầy gọi hỏi thăm em thôi. Mai thầy mong gặp em ở lớp.", en: "I just called to ask how you are. I hope to see you in class tomorrow.")

#sec("Cả nhóm nhỏ rủ nhau cúp tiết", en: "A small group skips class together")
#tinhhuong("10.4", "Cả nhóm nhỏ rủ nhau cúp tiết", "Ba em Hùng, Tài, Sơn cùng trốn tiết cuối chiều để đi chơi game. Cả ba bị phát hiện và rất lo lắng, nhưng vẫn cười gượng như không có gì.", en: "Hung, Tai and Son skipped the last lesson of the afternoon to play games. All three were found out and are very anxious, but still smile awkwardly as if nothing happened.")
#chieu("Ba vị khách mời", "Thầy mời cả ba em đến một buổi ngắn gọi là Họp tiểu ban quản lý rủi ro. Thầy nói: ba em vừa trải nghiệm một sự kiện, thầy cần ba em giúp thầy biết cách để các bạn khác không cúp tiết nữa. Mỗi em viết ba cách ngăn bạn trốn tiết mà không dùng việc phạt. Ba em suy nghĩ như người xây dựng nội quy, và thường chính các em thấy lý do mình sai.", en: ("Three guest advisers", "Invite the three to a short session you call the Risk Management Sub-committee. Say: you three have just experienced an event and I need your help knowing how to keep other students from skipping. Each writes three ways to stop friends skipping without using punishment. The three think like rule-makers, and often they themselves see why they were wrong."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Ba em ghé thầy một chút. Thầy cần ba em giúp thầy việc này: các em là chuyên gia vừa trốn tiết, hãy viết ba cách để các bạn khác không trốn, không dùng phạt.", en: "The three of you see me for a moment. I need your help: you are experts who have just skipped class, so write three ways to stop others skipping, without using punishment.")
  #tro("Dạ... chuyên gia hả thầy? Tụi em làm được.", en: "Um... experts, sir? We can do that.")
  #thay("Thầy tin. Thầy đọc xong sẽ chọn một cách đem ra lớp, ghi tên ba em.", en: "I trust you. After I read them I will choose one to bring to the class, with your names on it.")
]
#visao("Biến người phạm lỗi thành cố vấn giúp em từ phòng thủ sang cộng tác. Khi phải nghĩ cách ngăn trốn, em phải đặt mình vào vị trí người kiểm soát và nhìn lại hành vi của mình. Nội quy do em góp ý cũng dễ được tuân thủ hơn.", en: "Turning offenders into advisers moves them from defence to cooperation. Having to think of ways to prevent skipping puts them in the position of the enforcer, so they look back at their own act. Rules they helped shape are also easier to follow.")
#ranhgioi("Chỉ dùng khi lỗi ở mức nhẹ và là lần đầu. Không công khai danh sách ba em. Vẫn báo phụ huynh nếu quy định yêu cầu.", en: "Use only for mild, first-time faults. Do not make the list of the three public. Still inform parents if regulations require.")
#bientau("Chọn một cách do các em đề xuất và thử áp dụng trong một tuần.", en: "Pick one of their proposals and trial it for a week.")
#caunoi("Ba em là chuyên gia vừa trốn tiết, giúp thầy nghĩ ba cách để bạn khác không trốn nhé.", en: "You three are experts who have just skipped class; help me think of three ways to keep others from skipping.")

#sec("Em muốn nghỉ học hẳn", en: "A student wants to quit school altogether")
#tinhhuong("10.5", "Em muốn nghỉ học hẳn", "Minh, lớp 11, nói với thầy: em định nghỉ học đi làm. Em nói bình thản như đã quyết. Điểm em thấp, em thấy mình học không nổi. Thầy lo lắng.", en: "Minh, in grade 11, tells you: I plan to leave school and go to work. He says it calmly, as if decided. His marks are low and he feels he cannot keep up. You are worried.")
#chieu("Cửa lớp vẫn có ghế", "Thầy không thuyết giảng. Thầy nói: thầy hiểu em đang nặng nề lắm. Thầy xin em một điều: em đừng quyết trong tuần này. Mình hẹn nhau một buổi ra chơi mỗi ngày trong năm ngày để nói chuyện, em kể thầy nghe, thầy chỉ lắng nghe. Thầy cũng mời gia đình và nhà trường cùng tìm giải pháp như học nghề hoặc điều chỉnh lịch học. Chiếc ghế của em ở lớp vẫn giữ nguyên.", en: ("The classroom still has a seat", "Do not lecture. Say: I understand you are carrying a lot. I ask one thing of you: do not decide this week. We meet every day at break for five days to talk; you tell me, and I just listen. Also invite family and school to look for solutions, such as vocational training or an adjusted timetable. His seat in the class stays as it is."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Minh, thầy nghe em. Thầy xin em một điều thôi: đừng quyết trong tuần này. Mỗi ngày ra chơi mình nói chuyện năm phút, thầy chỉ lắng nghe.", en: "Minh, I hear you. I ask only one thing: do not decide this week. Every day at break we talk for five minutes, and I only listen.")
  #tro("Dạ... thầy cho em nghĩ thêm.", en: "Um... let me think a bit more, sir.")
  #thay("Chiếc ghế của em ở lớp vẫn đó. Em cứ nghĩ, thầy chờ.", en: "Your seat in the class is still there. You think, I will wait.")
]
#visao("Quyết định bỏ học thường đến sau một chuỗi cảm giác thất bại. Kéo dài thời gian quyết định, cho em được lắng nghe, và mở ra các lựa chọn khác như học nghề giúp em thấy mình còn lối đi. Thầy giữ ghế cho em là lời mời quay lại cụ thể.", en: "The decision to quit often follows a string of feeling like a failure. Extending the time to decide, letting him be heard, and opening other options shows him there are still roads. Keeping his seat is a concrete invitation to return.")
#ranhgioi("Không thuyết giảng, không dọa về tương lai. Không hứa những điều thầy không làm được. Phải phối hợp với gia đình và nhà trường, đặc biệt khi em có dấu hiệu trầm cảm hoặc bị ép buộc nghỉ học.", en: "Do not lecture or threaten about the future. Do not promise what you cannot deliver. You must coordinate with family and school, especially if he shows signs of depression or is being forced to leave.")
#bientau("Giới thiệu em với một chuyên viên hướng nghiệp hoặc một anh chị đã đi học nghề thành công.", en: "Introduce him to a career counsellor or an older student who has succeeded in vocational training.")
#caunoi("Thầy nghe em. Em đừng quyết trong tuần này, mình nói chuyện mỗi ngày năm phút nhé.", en: "I hear you. Do not decide this week; let us talk five minutes every day.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 10: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Em trốn tiết thường đang trốn một điều cụ thể. Tìm ra điều đó trước khi tính chuyện phạt.", "Cuộc gọi hỏi thăm không kèm trách móc có sức mạnh lớn hơn bất cứ cảnh cáo nào.", "Khi em nói muốn nghỉ học, đó thường là lời cầu cứu. Hãy kéo dài thời gian quyết định và mở thêm lối đi, đừng đóng cửa.",), en: ("A student who skips is usually skipping something specific. Find out what before thinking about punishment.", "A check-in call without blame has more force than any warning.", "When a student says he wants to leave school, it is often a cry for help. Extend the time to decide and open more options; do not close the door.",))
