#import "../template.typ": *

#chapter-open(3, "Đi trễ, quên đồ, quên bài", 3, "Quên và trễ là lỗi dễ lặp nhất. Cho nên hình phạt hay phải là loại giúp em nhớ, không phải loại giúp em sợ.", "Đi trễ, quên sách, quên bài tập, quên trực nhật là những lỗi tuần nào cũng gặp. Phạt nặng thì thầy mệt, phạt nhẹ thì lỗi lặp lại. Điều thầy cô cần là một cách làm em tự thấy cái giá của việc quên, đồng thời có công cụ để nhớ. Chương này tập trung vào chiêu phạt có phần xây dựng thói quen ở trong đó.", ("Em đi trễ nhiều lần trong tuần", "Em quên mang sách giáo khoa", "Em quên làm bài tập về nhà", "Em quên trực nhật", "Em quên dụng cụ cho tiết thực hành",), en: ("Late, forgetful, no homework", "Forgetting and lateness are the easiest faults to repeat. So a good punishment helps the student remember, not fear.", "Arriving late, forgetting books, forgetting homework, forgetting cleaning duty: faults that come every week. Punish heavily and you tire yourself; punish lightly and the fault returns. What you need is a way for the student to feel the real cost of forgetting, along with tools to remember. This chapter focuses on punishments that build a habit within them.", ("A student is late several times in one week", "A student forgets the textbook", "A student did not do the homework", "A student forgets cleaning duty", "A student forgets equipment for a practical lesson",)))

#sec("Em đi trễ nhiều lần trong tuần", en: "A student is late several times in one week")
#tinhhuong("3.1", "Em đi trễ nhiều lần trong tuần", "Bạn Phúc đã đi trễ bốn buổi trong tuần này. Lần nào em cũng xin lỗi, nhỏ giọng, nói kẹt xe. Thầy nhắc mấy lần rồi mà em vẫn trễ. Thầy chưa biết nguyên nhân thật là gì.", en: "Phuc has been late four times this week. Each time he apologises in a small voice and says traffic. You have reminded him many times and still he is late. You do not yet know the real cause.")
#chieu("Vé vào lớp", "Mỗi lần trễ, em nhận một tờ vé nhỏ, tự điền hai dòng: lý do thật, và một việc em sẽ làm khác vào ngày mai. Em đặt vé vào hộp trên bàn thầy. Đủ ba vé trong một tuần thì thầy mời em ngồi năm phút ở ra chơi để cùng xem ba vé có gì giống nhau. Ai đến sớm năm phút trong năm ngày liên tiếp thì thầy trả lại vé và xóa sổ, kèm một lời khen công khai.", en: ("Entry ticket", "Each time he is late, he receives a small ticket and fills in two lines himself: the real reason, and one thing he will do differently tomorrow. He puts the ticket in the box on your desk. Three tickets in a week and you invite him to sit for five minutes at break to look together at what the three have in common. Anyone who arrives five minutes early five days in a row gets his tickets returned and cleared, with a public word of praise."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Phúc, thầy không phạt em bằng lời mắng. Mỗi lần trễ em ghi vào vé hai dòng này nhé: lý do thật là gì, và ngày mai em làm gì khác. Em ghi thật là đủ.", en: "Phuc, I will not punish you with scolding. Each time you are late, write these two lines on a ticket: the real reason, and what you will do differently tomorrow. Just be honest.")
  #tro("Dạ... Thật ra nhà em xa, mẹ đi làm sớm nên em phải tự ăn sáng.", en: "Um... my home is far, and Mum leaves early for work, so I have to make my own breakfast.")
  #thay("Cảm ơn em đã nói thật. Giờ mình tìm cách cho em kịp giờ nhé, bắt đầu từ chuyện ăn sáng.", en: "Thank you for telling me the truth. Let us find a way to get you here on time, starting with breakfast.")
]
#visao("Trễ là chuyện có nguyên nhân, và nguyên nhân thường nằm ngoài ý muốn của em. Tờ vé giúp em nghĩ về nguyên nhân thay vì chỉ xin lỗi. Khi thầy có đủ ba tờ vé, thầy thấy mẫu chung và giúp được thật.", en: "Lateness has causes, and often they lie beyond the student's control. The ticket makes him think about the cause instead of just apologising. With three tickets, you see the pattern and can really help.")
#ranhgioi("Không phạt khi nguyên nhân là chuyện nhà hay phương tiện không thể tự quyết. Không đọc vé công khai. Không dùng vé làm bằng chứng để kỷ luật.", en: "Do not punish when the cause is family or transport he cannot decide. Do not read tickets aloud. Do not use tickets as evidence for discipline.")
#bientau("Thêm một cột thưởng: ai đến sớm năm phút ba ngày liền được chọn chỗ ngồi tuần đó.", en: "Add a reward column: five minutes early three days running earns the pick of seats that week.")
#caunoi("Thầy cần biết lý do thật để giúp em. Em ghi vào vé, mình cùng tìm cách.", en: "I need the real reason in order to help you. Write it on the ticket and we will find a way together.")

#sec("Em quên mang sách giáo khoa", en: "A student forgets the textbook")
#tinhhuong("3.2", "Em quên mang sách giáo khoa", "Hà quên sách lần thứ ba. Em ngồi chia sách với bạn bên cạnh, nhìn chung không ảnh hưởng nhiều nhưng bạn bên cạnh bị bất tiện, và thầy muốn em tự có trách nhiệm.", en: "Ha has forgotten her book for the third time. She shares with her neighbour; it does not disrupt much, but the neighbour is inconvenienced, and you want her to take responsibility.")
#chieu("Thư viện của thầy", "Thầy cho em mượn sách của thầy, nhưng với một chút phí: em làm trợ lý đọc to đoạn đầu bài hôm nay trước lớp. Nếu em nhút nhát, thầy cho em đọc thầm rồi tóm lại bằng một câu. Cuối tiết, em trả sách và nói một điều em nhớ được. Lần sau quên nữa, em tự chọn một món nhỏ đền bù như dán thêm nhãn cho sách thư viện lớp.", en: ("The teacher's lending library", "Lend her your own book, for a small fee: she serves as reading assistant and reads the opening passage of today's lesson aloud. If she is shy, let her read silently and summarise in one sentence. At the end of the lesson she returns the book and names one thing she remembers. If she forgets again, she chooses a small way to make amends, such as labelling books for the class library."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hà quên sách thì thầy cho mượn sách của thầy nhé. Phí mượn là em đọc to đoạn mở bài cho cả lớp. Em đọc rõ giúp thầy.", en: "Ha forgot her book, so I will lend you mine. The borrowing fee is that you read the opening passage aloud to the class. Read it clearly for me.")
  #tro("Dạ... em đọc ạ.", en: "Um... I will read it.")
  #thay("Cảm ơn em. Đọc rất rõ. Lần sau mình mượn thêm được không, hay em để quyển sách vào cặp từ tối?", en: "Thank you. That was very clear. Next time, shall we borrow again, or will you put the book in your bag the night before?")
]
#visao("Quên sách thường là việc tối hôm trước chưa chuẩn bị. Phí mượn là một việc có ích, không xấu hổ, và gắn với đúng bài học. Em được đọc to nên còn luyện thêm kỹ năng, nên cái giá phải trả vừa nhẹ, vừa có lợi.", en: "Forgetting a book is usually an unprepared evening. The fee is a useful task, not a shame, and tied to the very lesson. She also practises reading aloud, so the price is light and beneficial at once.")
#ranhgioi("Không công khai chê em hay hỏi dồn vì sao quên. Nếu em không có sách vì nhà khó khăn, đừng phạt mà hỗ trợ sách thật.", en: "Do not mock her publicly or press her on why she forgot. If she has no book because her family struggles, do not punish; give real support with books.")
#bientau("Cho em tự lên danh sách ba việc để nhớ sách và dán trong cặp.", en: "Let her write her own list of three things to remember the book and stick it in her bag.")
#caunoi("Thầy cho em mượn sách. Em giúp thầy đọc đoạn đầu cho cả lớp nhé.", en: "I will lend you my book. Will you read the opening passage aloud for the class?")

#sec("Em quên làm bài tập về nhà", en: "A student did not do the homework")
#tinhhuong("3.3", "Em quên làm bài tập về nhà", "Tiến không làm bài tập về nhà lần thứ hai trong tuần. Em nói: dạ em quên. Thầy không biết em quên thật hay em thấy không quan trọng.", en: "Tien did not do his homework twice this week. He says: I forgot. You do not know whether he truly forgot or thinks it unimportant.")
#chieu("Giấy hẹn trả", "Thầy cho em ký một tờ giấy hẹn: ngày giờ em sẽ nộp bài. Thầy nói rõ: nộp đúng hẹn thì không bị trừ điểm, và thầy còn cộng thêm một điểm cho việc giữ lời. Nếu trễ hẹn, em phải tự đưa lý do và nộp thêm một câu hỏi hay do em tự nghĩ ra thuộc bài đó. Giấy hẹn ở lại trong sổ của thầy đến cuối tháng để em thấy thầy tin em.", en: ("The promise slip", "Have him sign a small promise slip: the date and time he will hand it in. Say clearly: hand it in on time and there is no deduction, and I will add a point for keeping your word. If late, he gives the reason and hands in an extra question of his own about that topic. The slip stays in your book until the end of the month so he sees you trust him."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Tiến ơi, thầy không muốn trừ điểm em. Em ký giấy hẹn này: em hứa nộp vào chiều mai. Nộp đúng hẹn thầy còn khen. Em thấy được không?", en: "Tien, I do not want to deduct marks. Sign this promise slip: you promise to hand it in tomorrow afternoon. On time and I will praise you as well. Does that work?")
  #tro("Dạ được thầy. Em nộp đúng ạ.", en: "Yes, sir. I will hand it in on time.")
  #thay("Thầy tin em. Còn nếu có gì khó, ghé thầy trước khi hết hạn nhé.", en: "I trust you. And if something is hard, see me before the deadline.")
]
#visao("Học sinh quên bài thường sợ hậu quả hơn là chính bài. Giấy hẹn cho em quyền tự chọn ngày nộp, tức là cho em thấy mình chịu trách nhiệm, đồng thời cho thầy một thỏa thuận có chữ ký. Khi em giữ được lời, em tự đánh giá mình khác đi.", en: "Students who forget homework often fear the consequence more than the task. The slip lets him choose the date, so he sees himself as responsible, and gives you a signed agreement. When he keeps his word, he judges himself differently.")
#ranhgioi("Không dùng giấy hẹn cho em đang gặp chuyện nặng ở nhà. Không đưa giấy hẹn ra trước cả lớp. Nếu em quên liên tục kéo dài nhiều tuần, hỏi thẳng xem em có cần giúp đỡ gì.", en: "Do not use the slip for a student in serious trouble at home. Do not show it before the class. If he forgets constantly for weeks, ask directly whether he needs help.")
#bientau("Cho em chọn một bạn làm chứng giấy hẹn, bạn chỉ chứng kiến chứ không nhắc nhở thay.", en: "Let him choose a classmate as witness of the slip; the friend only witnesses, and does not remind in his place.")
#caunoi("Em ký giấy hẹn nhé. Thầy tin em sẽ nộp đúng ngày.", en: "Sign the promise slip. I trust you to hand it in on the day.")

#sec("Em quên trực nhật", en: "A student forgets cleaning duty")
#tinhhuong("3.4", "Em quên trực nhật", "Cả tổ ba quên trực nhật, riêng bạn Khôi quên cả hai tuần liền. Phòng học vẫn còn rác và bảng chưa lau. Các bạn khác bắt đầu phàn nàn.", en: "A whole group forgot cleaning duty, and Khoi has forgotten two weeks running. The room still has litter and the board is unwiped. Others are beginning to complain.")
#chieu("Một ngày làm quản gia lớp", "Thầy mời Khôi làm quản gia lớp vào ngày hôm sau. Em đến sớm mười phút, đi một vòng kiểm tra bảng, bàn ghế, cửa sổ, đèn, quạt, rồi báo lại với thầy bằng mười chữ. Em có một cây bút đặc biệt đeo lên túi áo ghi chữ Quản gia. Cả ngày em thấy việc trực nhật phức tạp thế nào. Những lần sau, em tự lên danh sách nhắc cho tổ.", en: ("A day as class steward", "Invite Khoi to be class steward the next day. He comes ten minutes early, does a round to check the board, desks, windows, lights, fans, and reports back in ten words. He wears a special pen on his pocket marked Steward. All day he sees how complicated cleaning duty is. Afterwards, he draws up his own reminder list for his group."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Khôi, ngày mai em làm quản gia lớp giúp thầy nhé. Em đến sớm mười phút, đi một vòng kiểm tra rồi báo thầy. Có bút Quản gia nữa, em đeo lên cho oai.", en: "Khoi, tomorrow you are class steward for me. Come ten minutes early, do a round of checks, then report to me. There is a Steward pen, wear it proudly.")
  #tro("Dạ... em làm được thầy.", en: "Um... I can do it, sir.")
  #thay("Thầy tin em. Em thấy lớp cần gì thì báo thầy luôn.", en: "I trust you. Whatever the class needs, report it to me.")
]
#visao("Việc trực nhật là phần không ai muốn nhớ. Khi em trở thành người chịu trách nhiệm toàn bộ, em hiểu giá trị của từng việc nhỏ. Danh hiệu quản gia cho em thấy đây là một vai trò có uy chứ không phải một hình phạt.", en: "Cleaning is the job nobody wants to remember. When he becomes the one responsible for everything, he understands the value of each small task. The steward title shows it is a role with standing, not a punishment.")
#ranhgioi("Không dùng việc trực nhật như hình phạt cố định, vì sẽ khiến học sinh ghét việc dọn dẹp. Không bắt em làm một mình quá hai mươi phút.", en: "Do not use cleaning as a fixed punishment, or students will come to hate tidying. Do not make him work alone for more than twenty minutes.")
#bientau("Tổ nào đủ mặt trực nhật ba ngày liền thì được chọn một món nhạc phát lúc ra chơi.", en: "A group that turns up in full for cleaning three days running chooses a piece of music to play at break.")
#caunoi("Ngày mai em làm quản gia lớp cho thầy, em đến sớm mười phút nhé.", en: "Tomorrow you are class steward for me; please come ten minutes early.")

#sec("Em quên dụng cụ cho tiết thực hành", en: "A student forgets equipment for a practical lesson")
#tinhhuong("3.5", "Em quên dụng cụ cho tiết thực hành", "Tiết thực hành cần thước và compa, Linh không mang. Em ngồi nhìn các bạn làm và không dám nói. Thầy nhìn thấy nhưng em vẫn cúi đầu, rõ ràng đang ngại.", en: "The practical lesson needs a ruler and compasses and Linh has none. She sits watching the others work and does not dare say so. You notice, but she keeps her head down, clearly embarrassed.")
#chieu("Dây buộc ngón tay", "Thầy không hỏi trách mà phát cho em một mảnh giấy nhớ nhỏ, nói: em dán lên bàn học ở nhà để mai nhớ. Thầy hỏi em muốn viết nội dung gì lên. Em tự viết, thầy ký tên bên dưới như người làm chứng. Sau đó thầy cho em mượn dụng cụ thầy có sẵn. Tuần sau thầy hỏi em mảnh giấy nhớ còn dán không.", en: ("String around the finger", "Do not scold; hand her a small sticky note and say: stick this on your desk at home so you remember tomorrow. Ask what she wants written on it. She writes it herself and you sign beneath it as witness. Then lend her the equipment you have ready. Next week ask whether the note is still stuck up."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Linh, thầy cho em mượn thước của thầy trước. Rồi thầy tặng em mảnh giấy này: em viết lên đó những thứ cần mang, dán ở bàn học nhà em.", en: "Linh, borrow my ruler first. Then I give you this note: write what you need to bring and stick it on your desk at home.")
  #tro("Dạ... em cảm ơn thầy.", en: "Um... thank you, sir.")
  #thay("Tuần sau thầy hỏi lại xem mảnh giấy còn dán không nhé.", en: "Next week I will ask whether the note is still there.")
]
#visao("Quên là lỗi của trí nhớ chứ không phải của thái độ. Một công cụ nhắc nhớ giải quyết đúng gốc, hiệu quả hơn nhiều lần so với lời trách móc. Em còn được thầy ký xác nhận nên thấy mình được tin.", en: "Forgetting is a failure of memory, not attitude. A memory tool solves the actual root, many times more effective than reproach. Your signature as witness makes her feel trusted.")
#ranhgioi("Không phạt em quên dụng cụ khi gia đình không đủ điều kiện mua. Không nói với cả lớp là em quên.", en: "Do not punish forgetting equipment when the family cannot afford to buy it. Do not tell the class she forgot.")
#bientau("Cho cả lớp một phút đầu mỗi tiết kiểm tra cặp, ai thiếu gì ghi vào mảnh giấy bên bàn.", en: "Give the whole class one minute at the start of each lesson to check bags, with anyone missing something writing it on a note by the desk.")
#caunoi("Quên thì mình có cách nhớ. Em dán giấy này lên bàn học nhé.", en: "Forgetting happens, and we have a way to remember. Stick this on your desk at home.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 3: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Hình phạt tốt cho lỗi quên là hình phạt tặng em một công cụ để nhớ, chứ không phải một nỗi sợ để nhớ.", "Hỏi nguyên nhân thật trước khi chọn chiêu. Trễ vì xa nhà, quên vì thiếu thời gian, hay quên vì không quan tâm là ba chuyện khác nhau.", "Đừng bao giờ dùng việc dọn dẹp làm hình phạt cố định. Lao động chỉ có ý nghĩa khi em thấy mình được tin giao việc.",), en: ("A good punishment for forgetting gives the student a tool to remember, not a fear to remember by.", "Ask the real cause before choosing the move. Late because of distance, forgetful for lack of time, and forgetful from not caring are three different things.", "Never make tidying a fixed punishment. Work has meaning only when the student feels trusted with it.",))
