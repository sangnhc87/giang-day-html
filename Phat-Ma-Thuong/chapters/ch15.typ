#import "../template.typ": *

#chapter-open(15, "Va chạm và hành vi nguy hiểm: đánh nhau, bắt nạt, thuốc lá, vật cấm", 15, "Những chuyện này không còn là trò đùa. Chiêu hay lúc này là chiêu giữ người an toàn trước, rồi mới nói đến phạt.", "Chương này khác các chương trước. Khi có bạo lực, bắt nạt kéo dài, chất gây nghiện hay vật nguy hiểm, vui và nhẹ nhàng không còn là mục tiêu đầu tiên. Mục tiêu đầu tiên là an toàn. Nhưng trong khuôn khổ an toàn đó, thầy cô vẫn có nhiều cách để việc xử lý mang tính dạy và giữ được quan hệ với em, thay vì chỉ trừng phạt. Mỗi tình huống dưới đây đều đi kèm phần báo cáo và phối hợp mà thầy cô không nên bỏ qua.", ("Hai em xô xát, đánh nhau", "Một em bị bắt nạt kéo dài", "Em hút thuốc lá, thuốc lá điện tử", "Em mang vật cấm: dao, pháo, bật lửa", "Em đe dọa: ra ngoài thầy xử",), en: ("Clashes and dangerous behaviour: fighting, bullying, tobacco, prohibited items", "These are no longer jokes. The best move now is the one that keeps people safe first, and only afterwards speaks of punishment.", "This chapter differs from the others. When there is violence, prolonged bullying, addictive substances or dangerous objects, being fun and gentle is no longer the first aim. The first aim is safety. But within that safety, teachers still have many ways to make the handling teach and keep the relationship with the student, instead of merely punishing. Each situation below comes with the reporting and coordination that teachers should not skip.", ("Two students scuffle and fight", "A student is bullied over a long period", "A student smokes or vapes", "A student brings a prohibited item: knife, firecracker, lighter", "A student threatens: I will deal with you outside",)))

#sec("Hai em xô xát, đánh nhau", en: "Two students scuffle and fight")
#tinhhuong("15.1", "Hai em xô xát, đánh nhau", "Giờ ra chơi, Long và Hải cãi nhau rồi đẩy nhau, đấm nhau. Các bạn kéo ra được. Cả hai thở dốc, mặt đỏ, mắt nảy lửa. Một em chảy máu mũi.", en: "At break, Long and Hai argue, then shove and punch each other. Friends pull them apart. Both are panting, faces red, eyes blazing. One has a bleeding nose.")
#chieu("Hai bản tường thuật", "Việc đầu tiên là tách hai em ra, kiểm tra vết thương, đưa em bị thương đến phòng y tế. Sau mười phút nguội bớt, thầy mời mỗi em ngồi riêng một góc và viết bản tường thuật của mình: chuyện bắt đầu thế nào, em cảm thấy gì, em đã làm gì. Thầy đọc từng bản, rồi mới cho hai em đổi bản đọc của nhau, thầy ngồi bên cạnh. Mục tiêu không phải nhận ai đúng, mà để mỗi em thấy chuyện qua mắt người kia. Sau đó thầy hỏi: hai em cần gì để chuyện này không lặp lại?", en: ("Two accounts", "First separate them, check injuries, take the injured one to the infirmary. After ten minutes of cooling, ask each to sit in a separate corner and write his own account: how it began, what he felt, what he did. Read each, then let them swap and read each other's, with you beside them. The aim is not to decide who was right, but for each to see events through the other's eyes. Then ask: what do you two need so this does not happen again?"))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hai em ngồi riêng, mỗi em viết lại chuyện vừa xảy ra, như em thấy. Thầy sẽ đọc cả hai. Em nào bị đau thì thầy đưa đi y tế trước.", en: "You two sit apart and each write down what just happened as you saw it. I will read both. Whoever is hurt, I take to the infirmary first.")
  #tro("(Sau khi đổi đọc.) Dạ... em không biết bạn ấy nghĩ vậy.", en: "(After swapping.) Um... I did not know he thought that.")
  #thay("Cảm ơn em đã đọc. Giờ mình cùng nói xem hai em cần gì để không lặp lại.", en: "Thank you for reading. Now let us talk about what you two need so it does not repeat.")
]
#visao("Đánh nhau xảy ra khi cảm xúc vượt khỏi lời nói. Việc viết giúp cảm xúc hạ nhiệt và tách chuyện khỏi cơn giận. Đọc bản của nhau cho mỗi em thấy một nửa sự thật mình chưa thấy, và là bước đầu để hai em tự thương lượng.", en: "Fights happen when feeling outruns words. Writing cools the feeling and separates the matter from the anger. Reading each other's account lets each see the half of the truth he has missed, and is the first step towards the two negotiating by themselves.")
#ranhgioi("An toàn thể chất và sơ cứu trước hết. Phải báo nhà trường, và thông báo gia đình theo quy định, đặc biệt khi có thương tích. Không bắt hai em bắt tay làm hòa ngay khi còn giận. Nếu một em bị bắt nạt lâu rồi mới phản kháng, xử lý như chuyện bắt nạt, không phạt ngang nhau.", en: "Physical safety and first aid come first. Report to the school, and inform families as regulations require, especially where there are injuries. Do not make the two shake hands while still angry. If one had been bullied for long before hitting back, treat it as bullying; do not punish them equally.")
#bientau("Nếu cả hai đồng ý, cho một trò chơi hợp tác ngắn có thầy làm trọng tài sau vài ngày, như hai em cùng dựng một mô hình.", en: "If both agree, a few days later give a short cooperative game with you as referee, such as building a model together.")
#caunoi("Hai em ngồi riêng, viết lại chuyện vừa xảy ra như em thấy. Thầy đưa em bị đau đi y tế trước.", en: "You two sit apart and write what just happened as you saw it. I take the hurt one to the infirmary first.")

#sec("Một em bị bắt nạt kéo dài", en: "A student is bullied over a long period")
#tinhhuong("15.2", "Một em bị bắt nạt kéo dài", "Bạn Tín bị một nhóm gọi bằng biệt danh, giấu cặp, nhắn tin xúc phạm trong nhóm lớp, và dần bị cô lập. Em không kể gì, nhưng gầy đi, hay xin nghỉ. Một bạn khác lặng lẽ báo cho thầy.", en: "Tin is called by a nickname by a group, has his bag hidden, receives insulting messages in the class chat, and is gradually isolated. He says nothing but is losing weight and often asks for leave. Another student quietly told you.")
#chieu("Vòng tay lớp và kế hoạch sửa lỗi", "Thầy làm hai việc song song, kín đáo. Với Tín: gặp riêng, nói rõ thầy đã biết, em không có lỗi, và thầy sẽ lo việc này. Cho em một người thầy có thể tìm bất cứ lúc nào. Với nhóm bắt nạt: gặp riêng từng em, không để nhóm đối chất với nhau. Thầy nói thẳng hành vi này không chấp nhận được, và mỗi em lập một kế hoạch sửa lỗi ba bước: dừng, xin lỗi bằng thư không ép nạn nhân tha thứ, và làm một việc tử tế cho lớp. Thầy cũng gọi gia đình hai bên và báo nhà trường. Trong lớp, thầy tạo một vòng bạn thân thiện quanh Tín, không gán mác tội nghiệp.", en: ("The class circle and the repair plan", "Do two things in parallel, discreetly. With Tin: meet privately and say plainly that you know, it is not his fault, and you will deal with it. Give him a teacher he can find at any time. With the bullying group: meet each privately; do not let the group confront each other. Say straight that this behaviour is unacceptable, and each draws up a three-step repair plan: stop, apologise by a letter without pressing the victim to forgive, and do one kind thing for the class. Also call both families and tell the school. In class, form a friendly circle round Tin without labelling him a pitiable case."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Với Tín.) Thầy đã biết chuyện. Em không có lỗi gì. Thầy sẽ lo, và em có thể tìm thầy bất cứ lúc nào, kể cả ngoài giờ.", en: "(To Tin.) I know what has been happening. It is not your fault. I will deal with it, and you can find me at any time, even outside lessons.")
  #tro("(Tín, nghẹn.) Dạ... em cảm ơn thầy. Em sợ nói ra bạn sẽ ghét em hơn.", en: "(Tin, choking.) Um... thank you, sir. I was afraid that if I told, they would hate me more.")
  #thay("Thầy sẽ làm sao để không ai biết là em nói. Em đã rất can đảm khi chịu đựng lâu như vậy.", en: "I will make sure nobody knows it was you who told. You were very brave to bear it so long.")
]
#visao("Nạn nhân bắt nạt thường im lặng vì sợ trả thù. Trước hết phải làm cho em thấy an toàn và không có lỗi. Phần xử lý nhóm bắt nạt cần rõ ràng và có hệ thống, vì hành vi lặp lại phải có hậu quả thật, nhưng kế hoạch sửa lỗi cho các em một lối đi để thay đổi.", en: "Victims of bullying are often silent for fear of revenge. First he must feel safe and blameless. Handling the group must be clear and systematic, since repeated behaviour must have real consequences, but the repair plan gives them a way to change.")
#ranhgioi("Bảo vệ nạn nhân là ưu tiên một. Phải báo nhà trường và gia đình, lưu lại bằng chứng như tin nhắn. Không ép hòa giải mặt đối mặt khi nạn nhân chưa sẵn sàng. Không bắt nạn nhân xin lỗi hay nhường nhịn. Nếu có dấu hiệu tự hại, báo ngay gia đình và chuyên viên tâm lý.", en: "Protecting the victim is priority one. You must report to the school and family, and keep evidence such as messages. Do not force face-to-face reconciliation before the victim is ready. Do not make the victim apologise or yield. If there are signs of self-harm, tell family and a counsellor at once.")
#bientau("Mời nhóm nhỏ các bạn tốt đồng hành với Tín một tuần, như ngồi cùng ăn trưa, mà không để em cảm thấy bị thương hại.", en: "Invite a small group of kind classmates to accompany Tin for a week, such as eating lunch together, without letting him feel pitied.")
#caunoi("Thầy đã biết chuyện, em không có lỗi gì. Thầy sẽ lo, và em có thể tìm thầy bất cứ lúc nào.", en: "I know, and it is not your fault. I will deal with it, and you can find me at any time.")

#sec("Em hút thuốc lá, thuốc lá điện tử", en: "A student smokes or vapes")
#tinhhuong("15.3", "Em hút thuốc lá, thuốc lá điện tử", "Bảo vệ báo có mùi thuốc ở nhà vệ sinh sau trường. Thầy tìm đến thì thấy Hùng cùng hai bạn cầm một cây vape. Cả ba hoảng, giấu tay ra sau lưng.", en: "The caretaker reports a smell of smoke in the toilets behind the school. You go and find Hung with two friends holding a vape. All three panic, hiding their hands behind their backs.")
#chieu("Hai mươi bốn giờ không khói và một bài tìm hiểu", "Thầy giữ vape một cách an toàn, ghi lại, không la mắng. Thầy nói: thầy lo cho sức khỏe của các em hơn là giận các em. Thầy giao hai việc: một, hai mươi bốn giờ không dùng và ghi lại em thấy thế nào, mỗi lần thèm là lúc nào; hai, mỗi em tự tìm hiểu một điều có thật về tác hại của thuốc lá điện tử với người tuổi mình và kể lại cho thầy trong năm phút. Thầy báo gia đình, kèm thông tin về hỗ trợ cai nghiện cho trẻ vị thành niên. Thầy không cười, không dọa, chỉ đặt câu hỏi.", en: ("Twenty-four hours smoke-free and a research task", "Take the vape safely, record it, do not shout. Say: I am more worried about your health than angry. Give two tasks: one, twenty-four hours without using it, noting how you feel and when you crave it; two, each finds one real fact about the harm of vaping to people your age and tells you in five minutes. Inform the family, with information on help for minors to quit. Do not laugh or threaten, only ask questions."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy giữ thiết bị này an toàn. Thầy lo cho sức khỏe của các em hơn là giận. Hai việc cho các em: hai mươi bốn giờ không dùng và ghi lại lúc nào thèm nhất, và tự tìm một điều có thật về tác hại để kể thầy nghe.", en: "I am keeping this device safely. I am more worried about your health than angry. Two tasks for you: twenty-four hours without it, noting when you crave it most, and find one real fact about the harm to tell me.")
  #tro("Dạ... tụi em xin lỗi. Tụi em tưởng không sao thầy.", en: "Um... we are sorry. We thought it was okay, sir.")
  #thay("Nhiều bạn cũng nghĩ vậy, vì thế thầy muốn các em tự đọc để biết. Có khó khăn thì ghé thầy, thầy giúp tìm người hỗ trợ.", en: "Many people think so, which is why I want you to read for yourselves. If it is hard, come to me and I will help find support.")
]
#visao("Dọa dẫm thường không hiệu quả với thuốc lá, vì em đã quen với việc nghe những lời dọa. Tự ghi lại cơn thèm và tự tìm bằng chứng khiến em nhìn thấy mối nguy bằng thông tin mình chọn. Báo gia đình đảm bảo em được hỗ trợ ngoài trường.", en: "Threats rarely work on tobacco, because students are used to hearing threats. Noting cravings and finding evidence themselves lets them see the danger in information they chose. Informing the family ensures support outside school.")
#ranhgioi("Phải báo gia đình và nhà trường theo quy định. Không xem điện thoại hay lục cặp quá mức. Không mỉa mai hay nói như đã biết thế nào cũng hư. Nếu em lệ thuộc nặng, đề nghị gia đình đưa em đến cơ sở y tế hoặc tư vấn cai nghiện cho người trẻ.", en: "You must inform family and school as regulations require. Do not search phones or bags excessively. Do not sneer or say you knew they would turn out bad. If the student is badly dependent, advise the family to take him to a medical facility or youth cessation counselling.")
#bientau("Nếu có nhiều em dùng, mời chuyên gia y tế nói chuyện với cả khối bằng số liệu và hình ảnh thật, không dọa.", en: "If many use it, invite a health professional to talk to the whole year with real figures and images, not threats.")
#caunoi("Thầy lo cho sức khỏe của các em hơn là giận. Hai mươi bốn giờ không dùng, rồi mình nói chuyện nhé.", en: "I am more worried about your health than angry. Twenty-four hours without it, then we talk.")

#sec("Em mang vật cấm: dao, pháo, bật lửa", en: "A student brings a prohibited item: knife, firecracker, lighter")
#tinhhuong("15.4", "Em mang vật cấm: dao, pháo, bật lửa", "Giữa tiết, bạn bên cạnh nói nhỏ với thầy: bạn Kiệt có con dao nhỏ trong cặp. Thầy nhìn Kiệt, em cúi đầu. Em nói chỉ để gọt bút chì, nhưng đó là con dao xếp bấm.", en: "In the middle of the lesson, a classmate whispers to you: Kiet has a small knife in his bag. You look at Kiet; he bows his head. He says it is only for sharpening pencils, but it is a flick knife.")
#chieu("Hộp gửi an toàn", "Thầy giữ bình tĩnh tuyệt đối. Thầy mời em ra ngoài lớp, nói riêng, và đề nghị em tự đưa con dao ra, đặt vào một chiếc hộp có nắp thầy chuẩn bị sẵn. Thầy ghi lại với em, không la. Thầy nói: thầy tin em chưa có ý hại ai, nhưng dao trong trường là điều mình không thể cho phép. Thầy hỏi: em mang vì sao? Có ai đe dọa em, hay em thấy cần tự vệ? Thầy báo nhà trường và mời gia đình đến nhận lại, cùng nghe lý do thật của em.", en: ("The safe-keeping box", "Stay perfectly calm. Invite him outside, speak privately, and ask him to hand the knife over himself, placing it in a lidded box you have ready. Record it with him, without scolding. Say: I believe you have no intention of harming anyone, but a knife in school is something we cannot allow. Ask: why did you bring it? Has someone threatened you, or did you feel you needed to protect yourself? Tell the school and invite the family to collect it, and hear his real reason together."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Kiệt, em đưa thầy con dao, đặt vào hộp này. Thầy không la em. Thầy chỉ muốn hỏi: em mang nó vì sao? Có ai làm em sợ không?", en: "Kiet, hand me the knife and put it in this box. I am not shouting at you. I only want to ask: why did you bring it? Is someone frightening you?")
  #tro("(Im một lúc.) Dạ... có mấy anh ngoài cổng hay chặn em, em sợ.", en: "(Silent a moment.) Um... some older boys at the gate keep stopping me, I am scared.")
  #thay("Cảm ơn em đã nói. Thầy sẽ xử lý chuyện này với nhà trường, em không phải tự lo một mình.", en: "Thank you for telling me. I will deal with this with the school; you do not have to cope alone.")
]
#visao("Nhiều em mang vật cấm vì sợ, không phải vì ác ý. Giữ bình tĩnh giúp em đưa ra thật, và hỏi lý do mở ra việc thầy cô có thể bảo vệ em ở chỗ thật sự nguy hiểm. Hình thức giao nhận bằng chiếc hộp giữ phẩm giá cho em.", en: "Many students carry prohibited items out of fear, not malice. Staying calm helps him hand it over honestly, and asking the reason lets teachers protect him where it is truly dangerous. The ritual of handing it over in a box keeps his dignity.")
#ranhgioi("An toàn của cả lớp là ưu tiên. Phải báo nhà trường, gia đình và theo quy định. Không giằng co hay khám người em một mình. Nếu vật là vũ khí nguy hiểm hoặc có đe dọa, báo ngay ban giám hiệu và cơ quan chức năng theo quy trình.", en: "The safety of the whole class is the priority. You must report to the school, family, and as regulations require. Do not wrestle with him or search him alone. If the item is a dangerous weapon or there is a threat, tell the headteacher and authorities at once through proper procedure.")
#bientau("Cùng nhà trường lập đường dây báo kín cho các em khi có ai mang vật nguy hiểm, để không em nào phải làm người tố cáo trực diện.", en: "With the school, set up an anonymous reporting line for students when someone brings something dangerous, so no student has to accuse directly.")
#caunoi("Em đưa thầy vật này, thầy không la. Thầy muốn biết em mang vì sao, có ai làm em sợ không?", en: "Hand me this and I will not shout. I want to know why you brought it, and whether someone is frightening you.")

#sec("Em đe dọa: ra ngoài thầy xử", en: "A student threatens: I will deal with you outside")
#tinhhuong("15.5", "Em đe dọa: ra ngoài thầy xử", "Sau một cuộc cãi vã, Đạt chỉ vào mặt một bạn và nói: ra khỏi cổng trường mày chết với tao. Cả lớp nghe thấy. Bạn kia tái mặt. Đạt vẫn còn đang giận.", en: "After a quarrel, Dat points a finger at a classmate and says: when we get out of the school gate you are dead. The whole class hears. The other student turns pale. Dat is still furious.")
#chieu("Cuộc hẹn trong phòng thầy", "Thầy mời Đạt ra ngoài, không nói trước lớp. Thầy bình tĩnh nói: câu em vừa nói thầy rất nghiêm túc. Thầy không muốn ai bị thương, cả bạn kia và em. Thầy cho em ngồi yên mười phút, uống nước, rồi nói: giờ ra về, thầy sẽ đi cùng hai em ra cổng và hai em về hướng khác nhau. Sáng mai, nếu cả hai đồng ý, thầy mời hai em ngồi cùng nhau nói chuyện. Thầy báo nhà trường và gia đình hai em.", en: ("A meeting in the teacher's office", "Invite Dat outside, saying nothing before the class. Say calmly: I take what you just said very seriously. I do not want anyone hurt, neither the other student nor you. Let him sit quietly for ten minutes, drink water, then say: at the end of school I will walk with both of you to the gate and you go in different directions. Tomorrow morning, if both agree, I invite you two to sit and talk. Tell the school and both families."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Đạt, thầy nghe câu em nói và thầy rất nghiêm túc. Thầy không muốn em hay bạn bị thương. Em ngồi yên mười phút, uống nước, rồi mình nói chuyện.", en: "Dat, I heard what you said and I take it very seriously. I do not want you or him hurt. Sit quietly for ten minutes, drink some water, and then we will talk.")
  #tro("Dạ... em chỉ nói vậy thôi, em không làm thật đâu thầy.", en: "Um... I only said it, I would not really do it, sir.")
  #thay("Có thể vậy, nhưng thầy không thể mạo hiểm. Chiều nay thầy đi cùng hai em ra cổng, mỗi em một hướng.", en: "Perhaps so, but I cannot take the risk. This afternoon I will walk you both to the gate, each in a different direction.")
]
#visao("Lời đe dọa thường phát ra từ cơn giận, nhưng cả hai em đều cần được bảo vệ. Giữ bình tĩnh và nghiêm túc cho em thấy thầy không coi nhẹ, cũng không làm em mất mặt. Việc đi cùng ra cổng ngăn chuyện xấu xảy ra ngay lập tức.", en: "A threat often comes from anger, but both students need protection. Staying calm and serious shows him you do not take it lightly, nor do you shame him. Walking them to the gate prevents harm happening immediately.")
#ranhgioi("Luôn xem đe dọa là nghiêm túc cho đến khi chắc chắn không. Phải báo nhà trường và gia đình. Không để hai em một mình đối diện lúc còn giận. Nếu có dấu hiệu em từng bị bạo hành và đang bắt chước, cần hỗ trợ tâm lý.", en: "Treat a threat as serious until you are sure it is not. You must report to the school and the families. Do not leave the two alone to face each other while still angry. If there are signs he was abused and is imitating, he needs psychological support.")
#bientau("Dạy cả lớp một kỹ thuật ngắn khi tức giận: đếm ngược mười, đi ra chỗ khác, nói với người lớn.", en: "Teach the whole class a short technique for anger: count down from ten, step away, tell an adult.")
#caunoi("Thầy rất nghiêm túc với câu em vừa nói. Thầy không muốn ai bị thương, và thầy sẽ đi cùng hai em ra cổng.", en: "I take what you said very seriously. I do not want anyone hurt, and I will walk you both to the gate.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 15: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Khi có bạo lực, bắt nạt hay vật nguy hiểm, an toàn đi trước, vui nhẹ nhàng đi sau. Chiêu nhẹ chỉ là phần phụ, không được thay thế việc báo cáo và bảo vệ.", "Luôn ghi lại sự việc, báo nhà trường, và liên hệ gia đình. Thầy cô không phải gánh một mình những chuyện này.", "Hỏi vì sao trước khi xử lý. Nhiều em mang dao, hút thuốc, đe dọa vì sợ hoặc bị cuốn vào nhóm. Hiểu được nguyên nhân giúp bảo vệ em thật sự.",), en: ("With violence, bullying or dangerous objects, safety comes first and fun comes after. Gentle moves are only a supplement; they never replace reporting and protecting.", "Always record what happened, tell the school, and contact the family. Teachers should not carry these matters alone.", "Ask why before you deal with it. Many students carry knives, smoke, or threaten from fear or being drawn into a group. Understanding the cause helps protect the student for real.",))
