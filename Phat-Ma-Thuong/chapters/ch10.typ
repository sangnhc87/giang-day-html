#import "../template.typ": *

#chapter-open(10, "Quay cóp, chép bài, gian lận", 10, "Một em quay cóp thường không phải vì xấu. Em quay cóp vì sợ. Gỡ nỗi sợ trước, rồi hãy xử lý hành vi.", "Quay cóp là lỗi nặng nhất về đạo đức học đường nhưng cũng là lỗi mà thầy cô dễ xử lý sai nhất, vì phạt nặng khiến em giấu giỏi hơn, còn bỏ qua khiến các em khác thấy gian lận có lợi. Chương này gợi những cách giữ nguyên tắc rất rõ nhưng vẫn đủ nhân văn để em sửa được, và để các bạn trung thực không bị thiệt.", ("Em chép bài bạn trước giờ vào lớp", "Em quay cóp trong bài kiểm tra", "Bạn giỏi cho chép bài rồi nói là giúp bạn", "Em dùng bài mạng chép nguyên văn",), en: ("Copying, cribbing, cheating", "A student who copies is seldom bad. He copies out of fear. Remove the fear first, then deal with the behaviour.", "Cheating is the gravest breach of school ethics, and also the fault teachers handle wrongly most easily, because heavy punishment makes students hide it better, while ignoring it tells others that cheating pays. This chapter offers ways to hold the principle very clearly yet humanely enough that the student can mend, and honest students are not disadvantaged.", ("A student copies a friend's homework before class", "A student cheats during a test", "A strong student lets a friend copy and calls it helping", "A student copies an online text word for word",)))

#sec("Em chép bài bạn trước giờ vào lớp", en: "A student copies a friend's homework before class")
#tinhhuong("10.1", "Em chép bài bạn trước giờ vào lớp", "Sáng nào thầy cũng thấy vài em xúm lại chép bài của bạn học giỏi trước giờ vào lớp. Có em chép nguyên văn cả sai chính tả. Bạn cho chép thì cười, nói là giúp bạn.", en: "Every morning you see several students crowd round a strong student's notebook to copy before class. One copies word for word, even the spelling errors. The friend lets them copy and laughs, saying he is helping.")
#chieu("Chép mà hiểu", "Thầy không bắt chép lại. Thầy gọi riêng em chép và nói: thầy cho em chọn một câu em đã chép, giải thích cho thầy nghe bằng lời của em một bước thôi. Nếu em nói được thì em đã học được từ chép, thầy ghi nhận. Nếu chưa nói được, thầy ngồi cùng em năm phút giảng lại đúng câu đó. Từ đó em hiểu chép là đường vòng mệt hơn học.", en: ("Copy and understand", "Do not make him copy again. Call the student who copied aside: choose one answer you copied and explain one step to me in your own words. If he can, he learned something from copying and you acknowledge it. If not, you sit with him for five minutes and explain exactly that line again. From then he sees that copying is a longer, more tiring route than learning."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Em chọn một câu em chép sáng nay, giải thích cho thầy một bước bằng lời của em. Em không nói được cũng không sao, thầy giảng lại ngay.", en: "Pick one answer you copied this morning and explain one step to me in your own words. If you cannot, that is fine; I will explain it again right away.")
  #tro("Dạ... em chưa hiểu bước này thầy.", en: "Um... I do not understand this step, sir.")
  #thay("Cảm ơn em nói thật. Mình ngồi năm phút làm lại nhé.", en: "Thank you for being honest. Let us sit for five minutes and redo it.")
]
#visao("Chép bài thường xảy ra khi em không đủ thời gian hoặc thấy bài khó. Cho em cơ hội chuyển từ chép sang hiểu một câu giúp em nhìn thấy chỗ trống kiến thức. Chiêu này không phạt mà làm hành vi chép mất ý nghĩa.", en: "Copying often happens when a student lacks time or finds the work hard. A chance to move from copying to understanding one line lets him see the gap in his knowledge. This move does not punish, it removes the point of copying.")
#ranhgioi("Không công khai tên em chép. Không dùng khi em chép vì quá tải nặng, vì lúc đó cần hỗ trợ khối lượng bài. Không đổ lỗi cho bạn cho chép trước lớp.", en: "Do not publicly name the student who copied. Do not use it when he copies from heavy overload, since then the workload needs support. Do not blame the friend who let him copy before the class.")
#bientau("Thiết lập góc làm bài sớm: sáng nào mười phút đầu cho học sinh làm bài cùng nhau có thầy ngồi cùng.", en: "Set up a corner for early work: ten minutes at the start of the morning where students do homework together with you sitting among them.")
#caunoi("Em giải thích giúp thầy một bước em đã chép nhé. Chưa hiểu thì thầy giảng lại.", en: "Explain one step you copied for me, in your own words. If you do not understand it yet, I will explain it again.")

#sec("Em quay cóp trong bài kiểm tra", en: "A student cheats during a test")
#tinhhuong("10.2", "Em quay cóp trong bài kiểm tra", "Thầy thấy Bảo liếc sang bài bạn bên cạnh hai lần. Đến lần thứ ba, thầy chắc chắn. Em biết mình bị phát hiện, mặt trắng bệch, tay run. Cả lớp không ai nhìn thấy.", en: "You see Bao glance at his neighbour's paper twice. By the third, you are certain. He knows he has been caught, his face white and his hand trembling. Nobody else in the class has noticed.")
#chieu("Hai lượt bài", "Thầy lặng lẽ úp bài em xuống, nói nhỏ: thầy giữ bài này, em làm tiếp trên tờ khác. Cuối giờ thầy giữ riêng em: lần này em làm, thầy giữ kết quả ở mức bài thật. Ba ngày sau, em làm lại một phần tương đương trong mười phút trước mặt thầy để thầy biết em thật sự hiểu đến đâu. Điểm lần sau là điểm thật. Thầy hỏi: điều gì khiến em muốn nhìn bài bạn? Em nói thật thì thầy cùng em tìm cách.", en: ("Two rounds", "Quietly turn his paper face down and whisper: I am keeping this paper; carry on a fresh sheet. At the end, keep him back privately: this time you did the work, I keep the result at the level of the genuine paper. Three days later he redoes an equivalent part in ten minutes in front of you so you know how much he really understands. The second mark is the true one. Ask: what made you want to look at your friend's paper? If he says the truth, you find a way together."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Bảo, thầy giữ bài này, em làm trên tờ khác. Cuối giờ em ở lại một chút, thầy muốn hỏi em một chuyện, không phải để mắng.", en: "Bao, I am keeping this paper; carry on with a new sheet. Stay a moment at the end, I want to ask you something, not to scold you.")
  #tro("Dạ... em xin lỗi thầy. Em sợ bị điểm thấp, ba mẹ đánh.", en: "Um... I am sorry, sir. I was afraid of a low mark, and my parents would hit me.")
  #thay("Thầy hiểu. Cảm ơn em nói thật. Thầy không để chuyện này lan ra. Mình cùng tìm cách ôn thêm cho em tự tin hơn nhé.", en: "I understand. Thank you for telling me the truth. I will not let this spread. Let us find a way to revise so you feel more confident.")
]
#visao("Gian lận thường là biểu hiện của nỗi sợ, và nỗi sợ sẽ lặp lại nếu chỉ phạt hành vi. Đưa ra cơ hội làm lại có thầy chứng kiến vừa giữ nguyên tắc, vừa cho em lối đi. Em học được rằng nói thật không hủy hoại em.", en: "Cheating is often a sign of fear, and the fear will recur if only the behaviour is punished. Offering a chance to redo it with you present keeps the principle and gives him a path. He learns that telling the truth does not destroy him.")
#ranhgioi("Nếu nội quy trường quy định mức xử lý, phải làm đúng quy định nhưng vẫn giữ giọng nhân văn. Không cười nhạo, không nói với cả lớp. Nếu nỗi sợ đến từ gia đình bạo hành, thầy cô cần hỗ trợ kín đáo, không nên thông báo gia đình ngay.", en: "If school rules set a penalty, follow them but keep a humane tone. Do not mock, do not tell the class. If the fear comes from violence at home, the teacher needs to give discreet support, and should not tell the family at once.")
#bientau("Cho em viết một tờ ngắn: nếu em được làm lại, em sẽ chuẩn bị gì và nhờ ai giúp.", en: "Have him write a short note: if I could redo it, what would I prepare and whom would I ask for help.")
#caunoi("Thầy giữ bài này. Em ở lại một chút, thầy muốn hỏi một chuyện, không phải để mắng.", en: "I am keeping this paper. Stay a moment, I want to ask you something, not to scold.")

#sec("Bạn giỏi cho chép bài rồi nói là giúp bạn", en: "A strong student lets a friend copy and calls it helping")
#tinhhuong("10.3", "Bạn giỏi cho chép bài rồi nói là giúp bạn", "Hiền cho bạn thân chép bài kiểm tra, vì không nỡ từ chối. Cô bạn kia sau đó bị phát hiện và khai ra Hiền. Hiền khóc, nói em chỉ muốn giúp bạn.", en: "Hien let her close friend copy a test because she could not bring herself to refuse. The friend was later caught and named Hien. Hien cries and says she only wanted to help.")
#chieu("Cho cần câu", "Thầy nói riêng với Hiền: tình bạn của em quý, nhưng cho bạn chép là cho cá chứ không cho cần câu. Nhiệm vụ của em: hai buổi sau em ngồi dạy lại bạn đúng phần bài đó, thầy ngồi bên cạnh quan sát. Em dạy xong thì thầy đo kết quả bằng một bài ngắn của bạn, không tính điểm. Hiền thấy giúp thật nghĩa là gì, và bạn kia thật sự học được.", en: ("Give the fishing rod", "Tell Hien privately: your friendship is precious, but letting her copy is giving a fish, not a fishing rod. Your task: for two sessions you sit and teach her friend exactly that part, with me beside you observing. After you finish, measure the result with a short paper of hers, not marked. Hien sees what real help means, and the other student actually learns."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hiền, thầy hiểu em thương bạn. Nhưng cho chép là cho cá. Hai buổi tới em dạy lại bạn đúng phần bài đó nhé, thầy ngồi bên cạnh.", en: "Hien, I understand you love your friend. But letting her copy is giving a fish. For the next two sessions you will teach her that exact part, and I will sit beside you.")
  #tro("Dạ... em dạy được thầy. Nhưng bạn ấy có giận em không?", en: "Um... I can teach her, sir. But will she be angry with me?")
  #thay("Thầy tin bạn hiểu. Mình cùng nói với bạn rằng em giúp theo cách khác.", en: "I believe she will understand. Let us tell her together that you help in a different way.")
]
#visao("Em cho chép thường vì tình bạn, không phải vì gian. Chiêu này giữ lại tình bạn và đổi cách giúp, giúp em hiểu ranh giới giữa giúp thật và giúp sai. Cô bạn kia cũng học thật.", en: "Students who let others copy usually act out of friendship, not dishonesty. This keeps the friendship and changes the form of help, so she grasps the line between real and wrong help. The other student also truly learns.")
#ranhgioi("Không công khai chuyện cho chép. Không để Hiền gánh trách nhiệm một mình cho bạn kia. Điểm của bài gian lận vẫn xử lý theo quy chế.", en: "Do not publicise the copying. Do not let Hien bear the responsibility alone for her friend. The mark for the cheated paper is still handled by regulation.")
#bientau("Lập đôi bạn cùng tiến để các em giúp nhau học một cách hợp lệ.", en: "Form pairs of buddies who help each other learn in permitted ways.")
#caunoi("Cho bạn chép là cho cá. Em dạy lại bạn bài đó, thầy ngồi cùng nhé.", en: "Letting a friend copy is giving a fish. You teach her that lesson and I will sit beside you.")

#sec("Em dùng bài mạng chép nguyên văn", en: "A student copies an online text word for word")
#tinhhuong("10.4", "Em dùng bài mạng chép nguyên văn", "Bài tập lớn của Phong có đoạn văn rất hay nhưng giọng văn lạ hẳn, không giống em. Thầy nghi em chép từ mạng hoặc dùng công cụ viết hộ. Em nói em tự viết.", en: "Phong's major assignment has a very good paragraph but a voice strangely unlike his. You suspect he copied it from the internet or used a tool to write it. He says he wrote it himself.")
#chieu("Đọc to để hỏi", "Thầy không buộc tội. Thầy mời em đọc to đoạn văn đó trước thầy, riêng. Thầy hỏi ba câu: ý chính đoạn này là gì, vì sao em chọn từ này, nếu viết lại bằng lời em thì em nói thế nào. Chỗ nào em giải thích được thì giữ. Chỗ nào không giải thích được, em viết lại bằng lời mình trong ba ngày. Thầy không hỏi em chép hay không, chỉ hỏi em có hiểu không.", en: ("Read aloud, then ask", "Do not accuse. Invite him to read the paragraph aloud to you privately. Ask three questions: what is the main idea, why did you choose this word, and if you rewrote it in your own words how would you say it? Where he can explain, the passage stays. Where he cannot, he rewrites in his own words within three days. You never ask whether he copied, only whether he understands."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Phong, thầy mời em đọc to đoạn này cho thầy nghe. Rồi thầy hỏi ba câu: ý chính là gì, vì sao em chọn từ này, và em nói lại bằng lời em thì thế nào.", en: "Phong, please read this paragraph aloud to me. Then I will ask three questions: what is the main idea, why did you choose this word, and how would you say it in your own words?")
  #tro("Dạ... đoạn này em có tham khảo thêm, em chưa hiểu hết thầy.", en: "Um... I referred to other sources for this paragraph, sir, I did not understand all of it.")
  #thay("Cảm ơn em nói thật. Em viết lại bằng lời mình trong ba ngày nhé, thầy sẽ đọc.", en: "Thank you for being honest. Rewrite it in your own words within three days and I will read it.")
]
#visao("Không buộc tội mà để em tự đối diện với hiểu biết của mình. Em thấy khoảng trống mà không cảm thấy bị bắt quả tang. Chuyển trọng tâm từ chép hay không sang hiểu hay không là cách dạy tinh thần học thật.", en: "Not accusing, but letting him face his own understanding. He sees the gap without feeling caught red-handed. Shifting the focus from whether he copied to whether he understands teaches the spirit of real learning.")
#ranhgioi("Nếu quy chế trường cấm nghiêm và em chép nguyên văn, vẫn phải xử lý theo đúng quy định. Không dùng phần hỏi để bẫy em. Tôn trọng giải thích của em nếu hợp lý.", en: "If school rules forbid it strictly and he copied verbatim, you must still follow procedure. Do not use the questions as a trap. Respect his explanation if reasonable.")
#bientau("Từ nay thầy đưa thêm bước trình bày miệng hai phút cho bài tập lớn.", en: "From now on add a two-minute oral presentation step to major assignments.")
#caunoi("Em đọc to đoạn này cho thầy, rồi nói lại bằng lời của em nhé.", en: "Read this paragraph aloud to me, then tell me in your own words.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 10: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Gian lận là nỗi sợ mặc áo hành vi. Gỡ nỗi sợ trước, giữ nguyên tắc sau, và luôn cho em một cơ hội làm lại thật.", "Hỏi em hiểu hay chưa hiểu, chứ đừng hỏi em có chép hay không. Câu hỏi thứ nhất dẫn tới học, câu hỏi thứ hai dẫn tới chối.", "Giữ danh dự cho em là giữ cánh cửa mở. Học sinh muốn sửa khi chưa bị đẩy vào đường cùng.",), en: ("Cheating is fear in the clothing of behaviour. Remove the fear first, keep the principle after, and always give a real chance to redo.", "Ask whether the student understands or not, never whether he copied. The first question leads to learning, the second leads to denial.", "Protecting the student's honour keeps the door open. Students want to mend when they have not been pushed into a corner.",))
