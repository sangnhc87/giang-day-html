#import "../template.typ": *

#chapter-open(10, "Rung động đầu đời và cơ thể đang lớn", 10, "Ba mẹ không chọn được việc con có rung động hay không. Ba mẹ chỉ chọn được việc con có kể cho mình nghe hay không.", "Chuyện tình cảm và giới tính là vùng mà ba mẹ Việt mình ngại nhất, nên hay xử lý bằng hai cách: cấm, hoặc lờ đi. Trong khi đó con vẫn lớn, vẫn rung động, và nếu không hỏi được ba mẹ thì con hỏi mạng, hỏi bạn. Chương này không dạy ba mẹ khuyến khích con yêu sớm. Nó giúp ba mẹ trở thành người con tìm tới được khi cần, vì ở vùng này, một lần con không dám kể có thể trả giá rất đắt.", ("Phát hiện con có người yêu", "Con thất tình", "Con hỏi một câu về giới tính làm mình đứng hình", "Con lỡ gửi một tấm ảnh riêng tư", "Con nói con thích một bạn cùng giới", "Người yêu của con kiểm soát con", "Con quen một người lớn tuổi hơn nhiều", "Con nói con chậm kinh, sợ có thai",), en: ("First feelings and a growing body", "You cannot choose whether your child has feelings for someone. You can only choose whether they will tell you.", "Romance and sexuality are what Vietnamese parents find most awkward, so we tend to handle them in two ways: forbid, or ignore. Meanwhile the child keeps growing and keeps having feelings, and if they cannot ask their parents they ask the internet and their friends. This chapter does not encourage early dating. It helps you become someone your child can come to when needed, because in this area a single time they did not dare to tell can cost very dearly.", ("You discover your child has a boyfriend", "Your child's heart is broken", "Your child asks a question about sex that freezes you", "Your child has sent a private photo", "Your child tells you they like someone of the same sex", "Your child's partner controls them", "Your child is seeing someone much older", "Your child says their period is late and they fear pregnancy",)))

#sec("Phát hiện con có người yêu", en: "You discover your child has a boyfriend")
#boicanh("Mẹ dọn phòng, thấy trong hộc bàn con gái lớp 9 một tấm thiệp: gửi Vy của anh. Điện thoại của Vy dạo này lúc nào cũng úp xuống. Tim mẹ đập thình thịch.", en: "Tidying her grade 9 daughter's room, Mum finds a card in the desk drawer: to my Vy. Lately Vy's phone is always face down. Mum's heart pounds.")
#phanxa("Mới nứt mắt ra đã yêu với đương! Thằng nào? Đưa điện thoại đây! Từ mai mẹ đưa đón, cấm tiệt!", "Thích một người là tội. Mẹ đọc lén đồ của mình. Từ giờ phải giấu kỹ hơn, và có chuyện gì cũng không được để mẹ biết.", en: ("Barely out of the cradle and already in love! Who is he? Give me your phone! From tomorrow I drive you everywhere; it's forbidden!", "Liking someone is a crime. Mum reads my things in secret. From now on hide better, and whatever happens, she must not find out."))
#scene("Tình huống 10.1 · Thử nói cách khác")[
  #me("(Để tấm thiệp lại chỗ cũ. Vài hôm sau, lúc hai mẹ con gấp đồ.) Vy nè, mẹ hỏi con chuyện này, con không muốn trả lời cũng được. Dạo này mẹ thấy con hay cười một mình với cái điện thoại. Có bạn nào đang làm con vui hả?", en: "(Puts the card back. A few days later, while they fold laundry.) Vy, may I ask something? You don't have to answer. Lately I see you smiling at your phone. Is there someone making you happy?")
  #con("(Đỏ mặt.) Đâu có gì đâu mẹ.", en: "(Blushes.) It's nothing, Mum.")
  #me("Ừ. Hồi lớp 9 mẹ cũng thích một anh lớp trên, viết thư tay đàng hoàng. Bà ngoại bắt được, xé trước mặt mẹ. Mẹ giận bà cả năm. Nên mẹ tự hứa sau này con mẹ có thích ai, mẹ sẽ không làm vậy.", en: "All right. In grade 9 I liked a boy in the year above, and I wrote proper letters by hand. Grandma found one and tore it up in front of me. I was angry with her for a year. So I promised myself that when my own child liked someone, I wouldn't do that.")
  #con("...Bà ngoại xé thiệt hả? Rồi mẹ có nghỉ thích ảnh không?", en: "...Grandma really tore it up? Did you stop liking him?")
  #me("Không. Mẹ chỉ nghỉ kể cho bà nghe thôi. (Cười.) Nên mẹ thà nghe con kể.", en: "No. I only stopped telling her. (Laughs.) So I'd rather hear it from you.")
  #con("(Im một lúc.) Bạn đó tên Khôi, lớp 9A3. Tụi con chỉ nhắn tin với đi về chung thôi.", en: "(After a pause.) His name is Khoi, class 9A3. We only text and walk home together.")
  #me("Khôi. Cảm ơn con cho mẹ biết. Bạn đó có gì làm con quý?", en: "Khoi. Thank you for telling me. What do you like about him?")
  #con("Bạn hiền, học Toán giỏi, hay chỉ bài cho con. Mẹ không cấm hả?", en: "He's kind and good at maths, and he helps me with homework. You're not forbidding it?")
  #me("Thích một người đâu phải cái công tắc mà mẹ bấm tắt được. Mẹ chỉ có vài điều mẹ cần con giữ: việc học không tụt, đi đâu mẹ biết, không ở riêng chỗ kín, và chuyện gì làm con thấy không thoải mái thì con có quyền nói không. Còn lại mẹ tin con.", en: "Liking someone is not a switch I can turn off. I only have a few things I need you to keep: your schoolwork doesn't slip, I know where you go, you don't stay alone together in private places, and whenever anything makes you uncomfortable you have the right to say no. Beyond that, I trust you.")
]
#hieusau1("Rung động ở tuổi mười ba mười lăm là một phần bình thường của sự phát triển, không phải dấu hiệu hư hỏng. Cấm đoán không làm cảm xúc biến mất, nó chỉ đẩy mối quan hệ vào bóng tối, nơi ba mẹ không còn thấy gì để mà bảo vệ con. Nghiên cứu về tuổi vị thành niên khá nhất quán: những em nói chuyện cởi mở được với ba mẹ về tình cảm có xu hướng chậm lại và an toàn hơn trong các mối quan hệ. Ba mẹ kể chuyện ngày xưa của mình là cách nhanh nhất để con thấy mình không bị xét xử.", en: "Having feelings at thirteen to fifteen is a normal part of development, not a sign of going wrong. A ban does not make feelings vanish; it only pushes the relationship into the dark, where parents can see nothing and therefore protect nothing. Research on adolescents is fairly consistent: those who can talk openly with parents about relationships tend to move more slowly and more safely. A parent telling their own old story is the quickest way for a child to feel they are not on trial.")
#cotloi("Cấm con rung động là việc không làm được. Việc làm được là giữ cho con vẫn kể, và cho con vài ranh giới rõ để tự giữ mình.", en: "Forbidding feelings cannot be done. What can be done is keeping your child talking, and giving them a few clear boundaries to protect themselves.")
#lamngay1("Kể cho con nghe về mối tình học trò đầu tiên của mình, có cả phần ngốc nghếch. Không kèm bài học. Chỉ kể. Con sẽ hiểu là chủ đề này nói được ở nhà.", en: "Tell your child about your own first school-age crush, silly parts included. No moral attached. Just tell it. Your child will understand this topic can be spoken about at home.")
#caunoi("Thích một người không có gì sai. Mẹ chỉ mong chuyện gì con cũng kể mẹ nghe được.", en: "There is nothing wrong with liking someone. I only hope you can tell me anything.")
#tusoi(("Nếu ngày xưa ba mẹ mình phản ứng khác đi với chuyện tình cảm của mình, mình có kể nhiều hơn không?", "Mình sợ con yêu sớm vì điều gì cụ thể nhất? Mình đã nói điều cụ thể đó với con chưa, hay chỉ nói cấm?",), en: ("If my own parents had reacted differently to my early feelings, would I have told them more?", "What exactly do I fear about early dating? Have I told my child that specific thing, or only said no?",))

#sec("Con thất tình", en: "Your child's heart is broken")
#boicanh("Thằng Khang lớp 11 ba ngày nay bỏ cơm, nằm úp mặt vô gối, mắt sưng. Em gái nó méc: anh Hai bị chị Ngân đá rồi. Ba vô phòng, thấy con trai mười bảy tuổi cao hơn mình mà co lại như đứa nhỏ.", en: "For three days Khang, in grade 11, has skipped meals and lain face down on his pillow, eyes swollen. His little sister reports: Ngan dumped him. Dad walks in and sees his seventeen-year-old, taller than himself, curled up like a small boy.")
#phanxa("Trời ơi có vậy mà cũng khóc. Đàn ông con trai mà yếu đuối. Lo học đi, sau này thành đạt thiếu gì gái theo.", "Nỗi đau của mình là chuyện tào lao. Con trai thì không được buồn. Ba không hiểu gì hết.", en: ("Crying over that? A boy shouldn't be so soft. Focus on your studies; once you're successful there'll be plenty of girls.", "My pain is nonsense. Boys are not allowed to be sad. Dad understands nothing."))
#scene("Tình huống 10.2 · Thử nói cách khác")[
  #ba("(Ngồi xuống cạnh giường, để tay lên lưng con, không nói gì một lúc.) Ba nghe bé Út nói rồi. Ba không hỏi gì đâu. Ba ngồi đây chút thôi.", en: "(Sits by the bed, rests a hand on his back, says nothing for a while.) Your sister told me. I'm not going to ask anything. I'll just sit here a bit.")
  #con("(Giọng nghẹt.) Con không sao.", en: "(Muffled.) I'm fine.")
  #ba("Ừ. Hồi ba hai mươi tuổi, ba bị người ta bỏ, ba cũng nói không sao. Rồi ba chạy xe vòng vòng thành phố tới hai giờ sáng. Đau thiệt chứ không phải đau chơi.", en: "Right. When I was twenty someone left me, and I said I was fine too. Then I rode around the city until two in the morning. It really hurt; it wasn't pretend.")
  #con("(Im lâu.) Nó nói con trẻ con. Nó quen thằng lớp 12 rồi.", en: "(A long silence.) She said I'm childish. She's with a grade 12 guy now.")
  #ba("Nghe câu đó chắc đau như ai đấm vô ngực.", en: "Hearing that must feel like a punch in the chest.")
  #con("Con làm gì cũng thấy nó. Con mở điện thoại là thấy hình nó với thằng kia.", en: "Whatever I do, I see her. I open my phone and there are photos of her with him.")
  #ba("Vậy thì khoan mở. Tạm ẩn người ta đi một thời gian, không phải vì ghét mà để vết thương khỏi bị cào lại mỗi ngày. Ba không nói con hết buồn liền được. Cái này phải mấy tuần, có khi mấy tháng. Nhưng nó sẽ nhạt dần, ba bảo đảm, vì ba qua rồi.", en: "Then don't open it for now. Mute her for a while, not out of hate but so the wound isn't scratched every day. I can't tell you the sadness will stop at once. This takes weeks, maybe months. But it will fade, I promise, because I've been through it.")
  #con("Ba qua rồi rồi ba gặp mẹ hả?", en: "And after that you met Mum?")
  #ba("Ba năm sau mới gặp mẹ con. Mà nè, ba ngày rồi con chưa ăn gì ra hồn. Ba không ép con vui, nhưng ép con ăn. Xuống ăn với ba tô hủ tíu, khỏi nói chuyện cũng được.", en: "Three years later. Now listen, for three days you've eaten nothing proper. I won't force you to be cheerful, but I will force you to eat. Come down and have a bowl of noodles with me; we don't have to talk.")
]
#hieusau1("Với người lớn, mối tình tuổi học trò là chuyện nhỏ. Với đứa trẻ, đó là lần mất mát lớn đầu tiên trong đời, và não tuổi mới lớn xử lý sự từ chối xã hội mạnh gần như một cơn đau thể xác. Xem nhẹ nỗi đau đó dạy con, nhất là con trai, rằng buồn là yếu và phải giấu. Ngồi cạnh, công nhận nó đau thật, kể rằng mình từng qua, rồi giữ cho con những nhịp cơ bản là ăn và ngủ: bấy nhiêu là đủ. Ba mẹ cũng cần để ý nếu con buồn quá hai ba tuần mà không nhúc nhích, hoặc nói những câu như sống làm gì.", en: "To adults a school romance is a small thing. To a child it is the first great loss of their life, and the adolescent brain processes social rejection almost as strongly as physical pain. Belittling it teaches children, boys especially, that sadness is weakness and must be hidden. Sitting close, admitting that it really hurts, saying you have been through it, and keeping the basics going, food and sleep: that is enough. Parents should also take note if the sadness has not shifted after two or three weeks, or if the child says things like what is the point of living.")
#cotloi("Đừng đo nỗi đau của con bằng cây thước của người lớn. Lần đầu bị bỏ rơi, con đau thật. Ngồi cạnh con là đủ, không cần lời hay.", en: "Do not measure your child's pain with an adult ruler. Being left for the first time truly hurts. Sitting beside them is enough; fine words are not needed.")
#lamngay1("Nếu con đang buồn chuyện tình cảm, làm một việc cụ thể không cần lời: nấu món con thích, rủ con đi một vòng xe, ngồi coi phim chung. Sự có mặt nói thay được rất nhiều câu.", en: "If your child is sad over a relationship, do one concrete wordless thing: cook their favourite dish, take them for a ride, watch a film together. Presence says a great deal.")
#caunoi("Chuyện này đau thiệt, ba biết. Nó sẽ nhạt dần. Ba từng qua rồi.", en: "This really hurts, I know. It will fade. I have been through it.")
#tusoi(("Trong nhà mình, con trai có được phép khóc không?", "Mình có nhớ nỗi buồn đầu đời của mình lớn cỡ nào vào lúc đó không?",), en: ("In our home, are boys allowed to cry?", "Do I remember how big my own first heartbreak felt at the time?",))

#sec("Con hỏi một câu về giới tính làm mình đứng hình", en: "Your child asks a question about sex that freezes you")
#boicanh("Đang coi tivi, bé Bi lớp 3 quay qua hỏi tỉnh bơ: mẹ ơi, em bé chui vô bụng mẹ bằng cách nào? Mấy năm sau, cũng thằng Bi đó lên lớp 7, mẹ vô tình thấy lịch sử máy tính có những trang không dành cho tuổi nó.", en: "Watching television, Bi, in grade 3, turns and asks calmly: Mum, how does a baby get into a mummy's tummy? A few years later the same Bi is in grade 7, and Mum happens to see in the computer history sites not meant for his age.")
#phanxa("Lúc con nhỏ: Con nít hỏi bậy bạ! Lớn lên rồi biết. Lúc con lớn: Con coi cái thứ gì bệnh hoạn vậy hả? Mẹ ghê con quá!", "Chuyện này dơ bẩn, không được hỏi. Mình tò mò tức là mình bệnh hoạn. Muốn biết thì phải lén tìm chỗ khác.", en: ("When he was small: Don't ask such rude things! You'll know when you grow up. When he was older: What sick stuff are you watching? You disgust me!", "This topic is dirty and must not be asked about. Being curious means I am sick. If I want to know, I must look elsewhere in secret."))
#scene("Tình huống 10.3 · Thử nói cách khác")[
  #me("(Năm con lớp 3.) Câu hỏi hay đó. Em bé bắt đầu từ một tế bào nhỏ xíu của ba gặp một tế bào nhỏ xíu của mẹ. Hai cái gặp nhau trong bụng mẹ, ở một chỗ gọi là tử cung, rồi lớn dần chín tháng. Con muốn biết thêm gì nữa không?", en: "(When he is in grade 3.) Good question. A baby starts from a tiny cell from the dad meeting a tiny cell from the mum. They meet inside the mum, in a place called the uterus, and grow for nine months. Would you like to know anything else?")
  #con("Rồi nó ra bằng đường nào?", en: "Then how does it come out?")
  #me("Có một đường riêng để em bé ra, gọi là âm đạo, hoặc bác sĩ mổ bụng mẹ đưa em ra. Con thì ra bằng đường mổ, mẹ còn sẹo nè.", en: "There is a special passage for the baby to come out, called the vagina, or a doctor opens the mum's tummy and lifts the baby out. You came out that way; I still have the scar.")
  #con("À. (Quay lại coi tivi.)", en: "Oh. (Goes back to the television.)")
  #me("(Năm con lớp 7, gõ cửa phòng.) Bi, mẹ nói chuyện này hơi ngại, mà mẹ nghĩ cần nói. Mẹ thấy lịch sử máy tính. Mẹ không la, không phạt. Tuổi con tò mò về cơ thể, về chuyện đó là bình thường, ai cũng vậy.", en: "(When he is in grade 7, knocks on his door.) Bi, this is a bit awkward to say, but I think I should. I saw the computer history. I'm not scolding and I'm not punishing. At your age, being curious about bodies and about sex is normal; everyone is.")
  #con("(Mặt đỏ bừng, cúi gằm.) ...Con xin lỗi.", en: "(Bright red, head down.) ...I'm sorry.")
  #me("Con không cần xin lỗi vì tò mò. Mẹ chỉ muốn con biết một điều mà mấy trang đó không nói: thứ trong đó là diễn, giống phim hành động, không phải thật. Ngoài đời, chuyện đó phải có thương nhau, tôn trọng nhau, hai người đều đồng ý, và người ta không đối xử với nhau như vậy. Coi nhiều thì đầu mình dễ tưởng đó là bình thường.", en: "You don't need to apologise for being curious. I just want you to know something those sites don't say: what's on them is acting, like an action film, not real. In real life, that has to come with love, respect and both people agreeing, and people do not treat each other that way. Watching a lot can make the mind think it is normal.")
  #con("Dạ.", en: "Okay.")
  #me("Mẹ sẽ cài bộ lọc trên máy, không phải vì không tin con mà vì mấy trang đó thiết kế ra để níu người ta lại. Còn con thắc mắc gì về cơ thể, về con gái, về bất cứ thứ gì, con hỏi ba hoặc mẹ. Ngại quá thì viết giấy cũng được. Hoặc mẹ mua cho con một cuốn sách đàng hoàng.", en: "I'll put a filter on the computer, not because I don't trust you but because those sites are designed to hold people. And anything you wonder about, your body, girls, anything, ask Dad or me. If it's too awkward, write a note. Or I'll buy you a proper book.")
  #con("...Mua sách đi mẹ.", en: "...Buy the book, Mum.")
]
#hieusau1("Trẻ hỏi về giới tính với sự tò mò y như hỏi vì sao trời mưa. Sự ngượng ngùng là của người lớn. Trả lời đúng, ngắn, dùng tên gọi thật của các bộ phận, và dừng khi con hết hỏi, là đủ. Con được dạy tên gọi đúng và được trả lời nghiêm túc sẽ biết cách mô tả và lên tiếng nếu bị ai đó đụng chạm sai. Còn với tuổi dậy thì, trẻ tiếp xúc nội dung người lớn trên mạng sớm hơn ba mẹ nghĩ rất nhiều. Làm con xấu hổ chỉ khiến con giấu. Điều con cần là một người lớn bình tĩnh nói cho con biết thứ đó méo mó ở chỗ nào.", en: "Children ask about sex with exactly the curiosity with which they ask why it rains. The embarrassment belongs to the adults. A correct, short answer, using the real names of body parts, and stopping when the child stops asking, is enough. Children who are taught correct names and answered seriously know how to describe and speak up if someone touches them wrongly. As for puberty, children meet adult content online far earlier than parents think. Shaming only makes them hide. What they need is a calm adult explaining where that content is distorted.")
#cotloi("Con hỏi về giới tính tức là con còn tin ba mẹ. Trả lời thật, ngắn, bình thản. Nếu ba mẹ không trả lời, mạng sẽ trả lời thay.", en: "A child who asks you about sex still trusts you. Answer truthfully, briefly, calmly. If you do not answer, the internet will.")
#lamngay1("Tìm một cuốn sách giáo dục giới tính hợp với tuổi của con, đọc trước một lượt, rồi đặt ở chỗ con dễ lấy. Nói với con: Sách này dành cho con, đọc xong muốn hỏi gì cứ hỏi.", en: "Find an age-appropriate book on bodies and sexuality, read it through first, and put it where your child can easily reach it. Say: This book is for you; ask me anything after reading.")
#caunoi("Tò mò là bình thường. Có gì thắc mắc con cứ hỏi ba mẹ, ngại quá thì viết giấy.", en: "Being curious is normal. Ask us anything; if it's too awkward, write a note.")
#tusoi(("Ngày xưa mình biết về chuyện giới tính từ nguồn nào? Mình có muốn con biết từ nguồn giống vậy không?", "Con mình đã biết tên gọi đúng của các bộ phận riêng tư và quy tắc không ai được đụng vào chưa?",), en: ("Where did I learn about sex when I was young? Would I want my child to learn from the same kind of source?", "Does my child know the correct names for private parts and the rule that nobody may touch them?",))

#sec("Con lỡ gửi một tấm ảnh riêng tư", en: "Your child has sent a private photo")
#boicanh("Hai giờ sáng, con bé Phương lớp 10 gõ cửa phòng ba mẹ, run lẩy bẩy, khóc không ra tiếng. Nó đã gửi ảnh riêng tư cho bạn trai. Hai đứa chia tay. Giờ thằng kia dọa tung lên nhóm lớp nếu nó không gửi thêm.", en: "At two in the morning Phuong, in grade 10, knocks on her parents' door, shaking, crying without sound. She sent intimate photos to her boyfriend. They broke up. Now he threatens to post them in the class group unless she sends more.")
#phanxa("Trời ơi là trời! Con gái con đứa mà ngu vậy hả? Mày bôi tro trát trấu vô mặt ba mẹ!", "Mình đã hủy hoại tất cả. Ba mẹ ghê tởm mình. Lẽ ra không nên nói. Không còn ai để bám.", en: ("Oh my God! How could a girl be so stupid? You have smeared our faces with ashes!", "I have destroyed everything. My parents are disgusted by me. I should not have told. There is nobody left to hold on to."))
#scene("Tình huống 10.4 · Thử nói cách khác")[
  #me("(Bật đèn, kéo con vô lòng.) Con nói ra được là đúng rồi. Đúng lắm. Mẹ ở đây, ba ở đây.", en: "(Switches on the light, pulls her close.) You were right to tell us. So right. I'm here, Dad is here.")
  #con("Con xin lỗi... con ngu quá... con chết mất mẹ ơi.", en: "I'm sorry... I was so stupid... I want to die, Mum.")
  #ba("Phương, nghe ba. Con tin lầm người, chuyện đó ai cũng có thể bị. Người sai nặng nhất lúc này là đứa đang đe dọa con. Cái nó làm là phạm pháp. Con không một mình nữa, từ giây này là việc của ba mẹ.", en: "Phuong, listen to me. You trusted the wrong person; that can happen to anyone. The one most in the wrong right now is the person threatening you. What he is doing is against the law. You are no longer alone; from this second it is our job.")
  #con("Nó nói sáng mai nó đăng nếu con không gửi thêm.", en: "He says he'll post them in the morning if I don't send more.")
  #me("Con tuyệt đối không gửi thêm gì, không chuyển tiền, không năn nỉ. Gửi thêm là nó có thêm thứ để dọa. Giờ con đưa điện thoại cho mẹ, mình chụp lại hết tin nhắn nó dọa. Đừng xóa gì hết.", en: "You must not send anything more, pay anything, or plead. Sending more only gives him more to threaten with. Give me your phone now and we'll screenshot every threat. Don't delete anything.")
  #con("Lỡ nó đăng thiệt thì sao? Cả trường sẽ thấy.", en: "What if he really posts them? The whole school will see.")
  #ba("Ba mẹ làm ngay mấy việc để chặn. Sáng mai ba gọi tổng đài 111 để được hướng dẫn và báo công an, vì đe dọa phát tán ảnh của người chưa đủ mười tám tuổi là tội nặng. Mẹ báo cáo tài khoản đó với nền tảng và gặp ban giám hiệu. Phần lớn những đứa dọa kiểu này rụt lại ngay khi biết người lớn và công an đã vào cuộc.", en: "We'll act right away to block that. In the morning I'll call the 111 hotline for guidance and report to the police, because threatening to share images of someone under eighteen is a serious crime. Mum will report the account to the platform and meet the school leadership. Most people who threaten like this back off the moment they learn adults and the police are involved.")
  #con("Ba mẹ có ghét con không?", en: "Do you hate me?")
  #me("Không. Mẹ thương con hơn bao giờ hết. Con đã làm một việc rất can đảm tối nay: con tới gõ cửa. Rất nhiều đứa không dám. Tối nay con ngủ đây với mẹ.", en: "No. I love you more than ever. You did something very brave tonight: you came and knocked. Many children don't dare. Tonight you sleep here with me.")
]
#hieusau1("Đây là một trong những tình huống nguy hiểm nhất với trẻ vị thành niên, vì nỗi xấu hổ và hoảng loạn có thể đẩy các em tới ý nghĩ tự hại chỉ trong vài giờ. Phản ứng trong năm phút đầu của ba mẹ quyết định con bám vào ai. Mọi lời trách lúc này đều phải gác lại. Con cần nghe ba điều: con nói ra là đúng, người sai là kẻ đe dọa, và từ giờ là việc của ba mẹ. Nguyên tắc xử lý: không gửi thêm, không trả tiền, lưu bằng chứng, báo cơ quan chức năng, và không để con một mình trong những ngày đầu.", en: "This is among the most dangerous situations for a teenager, because shame and panic can push a child towards thoughts of self-harm within hours. The parents' reaction in the first five minutes decides whom the child clings to. Every reproach must be set aside. The child needs to hear three things: you were right to tell us, the one in the wrong is the person threatening you, and from now on this is our job. The rules: send nothing more, pay nothing, keep the evidence, report to the authorities, and do not leave the child alone in the first days.")
#cotloi("Khi con tới với chuyện tệ nhất, câu đầu tiên phải là: con nói ra là đúng rồi. Bài học tính sau. Mạng sống và chỗ dựa của con tính trước.", en: "When your child comes to you with the worst thing, the first sentence must be: you were right to tell us. The lesson comes later. Their life and their anchor come first.")
#lamngay1("Nói với con ngay tuần này, khi chưa có chuyện gì: Nếu có ngày con lỡ gửi một thứ gì đó rồi bị dọa, dù chuyện có xấu hổ cỡ nào, con tới tìm ba mẹ ngay. Ba mẹ sẽ không la. Ba mẹ sẽ lo. Lời dặn này có thể cứu con.", en: "Tell your child this week, before anything happens: If one day you send something and get threatened, however embarrassing it is, come to us at once. We will not shout. We will handle it. That sentence may save your child.")
#caunoi("Con nói ra là đúng rồi. Từ giây này con không còn một mình nữa.", en: "You were right to tell us. From this second you are no longer alone.")
#tusoi(("Nếu con gặp chuyện xấu hổ nhất, con sẽ tới gõ cửa phòng mình, hay tự xoay xở?", "Mình đã bao giờ nói thẳng với con về chuyện gửi ảnh riêng tư và cách bọn xấu lợi dụng chưa?",), en: ("If my child faced the most shameful thing, would they knock on my door, or try to cope alone?", "Have I ever spoken plainly with my child about sending private photos and how bad people exploit them?",))

#sec("Con nói con thích một bạn cùng giới", en: "Your child tells you they like someone of the same sex")
#boicanh("Tối chủ nhật, Lam lớp 11 ngồi rất lâu ở mép giường mẹ rồi nói, mắt nhìn xuống: mẹ ơi, con thích một người. Là con gái. Mẹ đang gấp áo, tay khựng lại, quên cả gấp.", en: "On Sunday evening Lam, in grade 11, sits on the edge of her mother's bed for a long time and then says, eyes down: Mum, I like someone. A girl. Mum is folding clothes and her hands stop, the shirt forgotten.")
#phanxa("Con nói bậy gì vậy? Chắc tại con chơi với bạn nữ nhiều quá. Lớn lên rồi con sẽ khác. Đừng nói với ai hết, xấu hổ cả nhà.", "Mình bị coi là sai, là chuyện xấu hổ phải giấu. Từ giờ chuyện thật của mình, mình không kể với mẹ nữa.", en: ("What nonsense is this? You've been around girls too much. You'll change when you're older. Don't tell anyone; the whole family would be ashamed.", "I am wrong, something shameful to hide. From now on my real life I won't tell Mum."))
#scene("Tình huống 10.5 · Thử nói cách khác")[
  #me("(Đặt cái áo xuống, giữ giọng chậm.) Cảm ơn con đã nói với mẹ. Mẹ biết nói ra điều này khó lắm.", en: "(Puts the shirt down, keeps her voice slow.) Thank you for telling me. I know that was very hard to say.")
  #con("Con sợ mẹ ghét con.", en: "I was afraid you'd hate me.")
  #me("Mẹ không ghét con. Con là con của mẹ, chuyện đó không đổi. Mẹ nói thật là mẹ bất ngờ, và mẹ chưa biết nói gì cho đúng. Cho mẹ vài ngày để mẹ nghĩ, nhưng tình thương của mẹ thì không cần nghĩ.", en: "I don't hate you. You are my child and that does not change. I'll be honest: I'm surprised and I don't yet know what to say. Give me a few days to think, but my love doesn't need any thinking.")
  #con("Con cũng không chắc con là gì. Con chỉ biết con thích bạn ấy.", en: "I'm not sure what I am either. I just know I like her.")
  #me("Con không cần chắc ngay. Con cứ từ từ tìm hiểu mình, mẹ không ép con gọi tên gì hết. Bạn ấy có biết không?", en: "You don't have to be sure right away. Take your time getting to know yourself; I won't push you to put a name on anything. Does she know?")
  #con("Chưa. Con mới nói với mẹ thôi.", en: "No. I've only told you.")
  #me("Vậy chuyện này là của con, lúc nào nói với ai con tự quyết. Mẹ hứa không kể với ai khi con chưa đồng ý, kể cả ba và họ hàng. Còn ở trường, nếu có đứa nào trêu chọc con vì chuyện này, con nói mẹ ngay nha, đó là bắt nạt.", en: "Then this is yours: when and whom you tell is your decision. I promise not to tell anyone without your agreement, including Dad and relatives. And at school, if anyone teases you about this, tell me right away; that is bullying.")
  #con("Mẹ không bắt con đi khám hay gì hả?", en: "You're not going to make me see a doctor or anything?")
  #me("Thích một người không phải bệnh nên không có gì để chữa. Sau này nếu con thấy rối, buồn quá, mình tìm một cô tư vấn để con có chỗ nói, chứ không phải để sửa con.", en: "Liking someone isn't an illness, so there is nothing to cure. If you ever feel confused or very sad, we'll find a counsellor so you have someone to talk to, not to fix you.")
]
#hieusau1("Con nói ra điều này là đang trao cho ba mẹ một niềm tin rất lớn, và phản ứng trong những phút đầu quyết định con còn kể tiếp hay không. Phần lớn các em đã âm thầm mang chuyện này hàng năm. Nhiều nghiên cứu cho thấy trẻ có xu hướng tình cảm khác số đông gặp nguy cơ trầm cảm và tự hại cao hơn, và yếu tố bảo vệ mạnh nhất là sự chấp nhận của gia đình, không phải việc cố sửa con. Ba mẹ không cần đồng ý hay hiểu hết ngay. Chỉ cần giữ hai điều: tình thương không đổi, và bí mật thuộc về con.", en: "Telling you this is a great act of trust, and your reaction in the first minutes decides whether your child keeps telling you things. Most children have carried this quietly for years. Many studies find higher risks of depression and self-harm among children whose orientation differs from the majority, and the strongest protective factor is family acceptance, not attempts to change the child. You do not have to agree or understand everything at once. Hold to two things: your love is unchanged, and the secret belongs to your child.")
#cotloi("Con nói ra vì tin ba mẹ là nơi an toàn. Việc của ba mẹ là giữ cho nó đúng như vậy.", en: "Your child told you because they trust you to be a safe place. Your job is to keep it that way.")
#lamngay1("Dù chưa gặp chuyện này, hãy chuẩn bị trước: nghĩ một câu mở đầu mình sẽ nói, và hứa với bản thân ba điều không làm: không bắt con thề đổi, không kể với người khác khi chưa có phép con, không gọi đó là giai đoạn. Viết ra giấy.", en: "Even if this has not come up, prepare: think of the first sentence you would say, and promise yourself three things you will not do: not make your child swear to change, not tell others without permission, not call it a phase. Write it down.")
#caunoi("Con là con của mẹ, chuyện đó không đổi. Cảm ơn con đã tin mẹ.", en: "You are my child and that does not change. Thank you for trusting me.")
#tusoi(("Nếu hôm nay con nói điều này với mình, câu đầu tiên mình sẽ nói là gì? Mình cần bao lâu để lấy lại bình tĩnh?", "Mình có hay buông câu đùa hay lời bình phẩm về người đồng tính trước mặt con không?",), en: ("If my child told me this today, what would my first sentence be? How long would I need to steady myself?", "Do I make jokes or comments about gay people in front of my child?",))

#sec("Người yêu của con kiểm soát con", en: "Your child's partner controls them")
#boicanh("Dương lớp 11 dạo này luôn cầm điện thoại, trả lời tin nhắn trong vòng một phút, nếu không là xin lỗi rối rít. Con đã bỏ nhóm bạn thân, không đi sinh nhật ai. Mẹ nghe loáng thoáng: anh ấy nói nếu yêu thật thì con phải gửi vị trí.", en: "Duong, in grade 11, is always holding her phone lately, answering messages within a minute, or else apologising profusely. She has left her close friends and goes to nobody's birthday. Mum overhears: he says if I really love him I must share my location.")
#phanxa("Mới lớp 11 mà người yêu quản như vợ chồng! Chia tay ngay đi, không thì mẹ cấm gặp luôn!", "Mẹ lại quyết thay mình. Mình giận mẹ, mà chỗ để chạy tới chỉ còn mỗi anh ấy.", en: ("Grade 11 and a boyfriend running you like a husband! Break up right now or I'll ban you from seeing him!", "Mum decides for me again. I'm angry at her, and the only place left to run is him."))
#scene("Tình huống 10.6 · Thử nói cách khác")[
  #me("(Một buổi chiều, hai mẹ con đi chợ.) Dương, mẹ để ý dạo này con trả lời tin nhắn rất nhanh, và hay xin lỗi. Mẹ không hỏi để bắt lỗi. Mẹ thấy con căng, mẹ thương.", en: "(One afternoon, at the market together.) Duong, lately I notice you answer messages very quickly and you apologise a lot. I'm not asking to catch you out. I see you tense and I care.")
  #con("Con có sao đâu. Ảnh chỉ lo cho con thôi.", en: "I'm fine. He only worries about me.")
  #me("Mẹ tin ảnh có thương con. Mẹ hỏi thật: nếu con không trả lời trong năm phút thì chuyện gì xảy ra?", en: "I believe he cares about you. I'll ask honestly: if you don't answer within five minutes, what happens?")
  #con("...Ảnh giận. Ảnh nói con không coi ảnh ra gì. Có hôm ảnh không nói chuyện với con cả ngày.", en: "...He gets angry. He says I don't take him seriously. Some days he doesn't speak to me all day.")
  #me("Cả ngày. Rồi con làm gì?", en: "All day. And then what do you do?")
  #con("Con xin lỗi. Con ráng nhắn thật nhiều cho ảnh vui.", en: "I apologise. I try to send lots of messages to cheer him up.")
  #me("Mẹ nói con nghe điều mẹ đã đọc được, con nghĩ thử xem: người thương mình thì muốn mình vui, còn mình xin lỗi liên tục để người ta khỏi giận thì thường là sợ. Gửi vị trí, kiểm tra tin nhắn, cấm gặp bạn là những dấu hiệu của kiểm soát. Mẹ không bắt con chia tay. Con tự quyết. Nhưng mẹ muốn con nhìn rõ chuyện này.", en: "Let me tell you what I've read, and you think about it: someone who loves you wants you happy, while apologising constantly so someone won't be angry is usually fear. Sharing location, checking messages, forbidding you to see friends are signs of control. I'm not making you break up. That's your decision. But I want you to see it clearly.")
  #con("Con tưởng yêu là phải vậy.", en: "I thought love was supposed to be like that.")
  #me("Yêu thì có thể nhớ, có thể ghen một chút, nhưng người kia vẫn để con là con. Nếu có lúc nào con thấy sợ ảnh, hoặc ảnh dọa, hoặc đụng vào người con, con nói mẹ liền, bất kể giờ nào. Mẹ không la.", en: "Love can miss you and can be a little jealous, but the other person still lets you be you. If you ever feel afraid of him, or he threatens you or touches you when angry, tell me at once, any hour. I won't shout.")
]
#hieusau1("Kiểm soát trong mối quan hệ đầu đời thường được ngụy trang bằng sự quan tâm: anh ấy chỉ lo cho em thôi. Nó tăng dần: từ gửi vị trí, tới kiểm tra điện thoại, tới cô lập khỏi bạn bè, tới dọa dẫm. Một đứa trẻ chưa có hình mẫu nào khác sẽ tưởng đó là tình yêu. Cấm đoán làm con thấy ba mẹ cũng đang kiểm soát mình, và đẩy con về phía người kia. Giúp con tự nhìn ra mô hình, và để cửa nhà luôn mở, là cách giữ được con.", en: "Control in a first relationship is often disguised as care: he only worries about you. It escalates: from sharing location, to checking the phone, to cutting off friends, to threats. A child with no other model assumes that is love. Forbidding makes the child feel that parents are controlling too, and pushes her towards the partner. Helping her see the pattern for herself, and keeping the house door open, is how you keep your child.")
#cotloi("Đừng bắt con chia tay. Hãy giúp con nhìn ra dấu hiệu kiểm soát, và hứa rằng bất cứ lúc nào con sợ, cửa nhà vẫn mở và ba mẹ không la.", en: "Do not make your child break up. Help them see the signs of control, and promise that whenever they are afraid, the door is open and you will not shout.")
#lamngay1("Nói với con một lần, lúc bình thường, ba dấu hiệu của một mối quan hệ không lành mạnh: bị cô lập khỏi bạn bè, bị giám sát điện thoại và vị trí, bị dọa hoặc bị đụng chạm khi người kia giận. Rồi hỏi: con có thấy cái nào đã xảy ra với bạn mình không?", en: "Tell your child once, at an ordinary time, three signs of an unhealthy relationship: being cut off from friends, having phone and location monitored, being threatened or touched when the other is angry. Then ask: have you seen any of these with your friends?")
#caunoi("Người thương mình thì để mình được là mình. Nếu có lúc con sợ, nói mẹ liền, mẹ không la.", en: "Someone who loves you lets you be yourself. If you're ever afraid, tell me at once; I won't shout.")
#tusoi(("Mối quan hệ của chính mình có kiểu kiểm soát nào mà con đang nhìn thấy mỗi ngày không?", "Nếu con bị người yêu dọa hoặc đụng chạm, con sẽ nói với mình, hay sợ bị cấm yêu mà giấu?",), en: ("Does my own relationship contain a kind of control that my child sees every day?", "If my child were threatened or touched by a partner, would they tell me, or hide it for fear of being banned from dating?",))

#sec("Con quen một người lớn tuổi hơn nhiều", en: "Your child is seeing someone much older")
#boicanh("Hà lớp 9, mười lăm tuổi, dạo này có điện thoại mới, có túi quà, có người đón ở góc đường sau giờ học. Cô bé nói đó là anh bạn trên mạng, hai mươi ba tuổi. Anh dặn đừng nói với ba mẹ vì ba mẹ sẽ không hiểu.", en: "Ha, in grade 9 and fifteen, has a new phone lately, gift bags, and someone waiting for her at the corner after school. She says he is a friend from the internet, twenty-three. He told her not to tell her parents because they would not understand.")
#phanxa("Hai mươi ba tuổi mà dụ con nít! Con ngu quá, bị lừa mà không biết! Giao điện thoại đây, tối nay không được ra khỏi nhà!", "Mình ngu. Người dặn mình giấu ba mẹ nói đúng: ba mẹ không hiểu. Mình sẽ nghe anh ấy.", en: ("Twenty-three and preying on a child! You are so stupid, you're being fooled and don't know it! Hand over the phone, and you're not leaving the house tonight!", "I am stupid. The person who told me to hide it from my parents was right: they don't understand. I'll listen to him."))
#scene("Tình huống 10.7 · Thử nói cách khác")[
  #ba("(Gọi Hà ra, ngồi ngang tầm, giọng đều.) Hà, ba thấy chiếc điện thoại và người đón con. Ba không la. Ba nói trước một điều quan trọng nhất: ba thương con, và con không làm gì sai. Người sai là người lớn.", en: "(Calls Ha out, sits at her level, voice even.) Ha, I've seen the phone and the person who picks you up. I'm not shouting. First I'll say the most important thing: I love you, and you have done nothing wrong. The person in the wrong is the adult.")
  #con("Anh ấy tốt với con lắm. Anh nghe con nói hết. Ba mẹ thì lúc nào cũng bận.", en: "He's so good to me. He listens to everything I say. You and Mum are always busy.")
  #ba("Ba hiểu. Cảm giác có người chịu nghe mình là rất quý. Và ba nhận phần của ba: ba bận quá, ba chưa nghe con đủ. Ba sẽ sửa. Nhưng ba phải nói thẳng một điều: một người hai mươi ba tuổi mà làm bạn trai của đứa mười lăm tuổi, và dặn giấu ba mẹ, là dấu hiệu rất đáng lo.", en: "I understand. Having someone who listens is precious. And I own my part: I've been too busy, I haven't listened to you enough. I'll fix that. But I must say one thing plainly: a twenty-three-year-old being a boyfriend to a fifteen-year-old, and telling her to hide it from her parents, is a very worrying sign.")
  #con("Ảnh nói ảnh thương con thiệt.", en: "He says he really cares for me.")
  #ba("Người thương thật thì không dặn giấu cha mẹ người mình thương. Và theo pháp luật, người lớn có quan hệ tình dục với trẻ dưới mười sáu tuổi là phạm tội, dù trẻ có đồng ý. Ba không nói để dọa con. Ba nói để con biết đây là chuyện ba phải bảo vệ con.", en: "Someone who truly cares does not tell you to hide it from the parents of the person they care about. And by law, an adult having sex with a child under sixteen is committing a crime, even if the child agrees. I'm not saying this to scare you. I'm saying it so you know this is something I must protect you from.")
  #con("(Im lặng, rưng rưng.) Con chưa... tụi con chưa làm gì hết.", en: "(Silent, tearful.) We haven't... we haven't done anything.")
  #ba("Cảm ơn con nói thật. Việc ba sẽ làm, con nghe nha: ba giữ lại hết tin nhắn làm bằng chứng, con không nhắn cho anh ấy nữa, và ba sẽ gặp công an để họ xử lý. Ba không giấu con. Còn con, con không phải chịu chuyện này một mình.", en: "Thank you for telling the truth. Here is what I'll do, listen: I'll keep all the messages as evidence, you won't message him again, and I'll meet the police so they can handle it. I'm not hiding it from you. And you do not have to carry this alone.")
]
#hieusau1("Những người lớn tiếp cận trẻ vị thành niên thường dùng cùng một cách: lắng nghe điều trẻ đang thiếu, tặng quà, làm cho trẻ thấy mình đặc biệt, rồi dặn giữ bí mật với ba mẹ. Đứa trẻ bị bỏ đói sự chú ý ở nhà dễ rơi vào bẫy hơn nhiều. Đây là điểm duy nhất trong chương mà ranh giới không thương lượng: ba mẹ phải bảo vệ con, kể cả khi con giận. Nhưng cách nói quyết định kết quả: nếu con thấy mình bị mắng, con sẽ che chắn cho người kia. Nếu con thấy ba mẹ đứng cùng phe, con sẽ cho ba mẹ biết hết.", en: "Adults who approach teenagers usually use the same method: listen to what the child lacks, give gifts, make the child feel special, then ask them to keep it secret from parents. A child starved of attention at home is much more likely to fall for it. This is the one point in this chapter where the boundary is not negotiable: parents must protect their child, even if the child is angry. But how you say it decides the outcome: if she feels scolded, she will shield the other person. If she sees you on her side, she will tell you everything.")
#cotloi("Với người lớn tiếp cận con, không có thương lượng. Nhưng với con, câu đầu tiên luôn là: con không làm gì sai. Người sai là người lớn.", en: "With an adult who approaches your child, there is no negotiation. But to your child, the first sentence is always: you did nothing wrong. The person in the wrong is the adult.")
#lamngay1("Nói với con ngay tuần này, khi chưa có chuyện: Người lớn nào dặn con giữ bí mật với ba mẹ, tặng quà đắt tiền, hay nói con đặc biệt hơn bạn bè, là người con phải kể cho ba mẹ. Kể ngay, dù họ nói gì.", en: "Tell your child this week, before anything happens: Any adult who tells you to keep a secret from us, gives you expensive gifts, or says you are more special than your friends is someone you must tell us about. Tell us at once, whatever they say.")
#caunoi("Con không làm gì sai. Người sai là người lớn. Ba ở đây, con không phải chịu một mình.", en: "You did nothing wrong. The person in the wrong is the adult. I'm here; you don't have to carry this alone.")
#tusoi(("Con mình có đang thiếu một người chịu nghe mà người đó đáng lẽ là mình?", "Mình có biết con nói chuyện với ai trên mạng, và có ai trong đó là người lớn không?",), en: ("Is my child missing someone who listens, when that someone should have been me?", "Do I know who my child talks to online, and whether any of them are adults?",))

#sec("Con nói con chậm kinh, sợ có thai", en: "Your child says their period is late and they fear pregnancy")
#boicanh("Mười một giờ đêm, Chi mười sáu tuổi gõ cửa phòng mẹ, giọng run: mẹ ơi, con trễ kinh hai tuần rồi. Con có quan hệ với bạn trai. Con sợ lắm. Mẹ ngồi bật dậy, tim đập như muốn rớt ra ngoài.", en: "Eleven at night. Chi, sixteen, knocks at her mother's door, voice shaking: Mum, my period is two weeks late. I've had sex with my boyfriend. I'm so scared. Mum sits bolt upright, her heart pounding as if it would fall out.")
#phanxa("Trời ơi, mười sáu tuổi mà làm chuyện đó! Mày làm nhục cả nhà! Giờ tính sao với cái bụng?", "Mình hủy hoại cuộc đời cả nhà. Lần sau có chuyện thì tự xử lý, tự đi tìm thuốc trên mạng, đừng để mẹ biết.", en: ("Oh my God, sixteen and doing that! You've disgraced the whole family! Now what do we do about this belly?", "I have ruined everyone's life. Next time something happens I'll sort it out alone, look for pills online, and not let Mum know."))
#scene("Tình huống 10.8 · Thử nói cách khác")[
  #me("(Hít một hơi sâu, bật đèn, ngồi xuống cạnh con, nắm tay con.) Chi, mẹ nghe rồi. Mẹ đang rất sốc, mẹ không giấu. Nhưng điều đầu tiên mẹ muốn nói: cảm ơn con đã tới nói với mẹ. Con làm đúng.", en: "(Takes a deep breath, switches on the light, sits beside her, takes her hand.) Chi, I heard. I'm very shocked; I won't hide that. But the first thing I want to say: thank you for coming to tell me. You did the right thing.")
  #con("Mẹ có ghét con không?", en: "Do you hate me?")
  #me("Mẹ không ghét con. Mẹ lo cho con. Trễ kinh không có nghĩa chắc chắn là có thai, nhiều lý do khác cũng làm trễ. Mình cần biết chính xác. Sáng mai mẹ đưa con đi khám, hoặc mua que thử, rồi đi gặp bác sĩ phụ khoa.", en: "I don't hate you. I'm worried for you. A late period doesn't mean you are certainly pregnant; many things can delay it. We need to know exactly. Tomorrow I'll take you to be examined, or buy a test, and then see a gynaecologist.")
  #con("Con sợ lỡ có thì sao.", en: "I'm scared of what if it's true.")
  #me("Thì mẹ với con cùng tính. Có nhiều đường, và bác sĩ sẽ giúp mình hiểu từng đường. Con không phải quyết định gì trong đêm nay. Mẹ hỏi một câu quan trọng, không phải để la: lần quan hệ đó, con có muốn không? Có ai ép con không?", en: "Then we work it out together. There are several paths, and the doctor will help us understand each. You don't have to decide anything tonight. I'll ask one important question, not to scold: that time, did you want to? Did anyone pressure you?")
  #con("Con muốn. Tụi con thương nhau. Bạn ấy cũng mười bảy.", en: "I wanted to. We love each other. He's seventeen too.")
  #me("Mẹ hiểu. Cảm ơn con nói thật. Một chuyện nữa, mẹ cần biết cho an toàn: lần đó có dùng biện pháp gì không?", en: "I understand. Thank you for being honest. One more thing I need to know for your safety: did you use any protection?")
  #con("Không... Con không biết gì hết.", en: "No... I didn't know anything.")
  #me("Vậy ngoài chuyện này, mẹ sẽ đưa con đi gặp bác sĩ để con được biết đầy đủ cách bảo vệ mình, kể cả các bệnh lây qua đường tình dục. Con nói thật với mẹ thì mẹ mới giúp được.", en: "Then beyond this, I'll take you to a doctor so you get the full picture of how to protect yourself, including infections passed on through sex. You tell me the truth and I can help.")
]
#hieusau1("Một đứa trẻ tới nói điều này đã vượt qua nỗi sợ rất lớn. Phản ứng trong năm phút đầu quyết định lần sau con có tìm tới ba mẹ hay tìm thuốc trên mạng, hoặc giấu cho tới khi quá muộn. Mọi lời trách để sau. Việc cần làm theo thứ tự: bình tĩnh, cảm ơn con, xác nhận có thai hay không bằng que thử hoặc khám, hỏi xem con có bị ép không, và đưa con tới bác sĩ. Nếu mới xảy ra trong vài ngày, có loại thuốc tránh thai khẩn cấp cần dùng sớm, nên hỏi bác sĩ hoặc dược sĩ ngay. Nếu người kia lớn hơn nhiều tuổi hoặc con bị ép buộc, đây là chuyện phải báo cơ quan chức năng.", en: "A child who comes to say this has crossed a huge fear. Your reaction in the first five minutes decides whether next time she comes to you, or looks for pills online, or hides it until too late. Every reproach waits. The sequence: stay calm, thank your child, confirm pregnancy or not with a test or exam, ask whether she was pressured, and take her to a doctor. If it happened within the last few days, emergency contraception exists and must be taken early; ask a doctor or pharmacist at once. If the other person is much older or your child was forced, this must be reported to the authorities.")
#cotloi("Lúc con nói con sợ có thai, câu đầu tiên là: cảm ơn con đã nói với mẹ. Thứ tự: bình tĩnh, giúp con, rồi mới bàn chuyện dạy.", en: "When your child says they fear pregnancy, the first sentence is: thank you for telling me. The order: stay calm, help your child, and only later the teaching.")
#lamngay1("Nếu con tuổi dậy thì, ba mẹ nên nói trước với con một lần, kể cả khi con chưa có người yêu: Nếu có chuyện, con tới nói với ba mẹ, ba mẹ sẽ không la. Rồi tìm hiểu trước địa chỉ một phòng khám hoặc bác sĩ phụ khoa tin cậy gần nhà.", en: "With a child in puberty, say once, even before they have a partner: If something happens, come to us; we will not shout. Then find out in advance the address of a trustworthy gynaecology clinic or doctor near home.")
#caunoi("Cảm ơn con đã nói với mẹ. Con làm đúng. Mình cùng lo, con không phải một mình.", en: "Thank you for telling me. You did the right thing. We'll worry together; you are not alone.")
#tusoi(("Nếu con gái hoặc con trai mình gặp chuyện này đêm nay, con có dám gõ cửa phòng mình không?", "Mình đã bao giờ nói với con về biện pháp an toàn, về sự đồng ý, về chuyện đúng thời điểm chưa?",), en: ("If my daughter or son faced this tonight, would they dare to knock on my door?", "Have I ever spoken with my child about protection, about consent, about timing?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 10: mang theo bên mình]
#doicau1((("Lo học đi, yêu đương gì tuổi này.", "Con đang quý một bạn hả? Kể mẹ nghe về bạn đó đi.", "Focus on studying; what is all this romance at your age.", "Is there someone you like? Tell me about them."), ("Con nít hỏi bậy.", "Câu hỏi hay đó. Để mẹ nói cho con nghe.", "Children shouldn't ask such things.", "Good question. Let me explain."), ("Con gái mà không biết giữ mình.", "Cơ thể con là của con. Ai làm con không thoải mái, con có quyền nói không và nói với ba mẹ.", "A girl ought to know how to guard herself.", "Your body is yours. If anyone makes you uncomfortable, you have the right to say no and to tell us."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Giáo dục giới tính không phải một buổi nói chuyện lớn. Nó là rất nhiều câu trả lời ngắn, thật, rải suốt từ lúc con ba tuổi tới mười tám tuổi.", "Dạy con, cả trai lẫn gái, hai chiều của sự đồng ý: con có quyền nói không, và khi người kia nói không thì con phải dừng.", "Nếu con nói ra xu hướng tình cảm hay cảm nhận về giới của mình khác với điều ba mẹ nghĩ, câu đầu tiên nên là: Cảm ơn con đã tin ba mẹ. Con vẫn là con của ba mẹ. Mọi thứ khác có thể từ từ tìm hiểu.",), en: ("Sex education is not one big talk. It is many short, honest answers spread from age three to eighteen.", "Teach every child, boys and girls, both directions of consent: you have the right to say no, and when the other person says no, you must stop.", "If your child tells you their feelings or sense of gender differ from what you assumed, the first sentence should be: Thank you for trusting us. You are still our child. Everything else can be worked out slowly.",))
#listbox1("KHI NÀO CẦN TÌM NGƯỜI GIÚP  ·  WHEN TO SEEK HELP", crimson, rgb("FFF5F5"), ("Con bị đe dọa, tống tiền bằng hình ảnh; có người lớn làm quen, tặng quà, đòi giữ bí mật với con; con có dấu hiệu bị đụng chạm, xâm hại. Tin con, không tra hỏi dồn dập, lưu bằng chứng, gọi 111 hoặc báo công an ngay.",), mark: sym.triangle.filled.small.r, en: ("Your child is threatened or blackmailed with images; an adult befriends them, gives gifts and asks for secrecy; there are signs of unwanted touching or abuse. Believe your child, do not fire questions, keep the evidence, and call 111 or the police at once.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày, mỗi ngày ba mẹ tự trả lời thầm một câu con có thể hỏi về cơ thể, tình cảm, giới tính, để tới lúc con hỏi thật thì mình không đứng hình. Cuối tuần, đặt cuốn sách vào phòng con.",), mark: sym.star.filled, en: ("For seven days, silently prepare your answer to one question your child might ask about bodies, feelings or sex, so that when the real question comes you do not freeze. At the end of the week, put the book in their room.",))
