#import "../template.typ": *

#chapter-open(6, "Mùa thi và chuyện chọn đường", 6, "Con cần một người đứng cạnh đường đua đưa nước, không cần thêm một người cầm đồng hồ bấm giờ.", "Mùa thi, cả nhà như cùng nín thở. Ba mẹ đi nhẹ nói khẽ, nấu món bổ, và lo. Nỗi lo đó là tình thương, nhưng con nhận về lại là sức nặng. Rồi tới chuyện chọn trường, chọn ngành, nơi ước mơ của con và kinh nghiệm của ba mẹ dễ đụng nhau chan chát. Chương này bàn cách đồng hành với con qua những khúc cua đó mà không cầm lái thay con.", ("Đêm trước ngày thi con không ngủ được", "Con muốn học ngành ba mẹ không ưng", "Con học ngày học đêm, không dám nghỉ", "Con không biết mình thích gì",), en: ("Exam season and choosing a path", "Your child needs someone beside the track handing out water, not one more person holding a stopwatch.", "In exam season the whole household seems to hold its breath. Parents tiptoe, cook nourishing food, and worry. That worry is love, but what the child receives is weight. Then come the choices of school and career, where a child's dream and a parent's experience can collide head-on. This chapter is about walking with your child through those bends without taking the wheel.", ("The night before the exam your child cannot sleep", "Your child wants a field you do not approve of", "Your child studies day and night and dares not rest", "Your child does not know what they like",)))

#sec("Đêm trước ngày thi con không ngủ được", en: "The night before the exam your child cannot sleep")
#boicanh("Mười một giờ đêm trước ngày thi tốt nghiệp. Con bé Mai vẫn ngồi lật đề cương, tay lạnh ngắt. Nó nói với ba: con quên hết rồi, con không nhớ gì hết.", en: "Eleven at night before the graduation exam. Mai is still flipping through her notes, hands ice cold. She tells Dad: I've forgotten everything, I can't remember a thing.")
#phanxa("Có gì đâu mà lo. Con học giỏi mà, thế nào cũng đậu. Ba tin con đạt điểm cao.", "Ba kỳ vọng mình điểm cao. Lỡ mình làm không được thì ba sụp. Thêm một thứ để sợ.", en: ("Nothing to worry about. You're a good student, you'll pass for sure. I believe you'll get a high score.", "Dad expects a high score. If I can't do it, he will collapse. One more thing to fear."))
#scene("Tình huống 6.1 · Thử nói cách khác")[
  #ba("(Ngồi xuống cạnh, nắm tay con.) Tay lạnh quá. Con đang run hả?", en: "(Sits down beside her, takes her hand.) So cold. Are you shaking?")
  #con("Con sợ lắm ba. Con mở trang nào ra cũng thấy như chưa học.", en: "I'm so scared, Dad. Whatever page I open, it feels like I never studied it.")
  #ba("Ba biết cảm giác đó. Hồi ba thi cũng vậy, đêm trước ba nhìn chữ mà nó như nhảy múa. Không phải con quên đâu. Là con đang sợ, mà lúc sợ thì đầu nó khóa lại.", en: "I know that feeling. It was the same for me; the night before, the words seemed to dance on the page. You haven't forgotten. You're frightened, and when we're frightened the mind locks.")
  #con("Lỡ mai vô phòng thi con cũng vậy thì sao?", en: "What if it's the same in the exam room tomorrow?")
  #ba("Thì con làm y như bây giờ ba chỉ: để bút xuống, thở chậm bốn hơi, đọc câu dễ nhất trước. Làm được một câu là nó mở khóa. Giờ gấp đề cương lại đi con, học thêm cũng không vô nữa đâu.", en: "Then do exactly what I'm showing you now: put down the pen, take four slow breaths, read the easiest question first. Do one question and it unlocks. Now close the notes; nothing more will go in tonight.")
  #con("Ba không sợ con rớt hả?", en: "Aren't you afraid I'll fail?")
  #ba("Ba chỉ sợ con mệt. Còn mai con làm được bao nhiêu thì bấy nhiêu là của con. Kết quả ra sao, chiều mai ba vẫn chở con đi ăn bún bò như đã hứa.", en: "I am only afraid you'll be worn out. Tomorrow, whatever you manage is yours. Whatever the result, tomorrow afternoon I'm still taking you for beef noodle soup as promised.")
  #con("...Ba ngồi đây với con chút nữa nha.", en: "...Sit with me a little longer.")
  #ba("Ừ. Ba ngồi tới khi con buồn ngủ.", en: "Yes. I'll sit until you're sleepy.")
]
#hieusau1("Một chút hồi hộp giúp người ta tỉnh táo, nhưng lo quá mức thì làm trí nhớ tạm đóng băng: kiến thức vẫn còn đó nhưng không lấy ra được. Câu con giỏi mà, thế nào cũng đậu không làm con bớt lo, vì nó phủ nhận nỗi sợ và còn chất thêm kỳ vọng. Điều hạ được cơn lo là có người công nhận nó là bình thường, hơi thở chậm lại, và một lời bảo đảm rằng tình thương không phụ thuộc vào kết quả.", en: "A little nervousness keeps us alert, but too much temporarily freezes memory: the knowledge is still there but cannot be retrieved. You're good, you'll pass does not reduce the worry, because it denies the fear and piles on expectation. What lowers anxiety is having someone accept it as normal, slower breathing, and an assurance that love does not depend on the result.")
#cotloi("Đêm trước ngày thi, con không cần thêm kiến thức hay kỳ vọng. Con cần ngủ, và cần biết kết quả nào ba mẹ cũng đón được.", en: "The night before an exam, your child needs no more knowledge and no more expectations. They need sleep, and to know you can welcome any result.")
#lamngay1("Nếu nhà có con sắp thi, tối nay hứa một việc cụ thể sẽ làm sau buổi thi dù kết quả ra sao: một bữa ăn, một chuyến đi gần. Và tập cùng con cách thở chậm bốn hơi khi đầu bị khóa.", en: "If you have a child facing exams, promise tonight one specific thing you will do afterwards whatever the result: a meal, a short outing. And practise together the four slow breaths for when the mind locks.")
#caunoi("Mai con làm được bao nhiêu thì bấy nhiêu là của con. Chiều ba vẫn chở đi ăn bún bò.", en: "Whatever you manage tomorrow is yours. In the afternoon I'm still taking you for noodles.")
#tusoi(("Những câu động viên của mình có đang lén mang theo kỳ vọng không?", "Trong mùa thi của con, ai trong nhà đang lo nhiều nhất, và nỗi lo đó hiện ra với con dưới dạng gì?",), en: ("Are my encouraging words secretly carrying expectations?", "During my child's exam season, who at home is the most anxious, and in what form does that anxiety reach my child?",))

#sec("Con muốn học ngành ba mẹ không ưng", en: "Your child wants a field you do not approve of")
#boicanh("Thằng Đăng lớp 12 học đều các môn, ba mẹ đã nhắm sẵn ngành Kinh tế. Bữa cơm, nó nói: con muốn thi Thiết kế đồ họa. Ba đặt đũa xuống.", en: "Dang, in grade 12, is solid in every subject and his parents have Economics in mind. At dinner he says: I want to apply for Graphic Design. Dad puts down his chopsticks.")
#phanxa("Vẽ vời thì làm gì ra tiền. Ba mẹ nuôi con ăn học không phải để con đi vẽ quảng cáo. Học Kinh tế, ra trường ba xin việc cho.", "Ba không coi cái mình thích là thứ nghiêm túc. Đời mình mà ba quyết. Sau này có gì thì là tại ba.", en: ("Drawing doesn't pay. We didn't raise you to draw adverts. Study Economics; when you graduate I'll get you a job.", "Dad doesn't take what I love seriously. It's my life and he decides. If anything goes wrong later, it's on him."))
#scene("Tình huống 6.2 · Thử nói cách khác")[
  #ba("(Im một lúc.) Ba nói thật là ba bất ngờ, và ba có lo. Nhưng ba muốn nghe trước đã. Con thích ngành đó từ khi nào?", en: "(Quiet for a moment.) Honestly, I'm surprised, and I'm worried. But I want to hear first. When did you start liking that field?")
  #con("Từ lớp 10. Con tự học trên mạng, con làm poster cho câu lạc bộ, làm logo cho quán của chị bạn. Người ta trả con tiền rồi đó ba.", en: "Since grade 10. I taught myself online, I made posters for the club, a logo for a friend's sister's shop. People have already paid me, Dad.")
  #ba("Con có khách trả tiền rồi mà ba không biết. Cho ba coi mấy cái con làm được không?", en: "You have paying clients and I didn't know. May I see some of what you've made?")
  #con("(Mở máy.) Đây. Cái này con làm ba tuần.", en: "(Opens the laptop.) Here. This one took three weeks.")
  #ba("...Ba không rành, nhưng ba thấy nó ra hồn. Giờ ba nói cái lo của ba, con nghe thử: ba sợ ngành này cạnh tranh dữ, thu nhập bấp bênh, rồi máy móc làm thay. Con nghĩ sao về mấy chuyện đó?", en: "...I'm no expert, but it looks like real work. Now let me tell you my worries and you tell me what you think: I'm afraid this field is very competitive, the income unstable, and machines will take it over. What do you make of that?")
  #con("Con có tìm hiểu. Bấp bênh thiệt nếu chỉ biết vẽ. Nên con tính học thêm mảng giao diện ứng dụng, mảng đó cần người.", en: "I've looked into it. It is unstable if you can only draw. So I plan to learn app interface design as well; that area needs people.")
  #ba("Con tìm hiểu kỹ hơn ba tưởng. Vậy ba đề nghị vầy: hè này con đi thực tập thử ở một công ty thiết kế một tháng, ba kiếm chỗ. Coi nghề thật nó ra sao. Xong mà con vẫn muốn thì ba ủng hộ, con chịu không?", en: "You've researched more than I expected. Then here is my suggestion: this summer you intern for a month at a design company; I'll find a place. See what the real job is like. If you still want it afterwards, I'll back you. Deal?")
  #con("Chịu! Mà ba nói thiệt nha.", en: "Deal! But you mean it, right?")
  #ba("Ba nói thiệt. Đời con thì con cầm lái. Ba ngồi kế bên coi bản đồ phụ.", en: "I mean it. It's your life and you hold the wheel. I'll sit beside you and help read the map.")
]
#hieusau1("Ba mẹ phản đối thường vì thương: muốn con tránh con đường mình thấy rủi ro. Nhưng đứa trẻ bị ép ngành mang theo hai gánh, học thứ mình không muốn và mất cảm giác đời là của mình. Khi khó khăn tới, các em dễ buông vì đó đâu phải lựa chọn của tôi. Ngược lại, đứa trẻ được nghe, được chất vấn nghiêm túc và được thử nghề thật thường chọn chín chắn hơn, kể cả khi cuối cùng nó tự đổi ý.", en: "Parents usually object out of love: they want to steer the child away from a road that looks risky. But a child forced into a field carries two burdens, studying something unwanted and losing the sense that life is their own. When difficulty comes they let go easily, because it was never my choice. A child who is heard, seriously questioned and allowed to try the real job usually chooses more maturely, even if in the end they change their own mind.")
#cotloi("Ba mẹ có quyền nói ra nỗi lo, có quyền đặt câu hỏi khó. Nhưng tay lái cuộc đời con phải nằm trong tay con, vì chính con sẽ đi hết đoạn đường đó.", en: "You may voice your worries and ask hard questions. But the wheel of your child's life must be in their hands, because they are the one who will travel that whole road.")
#lamngay1("Hỏi con ba câu, chỉ nghe không phản biện: Con thích làm việc gì tới mức quên giờ? Con hình dung một ngày đi làm của mình ra sao? Con muốn thử nghề nào nhất nếu được đi coi một tuần?", en: "Ask three questions and only listen, no rebuttal: What do you do that makes you lose track of time? How do you picture a working day? Which job would you most like to try if you could watch it for a week?")
#caunoi("Ba có lo, ba nói ra để con biết. Nhưng đời con thì con cầm lái.", en: "I am worried, and I'm telling you so you know. But it's your life and you hold the wheel.")
#tusoi(("Mình muốn con học ngành đó vì con hợp, hay vì mình yên tâm?", "Có ước mơ nào ngày xưa mình bị cản không? Giờ mình nghĩ sao về chuyện đó?",), en: ("Do I want that field because my child suits it, or because it calms me?", "Was there a dream of mine that was blocked? How do I feel about that now?",))

#sec("Con học ngày học đêm, không dám nghỉ", en: "Your child studies day and night and dares not rest")
#boicanh("Con bé Linh lớp 12 đứng đầu lớp. Dạo này nó ăn cơm cũng cầm sách, hai giờ sáng còn sáng đèn, sụt bốn ký, rụng tóc. Được chín rưỡi thì khóc vì mất nửa điểm. Mẹ khuyên nghỉ thì nó gắt: mẹ không hiểu đâu.", en: "Linh, in grade 12, is top of her class. Lately she eats with a book in hand, the light is on at two in the morning, she has lost four kilos and her hair is falling out. She cries over a 9.5 because of the missing half mark. When Mum suggests a rest she snaps: you don't understand.")
#phanxa("Con học vậy là mẹ mừng. Ráng thêm vài tháng nữa thôi con, đậu rồi tha hồ nghỉ.", "Giá trị của mình là thành tích. Sức khỏe của mình xếp sau điểm số, mẹ cũng nghĩ vậy.", en: ("I'm glad to see you studying like this. Just a few more months, darling; once you're in you can rest all you like.", "My worth is my results. My health ranks below my marks, and Mum thinks so too."))
#scene("Tình huống 6.3 · Thử nói cách khác")[
  #me("(Gõ cửa lúc mười một giờ, mang theo trái cây.) Mẹ ngồi đây năm phút được không? Mẹ không cản con học đâu.", en: "(Knocks at eleven with some fruit.) May I sit for five minutes? I won't stop you studying.")
  #con("Con còn ba đề nữa mẹ.", en: "I still have three papers to do, Mum.")
  #me("Mẹ biết. Mẹ chỉ nói một chuyện rồi mẹ đi. Hôm qua mẹ thấy con khóc vì chín điểm rưỡi. Mẹ nằm nghĩ hoài: nhà mình có ai từng nói với con là phải mười điểm mới được thương không?", en: "I know. I'll say one thing and go. Yesterday I saw you cry over a 9.5. I lay awake wondering: has anyone in this house ever told you that you need a ten to be loved?")
  #con("Không ai nói... Nhưng con mà tụt thì mọi người sẽ thất vọng. Cô, ba mẹ, ai cũng nghĩ con phải đậu trường top.", en: "Nobody said it... But if I slip, everyone will be disappointed. My teacher, you and Dad, everyone thinks I must get into a top university.")
  #me("Vậy là con đang vác kỳ vọng của một đống người. Nặng quá con. Mẹ lấy lại phần của mẹ nha: mẹ không cần con đậu trường top. Mẹ cần con còn ăn được, ngủ được, còn cười.", en: "So you are carrying a whole crowd's expectations. That is too heavy. Let me take mine back: I do not need you to get into a top university. I need you to be able to eat, sleep, and still laugh.")
  #con("(Rưng rưng.) Con sợ lắm mẹ. Con dừng lại là con thấy mình đang thua.", en: "(Tearing up.) I'm so scared, Mum. When I stop, I feel like I'm losing.")
  #me("Mẹ hiểu. Sợ vậy mà chạy hoài không nghỉ thì tới ngày thi con hết xăng. Mình thử một tuần: mười hai giờ tắt đèn, chủ nhật nghỉ buổi chiều. Nếu điểm con tụt, mẹ chịu trách nhiệm. Thử với mẹ một tuần thôi.", en: "I understand. But running scared without resting, you'll have no fuel left on exam day. Let's try one week: lights out at midnight, Sunday afternoons off. If your marks drop, I take responsibility. Just one week, with me.")
]
#hieusau1("Trẻ cầu toàn nhìn bên ngoài là niềm mơ ước của mọi phụ huynh, nhưng bên trong thường là nỗi sợ: sợ rằng mình chỉ có giá trị khi đứng đầu. Các em không tận hưởng điểm cao, chỉ tạm thoát khỏi nỗi sợ điểm thấp. Thiếu ngủ và kiệt sức kéo dài làm hiệu quả học giảm, dẫn tới học nhiều hơn nữa, thành một vòng xoáy. Sụt cân, rụng tóc, khóc vì mất nửa điểm là dấu hiệu cơ thể đã lên tiếng thay con.", en: "A perfectionist child looks like every parent's dream, but inside there is often fear: the fear of having worth only when on top. These children do not enjoy high marks; they only escape, briefly, the fear of low ones. Long-term sleep loss and exhaustion reduce learning efficiency, which leads to still more study, a spiral. Weight loss, hair loss and tears over half a mark are the body speaking up on the child's behalf.")
#cotloi("Đứa trẻ học quá sức không cần được khen chăm. Nó cần được ba mẹ cho phép nghỉ, và được bảo đảm rằng mình có giá trị ngay cả khi không đứng nhất.", en: "A child who overworks does not need to be praised for diligence. They need permission to rest, and assurance that they have worth even when they are not first.")
#lamngay1("Nói với con một câu tách bạch: Ba mẹ thương con không phải vì điểm. Rồi đặt cùng con một giờ tắt đèn cố định và một buổi nghỉ trọn vẹn mỗi tuần. Ba mẹ cũng giữ giờ đó để con không thấy mình nghỉ một mình.", en: "Tell your child one clear sentence: We do not love you for your marks. Then set together a fixed lights-out time and one full rest period each week. Keep those hours yourself so your child does not feel they are resting alone.")
#caunoi("Mẹ không cần con đứng nhất. Mẹ cần con còn ăn được, ngủ được và còn cười.", en: "I don't need you to come first. I need you to eat, to sleep, and still to laugh.")
#tusoi(("Khi con đạt điểm cao, mình vui ra mặt. Khi con điểm thường, nét mặt mình thế nào? Con đọc được gì từ đó?", "Con mình có biết nghỉ ngơi mà không thấy có lỗi không?",), en: ("When my child gets a high mark my joy shows. When the mark is ordinary, what does my face do? What does my child read there?", "Can my child rest without feeling guilty?",))

#sec("Con không biết mình thích gì", en: "Your child does not know what they like")
#boicanh("Còn ba tháng nữa đăng ký nguyện vọng. Thằng Tâm lớp 12 học lực trung bình khá, không ghét môn nào, không mê môn nào. Mẹ hỏi con thích ngành gì, nó nhún vai: con không biết. Mẹ chọn đi.", en: "Three months until applications. Tam, in grade 12, is an average-to-good student who neither hates nor loves any subject. When Mum asks what field he wants, he shrugs: I don't know. You pick.")
#phanxa("Mười tám tuổi đầu rồi mà không biết mình thích gì. Bạn bè người ta có định hướng hết rồi. Con sống không có mục tiêu gì hết!", "Không biết mình thích gì là có lỗi. Mình thua kém bạn bè từ trong ruột.", en: ("Eighteen years old and you don't know what you like. Your friends all have a direction. You have no goals at all!", "Not knowing what I like is a fault. I am behind my friends at the very core."))
#scene("Tình huống 6.4 · Thử nói cách khác")[
  #me("Con nói không biết, mẹ tin là con không biết thiệt. Mười tám tuổi mà chưa biết mình thích gì là chuyện rất thường, hồi đó mẹ cũng vậy.", en: "You say you don't know, and I believe you really don't. Not knowing at eighteen is very common; I was the same.")
  #con("Mẹ cũng vậy hả? Mẹ làm kế toán mà.", en: "You were? But you're an accountant.")
  #me("Mẹ chọn đại vì bạn mẹ thi ngành đó. May là mẹ làm rồi thấy hợp. Nhưng mẹ không muốn con chọn đại như mẹ. Mình thử đi đường khác: con không cần biết con thích gì, con chỉ cần biết con không chịu nổi cái gì.", en: "I picked it at random because my friend applied for it. Luckily it turned out to suit me. But I don't want you to pick at random as I did. Let's try another route: you don't need to know what you like, only what you can't stand.")
  #con("Con không chịu nổi ngồi một chỗ tám tiếng. Với con ghét phải nói chuyện với người lạ suốt ngày.", en: "I can't stand sitting in one place for eight hours. And I hate having to talk to strangers all day.")
  #me("Rồi, loại được hai kiểu việc. Còn lúc nào con thấy thời gian trôi nhanh nhất?", en: "Good, two kinds of work ruled out. And when does time pass fastest for you?")
  #con("Lúc con sửa xe với cậu Út. Với lúc con ráp máy tính cho mấy đứa bạn.", en: "When I fix motorbikes with Uncle Ut. And when I build computers for my friends.")
  #me("Vậy là tay con thích làm việc, thích thứ gì hư thì sửa cho nó chạy. Có mấy ngành đi theo hướng đó, cả đại học lẫn nghề. Chủ nhật này mình rủ cậu Út cà phê, con hỏi cậu về nghề của cậu coi.", en: "So your hands like to work; you like making broken things run. Several paths go that way, university and vocational. This Sunday let's invite Uncle Ut for coffee and you ask him about his trade.")
  #con("Học nghề thì mẹ có thấy kỳ không?", en: "Would you find it strange if I went to vocational school?")
  #me("Mẹ thấy người làm nghề mình hợp thì sống vui. Kỳ là học bốn năm thứ mình không ưa.", en: "I find that people doing work that suits them live happily. Strange would be four years studying something you don't care for.")
]
#hieusau1("Xã hội đòi tuổi mười tám phải có đam mê rõ ràng, trong khi đa số người trưởng thành tìm ra hướng đi qua việc thử, không phải qua việc ngồi nghĩ. Đứa trẻ nói con không biết không trống rỗng, nó chỉ chưa có đủ trải nghiệm để so. Loại trừ thứ không chịu nổi và lần theo những lúc quên thời gian là cách thực tế hơn nhiều so với hỏi đam mê của con là gì. Và một con đường nghề nghiệp ít hào nhoáng nhưng hợp tay thường bền hơn một tấm bằng không dùng tới.", en: "Society demands that eighteen-year-olds have a clear passion, while most adults find their direction by trying things, not by sitting and thinking. A child who says I don't know is not empty; they simply have too few experiences to compare. Ruling out what they cannot stand and following the moments when time disappears is far more practical than asking what is your passion. And a less glamorous path that fits the hands often lasts longer than a degree left unused.")
#cotloi("Chưa biết mình thích gì ở tuổi mười tám không phải là lỗi. Đam mê hiếm khi tự tới, nó lớn lên từ những lần được thử.", en: "Not knowing what you like at eighteen is no fault. Passion seldom arrives by itself; it grows out of chances to try.")
#lamngay1("Cùng con liệt kê hai cột: việc con làm mà quên giờ, và việc con không chịu nổi. Sau đó tìm một người thật đang làm nghề gần với cột thứ nhất để con được hỏi chuyện ba mươi phút.", en: "With your child, list two columns: things I do and lose track of time, and things I cannot stand. Then find a real person working in something close to the first column for your child to talk to for thirty minutes.")
#caunoi("Chưa biết mình thích gì là chuyện thường. Mình cùng đi thử cho biết.", en: "Not knowing yet what you like is normal. Let's go and try things together.")
#tusoi(("Mình biết con mình quên thời gian khi làm việc gì không?", "Trong đầu mình có đang xếp hạng nghề nào sang, nghề nào hèn không? Con có nghe thấy điều đó không?",), en: ("Do I know what my child is doing when they lose track of time?", "Am I ranking jobs as respectable and lowly in my head? Can my child hear it?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 6: mang theo bên mình]
#doicau1((("Ráng lên, cả nhà trông vào con đó.", "Con cứ làm hết sức của con. Kết quả sao nhà mình cũng lo được.", "Keep going, the whole family is counting on you.", "Just do your best. Whatever the result, we can handle it."), ("Ngành đó ra trường thất nghiệp.", "Ba có mấy cái lo về ngành đó, ba nói con nghe rồi con nói lại ý con nha.", "Graduates in that field end up jobless.", "I have some worries about that field. I'll tell you them and then you tell me your view."), ("Thi xong rồi tha hồ chơi.", "Tối nay nghỉ sớm đi con. Ngủ đủ cũng là ôn bài.", "After the exam you can play all you like.", "Finish early tonight. Enough sleep is revision too."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Trước kỳ thi một tháng, việc của ba mẹ là hậu cần: giấc ngủ, bữa ăn, không khí trong nhà. Kiến thức là việc của con và thầy cô.", "Đừng hỏi làm bài được không ngay khi con bước ra khỏi phòng thi. Hỏi con đói chưa. Môn đã thi xong thì đóng lại, không dò đáp án khi còn môn sau.", "Luôn có phương án hai và ba, bàn với con trước khi thi, để con biết không có cửa nào là cửa duy nhất.",), en: ("In the month before an exam, the parents' job is logistics: sleep, meals, the atmosphere at home. Knowledge is the job of the child and the teachers.", "Do not ask how did it go the moment your child leaves the exam room. Ask if they are hungry. A paper that is done is closed; no checking answers while another paper remains.", "Always have a second and third option, discussed with your child before the exam, so they know no door is the only door.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày trong mùa thi, cả nhà giữ một bữa cơm tối không nhắc tới chữ thi, điểm, trường. Nói chuyện gì cũng được trừ chuyện đó. Để con nhớ mình còn là một đứa con, không chỉ là một thí sinh.",), mark: sym.star.filled, en: ("For seven days during exam season, keep one family dinner free of the words exam, marks and school. Talk about anything else. So your child remembers they are still a son or daughter, not only a candidate.",))
