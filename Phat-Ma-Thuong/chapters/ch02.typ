#import "../template.typ": *

#chapter-open(2, "Cả lớp ồn: khi lỗi là của tập thể", 2, "Lớp ồn không phải kẻ thù. Lớp ồn là một nguồn năng lượng chưa có chỗ đi.", "Phạt một em thì dễ. Phạt cả lớp mới khó, vì phạt tập thể rất dễ thành bất công với những em ngoan. Chương này gom những chiêu để thầy cô đưa cả lớp về nhịp học mà không phải la, không phải đập bàn, và không bắt em nào gánh lỗi thay người khác. Điểm chung: lớp tự điều chỉnh, thầy chỉ giữ nhịp.", ("Cả lớp ồn lên sau giờ ra chơi", "Chiều muộn, lớp rã rời và rộn ràng", "Cả lớp đồng loạt gõ bàn trêu thầy", "Giờ tự học, thầy ra ngoài là lớp ồn", "Có tiếng động lạ mà không biết ai làm",))

#sec("Cả lớp ồn lên sau giờ ra chơi")
#tinhhuong("2.1", "Cả lớp ồn lên sau giờ ra chơi", "Chuông vào lớp đã reo, mà lớp vẫn như cái chợ. Thầy bước vào, nhiều em vẫn đứng nói, có em chạy từ cuối lớp lên. Mỗi lần thầy phải mất năm bảy phút mới ổn định được lớp, trong khi tiết học chỉ có bốn lăm phút.")
#chieu("Tài khoản giây", "Thầy bước vào, không nói gì, lặng lẽ viết lên góc bảng chữ T và bắt đầu ghi số giây lớp chưa yên. Khi lớp ngồi xuống và im, thầy chốt con số, ví dụ 74 giây. Thầy nói: lớp đang nợ thầy 74 giây. Cuối tiết, thầy không giữ lớp lại, mà đổi: số giây đó được trả bằng cách lớp đứng im đọc to một câu thơ hoặc một công thức của bài hôm nay. Số giây ngày hôm sau thường giảm hẳn vì cả lớp tự nhìn thấy con số của mình.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy không la. Thầy chỉ ghi lại. Lớp mình đang nợ thầy bảy mươi bốn giây. Cuối tiết mình trả nhé, trả bằng cách đọc to công thức hôm nay.")
  #tro("Dạ, tụi em trả ạ.")
  #thay("Mai thầy ghi lại. Thầy đoán con số sẽ nhỏ hơn.")
]
#visao("Lớp ồn vì không có ai đo được nó. Một con số đứng trên bảng khiến cả lớp thấy mình đang bị đo, mà không có ai bị mắng. Việc trả nợ bằng đọc lại kiến thức biến hình phạt thành một lần ôn bài.")
#ranhgioi("Không ghi tên từng em lên bảng. Không kéo dài quá ba phút khi trả nợ. Nếu có em lớp nhiều lần nhắc mà vẫn ồn, làm riêng với em đó thay vì để cả lớp gánh.")
#bientau("Đổi thành đồng hồ cát lật ngược đặt trên bàn thầy, cát chảy hết mà lớp chưa im thì cuối tiết lớp tặng thầy một tràng pháo tay cho thầy kiên nhẫn.")
#caunoi("Thầy không giận, thầy chỉ đang đếm. Lớp mình tự trả nhé.")

#sec("Chiều muộn, lớp rã rời và rộn ràng")
#tinhhuong("2.2", "Chiều muộn, lớp rã rời và rộn ràng", "Tiết cuối buổi chiều, trời nóng, cả lớp vừa mệt vừa rộn. Thầy nói lớn thì ồn thêm, thầy nói nhỏ thì không ai nghe. Đưa ra chuông, đập bàn đều không còn tác dụng.")
#chieu("Thầy thì thầm", "Thầy ngừng giảng, bước đến giữa lớp, nói thật nhỏ gần như thì thầm. Em nào nghe được thì chăm chú, những em không nghe được sẽ phải im để nghe. Thầy giảng liên tục năm phút như thế, sau đó hỏi một câu nhỏ cũng bằng giọng thì thầm. Nếu lớp vẫn ồn, thầy dừng hẳn, mỉm cười, chờ. Cả lớp tự im vì tò mò thầy sắp nói gì.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Rất nhỏ, mỉm cười.) Từ giờ thầy nói nhỏ thôi. Em nào muốn nghe thì im giúp thầy nhé. Đây là phần quan trọng nhất của tiết.")
  #tro("(Thì thầm lại.) Dạ.")
  #thay("Tốt. Câu hỏi thứ nhất, nhỏ thôi, thầy hỏi: đường tròn có bao nhiêu trục đối xứng?")
]
#visao("Âm thanh lớn khiến cả lớp tự động nâng giọng theo. Hạ giọng thì cả lớp hạ theo. Chiêu này không phạt ai, nhưng làm cho sự ồn tự mất ý nghĩa vì không còn cuộc cạnh tranh về âm lượng.")
#ranhgioi("Không dùng khi lớp ồn vì xô xát hay mâu thuẫn thật. Lúc đó cần dừng hẳn và giải quyết chuyện đó trước.")
#bientau("Dùng một biển nhỏ ghi chữ SHHH đặt lên bảng, khi nào lớp im thì thầy mới lật mặt sau có chữ Cảm ơn.")
#caunoi("Thầy nói nhỏ để dành cho những ai thật sự muốn nghe.")

#sec("Cả lớp đồng loạt gõ bàn trêu thầy")
#tinhhuong("2.3", "Cả lớp đồng loạt gõ bàn trêu thầy", "Thầy vừa bước vào, cả lớp gõ bàn theo nhịp. Có vẻ là một trò đùa đã bàn trước. Nhìn thì vui nhưng thầy thấy đó là một thử thách quyền lực nho nhỏ.")
#chieu("Nhạc trưởng", "Thầy đứng yên, mỉm cười, rồi giơ tay như nhạc trưởng chuyên nghiệp và chỉ huy chính tiếng gõ đó: nhanh dần, chậm dần, to dần, nhỏ dần, rồi dừng đột ngột bằng nắm tay. Sau một phút, thầy cúi chào: cảm ơn dàn nhạc, tiết mục kết thúc. Cả lớp hiểu thầy biết trò đùa, thầy chơi cùng, nhưng thầy là người cầm đũa nhạc.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Ồ, lớp mình có dàn nhạc à? Để thầy chỉ huy cho chuyên nghiệp nhé. Nhanh dần... chậm dần... và dừng!")
  #tro("(Cười rộ.) Thầy chơi luôn hả thầy!")
  #thay("Cảm ơn dàn nhạc. Giờ mình sang bản nhạc tiếp theo: bài Hàm số.")
]
#visao("Một trò thử thách thường chờ phản ứng giận dữ. Khi thầy tiếp nhận và cầm quyền điều khiển, trò chơi mất đi phần kịch tính vì không còn gì để chống lại. Học sinh nhớ thầy là người biết đùa mà vẫn giữ nhịp.")
#ranhgioi("Chỉ áp dụng khi tiếng gõ là một trò đùa chung, không nhắm xúc phạm. Nếu nhịp gõ kèm lời chế nhạo thầy hay bạn, dừng và nói thẳng thắn, bình tĩnh.")
#bientau("Mời một học sinh khéo tay lên làm nhạc trưởng lần sau, thầy làm khán giả.")
#caunoi("Thầy rất thích dàn nhạc này. Thầy chỉ huy một chút rồi mình vào bài nhé.")

#sec("Giờ tự học, thầy ra ngoài là lớp ồn")
#tinhhuong("2.4", "Giờ tự học, thầy ra ngoài là lớp ồn", "Thầy ra khỏi lớp năm phút để nghe điện thoại hay lấy tài liệu, quay lại thì lớp ồn như họp chợ. Em lớp trưởng ghi tên mấy bạn nói chuyện, nhưng các bạn đó bị ghét lại.")
#chieu("Chấm xanh yên tĩnh", "Thầy đưa ra một bảng lớn có mười ô vuông nhỏ. Mỗi lần thầy vắng mà lớp giữ được yên tĩnh, cả lớp tự tô một chấm xanh. Khi đủ mười chấm xanh, lớp được thầy chọn một phần thưởng nhỏ do chính lớp đề xuất, như mười phút nghe nhạc hay thầy kể một câu chuyện. Nếu lớp ồn, không có chấm xanh nhưng cũng không trừ, chỉ chờ lần sau. Lớp trưởng không ghi tên ai, chỉ báo có hay không có chấm.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Từ giờ mỗi lần thầy ra ngoài mà lớp tự giữ yên thì được một chấm xanh. Mười chấm xanh, lớp mình chọn một phần thưởng. Thầy không cần ai ghi tên ai, chỉ cần lớp tự giữ.")
  #tro("Dạ. Phần thưởng gì cũng được ạ?")
  #thay("Do lớp bàn, thầy duyệt, miễn là vui và lành mạnh.")
]
#visao("Giao trách nhiệm cho tập thể mà không đẩy một em ra làm cảnh sát. Phần thưởng nhỏ nhưng có tiến độ nhìn thấy được, nên lớp tự có áp lực tích cực. Không trừ chấm khi hỏng giúp lớp không nản.")
#ranhgioi("Không để lớp trưởng bị biến thành người tố cáo. Không dùng phần thưởng đắt hay tốn nhiều giờ học.")
#bientau("Thay chấm xanh bằng mảnh ghép tranh, đủ mười mảnh ghép thì hiện ra bức hình cả lớp.")
#caunoi("Thầy tin lớp mình tự giữ được. Mười chấm xanh, lớp chọn phần thưởng.")

#sec("Có tiếng động lạ mà không biết ai làm")
#tinhhuong("2.5", "Có tiếng động lạ mà không biết ai làm", "Giữa tiết yên tĩnh, có tiếng như tiếng mèo kêu vang lên từ cuối lớp. Cả lớp cười rộ. Thầy nhìn quanh nhưng không ai nhận. Em nào cũng nhìn đi chỗ khác.")
#chieu("Mời tấu ở giờ ra chơi", "Thầy không truy tìm. Thầy mỉm cười nói: tiếng đó rất giống thật, thầy khâm phục. Ai làm thì ra chơi ghé thầy, tấu lại thật hay cho thầy nghe đúng một lần, rồi lần sau để dành tài năng đó cho văn nghệ lớp. Không gọi tên, không điều tra. Thường sẽ có một em ghé, hoặc cả hai em cùng ghé vì đã bị cả lớp nhìn.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Tiếng đó giống thật đến nỗi thầy giật mình. Em nào làm xong thì ra chơi ghé thầy tấu thêm một lần, thầy muốn nghe cho kỹ. Còn bây giờ mình học tiếp.")
  #tro("(Ra chơi, ngượng ngùng.) Dạ... thầy, là em ạ.")
  #thay("Cảm ơn em đã ghé. Tiếng rất hay. Lần sau, em để dành cho giờ văn nghệ nhé.")
]
#visao("Học sinh nhận lỗi dễ hơn khi không phải nhận trước cả lớp và khi thầy không tỏ ra đã bị xúc phạm. Chiêu này lấy mất phần thử thách của hành vi, đồng thời dẫn em tới chỗ gặp riêng, nơi nói chuyện nhẹ nhàng nhất.")
#ranhgioi("Không ép em phải nhận. Nếu không ai ghé, thầy cười cho qua. Không phạt cả lớp để tìm ra thủ phạm.")
#bientau("Mở một ô tài năng nhỏ ở cuối tuần, ai có tài lẻ như bắt chước tiếng, ảo thuật thì diễn hai phút.")
#caunoi("Tiếng đó rất tài. Em nào làm thì ra chơi tấu cho thầy nghe riêng nhé.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 2: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Lớp là một tập thể, nhưng phạt thì phải đến từng người. Phạt tập thể chỉ nên là một trò chơi, không bao giờ là sự trừng phạt có thật.", "Đưa cho lớp một con số, một biểu đồ, một dàn nhạc. Học sinh chịu tự điều chỉnh khi các em nhìn thấy chính mình.", "Thầy cô giữ bình tĩnh là hình phạt lớn nhất với sự ồn ào. Lớp thường lặng đi khi thấy thầy không nổi giận.",))
