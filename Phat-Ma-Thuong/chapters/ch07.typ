#import "../template.typ": *

#chapter-open(7, "Cãi thầy, trả treo, nói lì", 7, "Em dám cãi thầy là em còn tin thầy sẽ nghe. Em im lặng mới là điều đáng lo.", "Bị cãi trước lớp là lúc thầy cô dễ mất bình tĩnh nhất, vì cảm giác uy tín bị thách thức. Nhưng đây cũng là lúc một phản ứng khéo biến em từ người chống đối thành người hợp tác. Chương này gợi những chiêu giữ quyền của thầy mà vẫn mở cửa cho em nói, kèm những ranh giới cần giữ khi chuyện vượt quá giới hạn.", ("Em cãi lại ngay trước lớp", "Em lườm, làm thinh, không trả lời", "Em nói lì: em không làm", "Em chê thầy giảng dở", "Em bất ngờ bỏ ra khỏi lớp",), en: ("Talking back, sulking, stubbornness", "A student who dares to argue still trusts that you will listen. The silent student is the one to worry about.", "Being argued with before the class is when teachers lose their calm most easily, because it feels as if authority is being challenged. But it is also when a skilful response turns a student from opponent to partner. This chapter offers moves that protect your standing while keeping the door open for the student to speak, with the limits to hold when things go too far.", ("A student argues back in front of the class", "A student glares, stays silent, will not answer", "A student stubbornly denies: I did not do it", "A student says the teacher teaches badly", "A student suddenly walks out of the classroom",)))

#sec("Em cãi lại ngay trước lớp", en: "A student argues back in front of the class")
#tinhhuong("7.1", "Em cãi lại ngay trước lớp", "Thầy nhắc Phát ngồi ngay ngắn. Em cãi: em có làm gì đâu thầy, sao cứ nhắm vào em. Giọng em cao, cả lớp im phăng phắc nhìn hai thầy trò.", en: "You tell Phat to sit up properly. He retorts: I did nothing, sir, why do you always pick on me? His voice is raised and the whole class falls silent, watching teacher and student.")
#chieu("Hoãn cuộc cãi", "Thầy hít một hơi, nói bình thản: thầy nghe em rồi, và thầy muốn nghe cho kỹ. Mình hẹn nhau ra chơi tiết này, thầy nghe hết. Bây giờ mình tiếp tục để không mất giờ của cả lớp. Thầy không thắng bằng lời, thầy thắng bằng thời gian và sự bình tĩnh. Ra chơi, thầy nghe em nói đủ trước, rồi mới nói phần của thầy. Thường lúc đó em đã nguội và nhận được phần mình sai.", en: ("Postponing the argument", "Take a breath and say calmly: I hear you and I want to hear it properly. Let us meet at break; I will listen to all of it. For now we continue so we do not waste the class's time. You do not win with words, you win with time and calm. At break, let him speak fully first, then say your part. By then he has usually cooled and admits his share."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Phát, thầy nghe em rồi, và thầy muốn nghe cho kỹ. Mình hẹn ra chơi nhé, thầy nghe em nói hết. Giờ thầy xin em cùng thầy học tiếp.", en: "Phat, I hear you, and I want to hear it properly. Let us meet at break and I will listen to everything. For now I ask you to carry on the lesson with me.")
  #tro("(Im lặng một lúc.) ...Dạ.", en: "(Silent for a moment.) ...Yes.")
  #thay("Cảm ơn em. Ra chơi thầy chờ em.", en: "Thank you. At break I will be waiting for you.")
]
#visao("Cãi lại trước đám đông là cách em tự bảo vệ thể diện. Khi thầy không đáp trả và không đòi em xin lỗi ngay, em không còn gì để chống lại. Hẹn gặp riêng cho em quyền được nghe, và khi gặp riêng, em thường nhẹ nhàng hơn nhiều.", en: "Arguing before an audience is how he defends his face. When you do not retort and do not demand an apology on the spot, he has nothing to push against. Arranging a private meeting gives him the right to be heard, and in private he is usually much gentler.")
#ranhgioi("Phải thực sự gặp và nghe. Hẹn mà không giữ lời sẽ phá hết. Nếu em dùng lời xúc phạm nặng, vẫn hẹn gặp nhưng nói rõ lời nói đó không chấp nhận được.", en: "You must really meet and really listen. A promised meeting not kept ruins everything. If he uses seriously insulting words, still meet him but say clearly that such language is unacceptable.")
#bientau("Dùng cử chỉ thay lời, thầy giơ tay ra hiệu im lặng và gật đầu hẹn với em.", en: "Use gestures instead of words: raise a hand for silence and nod to arrange the meeting.")
#caunoi("Thầy nghe em rồi. Mình hẹn ra chơi để thầy nghe cho kỹ nhé.", en: "I hear you. Let us meet at break so I can listen properly.")

#sec("Em lườm, làm thinh, không trả lời", en: "A student glares, stays silent, will not answer")
#tinhhuong("7.2", "Em lườm, làm thinh, không trả lời", "Thầy gọi tên Thảo, em ngồi im, mặt hằm, ánh mắt thách thức. Thầy hỏi lại, em không trả lời. Cả lớp quay lại nhìn. Thầy không biết em giận chuyện gì.", en: "You call Thao's name; she sits silent, scowling, a defiant look. You ask again and still no answer. The whole class turns to look. You do not know what she is angry about.")
#chieu("Ba câu chọn một", "Thầy không ép em nói. Thầy đưa một mảnh giấy nhỏ với ba câu để em đánh dấu: một, em đang giận chuyện gì đó ở lớp; hai, em đang có chuyện ở nhà; ba, em muốn thầy để em yên hôm nay. Em chỉ cần chọn một số và đẩy tờ giấy về phía thầy. Thầy tôn trọng câu trả lời và điều chỉnh. Nếu em chọn ba, thầy ghi chú nhẹ và hỏi thăm sau một ngày.", en: ("Choose one of three", "Do not force her to speak. Hand over a small slip with three lines to tick: one, I am angry about something at school; two, there is something going on at home; three, I want to be left alone today. She only needs to choose a number and push the slip toward you. You respect her answer and adjust. If she picks three, make a light note and check in a day later."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thảo, em không cần trả lời thành lời. Em chọn một trong ba ý này, đẩy tờ giấy cho thầy là đủ. Thầy sẽ tôn trọng.", en: "Thao, you do not need to answer aloud. Choose one of these three and push the slip to me, that is enough. I will respect it.")
  #tro("(Chọn số một, kín đáo.)", en: "(Marks number one, discreetly.)")
  #thay("Cảm ơn em. Ra chơi nếu em muốn nói thêm, thầy ở bàn thầy.", en: "Thank you. If you want to say more at break, I will be at my desk.")
]
#visao("Em im lặng thường vì không biết nói gì hoặc sợ nói ra sẽ bị chê. Ba lựa chọn rút gọn nỗi khó của việc mở lời, và cho em cảm giác mình có quyền chọn. Thầy cô nhận được thông tin mà không phải ép.", en: "A silent student often does not know what to say or fears being criticised for saying it. Three options reduce the difficulty of opening her mouth and give her the feeling of having a choice. You get information without pressure.")
#ranhgioi("Không dùng làm cách điều tra. Tôn trọng câu trả lời ba. Nếu hai hoặc ba lặp lại nhiều ngày thì nói chuyện thêm và theo dõi.", en: "Do not use it as a way to interrogate. Respect the answer three. If two or three repeats over days, talk further and keep watch.")
#bientau("Em có thể thêm một dòng nếu muốn, hoặc thay bằng ba mặt cười để em chỉ vào.", en: "She may add a line if she wants, or you replace the slip with three faces, a smile, a frown, a flat mouth, to point at.")
#caunoi("Em không cần nói. Em chọn một trong ba ý này cho thầy biết nhé.", en: "You do not need to speak. Choose one of these three and let me know.")

#sec("Em nói lì: em không làm", en: "A student stubbornly denies: I did not do it")
#tinhhuong("7.3", "Em nói lì: em không làm", "Một cái ghế bị gãy, ba em ngồi quanh đó. Em nào cũng nói không phải em. Thầy hỏi lần thứ ba, em Hào vẫn lì ra: em không làm. Không ai nhận, nhưng thầy cảm thấy Hào biết điều gì đó.", en: "A chair is broken and three students sit around it. Each says it was not them. You ask a third time, and Hao stonewalls: I did not do it. Nobody owns up, but you feel Hao knows something.")
#chieu("Hợp đồng ba dòng", "Thầy không ép nhận lỗi. Thầy nói: thầy sẽ không truy ai nữa. Chiếc ghế cần sửa, và thầy muốn cả ba em giúp. Thầy soạn một tờ hợp đồng ba dòng: một, ai làm thì thầy không nhắc tên; hai, ba em cùng thầy đưa ghế tới nhân viên bảo trì; ba, nếu ghế còn gãy thêm thì cả ba nói thật. Em ký tên để cùng chịu trách nhiệm. Khi không còn áp lực bị truy, người làm thường tự nhận kín đáo.", en: ("A three-line agreement", "Do not force confession. Say: I will stop hunting for anyone. The chair needs mending and I want all three of you to help. Draw up a three-line agreement: one, whoever did it, I will not name; two, the three of you will take the chair with me to the maintenance man; three, if the chair breaks again, all three tell the truth. They sign so that all share responsibility. When the pressure of being hunted lifts, the one responsible often owns up privately."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy không truy ai nữa. Cái ghế cần sửa, thầy nhờ ba em cùng đưa ghế tới bác bảo trì với thầy. Ba em ký vào tờ này nhé, ai làm thì thầy không nhắc tên.", en: "I will stop hunting for anyone. The chair needs fixing, so I ask the three of you to take it to the caretaker with me. Sign this, and whoever did it, I will not name.")
  #tro("(Hào, nhỏ giọng.) Thầy ơi... là em lỡ đạp ạ.", en: "(Hao, in a small voice.) Sir... it was me, I kicked it by accident.")
  #thay("Cảm ơn Hào đã nói. Thầy giữ kín. Giờ mình cùng sửa nhé.", en: "Thank you, Hao, for saying it. I will keep it between us. Now let us fix it together.")
]
#visao("Truy ép khiến người làm sợ và càng chối. Bỏ áp lực nhưng giữ trách nhiệm tập thể cho em lối thoát danh dự. Khi nói thật được tôn trọng, em hiểu không cần lì để bảo vệ mình.", en: "Pressing for the culprit scares the one responsible and makes him deny more. Lifting the pressure while keeping group responsibility gives him an honourable exit. When telling the truth is respected, he learns he need not be stubborn to protect himself.")
#ranhgioi("Không dùng cách này nếu thiệt hại nghiêm trọng hay có người bị hại. Không hứa giữ kín mà sau đó lại công khai. Nếu không ai nhận, đừng phạt cả ba mà chỉ cùng nhau sửa.", en: "Do not use this when the damage is serious or someone is hurt. Do not promise secrecy and then make it public. If nobody owns up, do not punish all three, just mend it together.")
#bientau("Nếu em nhận kín, thầy yêu cầu một việc bù nhỏ như giúp bảo vệ lau ghế.", en: "If he owns up privately, ask for a small act of repair, such as helping the caretaker wipe the chair.")
#caunoi("Thầy không truy ai nữa. Ba em ký vào hợp đồng này và cùng thầy sửa cái ghế nhé.", en: "I will stop hunting for anyone. The three of you sign this agreement and help me fix the chair.")

#sec("Em chê thầy giảng dở", en: "A student says the teacher teaches badly")
#tinhhuong("7.4", "Em chê thầy giảng dở", "Giữa tiết, Việt nói bằng giọng chê: thầy giảng khó hiểu quá, thầy giảng như thế ai hiểu được. Một vài bạn cười. Thầy thấy tim mình trùng xuống.", en: "In the middle of the lesson, Viet says in a scathing tone: this is so hard to understand, how is anyone supposed to follow? A few laugh. You feel your heart sink.")
#chieu("Hộp góp ý có điều kiện", "Thầy mỉm cười nói: cảm ơn em, thầy rất cần nghe. Em có thể giúp thầy bằng một tờ góp ý ba dòng không: một điều thầy làm tốt, một chỗ khó hiểu cụ thể, và một đề xuất em muốn thầy đổi. Viết riêng nộp cuối tuần. Thầy hứa phản hồi bằng một câu trả lời lại. Em đã có cách nói cụ thể hơn, thầy có thông tin thật, và lớp thấy thầy biết lắng nghe.", en: ("A feedback box with conditions", "Smile and say: thank you, I really need to hear that. Can you help me with a three-line feedback slip: one thing I do well, one specific part that is hard to follow, and one change you would like me to make. Write it privately and hand it in at the end of the week. Promise to reply. He now has a more concrete way of speaking, you have real information, and the class sees that you can listen."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Cảm ơn em đã nói thẳng. Thầy cần nghe thật. Em giúp thầy bằng một tờ góp ý ba dòng nhé: điều thầy làm tốt, chỗ cụ thể khó hiểu, và một đề xuất của em.", en: "Thank you for saying it straight. I need to hear the truth. Help me with a three-line feedback slip: what I do well, the specific part that is hard to follow, and one suggestion of yours.")
  #tro("Dạ... em sẽ viết.", en: "Um... I will write it.")
  #thay("Thầy hứa đọc và trả lời em. Chỗ nào thầy sửa được thầy sửa.", en: "I promise to read it and reply. Where I can change, I will.")
]
#visao("Lời chê có thể là thông tin quý, nhưng cách nói còn thô. Yêu cầu cụ thể hóa biến chê bai thành góp ý và dạy em cách phản hồi mang tính xây dựng. Việc thầy hứa trả lời cho thấy thầy không sợ bị góp ý.", en: "A criticism can be valuable information, but the way it is said is rough. Asking for specifics turns jeering into feedback and teaches him how to give constructive responses. Your promise to reply shows you are not afraid of feedback.")
#ranhgioi("Phải thật sự đọc và trả lời, kể cả khi góp ý làm thầy buồn. Không dùng cách này để gài em. Nếu em chỉ muốn xúc phạm, nói rõ giới hạn.", en: "You must truly read and reply, even if it hurts. Do not use this to trap him. If he only wants to insult, state the limit.")
#bientau("Mở hộp góp ý ẩn danh cho cả lớp mỗi tháng một lần, thầy đọc to những góp ý tử tế.", en: "Open an anonymous feedback box for the whole class once a month and read aloud the kind suggestions.")
#caunoi("Cảm ơn em đã nói thẳng. Em viết cho thầy ba dòng góp ý cụ thể nhé, thầy sẽ trả lời.", en: "Thank you for saying it straight. Write me three specific lines of feedback and I will reply.")

#sec("Em bất ngờ bỏ ra khỏi lớp", en: "A student suddenly walks out of the classroom")
#tinhhuong("7.5", "Em bất ngờ bỏ ra khỏi lớp", "Sau khi bị nhắc, Duy đứng bật dậy, đẩy ghế, bỏ ra khỏi lớp và đóng sầm cửa. Cả lớp im lặng nhìn thầy. Thầy chưa biết phản ứng thế nào.", en: "After being reminded, Duy jumps up, shoves his chair, walks out and slams the door. The whole class sits silent, looking at you. You are not sure how to react.")
#chieu("Cửa vẫn mở", "Thầy không đuổi theo, không quát. Thầy nói với lớp: mình tiếp tục học, thầy sẽ gặp bạn sau. Một lúc sau, thầy nhờ lớp trưởng hoặc bác bảo vệ lặng lẽ nhìn xem em có an toàn không. Cuối tiết, thầy ra gặp, không nhắc chuyện đã xảy ra, chỉ nói: thầy thấy em đang rất giận, khi nào em sẵn sàng thì mình nói chuyện. Cửa lớp vẫn mở với em. Thầy không bắt xin lỗi trong lần gặp đầu.", en: ("The door stays open", "Do not chase and do not shout. Tell the class: we carry on, I will see him later. A little while on, quietly ask the class monitor or the caretaker to check that he is safe. At the end of the lesson go out and meet him, do not mention what happened, just say: I can see you are very angry; when you are ready we will talk. The classroom door is still open to him. Do not demand an apology at the first meeting."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Duy, thầy ở đây. Thầy không giận em. Khi nào em sẵn sàng thì mình nói, hôm nay hoặc mai đều được.", en: "Duy, I am here. I am not angry with you. When you are ready we will talk, today or tomorrow, whichever is fine.")
  #tro("(Im lặng một lúc.) Thầy mắng em trước cả lớp.", en: "(Silent a moment.) You scolded me in front of everyone.")
  #thay("Thầy nghe rồi. Cảm ơn em đã nói. Thầy xin lỗi nếu thầy làm em mất mặt. Mình cùng nghĩ cách để lần sau không như thế nhé.", en: "I hear you. Thank you for telling me. I am sorry if I embarrassed you. Let us think together about how to avoid that next time.")
]
#visao("Em bỏ đi khi cảm xúc quá lớn. Đuổi theo sẽ làm cảm xúc bùng thêm. Giữ cửa mở và gặp riêng khi em đã nguội cho em thấy thầy không cắt đứt, và thầy dám nhận phần mình.", en: "He leaves when his feelings are too big. Chasing him would inflame them further. Keeping the door open and meeting privately once he has cooled shows him you have not cut him off, and that you dare to own your part.")
#ranhgioi("Phải đảm bảo em an toàn khi bỏ đi, không cho em rời khỏi trường. Nếu em có dấu hiệu tự làm hại mình, báo ngay gia đình và nhà trường. Thầy có lỗi thì nhận lỗi thật lòng, đừng nhận cho xong.", en: "You must ensure his safety when he leaves, and not let him leave the school. If he shows signs of self-harm, tell family and school at once. If you were at fault, own it truly, not just to get it over with.")
#bientau("Chuẩn bị trước một tín hiệu để em xin ra ngoài bình tĩnh mà không cần nói lời nào, như đặt thẻ xanh lên bàn.", en: "Prepare in advance a signal for him to step out calmly without saying a word, such as placing a green card on his desk.")
#caunoi("Thầy ở đây khi nào em sẵn sàng. Cửa vẫn mở với em.", en: "I am here whenever you are ready. The door is still open to you.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 7: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Thắng một cuộc cãi trước lớp là thua một học sinh. Hoãn lại, nghe thật, và giữ bình tĩnh mới là thắng.", "Khi thầy cô sai, nhận lỗi trước một học sinh là cách thể hiện uy tín tốt nhất. Học sinh chỉ kính nể người dám nhận mình sai.", "Nếu lời lẽ của em vượt quá giới hạn xúc phạm, thầy cô vẫn có quyền dừng và nói rõ: lời đó không chấp nhận được, nhưng thầy vẫn muốn nghe điều em muốn nói.",), en: ("Winning an argument before the class is losing a student. Postponing, truly listening and staying calm is winning.", "When you are wrong, owning it to one student is the best way to show authority. Students respect only one who dares admit being wrong.", "If a student's words cross into insult, you still have the right to stop and say plainly: those words are not acceptable, but I still want to hear what you meant.",))
