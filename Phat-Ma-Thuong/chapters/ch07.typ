#import "../template.typ": *

#chapter-open(7, "Cãi thầy, trả treo, nói lì", 7, "Em dám cãi thầy là em còn tin thầy sẽ nghe. Em im lặng mới là điều đáng lo.", "Bị cãi trước lớp là lúc thầy cô dễ mất bình tĩnh nhất, vì cảm giác uy tín bị thách thức. Nhưng đây cũng là lúc một phản ứng khéo biến em từ người chống đối thành người hợp tác. Chương này gợi những chiêu giữ quyền của thầy mà vẫn mở cửa cho em nói, kèm những ranh giới cần giữ khi chuyện vượt quá giới hạn.", ("Em cãi lại ngay trước lớp", "Em lườm, làm thinh, không trả lời", "Em nói lì: em không làm", "Em chê thầy giảng dở", "Em bất ngờ bỏ ra khỏi lớp",))

#sec("Em cãi lại ngay trước lớp")
#tinhhuong("7.1", "Em cãi lại ngay trước lớp", "Thầy nhắc Phát ngồi ngay ngắn. Em cãi: em có làm gì đâu thầy, sao cứ nhắm vào em. Giọng em cao, cả lớp im phăng phắc nhìn hai thầy trò.")
#chieu("Hoãn cuộc cãi", "Thầy hít một hơi, nói bình thản: thầy nghe em rồi, và thầy muốn nghe cho kỹ. Mình hẹn nhau ra chơi tiết này, thầy nghe hết. Bây giờ mình tiếp tục để không mất giờ của cả lớp. Thầy không thắng bằng lời, thầy thắng bằng thời gian và sự bình tĩnh. Ra chơi, thầy nghe em nói đủ trước, rồi mới nói phần của thầy. Thường lúc đó em đã nguội và nhận được phần mình sai.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Phát, thầy nghe em rồi, và thầy muốn nghe cho kỹ. Mình hẹn ra chơi nhé, thầy nghe em nói hết. Giờ thầy xin em cùng thầy học tiếp.")
  #tro("(Im lặng một lúc.) ...Dạ.")
  #thay("Cảm ơn em. Ra chơi thầy chờ em.")
]
#visao("Cãi lại trước đám đông là cách em tự bảo vệ thể diện. Khi thầy không đáp trả và không đòi em xin lỗi ngay, em không còn gì để chống lại. Hẹn gặp riêng cho em quyền được nghe, và khi gặp riêng, em thường nhẹ nhàng hơn nhiều.")
#ranhgioi("Phải thực sự gặp và nghe. Hẹn mà không giữ lời sẽ phá hết. Nếu em dùng lời xúc phạm nặng, vẫn hẹn gặp nhưng nói rõ lời nói đó không chấp nhận được.")
#bientau("Dùng cử chỉ thay lời, thầy giơ tay ra hiệu im lặng và gật đầu hẹn với em.")
#caunoi("Thầy nghe em rồi. Mình hẹn ra chơi để thầy nghe cho kỹ nhé.")

#sec("Em lườm, làm thinh, không trả lời")
#tinhhuong("7.2", "Em lườm, làm thinh, không trả lời", "Thầy gọi tên Thảo, em ngồi im, mặt hằm, ánh mắt thách thức. Thầy hỏi lại, em không trả lời. Cả lớp quay lại nhìn. Thầy không biết em giận chuyện gì.")
#chieu("Ba câu chọn một", "Thầy không ép em nói. Thầy đưa một mảnh giấy nhỏ với ba câu để em đánh dấu: một, em đang giận chuyện gì đó ở lớp; hai, em đang có chuyện ở nhà; ba, em muốn thầy để em yên hôm nay. Em chỉ cần chọn một số và đẩy tờ giấy về phía thầy. Thầy tôn trọng câu trả lời và điều chỉnh. Nếu em chọn ba, thầy ghi chú nhẹ và hỏi thăm sau một ngày.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thảo, em không cần trả lời thành lời. Em chọn một trong ba ý này, đẩy tờ giấy cho thầy là đủ. Thầy sẽ tôn trọng.")
  #tro("(Chọn số một, kín đáo.)")
  #thay("Cảm ơn em. Ra chơi nếu em muốn nói thêm, thầy ở bàn thầy.")
]
#visao("Em im lặng thường vì không biết nói gì hoặc sợ nói ra sẽ bị chê. Ba lựa chọn rút gọn nỗi khó của việc mở lời, và cho em cảm giác mình có quyền chọn. Thầy cô nhận được thông tin mà không phải ép.")
#ranhgioi("Không dùng làm cách điều tra. Tôn trọng câu trả lời ba. Nếu hai hoặc ba lặp lại nhiều ngày thì nói chuyện thêm và theo dõi.")
#bientau("Em có thể thêm một dòng nếu muốn, hoặc thay bằng ba mặt cười để em chỉ vào.")
#caunoi("Em không cần nói. Em chọn một trong ba ý này cho thầy biết nhé.")

#sec("Em nói lì: em không làm")
#tinhhuong("7.3", "Em nói lì: em không làm", "Một cái ghế bị gãy, ba em ngồi quanh đó. Em nào cũng nói không phải em. Thầy hỏi lần thứ ba, em Hào vẫn lì ra: em không làm. Không ai nhận, nhưng thầy cảm thấy Hào biết điều gì đó.")
#chieu("Hợp đồng ba dòng", "Thầy không ép nhận lỗi. Thầy nói: thầy sẽ không truy ai nữa. Chiếc ghế cần sửa, và thầy muốn cả ba em giúp. Thầy soạn một tờ hợp đồng ba dòng: một, ai làm thì thầy không nhắc tên; hai, ba em cùng thầy đưa ghế tới nhân viên bảo trì; ba, nếu ghế còn gãy thêm thì cả ba nói thật. Em ký tên để cùng chịu trách nhiệm. Khi không còn áp lực bị truy, người làm thường tự nhận kín đáo.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy không truy ai nữa. Cái ghế cần sửa, thầy nhờ ba em cùng đưa ghế tới bác bảo trì với thầy. Ba em ký vào tờ này nhé, ai làm thì thầy không nhắc tên.")
  #tro("(Hào, nhỏ giọng.) Thầy ơi... là em lỡ đạp ạ.")
  #thay("Cảm ơn Hào đã nói. Thầy giữ kín. Giờ mình cùng sửa nhé.")
]
#visao("Truy ép khiến người làm sợ và càng chối. Bỏ áp lực nhưng giữ trách nhiệm tập thể cho em lối thoát danh dự. Khi nói thật được tôn trọng, em hiểu không cần lì để bảo vệ mình.")
#ranhgioi("Không dùng cách này nếu thiệt hại nghiêm trọng hay có người bị hại. Không hứa giữ kín mà sau đó lại công khai. Nếu không ai nhận, đừng phạt cả ba mà chỉ cùng nhau sửa.")
#bientau("Nếu em nhận kín, thầy yêu cầu một việc bù nhỏ như giúp bảo vệ lau ghế.")
#caunoi("Thầy không truy ai nữa. Ba em ký vào hợp đồng này và cùng thầy sửa cái ghế nhé.")

#sec("Em chê thầy giảng dở")
#tinhhuong("7.4", "Em chê thầy giảng dở", "Giữa tiết, Việt nói bằng giọng chê: thầy giảng khó hiểu quá, thầy giảng như thế ai hiểu được. Một vài bạn cười. Thầy thấy tim mình trùng xuống.")
#chieu("Hộp góp ý có điều kiện", "Thầy mỉm cười nói: cảm ơn em, thầy rất cần nghe. Em có thể giúp thầy bằng một tờ góp ý ba dòng không: một điều thầy làm tốt, một chỗ khó hiểu cụ thể, và một đề xuất em muốn thầy đổi. Viết riêng nộp cuối tuần. Thầy hứa phản hồi bằng một câu trả lời lại. Em đã có cách nói cụ thể hơn, thầy có thông tin thật, và lớp thấy thầy biết lắng nghe.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Cảm ơn em đã nói thẳng. Thầy cần nghe thật. Em giúp thầy bằng một tờ góp ý ba dòng nhé: điều thầy làm tốt, chỗ cụ thể khó hiểu, và một đề xuất của em.")
  #tro("Dạ... em sẽ viết.")
  #thay("Thầy hứa đọc và trả lời em. Chỗ nào thầy sửa được thầy sửa.")
]
#visao("Lời chê có thể là thông tin quý, nhưng cách nói còn thô. Yêu cầu cụ thể hóa biến chê bai thành góp ý và dạy em cách phản hồi mang tính xây dựng. Việc thầy hứa trả lời cho thấy thầy không sợ bị góp ý.")
#ranhgioi("Phải thật sự đọc và trả lời, kể cả khi góp ý làm thầy buồn. Không dùng cách này để gài em. Nếu em chỉ muốn xúc phạm, nói rõ giới hạn.")
#bientau("Mở hộp góp ý ẩn danh cho cả lớp mỗi tháng một lần, thầy đọc to những góp ý tử tế.")
#caunoi("Cảm ơn em đã nói thẳng. Em viết cho thầy ba dòng góp ý cụ thể nhé, thầy sẽ trả lời.")

#sec("Em bất ngờ bỏ ra khỏi lớp")
#tinhhuong("7.5", "Em bất ngờ bỏ ra khỏi lớp", "Sau khi bị nhắc, Duy đứng bật dậy, đẩy ghế, bỏ ra khỏi lớp và đóng sầm cửa. Cả lớp im lặng nhìn thầy. Thầy chưa biết phản ứng thế nào.")
#chieu("Cửa vẫn mở", "Thầy không đuổi theo, không quát. Thầy nói với lớp: mình tiếp tục học, thầy sẽ gặp bạn sau. Một lúc sau, thầy nhờ lớp trưởng hoặc bác bảo vệ lặng lẽ nhìn xem em có an toàn không. Cuối tiết, thầy ra gặp, không nhắc chuyện đã xảy ra, chỉ nói: thầy thấy em đang rất giận, khi nào em sẵn sàng thì mình nói chuyện. Cửa lớp vẫn mở với em. Thầy không bắt xin lỗi trong lần gặp đầu.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Duy, thầy ở đây. Thầy không giận em. Khi nào em sẵn sàng thì mình nói, hôm nay hoặc mai đều được.")
  #tro("(Im lặng một lúc.) Thầy mắng em trước cả lớp.")
  #thay("Thầy nghe rồi. Cảm ơn em đã nói. Thầy xin lỗi nếu thầy làm em mất mặt. Mình cùng nghĩ cách để lần sau không như thế nhé.")
]
#visao("Em bỏ đi khi cảm xúc quá lớn. Đuổi theo sẽ làm cảm xúc bùng thêm. Giữ cửa mở và gặp riêng khi em đã nguội cho em thấy thầy không cắt đứt, và thầy dám nhận phần mình.")
#ranhgioi("Phải đảm bảo em an toàn khi bỏ đi, không cho em rời khỏi trường. Nếu em có dấu hiệu tự làm hại mình, báo ngay gia đình và nhà trường. Thầy có lỗi thì nhận lỗi thật lòng, đừng nhận cho xong.")
#bientau("Chuẩn bị trước một tín hiệu để em xin ra ngoài bình tĩnh mà không cần nói lời nào, như đặt thẻ xanh lên bàn.")
#caunoi("Thầy ở đây khi nào em sẵn sàng. Cửa vẫn mở với em.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 7: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Thắng một cuộc cãi trước lớp là thua một học sinh. Hoãn lại, nghe thật, và giữ bình tĩnh mới là thắng.", "Khi thầy cô sai, nhận lỗi trước một học sinh là cách thể hiện uy tín tốt nhất. Học sinh chỉ kính nể người dám nhận mình sai.", "Nếu lời lẽ của em vượt quá giới hạn xúc phạm, thầy cô vẫn có quyền dừng và nói rõ: lời đó không chấp nhận được, nhưng thầy vẫn muốn nghe điều em muốn nói.",))
