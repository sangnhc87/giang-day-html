#import "../template.typ": *

#chapter-open(14, "Kho chiêu luân phiên: đổi chiêu mỗi tuần, khỏi nhàm", 14, "Chiêu hay đến đâu dùng mãi cũng nhàm. Thầy cô cần một kho chiêu để đổi, và một cách chọn đúng chiêu cho đúng em.", "Đây là chương trả lời đúng điều nhiều thầy cô tâm sự: phạt thì nhiều, nhưng ý tưởng thì cạn. Chương này không thêm một kiểu lỗi mới mà đưa ra phương pháp: cách đổi chiêu khi chiêu cũ nhàm, cách chọn chiêu theo lớp, theo tính cách học sinh, theo mức độ lỗi, và những khung chiêu có thể biến tấu vô tận. Mỗi khung chiêu dưới đây là một cỗ máy sinh ra nhiều chiêu.", ("Thầy cô thấy chiêu cũ đã nhàm", "Lớp mười mới vào, chưa biết nề nếp", "Học sinh lớp mười hai đang áp lực", "Lỗi đã lặp đến lần thứ năm", "Em nghịch nhưng rất thông minh", "Những khung chiêu có thể biến tấu vô tận",))

#sec("Thầy cô thấy chiêu cũ đã nhàm")
#tinhhuong("14.1", "Thầy cô thấy chiêu cũ đã nhàm", "Tháng đầu học kỳ, chiêu Hũ từ thay thế còn mới lạ. Tháng thứ ba các em đã quen, thậm chí còn nhờn. Thầy cô vừa chán vừa lo, vì ý tưởng mới cạn dần.")
#chieu("Bánh xe chiêu", "Thầy làm một bánh xe giấy chia tám ô, mỗi ô là một chiêu phạt hợp lệ đã từng dùng. Khi em phạm lỗi, thầy nói: em chọn ba trong tám ô, thầy quay bánh xe chọn một. Em cảm thấy mình được tham gia, và bản thân việc quay làm hình phạt mang màu sắc trò chơi. Mỗi tháng thầy thay hai ô cũ bằng hai ô mới, nên bánh xe luôn tươi.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Lần này em được chọn. Trong tám ô trên bánh xe này, em chọn ba ô em thấy chịu được, rồi mình quay xem rơi vào đâu.")
  #tro("Dạ... em chọn ô số ba, năm, bảy.")
  #thay("Được. Thầy quay nhé. Rơi vào ô năm: em làm bảo mẫu cây. Thầy tin em làm tốt.")
]
#visao("Chiêu nhàm khi trở thành quen thuộc. Bánh xe đưa vào yếu tố bất ngờ và quyền chọn. Em tham gia vào quyết định phạt nên ít kháng cự hơn và nhớ lâu hơn.")
#ranhgioi("Mọi ô trên bánh xe phải được thầy duyệt trước, đều tôn trọng em. Không có ô nào gây xấu hổ hay mất sức. Không dùng bánh xe với lỗi nghiêm trọng.")
#bientau("Cho lớp góp ý ô mới cho bánh xe mỗi tháng, thầy chọn những ô phù hợp.")
#caunoi("Em chọn ba ô thấy chịu được, rồi mình quay bánh xe nhé.")

#sec("Lớp mười mới vào, chưa biết nề nếp")
#tinhhuong("14.2", "Lớp mười mới vào, chưa biết nề nếp", "Đầu năm, lớp mười mới từ nhiều trường về. Nhiều em chưa biết quy định, trễ giờ, quên đồ, nói chuyện. Phạt ngay từ tuần đầu thì thấy nặng nề, bỏ qua thì sợ nề nếp lỏng lẻo.")
#chieu("Tuần ân hạn", "Thầy tuyên bố tuần đầu tiên là tuần ân hạn: mọi lỗi nề nếp được nhắc nhẹ, ghi vào một quyển sổ nhỏ gọi là sổ bài học, không phạt. Cuối tuần thầy đọc to các lỗi chung phổ biến, không nêu tên, và cả lớp cùng viết ra ba quy tắc lớp mình. Từ tuần thứ hai, các em tự áp dụng quy tắc do chính mình đặt, kèm các chiêu phạt nhẹ đã thống nhất.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Tuần này là tuần ân hạn. Mình ghi lại các lỗi để học, không phạt. Cuối tuần cả lớp cùng đặt ba quy tắc của lớp mình nhé.")
  #tro("Dạ... tụi em đặt quy tắc luôn hả thầy?")
  #thay("Luôn. Quy tắc tự đặt thì tự giữ.")
]
#visao("Lớp mới cần thời gian hiểu luật chơi. Ân hạn giảm áp lực và tạo thiện cảm đầu năm. Quy tắc do lớp đặt mang tính sở hữu nên được tôn trọng hơn quy tắc do thầy áp đặt.")
#ranhgioi("Ân hạn không áp dụng cho hành vi nguy hiểm hoặc xúc phạm bạn. Không kéo dài ân hạn quá hai tuần. Ghi lại để biết em nào cần quan tâm đặc biệt.")
#bientau("Làm hợp đồng lớp, mỗi em ký tên và dán vào góc lớp.")
#caunoi("Tuần này là tuần ân hạn, mình học luật và cùng đặt quy tắc của lớp nhé.")

#sec("Học sinh lớp mười hai đang áp lực")
#tinhhuong("14.3", "Học sinh lớp mười hai đang áp lực", "Lớp mười hai thi cuối cấp, mệt, căng, dễ cáu. Các em hay nói chuyện riêng, ngủ gật, đi trễ vì học thêm. Thầy muốn giữ nề nếp nhưng không muốn thêm áp lực.")
#chieu("Phạt không tốn thời gian", "Thầy dùng những chiêu ngắn dưới một phút và hữu ích cho ôn thi: em phạm lỗi thì đọc to một công thức hay một đoạn văn mẫu trong ba mươi giây, hoặc ra một câu hỏi trắc nghiệm cho cả lớp. Em không mất thời gian, còn cả lớp được ôn thêm. Thầy cũng đặt một quy ước: những lúc cả lớp quá mệt, thầy cho một phút nghỉ, hít thở, không cần lý do.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Em ồn thì thầy nhờ em một việc ngắn: đọc to cho lớp công thức này trong ba mươi giây. Cả lớp cùng ôn.")
  #tro("Dạ... em đọc ạ.")
  #thay("Cảm ơn em. Giờ cả lớp hít thở một phút, rồi mình học tiếp.")
]
#visao("Học sinh cuối cấp thiếu thời gian nhất. Phạt phải đúng bằng một đơn vị thời gian nhỏ và còn có ích cho kỳ thi. Việc tặng một phút nghỉ khi lớp quá mệt cho các em thấy thầy hiểu mình.")
#ranhgioi("Không tăng bài tập làm hình phạt khi các em đã quá tải. Không so sánh với lớp khác hay dọa kết quả thi. Quan sát em nào có dấu hiệu kiệt sức hoặc lo âu nặng.")
#bientau("Thêm một hũ lời động viên, mỗi em bốc một câu cuối tiết.")
#caunoi("Em đọc to cho cả lớp ôn công thức này ba mươi giây nhé.")

#sec("Lỗi đã lặp đến lần thứ năm")
#tinhhuong("14.4", "Lỗi đã lặp đến lần thứ năm", "Em Tú đi trễ lần thứ năm trong tháng. Thầy đã nhắc, đã dùng vé vào lớp, đã nói chuyện riêng. Em vẫn trễ. Thầy bối rối không biết còn chiêu nào.")
#chieu("Thang bốn bậc", "Thầy dùng một cái thang để biết mình đang ở đâu: bậc một nhắc nhẹ bằng ánh mắt, bậc hai hỏi thật lý do, bậc ba thỏa thuận bằng hợp đồng nhỏ, bậc bốn mời gia đình cùng giải quyết. Thầy không nhảy bậc và không lặp bậc. Khi lỗi lặp ở bậc nào thì thầy lên bậc kế, không tăng độ nặng của hình phạt mà tăng người cùng giải quyết. Tú ở bậc ba hay bốn thì sự thay đổi phải đến từ hoàn cảnh chứ không từ sức ép.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Tú, mình đã thử nhiều cách mà chưa ổn. Thầy mời ba mẹ em cùng nói chuyện với em và thầy một buổi, không phải để mắng, mà để cùng tìm cách.")
  #tro("Dạ... em đồng ý thầy.")
  #thay("Cảm ơn em. Thầy tin ba mẹ cũng muốn em ổn.")
]
#visao("Lỗi lặp lại nhiều lần thường có nguyên nhân sâu hơn. Tăng độ nặng của phạt không giải quyết nguyên nhân. Thêm người cùng gỡ nguyên nhân là hướng đúng.")
#ranhgioi("Khi mời gia đình, nói trước với em để em không thấy bị phản bội. Không dùng gia đình làm cách đe dọa. Nếu có dấu hiệu gia đình bạo lực, cân nhắc kỹ trước khi mời.")
#bientau("Ghi lại các bậc đã đi qua trong sổ để lần sau không phải làm lại từ đầu.")
#caunoi("Mình đã thử nhiều cách, giờ thầy mời ba mẹ cùng nghĩ cách với em nhé.")

#sec("Em nghịch nhưng rất thông minh")
#tinhhuong("14.5", "Em nghịch nhưng rất thông minh", "Quang là em thông minh nhất lớp nhưng cũng nghịch nhất. Em thường làm xong bài sớm rồi quay sang trêu bạn, cãi thầy. Những chiêu phạt thông thường em xem như trò chơi.")
#chieu("Em thiết kế hình phạt", "Thầy thách em: thầy tin em thông minh hơn các chiêu thầy có. Em hãy tự thiết kế hình phạt cho chính lỗi vừa rồi, theo ba tiêu chí: vui, có ích, và khiến em không muốn lặp lại. Em đưa thầy xem, thầy duyệt hoặc điều chỉnh. Em tự thấy nặng nhẹ, và nhiều khi em đặt hình phạt khó hơn thầy dự định. Em bị cuốn vào việc thiết kế nên chuyển năng lượng sang việc sáng tạo.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Quang, thầy thách em: tự thiết kế một hình phạt cho lỗi vừa rồi, ba tiêu chí: vui, có ích, và em không muốn lặp lại. Đưa thầy xem trong ra chơi nhé.")
  #tro("Dạ... để em nghĩ. Có khi em ra hình phạt nặng hơn thầy đó.")
  #thay("Càng hay. Thầy duyệt, và nếu hay thầy đem dùng cho cả lớp, ghi tên em là tác giả.")
]
#visao("Em thông minh chán các chiêu thông thường vì quá dễ. Giao cho em quyền thiết kế biến lỗi thành bài toán và biến thầy thành người cộng tác. Em tự đặt luật cho mình nên khó chống lại.")
#ranhgioi("Thầy giữ quyền duyệt cuối. Không để em chọn hình phạt gây hại cho mình hay người khác. Không dùng chiêu này với em bị cuốn vào cảm giác quyền lực quá mức.")
#bientau("Tập hợp các hình phạt hay do học sinh thiết kế thành một cuốn sổ chiêu của lớp.")
#caunoi("Em tự thiết kế hình phạt cho lỗi này nhé, ba tiêu chí: vui, có ích, không muốn lặp lại.")

#sec("Những khung chiêu có thể biến tấu vô tận")
#tinhhuong("14.6", "Những khung chiêu có thể biến tấu vô tận", "Thầy cô muốn có ý tưởng mới mỗi ngày nhưng không thể nghĩ ra liên tục. Nhìn các chiêu trong sách, thầy thấy chúng có mẫu chung. Thầy muốn biết cách tự sinh chiêu mới.")
#chieu("Mười hai khung chiêu", "Mỗi chiêu trong sách thuộc một trong mười hai khung. Một, nói thả ga có giới hạn giờ. Hai, đổi vai thử cảm giác bạn. Ba, giao chức vụ cho đúng nhu cầu em. Bốn, người nợ thời gian trả bằng việc tử tế. Năm, bảo mẫu một vật hay một việc trong một tháng. Sáu, viết thiệp hay thư ngắn cho người bị ảnh hưởng. Bảy, dạy lại bài hoặc kỹ năng cho bạn. Tám, tự thiết kế hình phạt. Chín, bản nháp và nâng cấp. Mười, hợp đồng nhỏ có chữ ký. Mười một, hũ hoặc sổ ghi lại thay cho nhắc. Mười hai, phiếu miễn và quyền chọn. Gặp lỗi mới, thầy cô chọn một khung rồi gắn vào đúng lỗi đó.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Tự hỏi.) Lỗi này thuộc loại gì? Thiếu chú ý thì khung chức vụ. Làm tổn thương bạn thì khung thiệp và đổi vai. Lặp lại thì khung sổ ghi và hợp đồng. Chọn một khung rồi gắn vào đúng lỗi.")
  #tro("(Em sau này.) Hình phạt của thầy lúc nào cũng khác nhưng lúc nào cũng có lý.")
  #thay("Đúng, vì thầy luôn hỏi mình: lỗi này em đang thiếu gì?")
]
#visao("Mọi chiêu hay đều xuất phát từ một ý tưởng gốc về nhu cầu của em. Khi thầy cô nắm được mười hai khung, việc nghĩ chiêu mới như ghép hình. Chiêu không cạn vì nhu cầu của học sinh vô tận.")
#ranhgioi("Mọi chiêu dù mới đều phải qua ba bài kiểm tra: riêng tư, gắn đúng lỗi, và kết thúc bằng việc có ích hoặc nụ cười. Chiêu không đạt thì bỏ.")
#bientau("Mỗi học kỳ cùng đồng nghiệp trao đổi mười chiêu mới, ghi vào sổ chiêu của tổ.")
#caunoi("Lỗi này em đang thiếu gì? Thầy chọn khung chiêu hợp rồi mình cùng làm.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 14: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Chiêu không bao giờ cạn nếu thầy cô hỏi đúng câu: em đang thiếu gì? Câu trả lời luôn dẫn tới một khung chiêu.", "Đổi chiêu mỗi tuần, cho em quyền chọn một phần. Em tham gia vào việc chọn phạt thì phạt trở thành thỏa thuận.", "Trao đổi chiêu với đồng nghiệp. Mỗi thầy cô có một kho kinh nghiệm riêng, ghép lại thành một kho lớn.",))
