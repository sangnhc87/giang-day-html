#import "../template.typ": *

#chapter-open(3, "Khen, chê và so sánh: ba thứ dao hai lưỡi", 3, "Lời khen đúng làm con muốn cố thêm. Lời khen sai làm con sợ mất danh hiệu.", "Người Việt mình thương con bằng cách chê, vì sợ khen nhiều con hư. Thế hệ sau thì ngược lại, khen không tiếc lời, giỏi quá, thông minh quá. Lạ là cả hai cách đều có thể làm con chùn chân. Chương này bàn về ba thứ ba mẹ dùng mỗi ngày mà ít khi dừng lại nghĩ: lời khen, lời chê, và câu con nhà người ta.", ("Con khoe điểm mười", "Con vẽ xấu mà hỏi mẹ thấy đẹp không", "Con nhà người ta", "Phải chê thì chê sao cho con còn muốn sửa",), en: ("Praise, criticism and comparison: three double-edged knives", "The right praise makes a child want to try harder. The wrong praise makes a child afraid of losing a title.", "Vietnamese parents traditionally love by criticising, fearing that praise will spoil a child. The next generation does the opposite and praises without limit: so good, so clever. Strangely, both can hold a child back. This chapter looks at three things parents use every day and rarely stop to think about: praise, criticism, and the phrase other people's children.", ("Your child shows off a perfect score", "The drawing is not good and your child asks if it is beautiful", "Other people's children", "When you must criticise, do it so they still want to improve",)))

#sec("Con khoe điểm mười", en: "Your child shows off a perfect score")
#boicanh("Bé Khánh lớp 4 chạy ào vô nhà, giơ bài kiểm tra Toán điểm 10 đỏ chói. Mắt con sáng rỡ chờ ba nói gì đó.", en: "Khanh, in grade 4, bursts into the house waving a maths test with a bright red 10. His eyes shine, waiting for Dad to say something.")
#phanxa("Giỏi quá! Con trai ba thông minh nhất nhà!", "Mình được thương vì mình thông minh. Vậy lần sau bài khó, làm sai thì mình hết thông minh. Tốt nhất là né bài khó.", en: ("Brilliant! My son is the smartest in the family!", "I am loved because I am smart. So next time, if the problem is hard and I get it wrong, I am not smart any more. Better avoid hard problems."))
#scene("Tình huống 3.1 · Thử nói cách khác")[
  #ba("Mười điểm luôn! Đưa ba coi nào. (Lật bài, coi kỹ.) Bài cuối này dài ghê, con làm sao ra vậy?", en: "A ten! Let me see. (Turns the pages, looks closely.) This last one is long. How did you work it out?")
  #con("Bài đó khó lắm ba. Con làm sai một lần, con gạch rồi làm lại nè.", en: "That one was really hard, Dad. I got it wrong once, crossed it out and did it again, see?")
  #ba("Ba thấy chỗ gạch rồi. Sai mà con không bỏ, con ngồi mò lại từ đầu. Cái đó ba thích còn hơn điểm mười.", en: "I see the crossing out. You got it wrong and didn't give up; you worked through it again from the start. I like that even more than the ten.")
  #con("Tại tuần trước con làm bài tập dạng này ba lần rồi.", en: "Because last week I did this kind of exercise three times.")
  #ba("À, vậy là điểm này không phải từ trên trời rớt xuống. Nó từ ba lần ngồi làm đó. Con thấy trong người sao?", en: "Ah, so this mark didn't fall from the sky. It came from those three practice sessions. How do you feel inside?")
  #con("Con thấy đã lắm!", en: "I feel great!")
  #ba("Nhớ cái cảm giác đã này nha. Nó là của con, con tự kiếm ra.", en: "Remember that feeling. It is yours; you earned it yourself.")
]
#hieusau1("Các nghiên cứu về lời khen cho thấy một điều đáng ngẫm: trẻ được khen thông minh có xu hướng chọn bài dễ ở lần sau để giữ danh hiệu, và dễ nản khi gặp bài khó. Trẻ được khen vì cách làm, vì sự cố gắng, vì dám làm lại thì ngược lại, các em chọn bài khó hơn và bền hơn khi vấp. Lý do đơn giản: thông minh là thứ con không điều khiển được, còn cố gắng thì con làm chủ.", en: "Research on praise points to something worth pondering: children praised for being smart tend to choose easier tasks next time to protect the label, and give up sooner when things get hard. Children praised for their method, their effort, their willingness to redo tend to choose harder tasks and last longer when they stumble. The reason is simple: smartness is not something a child can control; effort is.")
#cotloi("Khen thứ con làm chủ được: công sức, cách làm, sự kiên trì. Đừng khen thứ con chỉ có thể sợ mất: thông minh, giỏi nhất, số một.", en: "Praise what your child can control: effort, method, persistence. Do not praise what they can only fear losing: smart, the best, number one.")
#lamngay1("Hôm nay tìm một việc con làm, dù nhỏ, và khen theo công thức: Ba mẹ thấy con (làm việc cụ thể gì), nhờ vậy mà (kết quả gì). Ví dụ: Mẹ thấy con tự soạn cặp từ tối, nhờ vậy sáng nay cả nhà không ai phải hối.", en: "Today, find one thing your child did, however small, and praise it with this formula: I noticed you (specific action), and because of that (result). For example: I noticed you packed your bag last night, so this morning nobody had to rush.")
#caunoi("Ba thấy con làm sai rồi ngồi làm lại. Cái đó ba quý hơn điểm mười.", en: "I saw you get it wrong and then sit down to do it again. I value that more than the ten.")
#tusoi(("Mình hay khen con người của con (giỏi, ngoan, thông minh) hay khen việc con làm?", "Con mình có đang né những thứ khó vì sợ làm không giỏi không?",), en: ("Do I tend to praise who my child is (clever, good, smart) or what my child does?", "Is my child avoiding hard things for fear of not being good at them?",))

#sec("Con vẽ xấu mà hỏi mẹ thấy đẹp không", en: "The drawing is not good and your child asks if it is beautiful")
#boicanh("Bé Su lớp 2 vẽ cả buổi chiều, đem khoe mẹ một bức tranh mà mẹ nhìn mãi không biết là con gì. Con hỏi: đẹp không mẹ?", en: "Su, in grade 2, has been drawing all afternoon and brings Mum a picture Mum cannot make out at all. She asks: is it pretty, Mum?")
#phanxa("Đẹp lắm, đẹp lắm con. (Mắt vẫn nhìn điện thoại.)", "Mẹ không nhìn. Lời khen của mẹ là nói cho có. Mai mốt mẹ khen gì cũng không chắc là thật.", en: ("Very pretty, very pretty. (Eyes still on the phone.)", "Mum is not looking. Her praise is just noise. From now on I can't be sure anything she praises is true."))
#scene("Tình huống 3.2 · Thử nói cách khác")[
  #me("(Đặt điện thoại xuống, cầm tranh lên.) Ồ, nhiều màu ghê. Con kể mẹ nghe về bức này đi.", en: "(Puts the phone down, picks up the picture.) Oh, so many colours. Tell me about this one.")
  #con("Đây là con rồng. Nó đang bay qua cầu vồng để về nhà nó ở trên mây.", en: "This is a dragon. It's flying over a rainbow to get to its home in the clouds.")
  #me("À, đây là cánh nè. Mẹ thích chỗ con tô cái đuôi chuyển từ đỏ qua cam, nhìn giống như nó đang cháy.", en: "Ah, here are the wings. I like how you coloured the tail from red to orange; it looks like it's on fire.")
  #con("Tại nó phun lửa mà. Con tô ba lớp màu luôn đó.", en: "Because it breathes fire. I coloured three layers.")
  #me("Ba lớp, hèn gì nó đậm vậy. Con vẽ cái này lâu không?", en: "Three layers, no wonder it's so bold. Did this take you long?")
  #con("Lâu lắm. Mà cái đầu con vẽ chưa giống.", en: "Very long. But the head doesn't look right yet.")
  #me("Con thấy chưa giống chỗ nào?", en: "Which part doesn't look right to you?")
  #con("Cái miệng. Mai con coi hình rồng rồi vẽ lại.", en: "The mouth. Tomorrow I'll look at a dragon picture and draw it again.")
]
#hieusau1("Trẻ con không cần được khen đẹp bằng được nhìn thật. Một lời khen chung chung nói trong lúc mắt nhìn chỗ khác, con nhận ra ngay, và lâu dần con không còn tin lời khen của ba mẹ nữa. Mô tả cụ thể thứ mình thấy và hỏi con về nó là cách khen thật nhất mà không cần nói dối chữ nào. Con còn tự chỉ ra chỗ chưa ưng, tức là con đang học tự đánh giá, thứ quý hơn nhiều so với chờ người khác chấm.", en: "Children need to be truly seen more than they need to be called good. A vague compliment delivered with eyes elsewhere is recognised immediately, and over time the child stops trusting the parent's praise. Describing exactly what you see and asking about it is the most honest praise there is, without a single lie. The child even points out what she is not satisfied with, which means she is learning to evaluate herself, far more valuable than waiting for someone else's verdict.")
#cotloi("Không cần nói dối là đẹp. Chỉ cần nhìn thật kỹ, nói ra điều mình thấy, và hỏi con về nó.", en: "You do not need to lie and say it is beautiful. Look closely, say what you see, and ask your child about it.")
#lamngay1("Lần tới con khoe gì, đừng nói đẹp hay giỏi. Thử nói một chi tiết cụ thể mình thấy, rồi hỏi: Con thích chỗ nào nhất trong này?", en: "Next time your child shows you something, do not say pretty or good. Name one specific detail you notice, then ask: Which part do you like best?")
#caunoi("Kể mẹ nghe về bức này đi. Con thích chỗ nào nhất?", en: "Tell me about this one. Which part do you like best?")
#tusoi(("Mình có hay khen cho xong để con đi chỗ khác không?", "Con mình thường tự nhận xét việc mình làm, hay luôn chờ người lớn phán?",), en: ("Do I often praise just to finish the moment so my child will go away?", "Does my child comment on their own work, or always wait for an adult's verdict?",))

#sec("Con nhà người ta", en: "Other people's children")
#boicanh("Họp phụ huynh về, mẹ mang theo bảng xếp hạng. Con trai chị Lan cùng dãy trọ đứng thứ ba, con mình thứ hai mươi tám. Vừa thấy thằng Tuấn lớp 8 đang nằm coi điện thoại, mẹ nghẹn ở cổ.", en: "Mum comes back from the parents' meeting with the class ranking. Mrs Lan's son from the same row of rented rooms is third; her own son is twenty-eighth. Seeing Tuan, grade 8, lying there with his phone, she feels it rise in her throat.")
#phanxa("Con coi thằng Huy kìa, nhà nó còn khổ hơn nhà mình mà học đứng thứ ba. Con thì chỉ được cái ăn với chơi.", "Mẹ ước gì Huy là con mẹ. Mình là đứa làm mẹ thất vọng. Mà đã vậy thì cố làm gì.", en: ("Look at Huy. His family is poorer than ours and he's third in class. All you are good at is eating and playing.", "Mum wishes Huy were her son. I am her disappointment. So why bother trying."))
#scene("Tình huống 3.3 · Thử nói cách khác")[
  #me("(Để tờ giấy xuống bàn, ngồi cạnh con.) Mẹ họp về rồi. Mẹ nói thật là mẹ đang lo, nhưng mẹ không muốn la. Mẹ muốn hiểu.", en: "(Puts the paper on the table, sits next to him.) I'm back from the meeting. Honestly, I'm worried, but I don't want to scold. I want to understand.")
  #con("Con biết rồi. Hạng hai mươi tám chứ gì. Mẹ định so con với thằng Huy nữa hả?", en: "I know. Twenty-eighth. Are you going to compare me with Huy again?")
  #me("Trước giờ mẹ so hoài, mẹ biết. Mẹ so xong con có học khá hơn chút nào đâu, chỉ thấy hai mẹ con xa nhau thêm. Nên hôm nay mẹ không so nữa. Mẹ chỉ so con với con thôi: học kỳ trước Toán con 5, kỳ này 6 rưỡi. Con làm gì khác vậy?", en: "I've done that for years, I know. And after all my comparing you did not study any better; we only grew further apart. So today I'm not comparing. I'll only compare you with you: last term you got 5 in maths, this term 6.5. What did you do differently?")
  #con("...Con ngồi gần thằng Đạt, nó chỉ con mấy bài hình.", en: "...I sit near Dat. He explained some geometry problems to me.")
  #me("Vậy là có người giảng lại thì con vô. Còn môn nào con thấy đang đuối nhất?", en: "So when someone explains it again, it goes in. Which subject feels hardest right now?")
  #con("Anh văn. Con mất gốc từ lớp 6 rồi. Vô lớp con không hiểu cô nói gì hết.", en: "English. I've been lost since grade 6. In class I don't understand anything the teacher says.")
  #me("Ngồi cả tiết mà không hiểu gì thì cực lắm. Mẹ không biết chuyện đó. Mình tính coi gỡ lại từ chỗ nào nha.", en: "Sitting through a whole lesson understanding nothing must be awful. I didn't know that. Let's work out where to start untangling it.")
]
#hieusau1("Ba mẹ so sánh vì mong con nhìn gương mà cố. Nhưng đứa trẻ bị so không nhìn thấy tấm gương, nó chỉ thấy mình bị xếp dưới một đứa khác trong lòng ba mẹ. Phản ứng thường gặp là ghét luôn đứa kia, hoặc buông xuôi để khỏi phải đua một cuộc đua mình biết chắc thua. So con với chính con của tháng trước thì khác hẳn: cuộc đua đó con thắng được, và mỗi bước tiến nhỏ đều được nhìn thấy.", en: "Parents compare hoping the child will look at the example and try. But a compared child does not see an example; they see themselves ranked below another child in their parent's heart. The usual reaction is to hate the other child, or to give up so as not to run a race they are sure to lose. Comparing a child with who they were last month is entirely different: that race can be won, and every small step forward is seen.")
#cotloi("So con với đứa khác, con học được cách ghét bạn và ghét mình. So con với chính con hôm qua, con học được cách đi tới.", en: "Compare your child with another and they learn to dislike the friend and themselves. Compare them with who they were yesterday and they learn to move forward.")
#lamngay1("Tối nay tìm một thứ con đã tiến bộ so với sáu tháng trước, bất kể là gì: tự dậy, bớt cãi, lên được nửa điểm, biết phụ nấu cơm. Nói cho con nghe cụ thể, không kèm chữ nhưng.", en: "Tonight, find one thing your child has improved in compared with six months ago, whatever it is: getting up alone, arguing less, half a mark higher, helping cook. Tell them specifically, with no but.")
#caunoi("Mẹ không so con với ai hết. Mẹ chỉ nhìn con hôm nay với con hồi trước.", en: "I am not comparing you with anyone. I am only looking at you today and you before.")
#tusoi(("Hồi nhỏ mình bị so với ai? Giờ nghĩ tới người đó mình thấy gì?", "Nếu con đem mình ra so với ba mẹ của bạn nó, mình sẽ thấy sao?",), en: ("Who was I compared with as a child? What do I feel now when I think of that person?", "If my child compared me with their friends' parents, how would I feel?",))

#sec("Phải chê thì chê sao cho con còn muốn sửa", en: "When you must criticise, do it so they still want to improve")
#boicanh("Con bé Trâm lớp 7 nhận trực nhật nấu cơm chiều. Cơm nhão, canh mặn, bếp bừa như bãi chiến trường, vỏ trứng còn nằm trong bồn. Ba đi làm về, đói, nhìn cái bếp.", en: "Tram, in grade 7, is on dinner duty. The rice is mushy, the soup salty, the kitchen looks like a battlefield, eggshells still in the sink. Dad comes home hungry and looks at the kitchen.")
#phanxa("Con gái con đứa gì mà nấu bữa cơm cũng không xong. Bày ra vầy ai dọn?", "Mình vụng về, vô dụng. Cố làm rồi cũng bị chê. Lần sau không nhận nấu nữa cho khỏi nghe la.", en: ("What kind of daughter can't even cook a meal properly? Who is going to clean up this mess?", "I am clumsy and useless. I tried and still got criticised. Next time I won't offer to cook, so I won't be scolded."))
#scene("Tình huống 3.4 · Thử nói cách khác")[
  #ba("(Ăn một chén trước đã.) Hôm nay con nấu một mình hết hả? Món trứng chiên này vừa ăn, ba thích.", en: "(Eats a bowl first.) Did you cook all of this alone today? This fried egg is just right; I like it.")
  #con("Dạ. Mà cơm con nấu bị nhão, canh thì con lỡ tay.", en: "Yes. But the rice came out mushy and I slipped with the soup.")
  #ba("Ừ, cơm hơi nhão, canh hơi mặn, ba ăn ra. Con tự biết liền là giỏi rồi. Theo con thì tại khâu nào?", en: "True, the rice is a bit soft and the soup a bit salty; I can taste it. You noticed straight away, which is good. Where do you think it went wrong?")
  #con("Cơm chắc tại con đong nước theo gạo cũ. Canh thì con nêm xong không nếm.", en: "The rice, I think I measured water the way we do for the old rice. And the soup, I seasoned it and didn't taste.")
  #ba("Vậy là con có hai bài học rồi đó, không cần ba nói. Còn một chuyện ba cần nói thẳng: cái bếp. Vỏ trứng trong bồn, chảo chưa rửa. Nấu xong mà bếp vầy thì chưa xong việc.", en: "Then you already have two lessons without my saying anything. There is one thing I do need to say directly: the kitchen. Eggshells in the sink, pan unwashed. Cooking is not finished while the kitchen looks like this.")
  #con("Tại con nấu xong mệt quá.", en: "I was so tired after cooking.")
  #ba("Ba hiểu, nấu một mình là mệt thiệt. Vậy lần sau con thử vừa nấu vừa dọn, chờ nước sôi thì rửa cái thớt. Giờ ăn xong ba rửa chén, con lau bếp, mười phút là sạch.", en: "I understand; cooking alone really is tiring. Next time try cleaning as you cook: wash the chopping board while the water boils. After we eat, I'll wash the dishes and you wipe the counters; ten minutes and it's clean.")
]
#hieusau1("Lời chê nhắm vào con người, vụng, lười, hư, không cho con đường nào để sửa, vì con không thể thôi là chính mình. Lời góp ý nhắm vào một việc cụ thể thì có lối ra rõ ràng. Thứ tự cũng quan trọng: ghi nhận điều làm được trước, để con tự nói ra điều chưa được, rồi ba mẹ mới bổ sung điều con chưa thấy. Đứa trẻ tự nói ra lỗi của mình sẽ sửa nó nhanh hơn đứa bị chỉ mặt.", en: "Criticism aimed at the person, clumsy, lazy, bad, leaves no path to improvement, because a child cannot stop being themselves. Feedback aimed at one specific task has a clear way out. Order matters too: acknowledge what worked, let the child name what did not, and only then add what they missed. A child who names their own mistake fixes it faster than one who has it pointed out.")
#cotloi("Chê việc, không chê người. Và để con tự nói ra chỗ chưa được trước khi ba mẹ nói.", en: "Criticise the work, not the person. And let your child name what went wrong before you do.")
#lamngay1("Lần tới cần góp ý, bắt đầu bằng câu hỏi: Con thấy chỗ nào làm được, chỗ nào lần sau muốn làm khác? Nghe hết rồi mới thêm đúng một điều mình thấy quan trọng nhất. Một điều thôi.", en: "Next time you need to give feedback, begin with a question: What do you think went well, and what would you do differently next time? Listen to it all, then add exactly one thing you think matters most. Only one.")
#caunoi("Việc này chưa ổn, mình sửa được. Còn con thì ba không chê.", en: "This job isn't right yet, and we can fix it. I am not criticising you.")
#tusoi(("Lời chê nào của ba mẹ ngày xưa tới giờ mình vẫn còn nhớ nguyên văn?", "Mình góp ý cho đồng nghiệp ra sao? Có khác nhiều so với cách mình nói với con không?",), en: ("Which criticism from my own parents do I still remember word for word?", "How do I give feedback to a colleague? Is it very different from how I speak to my child?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 3: mang theo bên mình]
#doicau1((("Con giỏi quá, thông minh quá!", "Con ngồi làm tới cùng luôn. Kể mẹ nghe con làm cách nào.", "You're so good, so smart!", "You stuck with it to the end. Tell me how you did it."), ("Sao con không được như bạn Huy?", "Kỳ này con hơn kỳ trước ở chỗ nào? Chỗ nào còn kẹt?", "Why can't you be like Huy?", "Where are you ahead of last term? Where are you still stuck?"), ("Con lúc nào cũng ẩu, cũng lười.", "Bài này con làm vội nên sai hai chỗ. Mình coi lại hai chỗ đó.", "You are always careless, always lazy.", "You rushed this one and got two parts wrong. Let's look at those two parts."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Khen cụ thể, khen công sức, khen ngay lúc thấy. Một lời khen đúng và thật nặng ký hơn mười lời khen quen miệng.", "Hai chữ luôn luôn và không bao giờ biến một lỗi thành một bản án. Con luôn luôn bừa bộn nghe khác hẳn với hôm nay phòng con bừa.", "Đừng khen con trước mặt anh chị em theo kiểu ngầm chê đứa còn lại. Đứa được khen cũng không vui nổi.",), en: ("Praise specifically, praise effort, praise at the moment you see it. One accurate, sincere compliment outweighs ten automatic ones.", "The words always and never turn a mistake into a verdict. You are always messy sounds very different from your room is messy today.", "Do not praise one child in front of siblings as a hidden criticism of the other. Even the praised child cannot enjoy it.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày không dùng câu con nhà người ta, dưới mọi hình thức. Mỗi ngày nói với mỗi đứa con một điều cụ thể ba mẹ thấy con làm được. Ghi lại phản ứng của con vào ngày thứ bảy.",), mark: sym.star.filled, en: ("Seven days without the phrase other people's children, in any form. Each day tell each child one specific thing you saw them do well. On day seven, note how they respond.",))
