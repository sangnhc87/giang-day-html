#import "../template.typ": *

#chapter-open(1, "Nói chuyện riêng và mất trật tự", 1, "Một hình phạt hay là hình phạt mà học sinh kể lại cho bạn nghe và còn mỉm cười, nhưng lần sau vẫn nhớ không làm.", "Mỗi tiết học thầy cô đều gặp những chuyện rất nhỏ: hai em thì thầm, một em quay xuống, cả lớp rộ lên cười. Phạt nặng thì thấy dư, mà bỏ qua thì lớp trôi mất. Chương này gom những chiêu phạt ngắn, vui, riêng tư, không làm ai mất mặt, và quan trọng nhất là biến lỗi thành một việc có ích. Mỗi chiêu đi kèm lý do vì sao nó có tác dụng và ranh giới để thầy cô biết dừng ở đâu.", ("Hai em thì thầm suốt tiết", "Cả lớp rộ lên cười và không dừng được", "Một bạn quay xuống chọc bạn phía sau", "Một em cứ đứng lên đi lại giữa giờ", "Một em nói leo, chen vào mọi câu",))

#sec("Hai em thì thầm suốt tiết")
#tinhhuong("1.1", "Hai em thì thầm suốt tiết", "Hai em ngồi cuối lớp nói chuyện riêng gần hết tiết. Thầy nhắc hai lần, em nào cũng dạ rồi năm phút sau lại thì thầm. Hai em không ồn lắm, nhưng cứ lấn dần sự tập trung của những bạn xung quanh.")
#chieu("Mười phút thả ga", "Cuối tiết, thầy mời hai em ở lại ba phút đầu giờ ra chơi. Thầy nói: hai em có nhiều chuyện để nói như vậy, thầy cho hai em đúng ba phút để nói hết, nói thả ga, thầy bấm giờ. Hết ba phút thì đủ. Hai em vừa được nói, vừa nhận ra mình đang trả một món nợ thời gian mà mình đã lấy của cả lớp. Có thể thêm một dòng: lần sau còn chuyện cần nói thì hai em ghi ra giấy, ra chơi thầy nghe đại diện.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hai em ở lại giúp thầy ba phút nha. Thầy không giận, thầy chỉ muốn nghe hai em nói hết chuyện chưa xong. Bắt đầu nhé, ba phút.")
  #tro("Dạ... thầy cho tụi em nói luôn hả thầy?")
  #thay("Nói luôn. Ba phút nói thật nhiều. Hết giờ thầy xin lại sự tập trung của hai em trong tiết sau, được không?")
]
#visao("Học sinh nói chuyện riêng vì có chuyện thật muốn nói và không chờ được. Chiêu này công nhận nhu cầu đó, rồi gắn một giới hạn thời gian cụ thể cho nó. Hai em không bị mất mặt trước lớp, và khi được cho phép nói thoải mái, phần lớn các em tự thấy ngượng và dừng lại sớm trước khi hết ba phút.")
#ranhgioi("Không phạt trước cả lớp. Không hỏi chuyện hai em nói là gì. Nếu hai em nói chuyện vì một chuyện nghiêm trọng như bạn bè xích mích hay có chuyện ở nhà, đừng cho đây là hình phạt nữa mà chuyển thành một cuộc trò chuyện thật.")
#bientau("Nếu em ngại ở lại, đổi thành: hai em xếp lại ghế và bàn đầu giờ ra chơi, vừa nói vừa làm cũng được. Hoặc cho hai em tự chọn một trong hai: ba phút nói thả ga, hoặc ba phút im lặng đúng nghĩa trong tiết sau.")
#caunoi("Thầy hiểu hai em có nhiều chuyện để nói. Thầy cho hai em thời gian để nói hết, rồi tới giờ học thì mình học.")

#sec("Cả lớp rộ lên cười và không dừng được")
#tinhhuong("1.2", "Cả lớp rộ lên cười và không dừng được", "Một bạn vô tình nói một câu hài hước giữa tiết, cả lớp cười rộ. Thầy chờ, nhưng tiếng cười cứ kéo dài, có em còn nhắc lại câu đó để cười thêm. Tiết học đang đà tốt bị cắt ngang.")
#chieu("Ba mươi giây cười có kiểm soát", "Thầy mỉm cười: câu đó đúng là buồn cười, thầy cho cả lớp đúng ba mươi giây cười thật to, thầy bấm giờ. Hết giờ, thầy giơ tay: dừng. Lớp sẽ cười thêm nhưng yếu dần. Thầy nói: cảm ơn cả lớp, giờ mình học tiếp. Nếu có em còn cười, thầy chỉ nhắc nhẹ: còn nợ thầy mười giây.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Câu đó đáng được cười. Ba mươi giây, bắt đầu! ... Hết. Cảm ơn cả lớp, giờ mình trở lại bài.")
]
#visao("Tiếng cười không dập được bằng lệnh im lặng, càng cấm càng nổ. Cho phép nó trong một khung giờ rõ ràng biến nó thành thứ thầy điều khiển được. Cả lớp cũng thấy thầy là người có khiếu hài, và sẽ hợp tác hơn lần sau.")
#ranhgioi("Không cho cười nếu tiếng cười nhắm vào một bạn cụ thể với ý chê bai. Khi đó dừng ngay và nói riêng với người bị cười.")
#bientau("Dùng trò chơi nhỏ để cười xong rồi tập trung: cả lớp hít sâu ba lần, rồi mới đọc tiếp câu đề bài.")
#caunoi("Cười một chút cho đã rồi mình học tiếp.")

#sec("Một bạn quay xuống chọc bạn phía sau")
#tinhhuong("1.3", "Một bạn quay xuống chọc bạn phía sau", "Bạn Nam ngồi bàn trên cứ quay xuống chọc bút, nhéo áo bạn phía sau. Bạn bị chọc đã nhắc nhở nhiều lần mà bạn Nam vẫn cười và tiếp tục. Nhìn thì vui nhưng bạn phía sau bắt đầu bực.")
#chieu("Đổi vai năm phút", "Cuối tiết thầy gọi riêng Nam: tiết sau thầy cho em một nhiệm vụ đặc biệt, em đóng vai người bị chọc. Em ngồi ở bàn cuối, bạn bên cạnh sẽ làm chính xác điều em đã làm với bạn kia trong năm phút, rồi hai em kể cho thầy nghe cảm giác. Thầy dùng một bạn tình nguyện khác, không phải bạn từng bị chọc, để tránh làm bạn đó thêm ngại.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Nam, thầy không trách em. Thầy muốn em thử một việc: ngồi vào chỗ bạn bị chọc và kể thầy nghe cảm giác khi bị chọc như vậy liên tục.")
  #tro("Dạ... chắc là khó chịu thầy.")
  #thay("Khó chịu thế nào? Em tả thầy nghe.")
]
#visao("Trò chọc bạn thường xuất phát từ chán và muốn tương tác chứ không từ ác ý. Cho em thử vai ngược giúp em tự thấy tác động, thay vì nghe thầy giảng về sự tôn trọng. Em tự rút ra điều cần sửa nên không phản kháng.")
#ranhgioi("Không dàn dựng để em bị chọc quá mức hay bị chọc đau. Mỗi lần chọc chỉ nhẹ, đúng bằng điều em đã làm. Nếu thấy em chọc vì mâu thuẫn thật với bạn kia, chuyển sang hòa giải.")
#bientau("Thay vì đổi vai, cho Nam viết ba dòng: bạn bị chọc có thể đang cảm thấy gì, và em sẽ làm khác thế nào. Rồi hai em bắt tay.")
#caunoi("Thầy muốn em thử ngồi vào chỗ của bạn năm phút rồi kể thầy nghe cảm giác.")

#sec("Một em cứ đứng lên đi lại giữa giờ")
#tinhhuong("1.4", "Một em cứ đứng lên đi lại giữa giờ", "Bạn Hải ngồi không yên, cứ vài phút lại đứng lên lấy cục tẩy, đi mượn bút, ra thùng rác. Thầy nhắc ngồi xuống thì em dạ, một lúc sau lại đứng. Không phải em cố tình phá, em chỉ không chịu được việc ngồi yên.")
#chieu("Chức vụ có đi lại", "Thầy giao cho Hải một chức vụ chính thức: Trưởng ban phát và thu. Mỗi tiết em có hai lần được đứng lên đúng việc: phát tờ bài tập đầu giờ và thu bài cuối giờ. Ngoài hai lần đó, em ngồi tại chỗ. Thầy ghi vào sổ cái chức vụ của em kèm tên lớp phó để em thấy mình được tin.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy để ý em cần cử động nhiều hơn người khác. Thầy cho em một chức vụ: phát và thu bài. Hai lần mỗi tiết em được đứng thoải mái. Còn lại em giữ chỗ cho thầy, được không?")
  #tro("Dạ được thầy! Em làm được.")
]
#visao("Một số em cần vận động để tập trung, không phải vì hư. Biến nhu cầu đó thành một vai trò chính thức giữ được em trong lớp và đổi cách nhìn của cả lớp về em. Em đi lại có lý do, có giờ, có sự tin tưởng.")
#ranhgioi("Nếu em liên tục không ngồi yên ở mọi môn, mọi buổi, kéo dài nhiều tháng, hãy gợi ý ba mẹ trao đổi với chuyên viên về khả năng tăng động giảm chú ý. Không phạt thêm cho hành vi đó.")
#bientau("Cho em một món nhỏ cầm trong tay khi ngồi, như cục bóp tay hoặc dây chun, miễn không gây ồn.")
#caunoi("Thầy giao em một nhiệm vụ cần đi lại. Em giúp thầy được không?")

#sec("Một em nói leo, chen vào mọi câu")
#tinhhuong("1.5", "Một em nói leo, chen vào mọi câu", "Bạn Linh lúc nào cũng nói trước khi thầy hỏi xong, cắt lời bạn khác, đôi khi trả lời cả câu hỏi thầy dành cho bạn kia. Em hăng hái thật sự, nhưng các bạn đã bắt đầu ngại giơ tay.")
#chieu("Ba cây gậy lời", "Thầy phát cho Linh ba cây que nhỏ đầu tiết. Mỗi lần em nói không giơ tay, thầy lặng lẽ lấy lại một cây. Còn que cuối tiết thì em được một điểm cộng nhỏ cho sự hăng hái. Hết que thì em được thầy mời im lặng mười phút và ghi lại ý định nói của mình ra vở để lát thầy gọi. Em vừa được nói, vừa tập kiên nhẫn.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Thầy rất quý sự hăng hái của em. Em giúp thầy để các bạn khác cũng có cơ hội nói. Em có ba cây que, mỗi lần nói leo là thầy lấy lại một cây, được không?")
  #tro("Được ạ. Chắc em sẽ cố gắng giữ que.")
]
#visao("Nói leo là dấu hiệu của sự nhiệt tình, nên cần uốn nắn chứ không dập. Thứ có tác dụng là hệ thống nhìn thấy được, có thể tự theo dõi, và khen nhiều hơn phạt. Em đo được tiến bộ của mình bằng số que còn lại.")
#ranhgioi("Không khen em bằng cách mỉa mai độ hăng. Không cho cả lớp biết số que của em. Đây là thỏa thuận riêng giữa thầy và em.")
#bientau("Cho em quyền gọi bạn khác trả lời trước một lần mỗi tiết, để em học nhường lượt như một kỹ năng, không phải hình phạt.")
#caunoi("Thầy cần em giữ sự hăng hái đó, và để các bạn cũng được nói. Mình thử với ba cây que nhé.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 1: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Chiêu phạt hay có bốn điểm chung: ngắn, riêng tư, gắn với đúng lỗi, và kết thúc bằng một việc có ích hoặc một nụ cười.", "Hỏi trước khi phạt: em này đang thiếu gì, mệt gì, muốn gì? Hành vi chỉ là phần nổi.", "Không phạt tập thể cho lỗi của một người. Học sinh tha thứ cho nghiêm khắc nhưng không tha thứ cho bất công.",))
