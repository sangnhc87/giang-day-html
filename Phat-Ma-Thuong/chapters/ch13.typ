#import "../template.typ": *

#chapter-open(13, "Những lúc không phạt: khi em đang có chuyện", 13, "Có những lúc câu trả lời thông minh nhất của thầy cô là: hôm nay thầy không phạt, thầy hỏi thăm.", "Sau mười hai chương chiêu phạt, chương này nói điều ngược lại. Hành vi sai có khi không đáng bị phạt, mà đáng được hỏi han. Em khóc, em bất thường, em sai vì nhà có chuyện, em tự nhận lỗi, đều là những lúc phạt sẽ làm hỏng nhiều hơn xây. Hơn nữa, có những lúc chính thầy cô là người lỡ nặng lời. Chương này dạy phân biệt khi nào dùng chiêu phạt, khi nào dùng chiêu không phạt.", ("Em đang khóc, đang rất không ổn", "Em tự nhận lỗi trước khi thầy hỏi", "Em liên tục mắc lỗi vì nhà có chuyện", "Em hư để gây chú ý", "Thầy lỡ nặng lời với em",))

#sec("Em đang khóc, đang rất không ổn")
#tinhhuong("13.1", "Em đang khóc, đang rất không ổn", "Thầy nhắc Phương mấy lần vì không làm bài, em ngồi im. Thầy tiến lại thì thấy mắt em đỏ và nước mắt rơi xuống tập vở. Em không nói gì. Cả lớp bắt đầu nhìn.")
#chieu("Phiếu miễn phạt", "Thầy giữ một chồng phiếu miễn phạt, mỗi học sinh có hai phiếu mỗi học kỳ. Thầy đặt nhẹ một tấm lên bàn em và nói thật khẽ: hôm nay em dùng phiếu này, thầy không nhắc chuyện bài nữa. Em ra ngoài rửa mặt nếu muốn. Cuối giờ thầy hỏi thăm riêng. Phiếu này không cần giải thích, không cần xin. Em biết rằng khi hôm nay không ổn thì có một lối thoát.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Khẽ.) Phương, hôm nay em dùng phiếu miễn phạt này nhé. Thầy không nhắc bài nữa. Em ra rửa mặt nếu muốn, thầy chờ.")
  #tro("(Gật đầu, nước mắt rơi.) Dạ...")
  #thay("Cuối giờ nếu em muốn nói, thầy ở đó. Không muốn cũng không sao.")
]
#visao("Phạt một em đang khóc là dùng đòn trên người đã ngã. Phiếu miễn phạt cho em một quyền hợp pháp để không ổn mà không mất mặt. Em nhớ sự tử tế này lâu hơn mọi bài học trong tiết đó.")
#ranhgioi("Phiếu không phải để lạm dụng, nhưng nếu em dùng sạch phiếu sớm, đó là dấu hiệu em cần được quan tâm nhiều hơn. Không hỏi dồn nguyên nhân khi em đang khóc. Nếu có dấu hiệu em nguy cơ tự hại, báo gia đình và nhà trường ngay.")
#bientau("Đặt trên bàn thầy một hộp khăn giấy mà ai cần thì lấy, không cần hỏi.")
#caunoi("Hôm nay em dùng phiếu miễn phạt nhé. Thầy không nhắc bài, em cần gì thầy ở đây.")

#sec("Em tự nhận lỗi trước khi thầy hỏi")
#tinhhuong("13.2", "Em tự nhận lỗi trước khi thầy hỏi", "Sau giờ ra chơi, Tấn bước lên bàn thầy: thầy ơi, em làm vỡ cái bình hoa ở cuối lớp. Em đứng đó, tay run. Thầy biết em dũng cảm lắm mới nói ra.")
#chieu("Thưởng người dám nói", "Thầy dừng việc đang làm, nhìn em, nói chậm: cảm ơn em đã nói. Để thầy nói thật, thầy vui vì em trung thực nhiều hơn là tiếc cái bình. Thầy hỏi: em có bị đứt tay không? Cái bình thầy xử lý, em chỉ cần cùng thầy dọn mảnh vỡ. Thầy không phạt thêm. Thầy giữ một cái nháy mắt riêng: lần sau em cứ nói thật như vậy.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Cảm ơn em đã nói. Thầy vui vì em trung thực nhiều hơn tiếc cái bình. Em có bị đứt tay không? Mình cùng dọn nhé, không phạt gì thêm.")
  #tro("Dạ... em tưởng thầy sẽ giận.")
  #thay("Thầy không giận. Người dám nhận lỗi là người thầy tin.")
]
#visao("Phạt người nhận lỗi là dạy em lần sau giấu. Khen sự trung thực và bỏ hình phạt dạy em rằng nói thật không đau. Một em được trọng khi nhận lỗi sẽ nhận lỗi cả đời.")
#ranhgioi("Phải nhất quán, không phạt em này mà phạt em khác cho lỗi tương tự khi họ không tự nhận. Nếu lỗi lớn, vẫn xử lý theo quy định nhưng giảm nhẹ theo thái độ. Không khen quá nhiều làm em thấy cần làm sai để được khen.")
#bientau("Mở sổ ghi những lần em nhận lỗi trung thực, cuối năm trao thiệp cảm ơn.")
#caunoi("Cảm ơn em đã nói, thầy vui vì sự trung thực nhiều hơn tiếc cái bình.")

#sec("Em liên tục mắc lỗi vì nhà có chuyện")
#tinhhuong("13.3", "Em liên tục mắc lỗi vì nhà có chuyện", "Thầy để ý Bình dạo này trễ bài, hay ngủ gật, cáu gắt với bạn. Một em khác kể nhỏ rằng ba mẹ em đang chuyển ra ở riêng. Em chưa nói gì với thầy.")
#chieu("Sổ ba dòng", "Thầy không hỏi thẳng chuyện nhà. Thầy đặt trước mặt em một cuốn sổ nhỏ và nói: mỗi sáng em có thể viết ba dòng: hôm nay em thế nào, điều gì khó, điều gì thầy có thể giúp. Chỉ có thầy đọc. Thầy trả lời bằng một dòng, không bình luận nhiều. Những lỗi nhỏ trong thời gian này thầy lặng lẽ không tính và theo dõi. Khi em sẵn sàng, em tự mở lời.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Bình, thầy có một cuốn sổ nhỏ cho em. Mỗi sáng em có thể viết ba dòng: hôm nay em thế nào, điều gì khó, điều gì thầy giúp được. Chỉ thầy đọc.")
  #tro("Dạ... em cầm được ạ.")
  #thay("Em viết gì cũng được. Thầy chỉ đọc và trả lời một dòng thôi.")
]
#visao("Em đang gánh chuyện lớn nên các lỗi nhỏ chỉ là dấu hiệu. Phạt thêm là thêm gánh nặng. Cuốn sổ cho em một cách nói khi miệng chưa nói được, và thầy giữ vai trò người nghe an toàn.")
#ranhgioi("Không ép em kể chuyện gia đình. Không bàn tán với đồng nghiệp ngoài những người cần biết như nhà trường và bộ phận tâm lý. Nếu có dấu hiệu em gặp nguy hiểm hay bạo hành, báo ngay cho những người có trách nhiệm.")
#bientau("Khi em chưa muốn viết, đổi thành ba biểu tượng mặt cười, mặt buồn, mặt bình thường.")
#caunoi("Em viết cho thầy ba dòng mỗi sáng nhé. Chỉ thầy đọc, thầy ở đây.")

#sec("Em hư để gây chú ý")
#tinhhuong("13.4", "Em hư để gây chú ý", "Cường luôn là em nghịch nhất lớp: nói lớn, trêu bạn, chọc thầy. Phạt đủ cách đều không giảm. Có vẻ em càng bị phạt càng nghịch. Thầy chợt nghĩ em đang thiếu điều gì.")
#chieu("Bắt gặp em làm tốt", "Thầy đảo ngược chiến lược. Thầy đặt một mục tiêu bí mật: mỗi ngày bắt gặp Cường làm một điều tốt và nói riêng cho em biết. Có thể là em đưa bút cho bạn, em đến đúng giờ, em trả lời đúng. Thầy chỉ nói riêng, một câu ngắn: thầy thấy em vừa làm việc tốt. Sau vài tuần, em được chú ý qua việc tốt nên giảm hẳn việc nghịch để gây chú ý.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Riêng, sau tiết.) Cường, hôm nay thầy thấy em đưa bút cho bạn mà không ai bảo. Thầy thấy em tốt bụng.")
  #tro("Dạ... thầy thấy thật hả thầy?")
  #thay("Thấy thật. Thầy thấy nhiều lắm, chỉ là chưa nói thôi.")
]
#visao("Em nghịch để được chú ý, và nếu việc xấu là cách duy nhất được chú ý, em sẽ làm tiếp. Chuyển sự chú ý sang việc tốt cho em con đường tốt hơn để đạt cùng mục tiêu. Sự khen riêng tư cũng làm em tin vào lời khen.")
#ranhgioi("Khen phải thật, không bịa. Không dùng khen như giải thưởng khiến em diễn. Vẫn giữ giới hạn rõ cho hành vi sai, không bỏ phạt hoàn toàn.")
#bientau("Mời em làm trợ lý cho một việc nhỏ của thầy, để việc tốt có chỗ thể hiện.")
#caunoi("Hôm nay thầy thấy em làm một việc tốt, thầy muốn em biết là thầy thấy.")

#sec("Thầy lỡ nặng lời với em")
#tinhhuong("13.5", "Thầy lỡ nặng lời với em", "Giữa tiết, vì quá mệt và nóng, thầy quát Dũng: em có biết điều không hả! Cả lớp im. Dũng cúi đầu, mắt đỏ. Thầy nhận ra mình vừa nói quá. Sau tiết, thầy ngồi một mình nghĩ lại.")
#chieu("Thầy tự nhận phạt", "Hôm sau, đầu giờ, thầy xin phép cả lớp nói một điều. Thầy nói thẳng: hôm qua thầy nặng lời với một bạn, thầy sai. Thầy xin lỗi bạn ấy trước lớp, hoặc riêng nếu bạn thích. Thầy tự phạt mình: thầy làm giúp bạn trực nhật một hôm hay kể một chuyện thầy từng sai. Cả lớp thấy thầy cũng sai, thầy dám nhận, và uy tín thầy tăng chứ không giảm.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Dũng, hôm qua thầy nặng lời với em. Thầy sai. Thầy xin lỗi em. Thầy không biện hộ, chỉ muốn em biết thầy không nghĩ như câu thầy đã nói.")
  #tro("(Im một lúc.) Dạ... em cảm ơn thầy.")
  #thay("Thầy nợ em một điều. Em nói thầy muốn thầy làm gì để bù, thầy sẽ làm.")
]
#visao("Học sinh nhớ cách thầy cô nhận lỗi lâu hơn nhớ lỗi của thầy cô. Một lời xin lỗi thật dạy cả lớp về trách nhiệm, và đem lại cho Dũng sự công bằng. Thầy cô cũng cần quyền được sai và sửa.")
#ranhgioi("Không xin lỗi cho xong rồi lặp lại. Không đổ lỗi gián tiếp như thầy xin lỗi nhưng em cũng có phần. Không để lời xin lỗi thành gánh nặng bắt em phải tha thứ ngay.")
#bientau("Giữ thói quen tự đánh giá cuối tuần: tuần này thầy có lúc nào nặng lời không, và sửa thế nào.")
#caunoi("Hôm qua thầy nặng lời, thầy sai. Thầy xin lỗi em.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 13: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Trước khi chọn chiêu phạt, tự hỏi ba câu: hôm nay em có ổn không, lỗi này có thật sự cần phạt không, và nếu phạt thì em học được gì.", "Phiếu miễn phạt, sổ ba dòng, câu bắt gặp em làm tốt là những chiêu không phạt mạnh hơn hầu hết các chiêu phạt.", "Thầy cô xin lỗi em đúng cách là bài học đạo đức lớn nhất trong năm. Đừng bỏ cơ hội đó.",))
