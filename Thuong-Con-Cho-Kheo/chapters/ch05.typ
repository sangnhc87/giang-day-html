#import "../template.typ": *

#chapter-open(5, "Lười học, trì hoãn, mất gốc: đừng vội gọi con là lười", 5, "Chữ lười là cái nhãn người lớn dán lên một chuyện mình chưa kịp hiểu.", "Rất ít đứa trẻ lười thật. Đứa nằm ườn không chịu ngồi vô bàn có thể đang sợ một môn nó không còn hiểu gì. Đứa để tới phút chót có thể không biết bắt đầu từ đâu. Đứa nói chán học có thể đang kiệt sức. Chữ lười gom hết những chuyện đó vào một giỏ, rồi kê chung một toa là la mắng. Chương này mở cái giỏ ra, coi từng thứ bên trong.", ("Nhắc mười lần con vẫn chưa ngồi vô bàn", "Con nói con mất gốc rồi, học cũng vô ích", "Con để tới sát giờ mới làm", "Con nói con không muốn đi học nữa",), en: ("Laziness, procrastination, lost foundations: do not rush to call it lazy", "Lazy is a label adults stick on something they have not yet understood.", "Truly lazy children are rare. The one sprawled out refusing to sit at the desk may be afraid of a subject they no longer understand. The one who leaves everything to the last minute may not know where to start. The one who says school is boring may be exhausted. The word lazy throws all of these into one basket and prescribes the same medicine: scolding. This chapter opens the basket and looks at what is inside.", ("Ten reminders and still not at the desk", "Your child says the foundations are gone and studying is pointless", "Your child leaves everything to the last minute", "Your child says they do not want to go to school any more",)))

#sec("Nhắc mười lần con vẫn chưa ngồi vô bàn", en: "Ten reminders and still not at the desk")
#boicanh("Bảy giờ tối. Mẹ nhắc lần thứ nhất: đi học bài con. Tám giờ, lần thứ tư. Thằng Bảo lớp 5 vẫn nằm sofa: dạ, chút nữa. Chín giờ mẹ hết chịu nổi.", en: "Seven in the evening. Mum's first reminder: go and study. Eight o'clock, the fourth. Bao, in grade 5, is still on the sofa: yes, in a bit. At nine Mum cannot take any more.")
#phanxa("Mẹ nói bao nhiêu lần rồi hả? Lười như hủi! Tới giờ học là như đi đày!", "Mẹ nhắc mười lần mới giận, vậy chín lần đầu chưa cần nghe. Và mình là đứa lười, đã lười thì vậy luôn.", en: ("How many times do I have to tell you? Lazy as anything! Study time comes and you act as if you're being sent to prison!", "Mum only gets angry at the tenth reminder, so the first nine don't count. And I am a lazy kid; that is just what I am."))
#scene("Tình huống 5.1 · Thử nói cách khác")[
  #me("(Hôm sau, lúc năm giờ chiều, khi cả hai đang vui.) Bảo, mẹ muốn bàn với con một chuyện. Tối nào mẹ cũng nhắc, con cũng bực, mẹ cũng mệt. Mẹ không muốn làm cái đồng hồ báo thức biết la nữa.", en: "(Next day, five in the afternoon, when both are in a good mood.) Bao, I want to discuss something. Every evening I remind you, you get annoyed, and I get tired. I don't want to be an alarm clock that shouts any more.")
  #con("Tại mẹ nhắc hoài con nhức đầu.", en: "Because you keep reminding me and it gives me a headache.")
  #me("Mẹ cũng nhức đầu. Vậy mình đổi: con tự chọn giờ ngồi vô bàn. Mấy giờ thì con thấy hợp?", en: "It gives me one too. So let's change: you choose when you sit down to study. What time suits you?")
  #con("Tám giờ. Cho con coi hết tập phim đã.", en: "Eight. Let me finish my episode first.")
  #me("Tám giờ thì mười giờ mới xong, con sẽ thiếu ngủ. Bảy giờ rưỡi thì sao? Phim còn lại để sau khi học xong coi tiếp, coi lúc đó mới đã.", en: "If you start at eight you won't finish until ten and you'll be short of sleep. How about seven thirty? Save the rest of the episode for after homework; it's more fun then.")
  #con("Thôi cũng được. Bảy rưỡi.", en: "Fine. Seven thirty.")
  #me("Con tự cài báo thức đi. Chuông reo là con tự đi, mẹ không nhắc tiếng nào. Còn nếu chuông reo mà con chưa đi thì sao? Con tự đặt luật.", en: "Set your own alarm. When it rings, you go by yourself and I won't say a word. And if it rings and you don't go? You make the rule.")
  #con("Thì... hôm sau con không coi phim buổi tối.", en: "Then... no evening shows the next day.")
  #me("Được. Luật của con đó nha, mẹ chỉ giữ giùm.", en: "All right. It's your rule; I am only keeping it for you.")
]
#hieusau1("Nhắc đi nhắc lại biến việc học thành việc của mẹ, còn con chỉ là người bị giục. Càng bị giục, con càng trì lại để giữ chút quyền tự quyết còn sót. Trẻ từ tiểu học đã cần cảm giác mình được chọn. Cho con chọn trong khuôn khổ, giờ nào và hậu quả gì, thì việc ngồi vào bàn trở thành lời con tự hứa. Lời tự hứa nặng hơn lệnh của người khác rất nhiều.", en: "Repeated reminders turn studying into Mum's job, with the child merely the one being pushed. The more pushed, the more the child drags to keep a little self-determination. Even primary schoolers need to feel they have a choice. Letting a child choose within limits, what time and what consequence, makes sitting down a promise to themselves. A promise to oneself weighs far more than another person's order.")
#cotloi("Nhắc một lần là dặn. Nhắc mười lần là dạy con rằng chín lần đầu không tính.", en: "One reminder is an instruction. Ten reminders teach a child that the first nine do not count.")
#lamngay1("Chọn lúc cả nhà đang vui, không phải lúc đang căng, để cùng con lập giờ học do con chọn, viết ra giấy, con ký tên. Tuần đầu ba mẹ chỉ làm đúng một việc: không nhắc.", en: "Pick a relaxed moment, not a tense one, to set a study time your child chooses. Write it down and have them sign it. For the first week you do exactly one thing: do not remind.")
#caunoi("Mẹ không muốn làm cái đồng hồ biết la nữa. Con tự chọn giờ đi.", en: "I don't want to be the shouting alarm clock any more. You choose the time.")
#tusoi(("Việc học của con hiện giờ là nỗi lo của ai nhiều hơn: của con hay của mình?", "Mình có giữ được việc không nhắc trong ba ngày không? Điều gì làm mình khó giữ?",), en: ("Right now, whose worry is my child's studying more: theirs or mine?", "Could I go three days without reminding? What makes that hard for me?",))

#sec("Con nói con mất gốc rồi, học cũng vô ích", en: "Your child says the foundations are gone and studying is pointless")
#boicanh("Con bé Yến lớp 8 cứ tới giờ Toán là than đau bụng. Tập bài tập trắng trơn. Ba hỏi thì nó nói: con mất gốc rồi, giờ học cũng không kịp đâu.", en: "Yen, in grade 8, gets a stomach ache whenever it is maths time. Her exercise book is blank. When Dad asks she says: I've lost the basics, I can't catch up now.")
#phanxa("Mất gốc là tại lười. Chịu khó ngồi học là lấy lại được hết. Không có cái gì là không kịp!", "Ba không hiểu là mình đã thử rồi và không vô. Ba nghĩ dễ lắm. Nói với ba cũng vậy.", en: ("You lost the basics because you're lazy. Sit down and work and you'll get it all back. Nothing is ever too late!", "Dad doesn't understand that I already tried and it didn't go in. He thinks it's easy. There is no point telling him."))
#scene("Tình huống 5.2 · Thử nói cách khác")[
  #ba("Con nói mất gốc. Ba hỏi thiệt, con thấy mình bắt đầu không hiểu từ khi nào?", en: "You say you've lost the basics. Honestly, when do you think you stopped understanding?")
  #con("Từ lớp 6. Từ cái hồi học số âm với phân số.", en: "Grade 6. Around negative numbers and fractions.")
  #ba("Lớp 6 tới giờ là hai năm. Hai năm ngồi trong lớp nghe mà không hiểu. Ba mà vậy chắc ba cũng đau bụng.", en: "Grade 6 to now is two years. Two years sitting in class not understanding. I'd have a stomach ache too.")
  #con("Cô giảng con nghe như tiếng nước ngoài. Mà hỏi thì con không biết hỏi cái gì, tại con không hiểu từ đầu.", en: "When the teacher explains it sounds like a foreign language. And I can't even ask, because I don't know what to ask; I don't understand from the start.")
  #ba("Vậy bây giờ kêu con làm bài lớp 8 là kêu xây lầu ba trong khi lầu một còn thiếu gạch. Không phải con lười, là mình xây sai chỗ.", en: "So asking you to do grade 8 work is like building the third floor when the first is missing bricks. You are not lazy; we are building in the wrong place.")
  #con("Chứ giờ làm sao ba?", en: "So what do we do, Dad?")
  #ba("Mình xuống lầu một. Ba mua cuốn Toán lớp 6, mỗi tối mình làm đúng hai mươi phút, từ phân số. Không ai biết hết, khỏi quê. Bài trên lớp thì con cứ làm được tới đâu hay tới đó, ba nói với cô.", en: "We go down to the first floor. I'll buy a grade 6 maths book and every evening we do exactly twenty minutes, starting from fractions. Nobody needs to know, so no embarrassment. In class you just do what you can; I'll speak with your teacher.")
  #con("Học lại lớp 6 hả? Kỳ vậy.", en: "Go back to grade 6? That's weird.")
  #ba("Ba thấy không kỳ. Kỳ là để con ngồi thêm bốn năm nữa mà không hiểu gì. Thử hai tuần, không được thì mình tính cách khác.", en: "I don't think so. What's weird is letting you sit four more years understanding nothing. Try it for two weeks; if it doesn't work we'll find another way.")
]
#hieusau1("Toán và ngoại ngữ là những môn xây chồng lên nhau: hổng một tầng thì mọi thứ phía trên đều vô nghĩa. Đứa trẻ mất gốc không thiếu ý chí, nó thiếu điểm bám. Mỗi tiết học là thêm một lần xác nhận mình kém, nên né tránh trở thành cách tự bảo vệ, đôi khi hiện ra thành đau bụng, nhức đầu thật. Lùi về đúng chỗ hổng, học liều nhỏ và kín đáo cho con những lần làm được đầu tiên sau rất lâu, và chính những lần làm được đó mới kéo động lực trở lại.", en: "Maths and languages are built in layers: one missing layer makes everything above meaningless. A child who has lost the foundations is not short of willpower; they have nothing to hold on to. Every lesson confirms once more that they are bad at it, so avoidance becomes self-protection, sometimes showing up as real stomach aches and headaches. Going back to the exact gap, in small private doses, gives the child their first successes in a long time, and those successes are what bring motivation back.")
#cotloi("Mất gốc thì quay về gốc. Không ai xây được lầu ba trên một lầu một còn thiếu gạch.", en: "If the foundations are lost, go back to the foundations. Nobody builds a third floor on a first floor missing bricks.")
#lamngay1("Cùng con tìm chỗ hổng: lật sách các lớp dưới, lùi dần tới bài nào con làm được trơn tru. Điểm bắt đầu là ngay sau bài đó. Mỗi ngày hai mươi phút, không hơn.", en: "Find the gap together: turn back through earlier years' books until you reach a lesson your child can do smoothly. The starting point is right after it. Twenty minutes a day, no more.")
#caunoi("Không phải con lười. Là mình đang xây sai chỗ. Mình quay lại chỗ con còn hiểu.", en: "You are not lazy. We have been building in the wrong place. Let's go back to where you still understand.")
#tusoi(("Mình có biết chính xác con hổng từ lớp mấy, phần nào không?", "Khi con nói học không vô, mình thường nghe thành con lười hay con đang kẹt?",), en: ("Do I know exactly which year and which topic my child's gap starts from?", "When my child says it won't go in, do I hear lazy or stuck?",))

#sec("Con để tới sát giờ mới làm", en: "Your child leaves everything to the last minute")
#boicanh("Bài thuyết trình nhóm giao từ hai tuần trước. Mười giờ đêm trước hạn nộp, thằng Hiếu lớp 10 mới mở máy, vừa làm vừa cáu, bấm bàn phím rầm rầm. Mẹ đi ngang thấy, vừa thương vừa tức.", en: "A group presentation was set two weeks ago. At ten on the night before it is due, Hieu, in grade 10, finally opens his laptop, snapping and hammering the keys. Mum walks past, torn between pity and irritation.")
#phanxa("Hai tuần không làm, giờ thức tới sáng. Mẹ nói có sai đâu. Đáng đời!", "Lúc mình đang ngộp nhất thì mẹ đứng trên bờ nói đáng đời. Mẹ muốn mình thua để mẹ đúng.", en: ("Two weeks of nothing and now you're up till dawn. Was I wrong? Serves you right!", "When I am drowning, Mum stands on the bank saying serves you right. She wants me to lose so she can be right."))
#scene("Tình huống 5.3 · Thử nói cách khác")[
  #me("(Đặt dĩa trái cây lên bàn.) Tối nay căng hả con. Mẹ không giúp được phần bài, nhưng có cần mẹ pha gì uống không?", en: "(Puts a plate of fruit on the desk.) Tough night. I can't help with the work, but shall I make you something to drink?")
  #con("Dạ thôi. Con sắp điên rồi. Còn nguyên phần của con chưa đụng.", en: "No thanks. I'm going crazy. I haven't touched my part at all.")
  #me("Ừ. Mẹ để con làm. Một giờ mà chưa xong thì cũng đi ngủ nha, sáng dậy sớm làm tiếp đầu óc sáng hơn.", en: "All right. I'll let you work. If it's not done by one, go to bed anyway; get up early and your head will be clearer.")
  #con("(Hai ngày sau, bữa cơm.) Bài đó nhóm con được bảy điểm. Phần con làm ẩu nhất.", en: "(Two days later, at dinner.) Our group got seven. My part was the sloppiest.")
  #me("Con thấy tiếc không?", en: "Do you regret it?")
  #con("Tiếc. Con biết phải làm sớm mà cứ mở ra là không biết bắt đầu từ đâu, rồi con đóng lại, rồi con lướt điện thoại cho quên.", en: "Yes. I knew I should start early, but every time I opened it I didn't know where to begin, so I closed it, and then I scrolled on my phone to forget.")
  #me("À, vậy là không phải con không muốn làm. Con mở ra, thấy nó bự quá, rồi ngộp. Lần sau có bài lớn, ngay tối đầu tiên mình thử chỉ làm đúng một việc: viết ra giấy năm bước nhỏ. Không làm bước nào hết, chỉ viết ra.", en: "Ah, so it's not that you didn't want to do it. You opened it, it looked too big, and you felt swamped. Next time there's a big task, on the very first evening let's try just one thing: write five small steps on paper. Don't do any of them; just write them down.")
  #con("Chỉ viết ra thôi hả? Cái đó thì dễ.", en: "Only write them down? That's easy.")
  #me("Ừ, dễ thì mới bắt đầu được.", en: "Yes. It has to be easy to get started.")
]
#hieusau1("Trì hoãn hiếm khi là chuyện quản lý thời gian. Nó là chuyện né một cảm giác khó chịu: việc quá lớn, quá mơ hồ, hoặc sợ làm không tốt. Mỗi lần né, con được nhẹ người tức thì, nên thói quen càng được củng cố. Mắng lúc con đang chạy nước rút chỉ thêm một cảm giác khó chịu nữa để né. Nói chuyện sau khi mọi việc đã xong, và giúp con cắt việc lớn thành bước đầu tiên nhỏ tới mức buồn cười, mới chạm đúng gốc.", en: "Procrastination is rarely about time management. It is about avoiding an unpleasant feeling: the task is too big, too vague, or the fear of doing it badly. Each avoidance brings instant relief, which strengthens the habit. Scolding during the last-minute sprint only adds one more unpleasant feeling to avoid. Talking afterwards, and helping the child cut the big task down to a first step so small it is almost funny, reaches the root.")
#cotloi("Lúc con đang chạy nước rút, đưa nước. Rút kinh nghiệm để dành khi con đã về đích.", en: "While your child is sprinting, hand them water. Save the lessons for after the finish line.")
#lamngay1("Lần tới con có bài lớn, ngồi cùng con năm phút ngay ngày đầu tiên để viết ra các bước nhỏ và chọn bước đầu tiên làm được trong mười phút. Ba mẹ không làm giùm, chỉ hỏi: bước nhỏ nhất là gì?", en: "Next time your child has a big task, sit with them for five minutes on day one to write out the small steps and choose a first one that takes ten minutes. Do not do it for them; just ask: what is the smallest step?")
#caunoi("Việc này bự quá thì mình cắt nhỏ ra. Bước đầu tiên nhỏ nhất là gì?", en: "If it's too big, we cut it up. What is the smallest first step?")
#tusoi(("Bản thân mình có hay để nước tới chân mới nhảy không? Lúc đó mình cần người khác nói gì?", "Con trì hoãn ở mọi việc, hay chỉ ở những việc con thấy khó và mơ hồ?",), en: ("Do I myself often leave things to the last minute? What do I need to hear then?", "Does my child put off everything, or only what feels hard and unclear?",))

#sec("Con nói con không muốn đi học nữa", en: "Your child says they do not want to go to school any more")
#boicanh("Sáng thứ hai, thằng Nam lớp 11 không dậy. Mẹ vô kêu, nó trùm mền: con không đi học nữa đâu. Con chán lắm rồi. Mẹ sững người. Thằng nhỏ trước giờ học khá, chưa bao giờ như vậy.", en: "Monday morning, Nam, in grade 11, does not get up. Mum goes in; he pulls the blanket over his head: I'm not going to school any more. I'm sick of it. Mum is stunned. He has always been a decent student and never like this.")
#phanxa("Nói bậy! Không học thì làm gì mà ăn? Dậy ngay, trễ giờ rồi!", "Mẹ chỉ cần mình tới trường. Mình ra sao bên trong thì mẹ không muốn biết.", en: ("Nonsense! If you don't study, how will you earn a living? Get up, you're late!", "Mum only needs me to turn up at school. What is going on inside me, she does not want to know."))
#scene("Tình huống 5.4 · Thử nói cách khác")[
  #me("(Ngồi xuống mép giường, im một lúc.) Chắc con phải mệt dữ lắm mới nói ra câu đó. Con trước giờ đâu có vậy.", en: "(Sits on the edge of the bed, quiet for a moment.) You must be terribly tired to say that. It's not like you.")
  #con("Con mệt thiệt. Sáng nào mở mắt ra con cũng thấy nặng.", en: "I really am tired. Every morning I open my eyes and it feels heavy.")
  #me("Nặng kiểu sao con? Mẹ muốn hiểu, mẹ không ép con dậy liền đâu.", en: "Heavy how? I want to understand; I'm not making you get up right now.")
  #con("Học thêm tới chín giờ tối, về làm bài tới mười hai giờ. Sáng năm rưỡi dậy. Chủ nhật cũng học. Con không biết con học để làm gì nữa.", en: "Extra classes until nine at night, homework until midnight. Up at five thirty. Sundays too. I don't know what I'm studying for any more.")
  #me("Nghe con kể mẹ mới thấy lịch của con còn nặng hơn lịch người đi làm. Mà chính ba mẹ xếp cái lịch đó. Mẹ xin lỗi, mẹ không để ý là con đuối tới vậy.", en: "Hearing you, I realise your schedule is heavier than a working adult's. And we are the ones who built it. I am sorry I didn't notice you were this worn out.")
  #con("Con không phải muốn bỏ học thiệt. Con chỉ muốn được thở.", en: "I don't really want to quit school. I just want to breathe.")
  #me("Mẹ hiểu rồi. Hôm nay mẹ xin cô cho con nghỉ một buổi, con ngủ cho đủ. Tối nay ba mẹ với con ngồi coi lại lịch, bỏ bớt lớp nào được thì bỏ. Con chọn.", en: "I understand. I'll ask your teacher for a day off today; get some proper sleep. Tonight the three of us will go through the timetable and drop whatever classes can be dropped. You choose.")
]
#hieusau1("Câu con không đi học nữa của một đứa trẻ vốn học ổn gần như không bao giờ là chuyện lười. Nó là còi báo động: kiệt sức, mất ý nghĩa, hoặc có chuyện ở trường mà con chưa nói. Thiếu ngủ kéo dài ở tuổi mới lớn làm giảm trí nhớ, khả năng tập trung và làm khí sắc xấu đi rõ rệt. Bắt con dậy bằng được là tắt cái còi mà để nguyên đám cháy. Ngồi xuống hỏi nặng kiểu sao là đi tìm đám cháy.", en: "I'm not going to school any more, from a child who usually copes, is almost never laziness. It is an alarm: exhaustion, loss of meaning, or something at school the child has not mentioned. Long-term sleep loss in adolescence clearly reduces memory, concentration and mood. Forcing the child up is switching off the alarm while the fire keeps burning. Sitting down and asking heavy how is going to look for the fire.")
#cotloi("Khi con nói không muốn đi học nữa, câu cần hỏi không phải là không học thì làm gì ăn, mà là chuyện gì đang làm con nặng tới vậy.", en: "When your child says they do not want to go to school, the question is not how will you earn a living. It is what is making this so heavy for you.")
#lamngay1("Viết lịch một tuần của con ra giấy, từng giờ: học chính, học thêm, bài tập, ngủ, chơi. Cộng số giờ ngủ và số giờ con được tự do. Nếu con ngủ dưới bảy tiếng một đêm, việc đầu tiên cần cắt là một lớp học thêm.", en: "Write out your child's week hour by hour: school, extra classes, homework, sleep, play. Add up sleeping hours and free hours. If your child sleeps under seven hours a night, the first thing to cut is an extra class.")
#caunoi("Chắc con phải mệt lắm mới nói ra câu đó. Kể mẹ nghe đi.", en: "You must be very tired to say that. Tell me about it.")
#tusoi(("Mỗi tuần con mình có bao nhiêu giờ hoàn toàn không bị xếp lịch?", "Nếu con chán học vì chuyện ở trường (bạn bè, thầy cô), con có nói cho mình biết không?",), en: ("How many completely unscheduled hours does my child have each week?", "If my child were sick of school because of something there (friends, teachers), would they tell me?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 5: mang theo bên mình]
#doicau1((("Lười như hủi.", "Mẹ thấy con chưa bắt đầu được. Con đang kẹt ở chỗ nào?", "Lazy as anything.", "I can see you haven't been able to start. Where are you stuck?"), ("Học cho ba mẹ nhờ.", "Học là cho con. Ba mẹ chỉ đi cùng.", "Study so your parents can be proud.", "Studying is for you. We are only walking alongside."), ("Mẹ nói lần cuối đó nha!", "Mình đã thỏa thuận bảy rưỡi. Giờ là bảy rưỡi.", "This is the last time I'm telling you!", "We agreed on seven thirty. It is seven thirty."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Trước khi nói con lười, loại trừ bốn thứ: con thiếu ngủ, con mất gốc, con không biết bắt đầu từ đâu, con đang có chuyện buồn. Hết bốn thứ đó rồi hãy tính tới lười.", "Góc học không cần đẹp, chỉ cần không có điện thoại trong tầm tay. Điện thoại của ba mẹ cũng vậy: con khó học khi kế bên có người đang lướt.", "Thưởng tiền cho điểm số dễ làm con học vì tiền. Thứ giữ con học lâu dài là cảm giác mình làm được và hiểu ra.",), en: ("Before calling a child lazy, rule out four things: too little sleep, lost foundations, not knowing where to start, and something making them sad. Only after those four consider laziness.", "A study corner does not need to be pretty; it only needs no phone within reach. That includes yours: it is hard to study next to someone scrolling.", "Paying for marks easily makes a child study for money. What keeps a child learning in the long run is the feeling of I can do this and now I understand.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày không nhắc con học. Chỉ giữ đúng khung đã thỏa thuận và để hậu quả do con tự đặt lên tiếng. Ba mẹ ghi lại mỗi tối: mình đã suýt nhắc mấy lần, và chuyện gì xảy ra khi mình không nhắc.",), mark: sym.star.filled, en: ("Seven days without reminding your child to study. Just keep to the agreed frame and let the consequence your child set do the talking. Each night note: how many times did I almost remind, and what happened when I did not?",))
