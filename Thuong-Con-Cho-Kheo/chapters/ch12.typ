#import "../template.typ": *

#chapter-open(12, "Nói dối, lấy tiền, thử thứ không nên thử", 12, "Lúc con trượt chân là lúc con nhìn lên xem ba mẹ đưa tay ra hay giơ tay lên.", "Có những chuyện làm ba mẹ chết lặng: con nói dối trắng trợn, tiền trong ví vơi đi, trong cặp con có cái vape, con về nhà nồng mùi bia. Trong đầu ba mẹ lập tức chiếu một cuốn phim tương lai rất tệ. Nhưng một lần trượt chân chưa phải là một cuộc đời hỏng. Chương này bàn cách phản ứng sao cho con vừa hiểu đây là chuyện nghiêm trọng, vừa biết đường quay về nhà vẫn còn mở.", ("Con nói dối một chuyện rành rành", "Tiền trong ví mẹ vơi dần", "Trong cặp con có một cái vape", "Con đi sinh nhật về nồng mùi bia",), en: ("Lying, taking money, trying what they should not", "The moment a child slips is the moment they look up to see whether you are reaching out a hand or raising one.", "Some things leave parents speechless: a bare-faced lie, money thinning in the wallet, a vape in the school bag, a child coming home smelling of beer. Instantly a very bad film of the future plays in our heads. But one slip is not a ruined life. This chapter discusses how to respond so that your child understands this is serious and also knows the road home is still open.", ("Your child tells an obvious lie", "Money keeps disappearing from Mum's purse", "There is a vape in your child's school bag", "Your child comes home from a birthday smelling of beer",)))

#sec("Con nói dối một chuyện rành rành", en: "Your child tells an obvious lie")
#boicanh("Bánh trong tủ lạnh mẹ để dành cho bà nội biến mất. Mép bé Bo lớp 1 còn dính kem. Mẹ hỏi ai ăn bánh, nó đáp ngay: con không biết, chắc con mèo.", en: "The cake Mum was saving in the fridge for Grandma has vanished. There is still cream at the corner of Bo's mouth; he is in grade 1. Mum asks who ate the cake and he answers at once: I don't know, maybe the cat.")
#phanxa("Con nói dối! Mẹ ghét nhất là nói dối. Kem dính đầy miệng kìa. Còn nhỏ mà đã láo!", "Nói thật thì bị la vì ăn bánh. Nói dối bị bắt thì bị la nặng hơn. Vậy lần sau phải lau miệng cho sạch.", en: ("You're lying! I hate lying more than anything. There's cream all over your mouth. So little and already a liar!", "Telling the truth gets me scolded for eating the cake. Lying and being caught gets me scolded worse. So next time wipe my mouth properly."))
#scene("Tình huống 12.1 · Thử nói cách khác")[
  #me("(Ngồi xuống, lấy khăn lau mép con.) Mẹ thấy kem ở đây nè. Mẹ nghĩ con ăn bánh rồi, và mẹ nghĩ con sợ mẹ la nên con nói là con mèo.", en: "(Kneels, wipes his mouth with a cloth.) I can see cream here. I think you ate the cake, and I think you were afraid I'd scold you, so you said it was the cat.")
  #con("(Cúi mặt, gật.)", en: "(Looks down, nods.)")
  #me("Cảm ơn con gật đầu. Con có biết bánh đó mẹ để cho ai không?", en: "Thank you for nodding. Do you know who I was saving that cake for?")
  #con("Cho bà nội.", en: "Grandma.")
  #me("Ừ. Giờ bà nội không có bánh, mẹ hơi buồn chuyện đó. Nhưng mẹ còn muốn nói chuyện này quan trọng hơn cái bánh: khi con nói con mèo ăn, mẹ không biết phải tin câu nào của con nữa. Mẹ muốn tin con lắm.", en: "Yes. Now Grandma has no cake, and I'm a little sad about that. But there's something more important than the cake: when you said the cat ate it, I didn't know which of your words to believe. I really want to believe you.")
  #con("Con xin lỗi mẹ. Tại bánh ngon quá.", en: "I'm sorry, Mum. The cake was so yummy.")
  #me("Bánh đó ngon thiệt. Lần sau thèm, con nói mẹ ơi con muốn ăn. Có thể mẹ nói được, có thể mẹ nói chờ. Nhưng con nói thật thì mẹ không la. Mẹ hứa. Giờ mình làm gì cho bà nội đây?", en: "It was a very good cake. Next time you want some, say Mum, I'd like some. I might say yes, I might say wait. But if you tell the truth I won't scold. I promise. Now, what shall we do for Grandma?")
  #con("Con vẽ cho bà một cái bánh. Với con lấy tiền heo mua cho bà cái khác.", en: "I'll draw her a cake. And I'll use my piggy bank money to buy her another one.")
  #me("Vẽ thì mẹ chịu liền. Mua thì mẹ góp với con một nửa.", en: "The drawing, yes, straight away. The buying, I'll pay half with you.")
]
#hieusau1("Trẻ nhỏ nói dối là một cột mốc phát triển bình thường: con vừa phát hiện ra rằng người khác không đọc được ý nghĩ của mình. Ở tuổi này con nói dối chủ yếu để tránh bị phạt, không phải vì tính gian. Gài con bằng câu hỏi mà mình đã biết đáp án là mời con nói dối. Nói thẳng điều mình thấy, bỏ qua phần tra hỏi, cho con thấy nói thật thì nhẹ nhàng hơn, và để con sửa hậu quả, là cách xây thói quen trung thực bền nhất.", en: "Lying in small children is a normal developmental milestone: the child has just discovered that others cannot read their thoughts. At this age they lie mainly to avoid punishment, not from a dishonest character. Trapping a child with a question whose answer you already know is an invitation to lie. Stating plainly what you see, skipping the interrogation, showing that the truth is the gentler path, and letting the child repair the consequence builds honesty that lasts.")
#cotloi("Đã biết câu trả lời thì đừng hỏi để gài. Nói điều mình thấy, và làm cho việc nói thật luôn dễ chịu hơn nói dối.", en: "If you already know the answer, do not ask in order to trap. Say what you see, and make telling the truth always more comfortable than lying.")
#lamngay1("Lần tới biết chắc con làm một việc, thay câu hỏi ai làm bằng câu kể: Mẹ thấy ly sữa đổ trên sàn. Mình lấy khăn lau nha. Để ý xem con có bớt chối không.", en: "Next time you know for certain your child did something, replace who did this with a statement: I see milk spilled on the floor. Let's get a cloth. Watch whether your child denies less.")
#caunoi("Con nói thật thì mẹ không la. Mẹ hứa, và mẹ sẽ giữ lời.", en: "If you tell the truth I won't scold. I promise, and I will keep my word.")
#tusoi(("Mình có hay hỏi những câu đã biết đáp án để thử con không?", "Con có nghe mình nói dối những chuyện nhỏ không: nói mẹ không có nhà khi có người gọi, hứa rồi không làm?",), en: ("Do I often ask questions I already know the answer to, to test my child?", "Does my child hear me lie about small things: saying I'm not home when someone calls, promising and not doing?",))

#sec("Tiền trong ví mẹ vơi dần", en: "Money keeps disappearing from Mum's purse")
#boicanh("Lần thứ ba trong tháng, mẹ đếm lại ví thấy thiếu: năm chục, một trăm, rồi hai trăm. Nhà chỉ có thằng Lâm lớp 8 ra vô. Mẹ để ý nó dạo này hay có trà sữa, có đôi dép mới nói là bạn cho.", en: "For the third time this month Mum counts her purse and finds it short: fifty thousand, a hundred, then two hundred. Only Lam, in grade 8, is in and out of the house. She has noticed he often has milk tea lately and new sandals that he says a friend gave him.")
#phanxa("Mẹ biết con lấy rồi, đừng chối! Lục cặp ra! Ăn cắp quen tay, ngủ ngày quen mắt. Nhà này không có thứ trộm cắp!", "Mình bị kết án rồi. Chối thì bị nói lì, nhận thì bị gọi là trộm. Nhà này không có thứ như mình.", en: ("I know you took it, don't deny it! Empty your bag! Once a thief, always a thief. This family has no thieves!", "I have already been convicted. If I deny it I am stubborn; if I admit it I am a thief. This family has no place for someone like me."))
#scene("Tình huống 12.2 · Thử nói cách khác")[
  #ba("(Bàn với mẹ trước, rồi một mình ba nói chuyện với con ở quán cà phê gần nhà.) Lâm, ba có chuyện khó nói. Ví của mẹ thiếu tiền ba lần trong tháng này. Ba không lục cặp con, không gài bẫy con. Ba hỏi thẳng một lần, và con trả lời sao ba tin vậy: con có lấy không?", en: "(Talks with Mum first, then speaks to his son alone at a cafe near home.) Lam, I have something hard to say. Mum's purse has been short three times this month. I am not searching your bag or setting a trap. I'll ask once, directly, and I will believe whatever you answer: did you take it?")
  #con("(Im rất lâu, xoay xoay ly nước.) ...Có. Con lấy.", en: "(A very long silence, turning his glass.) ...Yes. I took it.")
  #ba("Nói ra câu đó khó lắm. Ba nể con nói thật. Ba không vui, nhưng ba nể. Giờ nói ba nghe con cần tiền làm gì.", en: "That was hard to say. I respect you for telling the truth. I'm not happy, but I respect it. Now tell me what you needed the money for.")
  #con("Tụi bạn con ra về hay đi uống trà sữa. Đứa nào cũng có tiền. Con mà không đi thì bị kêu là keo, là nhà nghèo. Con xin thì mẹ nói đi học chứ đi chơi đâu mà xin.", en: "After school my friends go for milk tea. They all have money. If I don't go they call me stingy and poor. When I asked, Mum said you go to school, not out to play, so why do you need money.")
  #ba("Vậy là con đã thử xin, và bị từ chối, rồi con chọn đường tắt. Ba hiểu khúc đầu. Khúc sau thì không được: tiền trong ví mẹ là mẹ đếm từng đồng để đi chợ. Mẹ đã nghi cả cô giúp việc theo giờ. Một người vô tội suýt bị oan vì con.", en: "So you tried asking, were refused, and then took a shortcut. I understand the first part. The second is not acceptable: the money in Mum's purse is counted out for the market. She even suspected the part-time helper. An innocent person was nearly blamed because of you.")
  #con("(Giật mình.) Con không biết chuyện đó.", en: "(Startled.) I didn't know that.")
  #ba("Giờ con biết rồi. Ba đề nghị ba việc. Một, con tự nói với mẹ, ba ngồi kế bên. Hai, con trả lại, trừ vô tiền tiêu vặt. Ba, phần của ba mẹ: nhà mình chưa bao giờ cho con tiền tiêu vặt cố định, cái đó thiếu sót. Từ tuần sau con có một khoản mỗi tuần, con tự quản, hết là hết.", en: "Now you do. I suggest three things. One, you tell Mum yourself, with me next to you. Two, you pay it back from pocket money. Three, our part: we have never given you regular pocket money, and that was a gap. From next week you get an amount each week; you manage it, and when it's gone it's gone.")
  #con("Con được có tiền riêng hả ba?", en: "I get my own money?")
  #ba("Tuổi con cần tập xài tiền. Xài sai vài lần lúc còn nhỏ, tiền còn nhỏ, tốt hơn là xài sai lúc lớn.", en: "At your age you need to practise spending. Getting it wrong a few times while you are young and the sums are small is better than getting it wrong when you are grown.")
]
#hieusau1("Trẻ lấy tiền trong nhà thường vì một nhu cầu có thật mà không có đường chính đáng để đáp ứng: muốn hòa vào nhóm bạn, muốn một thứ không dám xin, đôi khi là bị bạn trấn lột hoặc đang nợ ai đó. Tra khảo và lục soát làm con học cách giấu kỹ hơn. Hỏi thẳng một lần với lời cam kết sẽ tin, rồi tìm cho ra nhu cầu phía sau, thường mở được sự thật. Tiền tiêu vặt cố định dù nhỏ là công cụ giáo dục tốt: con học lập kế hoạch, học chờ, và hết lý do đi đường tắt.", en: "Children who take money at home usually have a real need with no legitimate way to meet it: fitting in with friends, wanting something they dare not ask for, sometimes being extorted or owing someone. Interrogation and searches teach a child to hide better. Asking once, directly, with a commitment to believe the answer, and then finding the need behind it, usually brings out the truth. Regular pocket money, even a little, is a good teaching tool: the child learns to plan and to wait, and loses the reason for shortcuts.")
#cotloi("Sau chuyện con lấy tiền luôn có một nhu cầu chưa được nghe. Xử chuyện lấy tiền cho nghiêm, rồi mở cho nhu cầu đó một con đường chính đáng.", en: "Behind taken money there is always a need nobody heard. Deal with the taking seriously, then open a legitimate path for the need.")
#lamngay1("Nếu con chưa có tiền tiêu vặt cố định, tuần này bắt đầu: một khoản vừa phải, phát đúng một ngày trong tuần, kèm quy ước rõ con tự chi những gì. Không ứng trước, không phát thêm khi con xài hết.", en: "If your child has no regular pocket money, start this week: a modest amount, given on the same day each week, with a clear agreement on what they pay for themselves. No advances, no top-ups when it runs out.")
#caunoi("Ba hỏi thẳng một lần, con trả lời sao ba tin vậy.", en: "I'll ask once, directly, and I will believe whatever you answer.")
#tusoi(("Khi con xin tiền, mình thường nghe hết lý do hay từ chối luôn?", "Nếu con lấy tiền vì đang bị ai đó ép, đe dọa, cách mình hỏi có giúp con nói ra chuyện đó không?",), en: ("When my child asks for money, do I hear out the reason or refuse at once?", "If my child were taking money because someone was forcing or threatening them, would the way I ask help them say so?",))

#sec("Trong cặp con có một cái vape", en: "There is a vape in your child's school bag")
#boicanh("Mẹ giặt cặp cho con, rơi ra một thiết bị nhỏ như cái USB, mùi xoài. Mẹ tra mạng mới biết là thuốc lá điện tử dùng một lần. Thằng Huy lớp 9. Tay mẹ run.", en: "Washing her son's bag, Mum finds a small device like a USB stick, smelling of mango. She looks it up: a disposable e-cigarette. Huy is in grade 9. Her hands shake.")
#phanxa("Con hút cái thứ này hả? Trời ơi, mới mười bốn tuổi đã nghiện ngập! Ai dụ con? Mẹ cấm con ra khỏi nhà!", "Mẹ coi mình như con nghiện. Nói gì mẹ cũng không tin. Lần sau giấu chỗ khác.", en: ("You smoke this? Fourteen and already an addict! Who got you into it? You're not leaving this house!", "Mum sees me as an addict. Whatever I say she won't believe. Next time hide it somewhere else."))
#scene("Tình huống 12.3 · Thử nói cách khác")[
  #me("(Đợi ba về, hai người thống nhất. Sau bữa tối, mẹ đặt cái vape lên bàn.) Huy, mẹ giặt cặp thấy cái này. Mẹ nói thật là mẹ sợ. Mẹ không la, mẹ cần hiểu. Nó là của con hay con giữ giùm ai?", en: "(Waits for Dad; they agree on an approach. After dinner she puts the vape on the table.) Huy, I found this when washing your bag. Honestly, I'm frightened. I'm not shouting; I need to understand. Is it yours, or are you holding it for someone?")
  #con("...Của con. Con mua chung với thằng Phát.", en: "...It's mine. I bought it together with Phat.")
  #me("Cảm ơn con không nói là giữ giùm. Con hút bao lâu rồi?", en: "Thank you for not saying you were holding it for someone. How long have you been using it?")
  #con("Chừng hai tháng. Lúc đầu thử cho biết. Tụi con hút ở sau căn tin.", en: "About two months. At first just to try. We do it behind the canteen.")
  #me("Giờ con hút mỗi ngày, hay lâu lâu?", en: "Is it every day now, or once in a while?")
  #con("Gần như mỗi ngày. Bữa nào không có con thấy bứt rứt, khó chịu, học không vô.", en: "Nearly every day. On days without it I feel restless and irritable and can't study.")
  #ba("Cái bứt rứt đó là nicotine đó con. Người ta làm mùi xoài, mùi dâu để mình tưởng nó vô hại, chứ trong đó có nicotine, nhiều cái còn đậm hơn thuốc lá. Hai tháng mà đã bứt rứt là cơ thể con dính rồi. Không phải con hư. Là con bị một món hàng thiết kế để gây nghiện bắt được.", en: "That restlessness is nicotine. They make it mango or strawberry so we think it's harmless, but it contains nicotine, often stronger than cigarettes. Restless after two months means your body is already hooked. It's not that you're bad. You were caught by a product designed to be addictive.")
  #con("Con cũng muốn bỏ. Con thử nghỉ ba ngày rồi không chịu nổi.", en: "I want to quit too. I tried stopping for three days and couldn't stand it.")
  #me("Con đã tự thử bỏ, mẹ không ngờ. Vậy mình cùng phe rồi. Bỏ cái này một mình khó lắm, người lớn còn bỏ không nổi. Tuần này ba mẹ đưa con đi bác sĩ hỏi cách cai cho đúng. Cái này mẹ giữ. Con còn cái nào khác không?", en: "You already tried to quit by yourself; I had no idea. Then we are on the same side. Quitting this alone is very hard; even adults fail. This week we'll take you to a doctor to ask how to do it properly. I'll keep this one. Do you have any others?")
  #con("Còn một cái trong hộc bàn. Để con lấy.", en: "One more in my desk drawer. I'll get it.")
  #ba("Ba cảm ơn con. Mấy tuần đầu sẽ khó chịu lắm, lúc nào thèm quá con nói ba, ba con mình đi đá banh, đi bơi, làm gì cũng được.", en: "Thank you. The first few weeks will be very uncomfortable. Whenever the craving is too strong, tell me, and we'll go and kick a ball, swim, anything.")
]
#hieusau1("Thuốc lá điện tử nhắm vào tuổi thiếu niên bằng hương vị, hình dáng dễ giấu và lời đồn rằng nó vô hại. Não đang phát triển nghiện nicotine nhanh hơn não người lớn, có khi chỉ sau vài tuần. Khi con đã có dấu hiệu lệ thuộc, bứt rứt, khó tập trung khi thiếu, thì đây là vấn đề sức khỏe cần hỗ trợ, không phải vấn đề đạo đức giải quyết bằng hình phạt. Hỏi bằng những câu cụ thể, bao lâu, bao nhiêu, cho ba mẹ bức tranh thật. Và gọi tên kẻ có lỗi là món hàng gây nghiện giúp con đứng cùng phe với ba mẹ để chống lại nó.", en: "E-cigarettes target teenagers with flavours, easy-to-hide shapes and the rumour that they are harmless. A developing brain becomes addicted to nicotine faster than an adult's, sometimes within weeks. Once a child shows signs of dependence, restlessness and poor concentration without it, this is a health problem needing support, not a moral problem to be solved by punishment. Asking specific questions, how long and how much, gives parents the real picture. And naming the culprit as the addictive product puts the child on the parents' side against it.")
#cotloi("Trước một chất gây nghiện, ba mẹ và con phải ở cùng một phe. Kẻ địch là nicotine, không phải đứa con.", en: "Against an addictive substance, parents and child must be on the same side. The enemy is nicotine, not the child.")
#lamngay1("Tìm hiểu mười phút về thuốc lá điện tử: hình dáng, tên gọi tụi nhỏ dùng, tác hại. Rồi hỏi con bằng giọng tò mò trong một bữa ăn: Ở trường con có ai hút pod không? Con nghĩ sao? Nghe trước khi dạy.", en: "Spend ten minutes learning about e-cigarettes: what they look like, what teenagers call them, the harm. Then ask at dinner, in a curious voice: Does anyone at your school vape? What do you think about it? Listen before teaching.")
#caunoi("Không phải con hư. Con bị một thứ thiết kế để gây nghiện bắt được. Ba mẹ cùng phe với con để gỡ nó ra.", en: "It's not that you are bad. Something designed to hook people caught you. We are on your side to get it off you.")
#tusoi(("Nếu con đã lỡ dính một thứ gì đó, con có tin là nói ra với mình thì được giúp chứ không bị kết án không?", "Trong nhà có ai hút thuốc, uống rượu trước mặt con không? Con học được gì từ đó?",), en: ("If my child were already caught up in something, would they trust that telling me brings help rather than a verdict?", "Does anyone at home smoke or drink in front of my child? What do they learn from that?",))

#sec("Con đi sinh nhật về nồng mùi bia", en: "Your child comes home from a birthday smelling of beer")
#boicanh("Mười một giờ đêm, trễ một tiếng so với giờ hẹn, thằng Quang lớp 11 về tới nhà, mặt đỏ, đi hơi xiêu, nồng mùi bia. Nó tự chạy xe về. Ba mẹ đã ngồi chờ ở phòng khách, gọi mười cuộc không bắt máy.", en: "Eleven at night, an hour past the agreed time, Quang, in grade 11, gets home, face flushed, slightly unsteady, smelling of beer. He rode his own motorbike. His parents have been waiting in the living room; ten calls went unanswered.")
#phanxa("Mới mười bảy tuổi đã bia bọt! Gọi không bắt máy! Mày muốn chết hả? Từ nay cấm đi đâu hết!", "Ba mẹ chỉ biết cấm. Lần sau có lỡ uống thì ngủ lại nhà bạn, đừng về, đừng gọi.", en: ("Seventeen and already drinking! Not answering your phone! Do you want to die? From now on you go nowhere!", "My parents only know how to forbid. Next time, if I've been drinking, I'll stay at a friend's; don't come home, don't call."))
#scene("Tình huống 12.4 · Thử nói cách khác")[
  #ba("(Nhìn con, giọng thấp.) Con về tới nhà rồi. Ba mẹ chờ từ mười giờ. Giờ con đi tắm, uống nước, ngủ. Sáng mai mình nói chuyện. Ba không nói chuyện với người đang có bia.", en: "(Looks at him, voice low.) You're home. We've been waiting since ten. Now go shower, drink water and sleep. We'll talk in the morning. I don't talk to someone who has beer in him.")
  #con("Con xin lỗi... con...", en: "I'm sorry... I...")
  #me("Sáng mai. Đi ngủ đi con.", en: "In the morning. Go to bed.")
  #ba("(Sáng hôm sau, cả ba ngồi ở bàn ăn.) Giờ con tỉnh rồi. Ba nói cái ba sợ nhất tối qua trước: không phải chuyện con uống. Là con uống rồi tự chạy xe về. Mười cuộc gọi không ai bắt máy, mẹ con đã nghĩ tới bệnh viện.", en: "(Next morning, all three at the table.) Now you're clear-headed. Let me say first what frightened me most last night: not that you drank. That you drank and then rode home. Ten calls with no answer; your mother was already thinking of hospitals.")
  #con("Con xin lỗi. Tụi nó ép con uống, không uống thì kỳ. Con uống có ba lon. Con thấy mình còn chạy được.", en: "I'm sorry. They pushed me to drink; it's awkward not to. I only had three cans. I felt I could still ride.")
  #ba("Ai uống rồi cũng thấy mình còn chạy được. Đó chính là thứ bia làm với cái đầu. Ba không hỏi con uống hay không, ba đoán tuổi con trước sau cũng có lần thử. Ba cần một thỏa thuận về mạng sống: con mà có uống, dù một lon, thì không cầm lái, và không ngồi sau xe đứa có uống.", en: "Everyone who has been drinking feels they can still ride. That is exactly what beer does to the head. I'm not asking whether you drink; I assume that at your age you'll try sooner or later. I need an agreement about staying alive: if you've had any, even one can, you don't ride, and you don't sit behind someone who has.")
  #con("Chứ con về bằng gì? Gọi ba mẹ thì bị la.", en: "Then how do I get home? If I call you I get shouted at.")
  #me("Đây là phần ba mẹ hứa: con gọi, bất kể mấy giờ, ba mẹ tới chở. Trên đường về không hỏi, không la một câu. Chuyện gì cũng để sáng hôm sau nói. Con chỉ cần nhắn một chữ đón là đủ.", en: "Here is our promise: you call, whatever the hour, and we come and get you. On the way home, not one question, not one scolding. Everything waits for the next morning. You only need to text one word, pickup.")
  #con("Thiệt hả? Không la?", en: "Really? No shouting?")
  #ba("Tối đó không la. Hôm sau vẫn nói chuyện, và chuyện tối qua vẫn có hậu quả: về trễ một tiếng không báo, hai tuần tới con không đi tối. Nhưng ba mẹ thà đi đón một đứa con say lúc hai giờ sáng còn hơn nhận một cuộc gọi khác.", en: "Not that night. We still talk the next day, and last night still has a consequence: coming home an hour late without telling us means no evenings out for two weeks. But we would rather collect a drunk child at two in the morning than receive a different phone call.")
]
#hieusau1("Thiếu niên uống rượu bia gặp nguy hiểm lớn nhất không phải từ chính ly bia mà từ những gì xảy ra sau đó: lái xe, té ngã, bị lợi dụng. Vùng não cân nhắc rủi ro còn đang hoàn thiện, và rượu bia làm nó yếu thêm. Nói chuyện với người đang say là vô ích, nên việc đầu tiên là bảo đảm con an toàn và để tới sáng. Lời hứa đón không hỏi là một thỏa thuận an toàn mà nhiều gia đình áp dụng: nó tách chuyện kỷ luật ra khỏi chuyện sống chết, để con không bao giờ phải chọn giữa bị la và liều mạng.", en: "The greatest danger to teenagers who drink is not the drink but what comes after: riding or driving, falls, being taken advantage of. The part of the brain that weighs risk is still maturing, and alcohol weakens it further. Talking to someone who is drunk is useless, so the first task is safety, and the conversation waits until morning. The no-questions pickup is a safety agreement many families use: it separates discipline from life and death, so a child never has to choose between a scolding and risking their life.")
#cotloi("Có thứ quan trọng hơn chuyện dạy con ngay tối đó: con còn sống để sáng mai nghe dạy. Hãy cho con một cuộc gọi luôn được bắt máy mà không bị mắng.", en: "Something matters more than teaching your child that very night: that they are alive in the morning to be taught. Give them a call that is always answered without a scolding.")
#lamngay1("Thống nhất với con một tín hiệu cầu cứu: con chỉ cần nhắn một chữ, ví dụ chữ đón, hoặc gọi và nói một câu mật hiệu, là ba mẹ tới chở về, không hỏi gì cho tới hôm sau. Dùng được cho mọi tình huống con thấy không an toàn.", en: "Agree on a rescue signal: your child only needs to text one word, such as pickup, or call and say a code phrase, and you come, asking nothing until the next day. It works for any situation where they feel unsafe.")
#caunoi("Mấy giờ cũng được, con nhắn một chữ là ba mẹ tới đón. Trên đường về không hỏi, không la.", en: "Any hour, text one word and we will come. On the way home, no questions and no scolding.")
#tusoi(("Nếu tối nay con kẹt ở một chỗ không an toàn, con sẽ gọi mình, hay sợ bị la mà tự liều?", "Mình có tách được chuyện an toàn của con ra khỏi chuyện kỷ luật không?",), en: ("If my child were stuck somewhere unsafe tonight, would they call me, or take the risk for fear of being shouted at?", "Can I keep my child's safety separate from discipline?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 12: mang theo bên mình]
#doicau1((("Ai làm? Khai mau!", "Mẹ thấy chuyện này rồi. Mình nói chuyện về nó nha.", "Who did it? Confess!", "I've seen this. Let's talk about it."), ("Đồ ăn cắp, đồ nói dối.", "Con đã lấy tiền mà không hỏi. Việc đó sai. Giờ con sửa ra sao?", "Thief. Liar.", "You took money without asking. That was wrong. How will you put it right?"), ("Nói thật đi rồi mẹ tha. (Rồi vẫn phạt nặng.)", "Con nói thật thì mẹ không la. Hậu quả thì con vẫn sửa, mẹ giúp.", "Tell the truth and I'll let you off. (Then punishes hard anyway.)", "If you tell the truth I won't shout. You will still put it right, and I'll help."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Ba câu hỏi trước khi phản ứng: con có đang an toàn không, nhu cầu nào nằm sau việc này, hậu quả nào giúp con sửa thay vì chỉ làm con đau.", "Hậu quả tốt thì liên quan trực tiếp tới việc sai, tương xứng, có điểm kết thúc, và được nói ra bằng giọng bình thường. Xong rồi là xong, không lôi lại mỗi lần giận.", "Giữ lời hứa không la khi con nói thật, kể cả khi sự thật làm mình choáng. Phá lời hứa một lần là con học được rằng nói thật là dại.",), en: ("Three questions before reacting: is my child safe, what need lies behind this, and which consequence helps them repair rather than only hurt.", "A good consequence is directly linked to what went wrong, proportionate, has an end, and is stated in a normal voice. When it is done, it is done; do not drag it out every time you are angry.", "Keep your promise not to shout when your child tells the truth, even when the truth staggers you. Break it once and your child learns that honesty is foolish.",))
#listbox1("KHI NÀO CẦN TÌM NGƯỜI GIÚP  ·  WHEN TO SEEK HELP", crimson, rgb("FFF5F5"), ("Con dùng chất gây nghiện thường xuyên, có dấu hiệu lệ thuộc, hoặc có liên quan tới ma túy: tìm bác sĩ, cơ sở y tế chuyên khoa. Đây là việc cần chuyên môn.", "Con lấy tiền với số lượng lớn, có người lạ liên lạc đòi nợ, con vay tiền trên mạng: có thể con đang bị lừa hoặc bị ép. Lưu bằng chứng, báo công an, gọi 111.",), mark: sym.triangle.filled.small.r, en: ("Your child uses an addictive substance regularly, shows signs of dependence, or is involved with drugs: see a doctor or specialist service. This needs professional help.", "Your child takes large sums, strangers contact them about debts, or they borrow money online: they may be being scammed or coerced. Keep the evidence, report to the police, call 111.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày, cả nhà chơi trò một điều thật khó nói: mỗi tối mỗi người kể một chuyện mình làm chưa đúng trong ngày, ba mẹ kể trước, không ai được trách ai. Mục đích duy nhất là tập cho việc nói thật trở thành chuyện thường trong nhà.",), mark: sym.star.filled, en: ("For seven days the family plays one hard truth: each evening everyone tells one thing they did not do well that day, parents first, and nobody may blame anyone. The only aim is to make telling the truth ordinary at home.",))
