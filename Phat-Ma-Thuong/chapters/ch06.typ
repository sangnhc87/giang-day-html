#import "../template.typ": *

#chapter-open(6, "Nói tục, biệt danh, đùa dai", 6, "Lời nói là nơi các em thử quyền lực đầu tiên. Dạy các em dùng nó cho tử tế là việc lớn hơn bất kỳ môn nào.", "Tuổi mới lớn thích nói tục để thấy mình trưởng thành, thích đặt biệt danh để thấy mình hài hước, thích đùa dai để thấy mình có chỗ đứng. Phạt nặng thì các em nói lén, nói ở nơi khác. Chương này gợi những chiêu giúp các em tự thấy lời mình nói đi đến đâu, và học cách nói khác mà vẫn là mình.", ("Em nói tục thành thói quen", "Em đặt biệt danh xúc phạm cho bạn", "Em giấu đồ của bạn để trêu", "Em cười nhạo bạn trả lời sai", "Em đùa về ngoại hình bạn",))

#sec("Em nói tục thành thói quen")
#tinhhuong("6.1", "Em nói tục thành thói quen", "Bạn Đạt chêm một từ tục vào gần như mỗi câu. Em nói vô thức, không nhắm vào ai. Nhưng các bạn nữ xung quanh đã bắt đầu né em, và thầy nghe rõ mỗi lần.")
#chieu("Hũ từ thay thế", "Thầy đặt một chiếc hũ nhỏ trên bàn. Mỗi lần Đạt nói tục, thầy chỉ nhìn em, em tự viết từ đó vào một mảnh giấy và bỏ vào hũ, kèm một từ thay thế do em tự sáng tạo, càng hài hước càng tốt, như trời ơi đất hỡi, ôi chao quả cam. Cuối tuần thầy mở hũ đọc riêng với em, chọn từ sáng tạo nhất và tặng một điểm cộng. Cả lớp chỉ thấy cái hũ, không biết bên trong có gì.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Đạt, thầy không mắng em. Mỗi lần buột miệng, em ghi từ đó vào giấy, bỏ hũ, và nghĩ ra một từ thay thế thật vui. Cuối tuần thầy chọn từ sáng tạo nhất.")
  #tro("Dạ... em thử xem thầy.")
  #thay("Nhớ nhé, từ thay thế càng buồn cười càng tốt. Thầy chờ cuối tuần.")
]
#visao("Nói tục là phản xạ cần có hướng đi khác để thoát. Cho em một từ thay thế sáng tạo vừa giữ cái cảm giác được thoát cảm xúc, vừa bắt em tập đổi từ. Việc tự bỏ giấy vào hũ khiến em tự quan sát chính mình.")
#ranhgioi("Không đọc nội dung hũ trước lớp. Không dùng khi từ tục nhắm vào người khác như xúc phạm gia đình hay ngoại hình. Khi đó chuyển sang nói chuyện nghiêm.")
#bientau("Cả lớp thi nghĩ từ cảm thán sáng tạo nhất tuần, thầy ghi những từ hay lên một góc bảng.")
#caunoi("Mỗi lần buột miệng em ghi vào hũ và nghĩ một từ thay thế thật vui nhé.")

#sec("Em đặt biệt danh xúc phạm cho bạn")
#tinhhuong("6.2", "Em đặt biệt danh xúc phạm cho bạn", "Bạn Minh bị cả lớp gọi bằng một cái biệt danh liên quan đến cân nặng. Em cười gượng cho qua nhưng thầy thấy mắt em tối lại. Người đặt đầu tiên là bạn Hưng, vẫn coi đó là chuyện vui.")
#chieu("Biệt danh tử tế", "Thầy hẹn riêng Hưng. Thầy nói: em có tài đặt tên, thầy khâm phục. Thầy thử em nhé, em hãy đặt cho Minh một biệt danh nói về điểm mạnh của bạn. Thầy chỉ dùng nếu Minh đồng ý. Em viết ra ba ý tưởng, thầy xem và cùng chọn. Sau đó Hưng tự hỏi Minh, nếu Minh gật thì cả hai dùng từ đó. Biệt danh cũ chấm dứt một cách tự nhiên.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hưng, em có tài đặt tên thật. Thầy thách em: nghĩ cho Minh một biệt danh nói về điểm mạnh của bạn, ba ý tưởng. Rồi hỏi Minh xem bạn có thích không.")
  #tro("Dạ... thầy cho em suy nghĩ.")
  #thay("Thầy chờ. Biệt danh hay là biệt danh người được gọi thấy vui.")
]
#visao("Em đặt biệt danh thường vì muốn được chú ý và hài hước. Chiêu này giữ lại tài đó và đổi hướng nó. Việc xin phép bạn trước khi dùng dạy em tôn trọng sự đồng ý của người khác.")
#ranhgioi("Không bắt Minh phải tha thứ hay tham gia. Nếu Minh bị tổn thương sâu, làm việc riêng với Minh trước. Không công khai phạt Hưng để tránh Minh càng bị chú ý.")
#bientau("Mở tuần lễ gọi tên thật trong lớp, ai gọi biệt danh thì được nhắc nhẹ bằng một cái nháy mắt.")
#caunoi("Em có tài đặt tên. Thầy thách em đặt cho bạn một biệt danh bạn thấy vui.")

#sec("Em giấu đồ của bạn để trêu")
#tinhhuong("6.3", "Em giấu đồ của bạn để trêu", "Mấy em giấu cặp của bạn Thư để trêu, bạn đi tìm khắp lớp, mắt đỏ lên. Cả nhóm cười thích thú. Đến khi thầy hỏi mới mang trả, nói chỉ là đùa.")
#chieu("Đội tìm đồ có nghĩa vụ", "Thầy hỏi nhóm em có biết bạn Thư đã tìm bao nhiêu phút không. Rồi thầy cho cả nhóm một nhiệm vụ: sáng hôm sau đến sớm, mỗi em giúp Thư hoàn thành một việc trong buổi sáng, như xếp sách, mang ba lô, đóng cửa sổ. Thầy nói: giấu đồ làm Thư mất mười phút đời của bạn, các em trả lại mười phút bằng việc tử tế. Cuối buổi, Thư kể cảm giác nếu bạn muốn.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Các em giấu cặp làm Thư mất mười phút tìm kiếm và lo lắng. Mai các em đến sớm, mỗi em giúp Thư một việc nhỏ để trả lại mười phút đó nhé.")
  #tro("Dạ... tụi em xin lỗi, tụi em không nghĩ vậy.")
  #thay("Thầy biết các em không có ý xấu. Nhưng đùa mà người kia không cười thì không phải đùa nữa.")
]
#visao("Trò đùa dai hay bỏ qua cảm giác của người bị đùa. Việc trả lại thời gian bằng hành động cụ thể giúp các em hiểu giá trị của điều mình lấy đi, mà vẫn giữ được thể diện.")
#ranhgioi("Không bắt Thư phải chấp nhận. Nếu có dấu hiệu bắt nạt kéo dài thì không còn là đùa và cần xử lý theo cách nghiêm túc hơn với nhà trường.")
#bientau("Cho cả nhóm cùng viết một lời xin lỗi chung, mỗi em một câu, đọc riêng cho Thư.")
#caunoi("Đùa mà bạn không cười thì không phải đùa. Mai các em đến sớm giúp Thư mười phút nhé.")

#sec("Em cười nhạo bạn trả lời sai")
#tinhhuong("6.4", "Em cười nhạo bạn trả lời sai", "Bạn Hoa giơ tay trả lời, đáp sai. Có tiếng cười ở dưới và một em nói xì. Hoa cúi gằm, sau đó cả tiết không giơ tay lần nào nữa.")
#chieu("Cảm ơn người dám sai", "Thầy ghi nhận ngay tại chỗ: cảm ơn Hoa đã dám trả lời, câu trả lời sai giúp lớp thấy chỗ dễ nhầm. Sau tiết, thầy mời em cười nhạo viết một tấm thiệp hai dòng cảm ơn Hoa vì đã giúp cả lớp hiểu bài và đặt lên bàn bạn. Thầy kể thêm lần thầy từng sai ngớ ngẩn nhất. Từ đó lớp bớt cười nhạo vì đã thấy thầy cũng sai.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Cảm ơn Hoa đã dám trả lời. Câu đó sai ở chỗ rất nhiều bạn cũng sẽ nhầm. Nhờ Hoa mà cả lớp thấy chỗ cần cẩn thận.")
  #tro("(Em cười nhạo, ra chơi.) Thầy ơi, em xin lỗi vì cười Hoa.")
  #thay("Em viết cho Hoa hai dòng cảm ơn, đặt lên bàn bạn nhé. Thầy tin Hoa sẽ vui.")
]
#visao("Cười nhạo người sai làm cả lớp ngại giơ tay. Khi thầy công nhận người dám sai, chuẩn mực của lớp đổi: dám sai là đáng quý. Tấm thiệp biến người cười thành người ghi nhận.")
#ranhgioi("Không bắt em cười nhạo xin lỗi công khai, vì sẽ làm Hoa thêm bối rối. Không so sánh Hoa với bạn trả lời đúng.")
#bientau("Mở mục câu trả lời sai hay nhất tuần, chọn ra một câu trả lời sai giúp cả lớp hiểu sâu.")
#caunoi("Cảm ơn bạn dám trả lời, câu sai này giúp cả lớp hiểu rõ hơn.")

#sec("Em đùa về ngoại hình bạn")
#tinhhuong("6.5", "Em đùa về ngoại hình bạn", "Bạn Sơn nói một câu về làn da của bạn Trang, cả nhóm cười. Trang giả vờ không nghe nhưng thầy thấy em cúi mặt, sau đó em ngồi một mình ở ra chơi.")
#chieu("Ba điều thật sự đẹp", "Thầy hẹn riêng Sơn, không trách. Thầy nói: những câu đùa về ngoại hình thường làm người kia nhớ rất lâu. Thầy giao em một việc: viết ba điều thật sự đẹp ở Trang mà không liên quan ngoại hình, như tính cách, thói quen tốt, tài năng. Em đưa thầy xem, nếu chân thành thì em trao cho Trang kèm một lời xin lỗi ngắn do em tự chọn cách nói. Lần sau còn đùa ngoại hình thì thầy chỉ cần giơ ba ngón tay.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Sơn, thầy tin em không có ý ác, nhưng câu đó có thể ở lại trong lòng Trang rất lâu. Em viết ba điều thật sự đẹp ở bạn, không về ngoại hình, rồi đưa thầy xem trước.")
  #tro("Dạ... em nghĩ được ạ.")
  #thay("Nếu thật lòng, em trao cho Trang cùng một lời xin lỗi ngắn. Còn nếu chưa nghĩ ra, em cứ nói thầy biết.")
]
#visao("Em đùa về ngoại hình thường chưa ý thức hết sức nặng của lời nói. Phải tìm điều tốt thật ở bạn buộc em nhìn bạn như một con người đầy đủ. Giơ ba ngón tay là mật hiệu kín đáo giữa thầy và em.")
#ranhgioi("Không ép em xin lỗi trước cả lớp. Không để lời khen giả dối, nếu em không tìm được điều thật thì nói chuyện thêm chứ không bắt viết. Nếu đây là bắt nạt kéo dài, xử lý theo cách nghiêm hơn.")
#bientau("Cho cả lớp cùng viết một thẻ khen không về ngoại hình cho một bạn bốc thăm, gửi qua hộp thư lớp.")
#caunoi("Thầy tin em không có ý ác. Em viết ba điều thật đẹp ở Trang, không nói về ngoại hình, rồi thầy cùng xem nhé.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 6: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Lời nói tổn thương thường xuất phát từ nhu cầu được chú ý. Hãy để em dùng cùng tài năng đó cho một việc tử tế.", "Xin lỗi giả không có giá trị. Đừng ép xin lỗi trước đám đông, hãy để em tự chọn cách sửa.", "Khi đùa thành bắt nạt, đừng cố giữ chiêu nhẹ nhàng. Báo nhà trường và gia đình, bảo vệ người bị tổn thương trước.",))
