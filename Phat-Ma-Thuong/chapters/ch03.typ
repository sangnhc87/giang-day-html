#import "../template.typ": *

#chapter-open(3, "Đi trễ, quên đồ, quên bài", 3, "Quên và trễ là lỗi dễ lặp nhất. Cho nên hình phạt hay phải là loại giúp em nhớ, không phải loại giúp em sợ.", "Đi trễ, quên sách, quên bài tập, quên trực nhật là những lỗi tuần nào cũng gặp. Phạt nặng thì thầy mệt, phạt nhẹ thì lỗi lặp lại. Điều thầy cô cần là một cách làm em tự thấy cái giá của việc quên, đồng thời có công cụ để nhớ. Chương này tập trung vào chiêu phạt có phần xây dựng thói quen ở trong đó.", ("Em đi trễ nhiều lần trong tuần", "Em quên mang sách giáo khoa", "Em quên làm bài tập về nhà", "Em quên trực nhật", "Em quên dụng cụ cho tiết thực hành",))

#sec("Em đi trễ nhiều lần trong tuần")
#tinhhuong("3.1", "Em đi trễ nhiều lần trong tuần", "Bạn Phúc đã đi trễ bốn buổi trong tuần này. Lần nào em cũng xin lỗi, nhỏ giọng, nói kẹt xe. Thầy nhắc mấy lần rồi mà em vẫn trễ. Thầy chưa biết nguyên nhân thật là gì.")
#chieu("Vé vào lớp", "Mỗi lần trễ, em nhận một tờ vé nhỏ, tự điền hai dòng: lý do thật, và một việc em sẽ làm khác vào ngày mai. Em đặt vé vào hộp trên bàn thầy. Đủ ba vé trong một tuần thì thầy mời em ngồi năm phút ở ra chơi để cùng xem ba vé có gì giống nhau. Ai đến sớm năm phút trong năm ngày liên tiếp thì thầy trả lại vé và xóa sổ, kèm một lời khen công khai.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Phúc, thầy không phạt em bằng lời mắng. Mỗi lần trễ em ghi vào vé hai dòng này nhé: lý do thật là gì, và ngày mai em làm gì khác. Em ghi thật là đủ.")
  #tro("Dạ... Thật ra nhà em xa, mẹ đi làm sớm nên em phải tự ăn sáng.")
  #thay("Cảm ơn em đã nói thật. Giờ mình tìm cách cho em kịp giờ nhé, bắt đầu từ chuyện ăn sáng.")
]
#visao("Trễ là chuyện có nguyên nhân, và nguyên nhân thường nằm ngoài ý muốn của em. Tờ vé giúp em nghĩ về nguyên nhân thay vì chỉ xin lỗi. Khi thầy có đủ ba tờ vé, thầy thấy mẫu chung và giúp được thật.")
#ranhgioi("Không phạt khi nguyên nhân là chuyện nhà hay phương tiện không thể tự quyết. Không đọc vé công khai. Không dùng vé làm bằng chứng để kỷ luật.")
#bientau("Thêm một cột thưởng: ai đến sớm năm phút ba ngày liền được chọn chỗ ngồi tuần đó.")
#caunoi("Thầy cần biết lý do thật để giúp em. Em ghi vào vé, mình cùng tìm cách.")

#sec("Em quên mang sách giáo khoa")
#tinhhuong("3.2", "Em quên mang sách giáo khoa", "Hà quên sách lần thứ ba. Em ngồi chia sách với bạn bên cạnh, nhìn chung không ảnh hưởng nhiều nhưng bạn bên cạnh bị bất tiện, và thầy muốn em tự có trách nhiệm.")
#chieu("Thư viện của thầy", "Thầy cho em mượn sách của thầy, nhưng với một chút phí: em làm trợ lý đọc to đoạn đầu bài hôm nay trước lớp. Nếu em nhút nhát, thầy cho em đọc thầm rồi tóm lại bằng một câu. Cuối tiết, em trả sách và nói một điều em nhớ được. Lần sau quên nữa, em tự chọn một món nhỏ đền bù như dán thêm nhãn cho sách thư viện lớp.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Hà quên sách thì thầy cho mượn sách của thầy nhé. Phí mượn là em đọc to đoạn mở bài cho cả lớp. Em đọc rõ giúp thầy.")
  #tro("Dạ... em đọc ạ.")
  #thay("Cảm ơn em. Đọc rất rõ. Lần sau mình mượn thêm được không, hay em để quyển sách vào cặp từ tối?")
]
#visao("Quên sách thường là việc tối hôm trước chưa chuẩn bị. Phí mượn là một việc có ích, không xấu hổ, và gắn với đúng bài học. Em được đọc to nên còn luyện thêm kỹ năng, nên cái giá phải trả vừa nhẹ, vừa có lợi.")
#ranhgioi("Không công khai chê em hay hỏi dồn vì sao quên. Nếu em không có sách vì nhà khó khăn, đừng phạt mà hỗ trợ sách thật.")
#bientau("Cho em tự lên danh sách ba việc để nhớ sách và dán trong cặp.")
#caunoi("Thầy cho em mượn sách. Em giúp thầy đọc đoạn đầu cho cả lớp nhé.")

#sec("Em quên làm bài tập về nhà")
#tinhhuong("3.3", "Em quên làm bài tập về nhà", "Tiến không làm bài tập về nhà lần thứ hai trong tuần. Em nói: dạ em quên. Thầy không biết em quên thật hay em thấy không quan trọng.")
#chieu("Giấy hẹn trả", "Thầy cho em ký một tờ giấy hẹn: ngày giờ em sẽ nộp bài. Thầy nói rõ: nộp đúng hẹn thì không bị trừ điểm, và thầy còn cộng thêm một điểm cho việc giữ lời. Nếu trễ hẹn, em phải tự đưa lý do và nộp thêm một câu hỏi hay do em tự nghĩ ra thuộc bài đó. Giấy hẹn ở lại trong sổ của thầy đến cuối tháng để em thấy thầy tin em.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Tiến ơi, thầy không muốn trừ điểm em. Em ký giấy hẹn này: em hứa nộp vào chiều mai. Nộp đúng hẹn thầy còn khen. Em thấy được không?")
  #tro("Dạ được thầy. Em nộp đúng ạ.")
  #thay("Thầy tin em. Còn nếu có gì khó, ghé thầy trước khi hết hạn nhé.")
]
#visao("Học sinh quên bài thường sợ hậu quả hơn là chính bài. Giấy hẹn cho em quyền tự chọn ngày nộp, tức là cho em thấy mình chịu trách nhiệm, đồng thời cho thầy một thỏa thuận có chữ ký. Khi em giữ được lời, em tự đánh giá mình khác đi.")
#ranhgioi("Không dùng giấy hẹn cho em đang gặp chuyện nặng ở nhà. Không đưa giấy hẹn ra trước cả lớp. Nếu em quên liên tục kéo dài nhiều tuần, hỏi thẳng xem em có cần giúp đỡ gì.")
#bientau("Cho em chọn một bạn làm chứng giấy hẹn, bạn chỉ chứng kiến chứ không nhắc nhở thay.")
#caunoi("Em ký giấy hẹn nhé. Thầy tin em sẽ nộp đúng ngày.")

#sec("Em quên trực nhật")
#tinhhuong("3.4", "Em quên trực nhật", "Cả tổ ba quên trực nhật, riêng bạn Khôi quên cả hai tuần liền. Phòng học vẫn còn rác và bảng chưa lau. Các bạn khác bắt đầu phàn nàn.")
#chieu("Một ngày làm quản gia lớp", "Thầy mời Khôi làm quản gia lớp vào ngày hôm sau. Em đến sớm mười phút, đi một vòng kiểm tra bảng, bàn ghế, cửa sổ, đèn, quạt, rồi báo lại với thầy bằng mười chữ. Em có một cây bút đặc biệt đeo lên túi áo ghi chữ Quản gia. Cả ngày em thấy việc trực nhật phức tạp thế nào. Những lần sau, em tự lên danh sách nhắc cho tổ.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Khôi, ngày mai em làm quản gia lớp giúp thầy nhé. Em đến sớm mười phút, đi một vòng kiểm tra rồi báo thầy. Có bút Quản gia nữa, em đeo lên cho oai.")
  #tro("Dạ... em làm được thầy.")
  #thay("Thầy tin em. Em thấy lớp cần gì thì báo thầy luôn.")
]
#visao("Việc trực nhật là phần không ai muốn nhớ. Khi em trở thành người chịu trách nhiệm toàn bộ, em hiểu giá trị của từng việc nhỏ. Danh hiệu quản gia cho em thấy đây là một vai trò có uy chứ không phải một hình phạt.")
#ranhgioi("Không dùng việc trực nhật như hình phạt cố định, vì sẽ khiến học sinh ghét việc dọn dẹp. Không bắt em làm một mình quá hai mươi phút.")
#bientau("Tổ nào đủ mặt trực nhật ba ngày liền thì được chọn một món nhạc phát lúc ra chơi.")
#caunoi("Ngày mai em làm quản gia lớp cho thầy, em đến sớm mười phút nhé.")

#sec("Em quên dụng cụ cho tiết thực hành")
#tinhhuong("3.5", "Em quên dụng cụ cho tiết thực hành", "Tiết thực hành cần thước và compa, Linh không mang. Em ngồi nhìn các bạn làm và không dám nói. Thầy nhìn thấy nhưng em vẫn cúi đầu, rõ ràng đang ngại.")
#chieu("Dây buộc ngón tay", "Thầy không hỏi trách mà phát cho em một mảnh giấy nhớ nhỏ, nói: em dán lên bàn học ở nhà để mai nhớ. Thầy hỏi em muốn viết nội dung gì lên. Em tự viết, thầy ký tên bên dưới như người làm chứng. Sau đó thầy cho em mượn dụng cụ thầy có sẵn. Tuần sau thầy hỏi em mảnh giấy nhớ còn dán không.")
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Linh, thầy cho em mượn thước của thầy trước. Rồi thầy tặng em mảnh giấy này: em viết lên đó những thứ cần mang, dán ở bàn học nhà em.")
  #tro("Dạ... em cảm ơn thầy.")
  #thay("Tuần sau thầy hỏi lại xem mảnh giấy còn dán không nhé.")
]
#visao("Quên là lỗi của trí nhớ chứ không phải của thái độ. Một công cụ nhắc nhớ giải quyết đúng gốc, hiệu quả hơn nhiều lần so với lời trách móc. Em còn được thầy ký xác nhận nên thấy mình được tin.")
#ranhgioi("Không phạt em quên dụng cụ khi gia đình không đủ điều kiện mua. Không nói với cả lớp là em quên.")
#bientau("Cho cả lớp một phút đầu mỗi tiết kiểm tra cặp, ai thiếu gì ghi vào mảnh giấy bên bàn.")
#caunoi("Quên thì mình có cách nhớ. Em dán giấy này lên bàn học nhé.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 3: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ", rgb("1E293B"), softbg, ("Hình phạt tốt cho lỗi quên là hình phạt tặng em một công cụ để nhớ, chứ không phải một nỗi sợ để nhớ.", "Hỏi nguyên nhân thật trước khi chọn chiêu. Trễ vì xa nhà, quên vì thiếu thời gian, hay quên vì không quan tâm là ba chuyện khác nhau.", "Đừng bao giờ dùng việc dọn dẹp làm hình phạt cố định. Lao động chỉ có ý nghĩa khi em thấy mình được tin giao việc.",))
