#import "../template.typ": *

#chapter-open(13, "Nghịch phá đồ đạc, viết vẽ bậy", 13, "Một cái bàn bị vẽ bậy là một lời nhắn của em. Đọc lời nhắn trước, lau bàn sau.", "Vẽ lên bàn, khắc lên ghế, làm hỏng quạt, ném giấy khắp lớp là những lỗi thầy cô nhìn thấy ngay vì chúng để lại vết. Phạt bằng tiền hay bắt chép phạt thường không dạy được điều gì. Điều có tác dụng là để em sửa chính cái mình làm hỏng, bằng cách có ý nghĩa và có sự tự hào ở cuối. Chương này gợi những chiêu như thế.", ("Em vẽ bậy lên bàn", "Em làm hỏng đồ dùng của lớp", "Cả lớp ném giấy, phi tiêu giấy", "Em viết bậy ở nhà vệ sinh", "Em khắc tên lên cây trong sân trường",), en: ("Vandalism, scribbling, damaging property", "A defaced desk is a message from the student. Read the message first, wipe the desk afterwards.", "Drawing on desks, carving chairs, breaking fans, throwing paper around: faults you see at once because they leave a mark. Punishing with money or lines rarely teaches anything. What works is letting the student repair what he spoiled, in a meaningful way that ends with some pride. This chapter offers moves of that kind.", ("A student draws on the desk", "A student damages class equipment", "The class throws paper balls and paper planes", "A student scrawls on the toilet wall", "A student carves his name into a tree in the school yard",)))

#sec("Em vẽ bậy lên bàn", en: "A student draws on the desk")
#tinhhuong("13.1", "Em vẽ bậy lên bàn", "Thầy phát hiện một mặt bàn đầy hình vẽ nguệch ngoạc và vài câu chữ. Qua vài ngày, thầy biết là của Lâm. Em không nhận ngay nhưng khi thầy hỏi nhẹ thì cúi đầu.", en: "You find a desktop covered in doodles and a few lines of writing. After a few days you learn it was Lam. He does not own up at once, but bows his head when you ask gently.")
#chieu("Họa sĩ trả bàn", "Thầy khen trước: nét vẽ của em có hồn. Rồi thầy giao việc: em dùng nước tẩy lau sạch mặt bàn, trong giờ ra chơi có thầy ngồi cùng. Xong rồi, em được thầy mời vẽ một bức tranh nhỏ hoặc một câu thơ ngắn lên tấm bảng tin của lớp, cho phép vẽ thoải mái. Em sửa lỗi và đồng thời có nơi để thể hiện, nên không còn nhu cầu vẽ lên bàn.", en: ("The artist pays back the desk", "Praise first: your drawing has real spirit. Then assign the task: clean the desktop with cleaner at break, with you sitting beside him. When done, invite him to paint a small picture or a short poem on the class noticeboard, free to draw as he likes. He mends the fault and also has a place to express himself, so he no longer needs the desk."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Lâm, nét vẽ của em có hồn thật. Nhưng bàn là của cả lớp. Em lau sạch trong giờ ra chơi, thầy ngồi cùng. Xong rồi thầy giao em vẽ lên bảng tin lớp, vẽ thoải mái.", en: "Lam, your drawing really has spirit. But the desk belongs to the whole class. Clean it at break, I will sit with you. Afterwards I give you the class noticeboard to draw on, as freely as you like.")
  #tro("Dạ... em lau ngay thầy. Em xin lỗi.", en: "Um... I will clean it right away. I am sorry.")
  #thay("Cảm ơn em. Thầy mong thấy bức vẽ của em trên bảng tin.", en: "Thank you. I look forward to seeing your picture on the board.")
]
#visao("Em vẽ lên bàn vì cần chỗ thể hiện. Bắt em tự lau là trả giá cho hành vi. Cho em một nơi vẽ hợp lệ là đáp ứng nhu cầu gốc. Khen trước giúp em nghe lời sau mà không phòng thủ.", en: "He draws on the desk because he needs somewhere to express himself. Making him clean it pays for the act; giving him a legitimate place to draw meets the root need. Praise first helps him listen without defending.")
#ranhgioi("Không dùng nội dung bậy hay xúc phạm làm trò đùa. Nếu hình vẽ chứa lời đe dọa hay xúc phạm cụ thể một người, phải xử lý nghiêm hơn và bảo vệ người bị nhắm tới.", en: "Do not treat obscene or insulting content as a joke. If the drawing contains a threat or insults a specific person, deal with it more seriously and protect the person targeted.")
#bientau("Mở bức tường sáng tạo của lớp, mỗi tuần một em được phụ trách trang trí.", en: "Open a creative wall in the class, with one student in charge of decoration each week.")
#caunoi("Nét vẽ của em có hồn. Em lau bàn rồi mình tìm cho em một chỗ vẽ thoải mái nhé.", en: "Your drawing has spirit. Clean the desk and let us find you a place to draw freely.")

#sec("Em làm hỏng đồ dùng của lớp", en: "A student damages class equipment")
#tinhhuong("13.2", "Em làm hỏng đồ dùng của lớp", "Cái quạt trần kêu lạ, hóa ra có em tò mò nghịch công tắc làm hỏng. Cái bảng bị trầy do một nhóm chơi đùa. Không ai nhận, nhưng vài em có vẻ hiểu chuyện.", en: "The ceiling fan makes a strange noise; it turns out someone curious tampered with the switch and broke it. The board is scratched by a group fooling around. Nobody owns up, but a few seem to know.")
#chieu("Phiếu bảo trì", "Thầy nói với cả lớp: đồ hỏng không phải để tìm người đáng trách mà để tìm cách sửa. Thầy viết lên bảng một phiếu bảo trì nhỏ, ghi món hỏng và cách sửa. Em nào biết điều gì thì ghi tên và hướng giúp sửa, thầy chưa hỏi ai làm hỏng. Cuối tuần các em cùng nhân viên bảo trì làm công việc sửa chữa nhỏ, học cách vặn ốc. Nếu có em nhận, thầy ghi nhận sự trung thực hơn hành vi.", en: ("A maintenance slip", "Tell the class: broken things are not for finding someone to blame but for finding a way to mend. Write a small maintenance slip on the board, noting the broken item and how to fix it. Anyone who knows something writes a name and offers to help repair; you do not yet ask who broke it. At the end of the week they work with the caretaker on small repairs and learn to turn a screw. If anyone owns up, you value honesty above the act."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Đồ hỏng thì mình lo sửa, thầy chưa hỏi ai làm. Em nào muốn giúp sửa thì ghi tên vào phiếu này, cuối tuần mình cùng bác bảo trì học vặn ốc.", en: "Broken things we mend; I have not asked who did it. Whoever wants to help repair, write your name on this slip, and at the end of the week we learn to turn screws with the caretaker.")
  #tro("Dạ... em xin giúp thầy. Thật ra em có nghịch công tắc.", en: "Um... I would like to help, sir. Actually I did fiddle with the switch.")
  #thay("Cảm ơn em nhận. Thầy ghi nhận sự trung thực của em, và em giúp bác bảo trì nhé.", en: "Thank you for owning up. I value your honesty, and you help the caretaker.")
]
#visao("Gặng hỏi thủ phạm làm em sợ và giấu. Chuyển trọng tâm sang sửa chữa thì người làm hỏng dễ lên tiếng vì được trọng vọng như người giúp. Học việc sửa chữa cũng cho các em hiểu giá trị của đồ vật.", en: "Pressing for the culprit frightens the student into hiding. Shifting the focus to repair makes the one responsible speak up, because he is honoured as a helper. Learning repair also shows students the value of objects.")
#ranhgioi("Không áp mức đền bù tiền cho học sinh nếu quy định không cho phép. Không cho em làm việc nguy hiểm như thang cao hay điện. Nếu thiệt hại lớn, báo phụ huynh theo quy định.", en: "Do not impose money compensation on students if rules do not allow it. Do not let students do dangerous work like high ladders or electricity. If the damage is large, inform parents as regulations require.")
#bientau("Cuối học kỳ tặng lớp một biển tự hào đã giữ đồ dùng tốt.", en: "At the end of the term, award the class a badge of pride for taking care of its equipment.")
#caunoi("Đồ hỏng thì mình cùng sửa. Em nào muốn giúp bác bảo trì thì ghi tên nhé.", en: "Broken things we mend together. Whoever wants to help the caretaker, write your name.")

#sec("Cả lớp ném giấy, phi tiêu giấy", en: "The class throws paper balls and paper planes")
#tinhhuong("13.3", "Cả lớp ném giấy, phi tiêu giấy", "Giờ ra chơi vừa hết, sàn lớp ngập giấy vo tròn và máy bay giấy. Một em ném trúng đầu một bạn. Cả lớp cười ồn. Thầy vào lớp thấy cảnh hỗn độn.", en: "Break has just ended and the classroom floor is strewn with crumpled paper and paper planes. One student has hit a classmate on the head. The class is laughing loudly. You walk in on the mess.")
#chieu("Sân bóng giấy", "Thầy mỉm cười, lấy một cái thùng carton đặt giữa lớp và nói: cả lớp ném giỏi như vậy thì thi luôn, mỗi em ném một tờ giấy vào thùng từ chỗ mình ngồi. Ai ném vào là ghi một điểm cho lớp. Sau đó cả lớp gom giấy còn lại, thầy mời cả lớp thi gấp nhanh máy bay giấy từ giấy sạch, nộp cho thầy để làm trang trí. Cả lớp đổi từ phá sang chơi có luật rồi dọn sạch.", en: ("The paper ball court", "Smile, put a cardboard box in the middle of the room and say: if the whole class throws that well, let us make it a contest. Each student throws one sheet into the box from their seat. Each that lands scores a point for the class. Then everyone gathers the rest of the paper, and you invite them to race to fold paper planes from clean paper and hand them in for decorations. The class moves from wrecking to playing by rules and then tidies up."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Lớp mình ném giỏi thế thì thi luôn! Mỗi em ném một tờ vào thùng này từ chỗ ngồi, vào được thì ghi điểm cho lớp. Xong rồi cả lớp gom giấy nhé.", en: "If our class throws that well, let us make it a contest! Each throws one sheet into this box from your seat, and each that goes in scores a point for the class. Afterwards the whole class gathers the paper.")
  #tro("(Cười.) Dạ, thầy cho thi thật hả thầy?", en: "(Laughing.) You really let us compete, sir?")
  #thay("Thi thật. Nhưng ném xong thì dọn sạch trong hai phút.", en: "Really. But when we finish, we tidy up in two minutes.")
]
#visao("Nghịch phá giấy là năng lượng chưa có chỗ đi. Cho thi có luật biến phá thành chơi, nên các em tự thấy điểm dừng. Kết thúc bằng việc dọn giúp các em thấy mình chịu trách nhiệm.", en: "Paper-throwing is energy with nowhere to go. A contest with rules turns wrecking into play, so students sense the stopping point themselves. Ending with tidying shows them their responsibility.")
#ranhgioi("Không cho ném vật nhọn hay nặng. Không để trò thi kéo dài thành cuộc ồn ào. Nếu có em bị ném đau, dừng lại và chăm sóc em đó trước.", en: "Do not allow sharp or heavy objects to be thrown. Do not let the contest drag into noisy chaos. If a student is hurt by a throw, stop and care for that student first.")
#bientau("Dùng giấy gom được làm sản phẩm tái chế như hộp bút của lớp.", en: "Use the gathered paper to make recycled products, like a class pencil holder.")
#caunoi("Ném giỏi thế thì mình thi có luật, rồi cả lớp cùng dọn sạch nhé.", en: "If we throw this well, let us compete with rules and then tidy up together.")

#sec("Em viết bậy ở nhà vệ sinh", en: "A student scrawls on the toilet wall")
#tinhhuong("13.4", "Em viết bậy ở nhà vệ sinh", "Bảo vệ báo có dòng chữ xúc phạm về một bạn trong lớp được viết trên tường nhà vệ sinh. Cả lớp xì xào. Bạn bị nhắc đến rất buồn, nhưng không muốn nói.", en: "The caretaker reports an insulting line about a classmate written on the toilet wall. The class whispers. The student mentioned is very upset but does not want to speak.")
#chieu("Lau tường, viết lại lời", "Chiêu này nghiêm hơn và chỉ làm riêng. Thầy xóa dòng chữ cùng nhà trường ngay để bảo vệ bạn. Thầy không điều tra trước lớp, mà đặt một tờ giấy nhỏ lên bàn mỗi em: ai có thông tin xin nói với thầy riêng, ai đã viết có thể ghé thầy. Em nhận lỗi thì ngoài việc lau tường, em viết một lá thư không tên xin lỗi bạn bị nhắc đến, thầy chuyển thư và giữ kín.", en: ("Wipe the wall, write the words", "This move is more serious and done in private. You and the school erase the writing at once to protect the student. You do not investigate before the class but put a small slip on each desk: whoever has information is asked to tell you privately, and whoever wrote it may come to see you. A student who owns up, besides cleaning the wall, writes an unsigned letter of apology to the student named; you pass it on and keep it confidential."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("(Với cả lớp, nhẹ.) Thầy đã xóa dòng chữ trên tường. Ai biết điều gì hoặc đã viết, xin ghé thầy riêng. Thầy sẽ giữ kín và cùng em sửa.", en: "(To the whole class, gently.) I have had the writing on the wall erased. Whoever knows something or wrote it, please come to me privately. I will keep it confidential and we will put it right together.")
  #tro("(Một em ghé riêng.) Thầy, là em viết... em xin lỗi.", en: "(One student comes privately.) Sir, it was me who wrote it... I am sorry.")
  #thay("Cảm ơn em đến. Em viết một lá thư không tên xin lỗi bạn đó, thầy chuyển giúp. Còn ai đã nghe chuyện này, thầy cũng cần em giúp bạn.", en: "Thank you for coming. Write an unsigned letter of apology to that student and I will pass it on. And whoever else heard about it, I need your help too, to support that friend.")
]
#visao("Bảo vệ người bị nhắm tới là việc đầu tiên, nên xóa ngay. Giữ kín cho người nhận lỗi giúp em dám bước ra mà không sợ bị cả lớp cười. Lá thư không tên cho phép sửa lỗi mà không công khai nhục.", en: "Protecting the person targeted comes first, so wipe it at once. Keeping confidentiality for the one who owns up lets him step forward without fearing the class's laughter. The unsigned letter lets him make amends without public humiliation.")
#ranhgioi("Nếu nội dung nặng như đe dọa, quấy rối hay nhắm vào giới tính, phải báo nhà trường và xử lý theo quy định. Không bắt bạn bị nhắm tới phải gặp em viết. Không đoán mò thủ phạm.", en: "If the content is serious, such as threats, harassment or targeting gender, report to the school and handle under regulations. Do not make the targeted student meet the writer. Do not guess the culprit.")
#bientau("Thêm một buổi sinh hoạt nói về lời nói làm tổn thương bạn, không nêu tên ai.", en: "Add a session on words that hurt friends, naming nobody.")
#caunoi("Thầy đã xóa dòng chữ. Em nào biết hoặc đã viết thì ghé thầy riêng, thầy giữ kín.", en: "I have had the writing erased. Whoever knows or wrote it, come see me privately and I will keep it confidential.")

#sec("Em khắc tên lên cây trong sân trường", en: "A student carves his name into a tree in the school yard")
#tinhhuong("13.5", "Em khắc tên lên cây trong sân trường", "Giờ ra chơi, một nhóm em dùng bút bi khắc tên lên thân cây phượng, rồi khoe với nhau. Cây có vết dài. Bác bảo vệ rất tiếc, thầy cũng tiếc.", en: "At break, a group of students carve their names with ballpoint pens into the trunk of the flame tree and boast to each other. The tree has a long scar. The caretaker is very sad, and so are you.")
#chieu("Bảo mẫu của cây", "Thầy hỏi nhóm: các em có biết cây phượng này bao nhiêu tuổi không? Thầy giao nhiệm vụ: nhóm trở thành bảo mẫu của cây trong một tháng. Mỗi tuần tưới nước hai lần, nhặt lá quanh gốc, chụp ảnh ghi lại sự thay đổi. Cuối tháng viết một bản tin nhỏ về cây. Cây có tên nhóm gắn bảng nhỏ ghi: Cây này được nhóm chăm sóc. Chữ tên vẫn ở đó, nhưng giờ là tên người chăm.", en: ("Guardians of the tree", "Ask the group: do you know how old this tree is? Assign the task: for a month the group becomes the tree's guardians. Each week water it twice, pick up fallen leaves around its base, and photograph how it changes. At the end of the month write a short bulletin about the tree. A small sign by the trunk reads: this tree is cared for by the group. The names remain, but now they are the names of those who care."))
#scene("Thầy nói thế nào · gợi ý")[
  #thay("Các em khắc tên lên cây, vậy từ giờ các em là bảo mẫu của cây một tháng nhé. Tưới nước, nhặt lá, chụp ảnh ghi lại. Cuối tháng viết bản tin về cây cho lớp.", en: "You carved your names on the tree, so from now on you are the tree's guardians for a month. Water it, gather the leaves, photograph the changes. At the end of the month write a bulletin about the tree for the class.")
  #tro("Dạ... bọn em làm được thầy.", en: "Um... we can do that, sir.")
  #thay("Thầy tin. Tên các em sẽ được ghi lại trên bảng nhỏ ở gốc cây, nhưng với tư cách người chăm.", en: "I trust you. Your names will be on a small sign at the foot of the tree, as the ones who look after it.")
]
#visao("Em khắc tên để được ghi dấu. Thầy giữ lại nhu cầu được ghi dấu và đổi bằng một cách tích cực. Chăm sóc tạo gắn bó, nên các em tự không muốn làm đau cây nữa.", en: "He carves his name to leave a mark. You keep the need to leave a mark and turn it positive. Caring creates attachment, so the students no longer want to hurt the tree.")
#ranhgioi("Không bắt em làm việc dưới nắng gắt. Không dùng cây như phương tiện hạ nhục em. Nếu cây bị hại nặng, báo nhà trường để xử lý đúng cách.", en: "Do not make them work in the burning sun. Do not use the tree as a means to humiliate them. If the tree is badly damaged, report to the school to handle it properly.")
#bientau("Cả lớp cùng đặt tên cho cây và vẽ bản đồ cây xanh của trường.", en: "The whole class names the tree together and draws a map of the school's trees.")
#caunoi("Các em khắc tên lên cây thì từ nay các em là bảo mẫu của cây nhé.", en: "You carved your names on the tree, so from now on you are its guardians.")

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 13: mang theo bên mình]
#listbox1("THẦY CÔ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Em phá đồ vì cần được ghi dấu, được vận động hoặc được chú ý. Cho em một nơi hợp lệ để làm điều đó, em sẽ không phá nữa.", "Hỏi ai làm trước cả lớp thường đẩy người làm vào chỗ giấu. Hỏi ai giúp sửa, người làm tự bước ra.", "Những dòng chữ nhắm vào một người cụ thể không còn là nghịch phá. Hãy bảo vệ người đó trước rồi mới tính chuyện người viết.",), en: ("Students damage things because they need to leave a mark, move, or be noticed. Give them a legitimate place to do that and they will stop.", "Asking who did it before the class often pushes the culprit into hiding. Asking who will help mend lets him step forward on his own.", "Writing aimed at a particular person is no longer mischief. Protect that person first and consider the writer afterwards.",))
