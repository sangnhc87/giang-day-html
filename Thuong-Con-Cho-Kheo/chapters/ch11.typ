#import "../template.typ": *

#chapter-open(11, "Cái điện thoại ở giữa ba mẹ và con", 11, "Giật cái điện thoại khỏi tay con thì dễ. Khó là đặt vào bàn tay trống đó một thứ đáng hơn.", "Không có chủ đề nào gây cãi nhau trong nhà nhiều bằng cái màn hình. Ba mẹ thấy con bị nuốt mất. Con thấy ba mẹ không hiểu gì về thế giới của mình. Và cả hai bên đều cầm điện thoại nhiều hơn mình tưởng. Chương này không cho rằng màn hình là kẻ thù. Nó bàn cách đặt luật mà con chịu giữ, cách phân biệt ham chơi với lệ thuộc, và phần khó nhất: ba mẹ tự soi mình.", ("Kêu tắt máy là con nổi khùng", "Con cầm điện thoại tới hai giờ sáng", "Ba mẹ cũng dán mắt vô màn hình", "Con lén nạp tiền vào game",), en: ("The phone that sits between you and your child", "Snatching the phone from a child's hand is easy. The hard part is putting something more worthwhile into the empty hand.", "Nothing causes more arguments at home than the screen. Parents see a child being swallowed. The child sees parents who understand nothing about their world. And both sides hold a phone more than they think. This chapter does not treat screens as the enemy. It discusses rules a child will actually keep, how to tell keen play from dependence, and the hardest part: looking at ourselves.", ("Told to switch off, your child explodes", "Your child is on the phone until two in the morning", "Parents are glued to their screens too", "Your child secretly tops up a game with your money",)))

#sec("Kêu tắt máy là con nổi khùng", en: "Told to switch off, your child explodes")
#boicanh("Mẹ nói lần thứ ba: tắt game, ăn cơm. Thằng Bảo lớp 6 không ngẩng lên: chờ chút, con đang giữa trận! Mẹ bước tới rút phích cắm. Nó hét lên, quăng tay cầm, đạp ghế.", en: "Mum says it a third time: game off, dinner. Bao, in grade 6, does not look up: wait, I'm in the middle of a match! Mum walks over and pulls the plug. He yells, throws the controller and kicks the chair.")
#phanxa("À, mày dám hét với mẹ hả? Vì cái game mà hỗn với mẹ! Mẹ đập cái máy này cho coi!", "Mẹ không cần biết mình đang làm gì. Mẹ muốn phá là phá. Mình ghét mẹ, và mình sẽ chơi lén.", en: ("So you dare shout at me? Rude to your mother over a game! I'll smash this machine!", "Mum doesn't care what I'm doing. She breaks things when she wants. I hate her, and I'll play in secret."))
#scene("Tình huống 11.1 · Thử nói cách khác")[
  #me("(Hôm sau, lúc con không chơi.) Bảo, chuyện hôm qua. Mẹ rút điện giữa chừng là mẹ nóng, mẹ nhận. Còn con quăng đồ đạp ghế thì cũng không được. Hai mẹ con mình đều chưa ổn.", en: "(Next day, when he is not playing.) Bao, about yesterday. Pulling the plug mid-match was me losing my temper; I own that. And you throwing things and kicking the chair is not acceptable either. Neither of us did well.")
  #con("Tại mẹ rút lúc con đang đánh xếp hạng. Thua là con bị trừ điểm, cả đội bị con làm thua luôn.", en: "You pulled it when I was in a ranked match. If I lose, I lose points, and I made the whole team lose.")
  #me("À, có cả đội hả? Mẹ không biết. Mẹ tưởng game thì bấm dừng lúc nào cũng được.", en: "Oh, there's a team? I didn't know. I thought games could be paused any time.")
  #con("Đâu có. Một trận hai mươi phút, vô rồi là không thoát được. Thoát là bị phạt.", en: "No. A match is twenty minutes and once you're in you can't leave. If you leave you get penalised.")
  #me("Vậy là hồi giờ mẹ kêu tắt liền là mẹ kêu một chuyện con không làm được. Còn con thì không nói cho mẹ hiểu, chỉ nói chờ chút. Giờ mình tính lại. Cơm nhà mình sáu giờ rưỡi. Vậy trận cuối con phải bắt đầu trước mấy giờ?", en: "So all this time, when I said switch off right now, I was asking for something you couldn't do. And you never explained; you just said wait. Let's redo this. Dinner here is at six thirty. So your last match has to start before when?")
  #con("Trước sáu giờ. Sáu giờ năm phút mà chưa vô trận thì con không vô nữa.", en: "Before six. If I'm not in a match by five past six, I won't start one.")
  #me("Hợp lý. Mẹ sẽ báo trước: năm giờ năm mươi mẹ nói còn mười phút. Sau câu đó không mở trận mới. Còn nếu con vẫn mở?", en: "Reasonable. I'll give notice: at ten to six I'll say ten minutes left. After that, no new match. And if you start one anyway?")
  #con("Thì hôm sau con nghỉ chơi một ngày.", en: "Then no playing for a day.")
  #me("Được. Mà bữa nào rảnh chỉ mẹ coi con chơi một trận. Mẹ muốn biết cái gì mà nó hấp dẫn con dữ vậy.", en: "Agreed. And when you have time, show me a match. I want to know what makes it so gripping.")
]
#hieusau1("Game và video được thiết kế để không có điểm dừng tự nhiên, và bị cắt ngang giữa chừng gây khó chịu thật, giống người lớn đang coi phim tới đoạn gay cấn bị tắt tivi. Não trẻ chưa đủ sức tự phanh trước những thiết kế đó, nên cần cái phanh từ bên ngoài. Nhưng cái phanh hiệu quả là cái được báo trước và do con cùng đặt ra. Khi ba mẹ chịu hiểu luật chơi của trò con mê, luật nhà đặt ra mới sát thực tế và con mới thấy công bằng.", en: "Games and videos are designed without natural stopping points, and being cut off mid-way is genuinely upsetting, like having the television switched off at the climax of a film. A child's brain cannot yet brake against those designs, so it needs an outside brake. But the brake that works is one announced in advance and set together. When parents understand how the game works, the house rule fits reality and the child sees it as fair.")
#cotloi("Luật màn hình phải đặt lúc cả hai đang bình tĩnh, báo trước khi hết giờ, và sát với cách trò chơi vận hành. Rút điện giữa trận chỉ thắng được một buổi tối.", en: "Screen rules must be made when both are calm, with warning before time is up, and in line with how the game works. Pulling the plug mid-match wins only one evening.")
#lamngay1("Ngồi coi con chơi trò con thích trong mười lăm phút, hỏi con như một người muốn học: mục tiêu là gì, một ván bao lâu, con giỏi vai nào. Sau đó mới bàn luật. Con sẽ nghe người hiểu trò của nó.", en: "Watch your child play their favourite game for fifteen minutes and ask like a learner: what's the goal, how long is a round, which role are you best at? Only then discuss rules. Children listen to someone who understands their game.")
#caunoi("Chỉ mẹ coi con chơi một trận đi. Mẹ muốn hiểu rồi mình mới đặt luật cho đúng.", en: "Show me a match. I want to understand, and then we'll set rules that make sense.")
#tusoi(("Mình có biết tên trò chơi, kênh video, người nổi tiếng mà con đang mê không?", "Luật màn hình ở nhà mình hiện giờ do ai đặt, và con có được nói gì trong đó không?",), en: ("Do I know the names of the games, channels and personalities my child is into?", "Who sets the screen rules at home, and does my child have any say?",))

#sec("Con cầm điện thoại tới hai giờ sáng", en: "Your child is on the phone until two in the morning")
#boicanh("Hai giờ sáng mẹ dậy uống nước, thấy khe cửa phòng con gái lớp 9 còn hắt ánh xanh. Mấy tuần nay sáng nào Thy cũng dậy không nổi, mắt thâm, điểm tụt. Mẹ mở cửa: nó giấu vội điện thoại dưới gối.", en: "At two in the morning Mum gets up for water and sees blue light under her grade 9 daughter's door. For weeks Thy has struggled to get up, with dark circles and falling marks. Mum opens the door; Thy shoves the phone under her pillow.")
#phanxa("Hèn chi! Đưa đây, tịch thu! Từ nay khỏi điện thoại gì hết cho tới khi lên điểm!", "Mẹ rình mình. Không có điện thoại là mình mất hết bạn bè. Phải kiếm cách khác, mượn máy cũ của bạn.", en: ("No wonder! Hand it over, confiscated! No phone at all until your marks go up!", "Mum spies on me. Without a phone I lose all my friends. I'll find another way, borrow a friend's old one."))
#scene("Tình huống 11.2 · Thử nói cách khác")[
  #me("(Sáng hôm sau, chủ nhật.) Tối qua mẹ thấy con thức tới hai giờ. Mẹ không lấy điện thoại. Mẹ muốn hiểu: giờ đó con làm gì mà cuốn dữ vậy?", en: "(Next morning, Sunday.) I saw you awake until two last night. I'm not taking the phone. I want to understand: what pulls you in so much at that hour?")
  #con("Con coi clip thôi. Coi một cái rồi nó ra cái nữa, con tính coi thêm một cái là ngủ...", en: "I just watch clips. I watch one and another comes up, and I mean to watch one more and sleep...")
  #me("Rồi thành hai tiếng. Mẹ cũng bị y vậy, hôm bữa mẹ lướt tới một giờ, sáng dậy muốn xỉu. Cái đó không phải tại con yếu. Mấy ứng dụng đó có cả ngàn kỹ sư ngồi nghĩ cách cho mình không buông ra được.", en: "And then it's two hours. It happens to me too; the other day I scrolled until one and nearly fainted in the morning. It isn't you being weak. Those apps have thousands of engineers working out how to stop us letting go.")
  #con("Con biết mà con không ngừng được. Sáng nào con cũng hối hận.", en: "I know, and I still can't stop. Every morning I regret it.")
  #me("Con tự thấy vậy là quý lắm. Vậy mình đừng đọ ý chí với nó, đọ không lại đâu. Mình để nó ra xa. Mẹ đề nghị: mười giờ tối, điện thoại cả nhà sạc ngoài phòng khách. Của mẹ, của ba, của con. Không ai được ngoại lệ.", en: "That you see it yourself is precious. So let's not pit willpower against it; we'd lose. Let's put it further away. My proposal: at ten at night, the whole family's phones charge in the living room. Mine, Dad's, yours. No exceptions.")
  #con("Ba mẹ cũng để ngoài luôn hả?", en: "You two will leave yours out too?")
  #me("Để luôn. Mẹ cũng cần ngủ. Con cần báo thức thì mẹ mua cái đồng hồ.", en: "Yes. I need sleep as well. If you need an alarm I'll buy a clock.")
  #con("Còn nhóm chat tụi bạn con nhắn khuya thì sao? Sáng ra con thành người tối cổ.", en: "What about the group chat? My friends text late. In the morning I'll be a dinosaur.")
  #me("Con nói với tụi nó: mẹ tao thu máy mười giờ. Đổ hết cho mẹ. Biết đâu có đứa cũng đang mong có cớ để đi ngủ.", en: "Tell them: my mum collects phones at ten. Blame it all on me. Maybe someone else is hoping for an excuse to go to sleep.")
]
#hieusau1("Thiếu ngủ là tác hại rõ ràng và được chứng minh chắc chắn nhất của điện thoại với tuổi mới lớn. Các em cần tám tới mười tiếng ngủ mỗi đêm, và ánh sáng cùng nội dung kích thích ban khuya đẩy giấc ngủ lùi lại. Thiếu ngủ kéo theo cáu gắt, giảm tập trung, buồn bã, rất dễ bị nhầm thành hư hoặc lười. Tịch thu hẳn thì cắt luôn đời sống xã hội của con và mời gọi sự lén lút. Một quy tắc về chỗ để máy ban đêm, áp dụng cho cả nhà, giải quyết đúng phần hại nhất mà con vẫn chấp nhận được.", en: "Sleep loss is the clearest and best-proven harm phones do to teenagers. They need eight to ten hours a night, and late-night light and stimulation push sleep back. Lack of sleep brings irritability, poor concentration and low mood, easily mistaken for bad behaviour or laziness. Confiscation cuts off a child's social life and invites secrecy. A rule about where devices spend the night, applied to the whole family, addresses the most harmful part while remaining acceptable to the child.")
#cotloi("Đừng bắt con thắng một cái máy được thiết kế để không ai thắng nổi. Hãy để nó ngủ ngoài phòng khách, cùng với điện thoại của ba mẹ.", en: "Do not ask your child to beat a device built so that nobody can. Let it sleep in the living room, next to yours.")
#lamngay1("Mua một ổ sạc chung đặt ngoài phòng khách và một cái đồng hồ báo thức cho mỗi phòng ngủ. Tối nay ba mẹ là người đầu tiên cắm máy vào đó lúc mười giờ.", en: "Buy a shared charging station for the living room and an alarm clock for each bedroom. Tonight you are the first to plug in your phone at ten.")
#caunoi("Không phải tại con yếu. Cái máy đó ai cũng thua. Nên cả nhà mình cùng để nó ngoài phòng khách.", en: "It isn't that you're weak. Everybody loses to that thing. So we will all leave ours in the living room.")
#tusoi(("Điện thoại của mình tối nay ngủ ở đâu?", "Con mình ngủ được mấy tiếng mỗi đêm trong tuần vừa rồi?",), en: ("Where will my phone sleep tonight?", "How many hours did my child sleep each night this past week?",))

#sec("Ba mẹ cũng dán mắt vô màn hình", en: "Parents are glued to their screens too")
#boicanh("Bữa cơm tối. Ba vừa ăn vừa trả lời tin nhắn công việc. Mẹ lướt coi bán hàng trực tiếp. Bé Na lớp 4 kể chuyện ở lớp, kể tới lần thứ hai không ai đáp. Nó lấy máy tính bảng ra. Ba ngẩng lên: ăn cơm mà coi cái gì, cất!", en: "Dinner. Dad eats while answering work messages. Mum scrolls a live sale. Na, in grade 4, tells a story from class; by the second attempt nobody has responded. She takes out the tablet. Dad looks up: no screens at dinner, put it away!")
#phanxa("Ba mẹ làm việc mới phải coi điện thoại. Con nít thì không được, cất ngay!", "Có hai bộ luật trong nhà này. Chuyện của mình không thú vị bằng cái điện thoại của ba mẹ.", en: ("We look at phones because of work. Children don't; put it away now!", "There are two sets of rules in this house. My story is less interesting than my parents' phones."))
#scene("Tình huống 11.3 · Thử nói cách khác")[
  #con("Sao ba mẹ coi được mà con không được coi?", en: "Why can you look and I can't?")
  #ba("(Định quát, rồi khựng lại. Đặt điện thoại xuống, úp mặt máy.) ...Con nói đúng. Ba kêu con cất mà ba cầm nãy giờ.", en: "(About to snap, then stops. Puts the phone down, face down.) ...You're right. I told you to put it away while holding mine all this time.")
  #con("Con kể chuyện bạn Mít hai lần mà không ai nghe hết.", en: "I told the story about Mit twice and nobody listened.")
  #me("(Cũng đặt máy xuống.) Mẹ xin lỗi Na. Mẹ nghe mà không vô đầu. Con kể lại lần nữa được không? Lần này mẹ nghe đàng hoàng.", en: "(Puts hers down too.) I'm sorry, Na. I heard but it didn't go in. Would you tell it again? This time I'll listen properly.")
  #con("Thôi, con hết muốn kể rồi.", en: "Never mind, I don't feel like it now.")
  #ba("Ừ, kể hai lần mà không ai nghe thì ba cũng hết muốn kể. Ba mẹ sai chỗ này. Vậy từ mai nhà mình có luật mới, cho cả ba người: giờ cơm, điện thoại nằm trên kệ. Ai cầm thì rửa chén.", en: "Yes, if I'd told something twice and nobody listened, I wouldn't want to either. We were wrong here. So from tomorrow there's a new rule for all three of us: at dinner, phones stay on the shelf. Whoever picks one up washes the dishes.")
  #con("Ba cũng rửa hả?", en: "You too, Dad?")
  #ba("Ba cầm thì ba rửa. Con làm trọng tài.", en: "If I pick it up, I wash. You're the referee.")
  #con("(Cười.) Vậy ba rửa chén dài dài rồi. ...Mà bạn Mít hôm nay đem con chuột hamster vô lớp, nó sổng ra...", en: "(Laughs.) Then you'll be washing dishes for a long time. ...Anyway, today Mit brought his hamster to class and it got out...")
]
#hieusau1("Trẻ học cách dùng màn hình từ việc quan sát ba mẹ nhiều hơn là từ lời dặn. Khi ba mẹ nhìn điện thoại lúc con đang nói, con nhận một thông điệp rất rõ dù không ai nói ra: thứ trong máy quan trọng hơn con. Trẻ nhỏ sẽ quấy để giành lại sự chú ý. Trẻ lớn thì thôi không kể nữa và quay vào màn hình của riêng mình. Một luật chung mà ba mẹ cũng chịu hậu quả khi phạm là thứ thuyết phục nhất, vì trẻ con cực kỳ nhạy với chuyện công bằng.", en: "Children learn screen habits by watching parents far more than by listening to them. When a parent looks at a phone while a child is speaking, the child receives a very clear unspoken message: what is in there matters more than you. Small children act up to win attention back. Older ones stop telling and turn to a screen of their own. A shared rule under which parents also bear the consequence is the most persuasive, because children are extremely sensitive to fairness.")
#cotloi("Con không làm theo lời ba mẹ nói. Con làm theo việc ba mẹ làm. Muốn con buông điện thoại, ba mẹ buông trước.", en: "Children do not do what we say. They do what we do. If you want your child to put the phone down, put yours down first.")
#lamngay1("Chọn một khung giờ không màn hình cho cả nhà, bắt đầu từ bữa cơm tối. Đặt một cái rổ hoặc cái kệ làm chỗ để máy. Cho con làm trọng tài bắt lỗi ba mẹ.", en: "Choose one screen-free time for everyone, starting with dinner. Set out a basket or shelf for the devices. Let your child be the referee who catches the parents.")
#caunoi("Con nói đúng, ba cũng cầm điện thoại nãy giờ. Từ mai luật này áp dụng cho cả ba.", en: "You're right, I've been holding my phone this whole time too. From tomorrow the rule is for all three of us.")
#tusoi(("Hôm nay mình mở điện thoại bao nhiêu lần trước mặt con? Thử coi mục thống kê thời gian sử dụng.", "Lần gần nhất con nói chuyện mà mình nhìn con trọn vẹn, không liếc màn hình, là khi nào?",), en: ("How many times did I open my phone in front of my child today? Check the screen-time statistics.", "When did I last look at my child fully while they talked, without a glance at a screen?",))

#sec("Con lén nạp tiền vào game", en: "Your child secretly tops up a game with your money")
#boicanh("Tin nhắn ngân hàng báo: tài khoản của mẹ bị trừ tổng cộng hai triệu ba trong một tuần, toàn giao dịch nạp game. Thằng Tín lớp 7 đã lấy điện thoại mẹ lúc mẹ tắm, tự xác nhận mã rồi xóa tin nhắn.", en: "A bank message arrives: 2.3 million dong has left Mum's account in a week, all game top-ups. Tin, in grade 7, took her phone while she showered, confirmed the codes and deleted the messages.")
#phanxa("Mày ăn cắp tiền của mẹ! Hai triệu ba là mẹ làm mấy ngày mới có! Mới bây lớn đã trộm cắp, sau này đi tù!", "Mình là thằng ăn cắp, sau này đi tù. Mẹ đã phán vậy rồi.", en: ("You stole my money! It takes me days to earn 2.3 million! So young and already a thief; you'll end up in prison!", "I am a thief and I will end up in prison. Mum has already ruled on it."))
#scene("Tình huống 11.4 · Thử nói cách khác")[
  #me("(Gọi con ra, đặt điện thoại lên bàn, mở sao kê.) Tín, mẹ thấy mấy khoản này. Mẹ đang rất giận và rất buồn, mẹ nói trước để con biết. Nhưng mẹ muốn nghe con.", en: "(Calls him over, puts the phone on the table with the statement open.) Tin, I've seen these payments. I am very angry and very sad; I'm telling you that first. But I want to hear you.")
  #con("(Cúi mặt, lâu.) ...Con nạp. Con xin lỗi mẹ.", en: "(Head down, a long time.) ...I topped up. I'm sorry, Mum.")
  #me("Con nhận, không chối. Mẹ ghi nhận. Giờ nói mẹ nghe: con nạp để làm gì?", en: "You admit it without denying. I note that. Now tell me: what was it for?")
  #con("Mua trang phục cho nhân vật. Tụi bạn con đứa nào cũng có. Con chơi nhân vật mặc định tụi nó kêu con là thằng nghèo.", en: "Outfits for my character. All my friends have them. I play with the default one and they call me the poor kid.")
  #me("Bị kêu vậy chắc tức lắm. Mẹ hiểu vì sao con muốn. Nhưng cách con lấy thì mẹ gọi đúng tên của nó: lấy tiền của người khác mà không hỏi, rồi xóa tin nhắn để giấu. Con có biết hai triệu ba mẹ làm bao lâu không?", en: "That must sting. I see why you wanted it. But I will call the way you got it by its name: taking someone's money without asking, then deleting messages to hide it. Do you know how long it takes me to earn 2.3 million?")
  #con("Con không biết.", en: "No.")
  #me("Gần sáu ngày công. Sáu ngày mẹ đứng bán từ sáng tới tối. Giờ theo con, chuyện này phải sửa làm sao?", en: "Nearly six working days. Six days standing at my stall from morning to night. So, how do you think this should be put right?")
  #con("Con trả lại mẹ. Mà con không có tiền.", en: "I'll pay you back. But I don't have money.")
  #me("Con có tiền lì xì trong heo, tiền tiêu vặt mỗi tuần, và hai bàn tay. Mình tính: heo đất trả một phần, tiền tiêu vặt trừ một nửa trong mười tuần, phần còn lại con làm thêm việc nhà để trả, mẹ ghi sổ. Trả hết thì xong, mẹ không nhắc lại nữa. Còn thẻ ngân hàng mẹ sẽ gỡ khỏi máy, cái đó là phần mẹ phải làm cho kỹ từ đầu.", en: "You have New Year money in your piggy bank, weekly pocket money, and two hands. Let's work it out: the piggy bank pays part, half your pocket money for ten weeks, and the rest you earn with extra chores, which I'll record. When it's paid, it's over and I won't bring it up again. And I'll remove the bank card from the phone; that part I should have done properly from the start.")
  #con("Dạ. Mẹ còn tin con không?", en: "Okay. Do you still trust me?")
  #me("Lòng tin giống cái heo đất, con làm bể rồi thì bỏ lại từng đồng. Mẹ tin là con bỏ lại được. Và lần sau muốn thứ gì, con tới xin, mẹ có thể nói không, nhưng mình nói chuyện đàng hoàng.", en: "Trust is like a piggy bank: you broke it, so now you put coins back one at a time. I believe you can. And next time you want something, come and ask. I might say no, but we'll talk about it properly.")
]
#hieusau1("Game hiện đại bán vật phẩm bằng những cơ chế tâm lý rất tinh vi: khan hiếm, so bì với bạn bè, mua bằng tiền ảo để quên giá thật. Trẻ mười hai mười ba tuổi chưa đủ khả năng cưỡng lại và chưa cảm được giá trị của tiền. Điều đó giải thích hành vi nhưng không xóa trách nhiệm. Cách dạy hiệu quả là quy tiền ra ngày công lao động thật và để con bồi hoàn bằng chính tiền và sức của mình, có điểm kết thúc rõ ràng. Đồng thời ba mẹ đóng lại cánh cửa kỹ thuật: gỡ thẻ, đặt mật khẩu thanh toán.", en: "Modern games sell items using sophisticated psychology: scarcity, comparison with friends, virtual currency that hides the real price. Twelve and thirteen-year-olds cannot yet resist these and do not yet feel the value of money. That explains the behaviour but does not erase responsibility. The effective approach is to translate the money into real working days and have the child repay with their own money and effort, with a clear end point. At the same time, close the technical door: remove the card, set a payment password.")
#cotloi("Gọi đúng tên việc làm, không gọi tên con người. Để con bồi hoàn tới nơi, rồi khép chuyện lại, không nhắc mãi.", en: "Name the act, not the person. See the repayment through, then close the matter and do not keep bringing it up.")
#lamngay1("Kiểm tra ngay điện thoại của mình: thẻ có đang lưu sẵn trong kho ứng dụng không, mua hàng có cần mật khẩu không. Rồi nói với con một lần về việc một giờ làm của ba mẹ đổi được bao nhiêu tiền, bằng con số thật.", en: "Check your phone now: is a card saved in the app store, do purchases need a password? Then tell your child once, with a real figure, how much one hour of your work earns.")
#caunoi("Lòng tin giống cái heo đất. Bể rồi thì mình bỏ lại từng đồng. Mẹ tin con bỏ lại được.", en: "Trust is like a piggy bank. Once broken, we put coins back one at a time. I believe you can.")
#tusoi(("Con mình có hiểu tiền trong nhà tới từ đâu và ba mẹ đổi nó bằng gì không?", "Khi con làm sai chuyện tiền bạc, mình có cho con con đường để sửa xong, hay mình nhắc lại chuyện đó mỗi lần giận?",), en: ("Does my child understand where the family's money comes from and what we give up to earn it?", "When my child does wrong with money, do I give them a way to finish making it right, or do I bring it up every time I'm angry?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 11: mang theo bên mình]
#doicau1((("Suốt ngày ôm cái điện thoại!", "Mẹ thấy con cầm máy từ chiều. Tới giờ mình thỏa thuận rồi đó con.", "Glued to that phone all day!", "I've seen you on it since the afternoon. It's the time we agreed on."), ("Tịch thu, khỏi chơi gì nữa!", "Mình có luật rồi. Hôm nay con quá giờ nên mai nghỉ một ngày, như con đã chọn.", "Confiscated, no more playing at all!", "We have a rule. You went over today, so tomorrow is a day off, as you chose."), ("Game là thứ vô bổ.", "Trò này có gì hay, chỉ ba coi với.", "Games are a waste of time.", "What's good about this game? Show me."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Ba cái mốc đáng giữ nhất: không màn hình trong bữa ăn, không điện thoại trong phòng ngủ ban đêm, và bài vở xong trước khi chơi. Giữ được ba cái này là giữ được phần lớn.", "Ham chơi khác với lệ thuộc. Đáng lo khi con bỏ ăn bỏ ngủ, bỏ hết bạn bè và sở thích ngoài đời, nói dối và lấy tiền để chơi, và trở nên bồn chồn, hung hăng mỗi khi không có máy, kéo dài nhiều tháng.", "Màn hình lấp vào chỗ trống. Mỗi giờ muốn con rời máy cần một thứ thật để thay: một trái banh, một người bạn, một việc làm chung với ba mẹ.",), en: ("The three markers most worth keeping: no screens at meals, no phones in bedrooms at night, and schoolwork before play. Hold these three and you hold most of it.", "Keen play is not dependence. Be concerned when a child skips meals and sleep, drops all offline friends and interests, lies and takes money to play, and becomes restless or aggressive whenever the device is absent, for many months.", "Screens fill a gap. Every hour you want your child off the device needs something real to replace it: a ball, a friend, something done with a parent.",))
#listbox1("KHI NÀO CẦN TÌM NGƯỜI GIÚP  ·  WHEN TO SEEK HELP", crimson, rgb("FFF5F5"), ("Con có đủ các dấu hiệu lệ thuộc nói trên và gia đình đã thử đặt luật nhiều lần không được: nên đưa con gặp chuyên viên tâm lý hoặc bác sĩ tâm thần nhi. Đừng tự xử bằng cách cắt đột ngột hoàn toàn hay gửi con vào những nơi cai nghiện game không rõ chuyên môn.",), mark: sym.triangle.filled.small.r, en: ("Your child shows all the signs of dependence above and the family has tried rules many times without success: see a psychologist or child psychiatrist. Do not handle it by cutting off everything suddenly or by sending your child to gaming rehab centres of unclear expertise.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày, mỗi tối cả nhà có ba mươi phút không màn hình làm chung một việc: đi bộ, chơi cờ, nấu ăn, lau nhà mở nhạc. Con chọn việc cho ba ngày, ba mẹ chọn bốn ngày.",), mark: sym.star.filled, en: ("For seven days, the family spends thirty screen-free minutes each evening doing something together: walking, chess, cooking, cleaning with music on. Your child chooses for three days, you for four.",))
