#import "../template.typ": *

#chapter-open(2, "Nghe sao cho con chịu nói", 2, "Con không ngừng kể vì hết chuyện. Con ngừng kể vì mỗi lần kể xong lại thấy mệt hơn.", "Nhiều ba mẹ than: con càng lớn càng ít nói, hỏi gì cũng bình thường, không có gì. Ít ai nhớ rằng hồi năm sáu tuổi, chính đứa trẻ đó nói suốt ngày không ngừng. Cánh cửa ấy không tự nhiên đóng. Nó khép lại từng chút một, sau mỗi lần con kể mà nhận về lời dạy, lời chê, hay một cái gật đầu của người đang nhìn điện thoại. Tin tốt là cửa khép từ từ thì cũng mở lại từ từ được.", ("Hỏi gì con cũng trả lời bình thường", "Con vừa kể là mình đã dạy", "Con chỉ mở lời lúc mười một giờ đêm", "Con nói một câu làm mình sốc",), en: ("Listening so your child will talk", "Children do not stop talking because they run out of stories. They stop because each time they told one, they felt worse afterwards.", "Many parents complain: the older my child gets, the less they say; every answer is fine or nothing. Few recall that at five or six this same child talked all day long. That door did not close by itself. It closed a little each time the child shared something and got back a lecture, a criticism, or a nod from someone looking at a phone. The good news: a door that closed slowly can open slowly too.", ("Every answer is fine", "Your child starts to tell and you start to teach", "Your child only opens up at eleven at night", "Your child says something that shocks you",)))

#sec("Hỏi gì con cũng trả lời bình thường", en: "Every answer is fine")
#boicanh("Chiều nào đón con, mẹ cũng hỏi một câu: hôm nay học sao con? Thằng Minh lớp 8 đáp gọn lỏn: bình thường. Rồi đeo tai nghe. Mẹ hỏi thêm thì nó nhăn mặt: mẹ hỏi hoài.", en: "Every afternoon at pick-up Mum asks the same question: how was school? Minh, in grade 8, answers flatly: fine. Then the earphones go in. If she asks more, he frowns: you keep asking.")
#phanxa("Hỏi có một câu mà cũng không trả lời đàng hoàng. Nuôi cho lớn rồi coi ba mẹ như người dưng.", "Mẹ không hỏi vì muốn biết mình ra sao. Mẹ hỏi để kiểm tra, và mình lại vừa bị chấm rớt.", en: ("One simple question and you can't answer properly. We raise you and you treat us like strangers.", "Mum is not asking because she wants to know how I am. She is checking, and I have just failed the check again."))
#scene("Tình huống 2.1 · Thử nói cách khác")[
  #me("(Hôm sau, không hỏi chuyện học. Đưa con ly trà sữa.) Mẹ mua đại vị này, không biết con còn thích không.", en: "(Next day, no school questions. Hands him a milk tea.) I just picked this flavour. I don't know if you still like it.")
  #con("Cũng được. Mà sao bữa nay mẹ mua?", en: "It's okay. Why did you buy it today?")
  #me("Tại mẹ thèm, mua một mình thì kỳ. Mà nè, hôm nay ở chỗ làm mẹ gặp một chuyện tức cười lắm, con nghe không?", en: "I was craving one and it felt odd to buy just one. By the way, something funny happened at work today. Want to hear?")
  #con("Chuyện gì?", en: "What?")
  #me("(Kể một chuyện ngắn, có cả phần mình bị quê.) ...Mẹ đứng hình luôn. Tới giờ nghĩ lại còn mắc cỡ.", en: "(Tells a short story that includes her own embarrassing moment.) ...I just froze. I still blush thinking about it.")
  #con("(Cười.) Lớp con bữa nay cũng có vụ quê y vậy. Thằng Tín đang ngủ gục bị thầy kêu, nó đứng dậy trả lời môn khác luôn.", en: "(Laughs.) Something just like that happened in my class today. Tin was asleep, the teacher called on him, and he stood up and answered for a different subject.")
  #me("Trời đất, rồi thầy nói sao?", en: "Oh no, what did the teacher say?")
  #con("Thầy cười, cả lớp cười. Mà thầy đó dễ, chứ gặp cô Toán là xong...", en: "He laughed, everyone laughed. That teacher is easy-going. With the maths teacher he'd be finished...")
]
#hieusau1("Câu hôm nay học sao nghe thì là hỏi thăm, nhưng với tuổi mới lớn nó mang mùi kiểm tra, và câu trả lời an toàn nhất cho một bài kiểm tra là nói càng ít càng tốt. Trẻ tuổi này mở lời theo kiểu có qua có lại: người lớn kể một chuyện thật của mình trước, có chút vụng về trong đó, thì con thấy mình được mời vào một cuộc nói chuyện ngang hàng. Ngồi cạnh nhau trên xe, cùng ăn một món cũng dễ nói hơn là ngồi đối diện nhìn thẳng vào mắt.", en: "How was school sounds like caring, but to a teenager it smells of inspection, and the safest answer to an inspection is to say as little as possible. Teenagers open up through exchange: when an adult first shares something real, including a little clumsiness, the child feels invited into a conversation between equals. Sitting side by side in a car or sharing a snack is also easier than sitting face to face with eyes locked.")
#cotloi("Muốn con kể chuyện của con, ba mẹ thử kể chuyện của mình trước. Và đừng chấm điểm câu chuyện con vừa kể.", en: "If you want to hear your child's stories, try telling one of yours first. And do not grade the story they have just told.")
#lamngay1("Tối nay đổi câu hỏi. Thay cho hôm nay học sao, thử một trong ba câu: Hôm nay có gì làm con mắc cười không? Giờ ra chơi con làm gì? Hôm nay con thấy ai dễ thương nhất? Hỏi một câu thôi, rồi nghe.", en: "Change the question tonight. Instead of how was school, try one of these: Did anything make you laugh today? What did you do at break? Who was the kindest person you saw today? One question only, then listen.")
#caunoi("Hôm nay mẹ có chuyện này tức cười lắm, con nghe không?", en: "Something funny happened to me today. Want to hear?")
#tusoi(("Trong mười câu mình nói với con mỗi ngày, mấy câu là hỏi, nhắc, dặn, và mấy câu chỉ là trò chuyện?", "Con biết gì về một ngày đi làm của mình?",), en: ("Of the ten things I say to my child each day, how many are questions, reminders and instructions, and how many are simply conversation?", "What does my child know about a day in my working life?",))

#sec("Con vừa kể là mình đã dạy", en: "Your child starts to tell and you start to teach")
#boicanh("Bé Thảo lớp 6 về nhà mặt xụ, kể: bạn Ngân rủ cả nhóm đi ăn mà không rủ con. Ba đang rửa chén, nghe chưa hết câu đã có sẵn lời giải.", en: "Thao, in grade 6, comes home with a long face: her friend Ngan invited the whole group out to eat and left her out. Dad is washing dishes and has a solution before she finishes.")
#phanxa("Thì tại con sao đó người ta mới không rủ. Con phải coi lại mình. Mà bạn bè vậy thì nghỉ chơi, lo học đi.", "Kể ra là bị nói mình sai. Lần sau buồn thì tự giữ lấy.", en: ("You must have done something or they would have asked you. Take a look at yourself. And if they are like that, drop them and focus on studying.", "If I tell, I am told I am wrong. Next time I'm sad, I'll keep it to myself."))
#scene("Tình huống 2.2 · Thử nói cách khác")[
  #ba("(Tắt vòi nước, lau tay, quay lại.) Cả nhóm đi mà không rủ con hả? Nghe là thấy tủi rồi.", en: "(Turns off the tap, dries his hands, turns around.) The whole group went and didn't ask you? That would hurt anyone.")
  #con("Dạ. Con thấy tụi nó đăng hình. Con ngồi ngay đó mà không ai nói gì với con hết.", en: "Yes. I saw the photos they posted. I was sitting right there and nobody said anything to me.")
  #ba("Con thấy hình rồi mới biết. Cái đó còn đau hơn nữa.", en: "You only found out from the photos. That hurts even more.")
  #con("Con không biết con làm gì sai. Hôm qua con với Ngân còn nói chuyện bình thường.", en: "I don't know what I did wrong. Yesterday Ngan and I were talking like normal.")
  #ba("Tức là con đang vừa buồn vừa rối, không hiểu chuyện gì. Con muốn ba nghe thôi, hay muốn ba cùng nghĩ coi làm gì?", en: "So you are sad and confused at the same time, not knowing what happened. Do you want me just to listen, or to think with you about what to do?")
  #con("Ba nghe thôi. ...Mà chắc mai con hỏi thẳng Ngân.", en: "Just listen. ...Maybe tomorrow I'll ask Ngan straight out.")
  #ba("Ừ. Con tính hỏi sao?", en: "Okay. How will you ask?")
  #con("Con hỏi nhẹ nhẹ thôi. Kiểu bữa đó tụi bây đi ăn hả, lần sau rủ tao với.", en: "Gently. Something like, you guys went out the other day? Ask me next time.")
]
#hieusau1("Khi con kể chuyện buồn, bộ não người lớn nhảy ngay sang chế độ sửa chữa, vì nhìn con buồn mình khó chịu. Nhưng lời khuyên đưa ra quá sớm mang một thông điệp ngầm: cảm xúc của con là thứ cần dẹp đi cho nhanh. Gọi đúng tên cảm xúc của con, tủi, rối, bực, làm cho cơn xúc động dịu xuống thấy rõ, và một đứa trẻ đã dịu lại thường tự nghĩ ra cách giải quyết, nhiều khi hay hơn cách của ba mẹ.", en: "When a child shares something painful, the adult brain jumps straight into repair mode, because watching a child hurt is uncomfortable. But advice given too early carries a hidden message: your feeling is something to get rid of quickly. Naming the feeling accurately, hurt, confused, annoyed, visibly calms the emotion, and a calmer child often finds a solution alone, sometimes better than ours.")
#cotloi("Con kể chuyện buồn không phải để xin lời giải. Con kể để khỏi phải buồn một mình.", en: "A child does not share sadness to get a solution. They share so they do not have to be sad alone.")
#lamngay1("Lần tới con kể chuyện gì, tập ba bước: dừng tay, nhắc lại ý con bằng lời mình, rồi hỏi câu này: Con muốn ba mẹ nghe thôi, hay muốn ba mẹ góp ý? Con chọn gì thì làm đúng vậy.", en: "Next time your child tells you something, practise three steps: stop what you are doing, repeat their point in your own words, then ask: Do you want me just to listen, or to give ideas? Do exactly what they choose.")
#caunoi("Con muốn ba nghe thôi, hay muốn ba cùng nghĩ cách?", en: "Do you want me just to listen, or to think it through with you?")
#tusoi(("Lần gần nhất mình để con nói hết một chuyện mà không chen vào là khi nào?", "Khi mình buồn mà người khác vội khuyên, mình thấy sao?",), en: ("When did I last let my child finish a whole story without interrupting?", "When I am sad and someone rushes to advise me, how do I feel?",))

#sec("Con chỉ mở lời lúc mười một giờ đêm", en: "Your child only opens up at eleven at night")
#boicanh("Cả ngày con bé Hân lớp 10 không nói gì. Mười một giờ đêm, mẹ sắp ngủ, nó lò dò qua phòng: mẹ ngủ chưa? Mẹ mệt rã rời, mai còn họp sớm.", en: "All day Han, in grade 10, says nothing. At eleven, when Mum is about to sleep, she drifts into the bedroom: Mum, are you asleep? Mum is exhausted and has an early meeting.")
#phanxa("Giờ này còn chưa ngủ? Có gì mai nói, đi ngủ đi con.", "Chuyện của mình không đáng để mẹ thức thêm mười phút. Mai thì mình hết muốn nói rồi.", en: ("Still awake at this hour? Whatever it is, tell me tomorrow. Go to bed.", "My problem is not worth ten more minutes of Mum's time. By tomorrow I won't want to say it."))
#scene("Tình huống 2.3 · Thử nói cách khác")[
  #me("Chưa ngủ. Vô đây con. (Dịch ra, vỗ chỗ trống trên giường.)", en: "Not yet. Come in. (Moves over, pats the empty space on the bed.)")
  #con("Không có gì đâu... Con hỏi vậy thôi.", en: "It's nothing... I was just asking.")
  #me("Ừ. Vậy nằm đây với mẹ chút cho vui. Lâu rồi hai mẹ con không nằm chung.", en: "All right. Then lie here with me for a bit. It's been a while since we did that.")
  #con("(Im một lúc lâu.) Mẹ ơi, hồi đó mẹ có bao giờ thấy mình không giỏi cái gì hết không?", en: "(Silent for a long time.) Mum, did you ever feel like you weren't good at anything?")
  #me("Có chứ. Năm lớp 11 mẹ thấy vậy suốt. Con đang thấy vậy hả?", en: "Oh yes. In grade 11 I felt that all the time. Is that how you're feeling?")
  #con("Dạ. Lớp con ai cũng có cái gì đó. Đứa giỏi Anh, đứa vẽ đẹp. Con thì không có gì.", en: "Yes. Everyone in my class has something. One is good at English, one draws well. I have nothing.")
  #me("Nằm một mình mà ôm suy nghĩ đó thì nặng lắm. Con kể mẹ nghe thêm đi, mẹ không buồn ngủ đâu.", en: "Lying alone with that thought is heavy. Tell me more; I'm not sleepy.")
]
#hieusau1("Tuổi mới lớn có đồng hồ sinh học lệch về khuya, và bóng tối, sự yên tĩnh làm các em bớt ngại. Vì vậy những chuyện thật nhất thường ló ra vào giờ bất tiện nhất, và thường bắt đầu bằng một câu thăm dò rất bâng quơ. Câu không có gì đâu là con đang thử xem cửa có mở thật không. Mười lăm phút thiếu ngủ của ba mẹ đổi lấy thông điệp con sẽ giữ rất lâu: lúc nào con cần, ba mẹ cũng ở đó.", en: "Teenagers' body clocks run late, and darkness and quiet make them less self-conscious. So the truest things tend to surface at the most inconvenient hour, usually opened with a very casual test question. It's nothing is the child checking whether the door is really open. Fifteen minutes of lost sleep buys a message your child will keep for years: whenever I need them, my parents are there.")
#cotloi("Con không chọn giờ tiện cho ba mẹ để mở lòng. Con chọn lúc con đủ can đảm. Lúc đó hiếm lắm, đừng hẹn lại.", en: "Children do not pick a convenient time to open their hearts. They pick the moment they find the courage. That moment is rare; do not reschedule it.")
#lamngay1("Tối nay trước khi ngủ, ghé phòng con hai phút, không kiểm tra bài, không nhắc gì. Chỉ ngồi mép giường hỏi: hôm nay của con ổn không? Rồi chúc ngủ ngon. Làm đều thì tới ngày con có chuyện, con biết phải tìm ai.", en: "Tonight, before bed, stop by your child's room for two minutes. No homework check, no reminders. Sit on the edge of the bed and ask: was your day okay? Then say goodnight. Do it regularly, and on the day something happens, your child will know who to find.")
#caunoi("Mẹ chưa ngủ đâu. Vô đây với mẹ.", en: "I'm not asleep yet. Come in.")
#tusoi(("Con hay bắt chuyện với mình vào lúc nào trong ngày? Lúc đó mình thường đang làm gì?", "Câu thăm dò quen thuộc của con mình là câu gì?",), en: ("At what time of day does my child usually start a conversation with me? What am I usually doing then?", "What is my child's usual test question?",))

#sec("Con nói một câu làm mình sốc", en: "Your child says something that shocks you")
#boicanh("Đang ăn cơm, thằng Phúc lớp 9 buông một câu tỉnh rụi: lớp con có mấy đứa hút pod trong nhà vệ sinh. Mẹ khựng đũa. Trong đầu mẹ nổ ra cả chục câu hỏi cùng lúc.", en: "At dinner, Phuc, in grade 9, drops a casual line: some kids in my class vape in the toilets. Mum's chopsticks stop. A dozen questions explode in her head at once.")
#phanxa("Cái gì?! Con có hút không? Đứa nào? Con mà chơi với tụi nó là chết với mẹ! Mai mẹ lên gặp cô!", "Kể chuyện thật là bị hỏi cung, và bạn mình sẽ gặp rắc rối vì mình. Từ nay chuyện gì cũng nói không biết.", en: ("What?! Do you vape? Who are they? If you hang out with them you are in big trouble! Tomorrow I'm going to see your teacher!", "Telling the truth gets me interrogated, and my friends will be in trouble because of me. From now on I know nothing."))
#scene("Tình huống 2.4 · Thử nói cách khác")[
  #me("(Gắp tiếp miếng cá, giữ giọng bình thường.) Vậy hả. Trong nhà vệ sinh luôn?", en: "(Takes another piece of fish, keeps her voice normal.) Really. In the toilets?")
  #con("Dạ. Giờ ra chơi. Mùi trái cây thơm lắm, cô đi ngang cũng không biết.", en: "Yes. At break. It smells like fruit; teachers walk past and don't notice.")
  #me("Mẹ cảm ơn con kể cho mẹ nghe. Con thấy cảnh đó thì con nghĩ sao?", en: "Thank you for telling me. When you see that, what do you think?")
  #con("Con thấy bình thường. Tụi nó nói cái đó không hại như thuốc lá.", en: "It seems normal. They say it's not as harmful as cigarettes.")
  #me("Ừ, mẹ cũng nghe nhiều người nói vậy. Mẹ thì đọc được là nó vẫn có nicotine, hút vài tuần là ghiền, mà phổi tuổi tụi con còn đang lớn. Có ai mời con chưa?", en: "Yes, I've heard many people say that. What I have read is that it still contains nicotine, people get hooked within weeks, and lungs at your age are still growing. Has anyone offered you one?")
  #con("Có một lần. Con nói con bị suyễn nên thôi.", en: "Once. I said I have asthma and that was that.")
  #me("Con từ chối khéo ghê. Lần đó con có thấy khó không?", en: "That was a smart way to say no. Was it hard?")
  #con("Hơi khó. Tại tụi nó nhìn mình kiểu nhát.", en: "A bit. They look at you like you're a coward.")
  #me("Bị nhìn vậy mà con vẫn giữ được ý mình. Mẹ nể. Sau này có lúc nào khó từ chối quá, con cứ đổ cho mẹ: mẹ tao kiểm tra dữ lắm. Mẹ chịu tiếng ác cho.", en: "They looked at you like that and you still held your ground. I respect that. If it ever gets too hard to refuse, blame me: my mum checks everything. I'll happily be the villain.")
]
#hieusau1("Con thường kể chuyện nhạy cảm theo kiểu thả một mẩu thông tin về người khác, rồi quan sát phản ứng của ba mẹ. Đó là một phép thử. Nếu ba mẹ hoảng, con rút ra kết luận rằng chuyện loại này không kể được ở nhà, và những chuyện lớn hơn sau này sẽ không bao giờ tới tai ba mẹ. Giữ nét mặt bình thường và hỏi con nghĩ sao giúp ba mẹ biết được điều quan trọng nhất: con đang đứng ở đâu trong chuyện đó.", en: "Children often raise sensitive topics by dropping a piece of information about someone else and watching how the parent reacts. It is a test. If the parent panics, the child concludes this kind of thing cannot be discussed at home, and bigger things later will never reach you. Keeping a normal face and asking what do you think tells you the most important thing: where your child stands in all this.")
#cotloi("Phản ứng của ba mẹ với chuyện nhỏ hôm nay quyết định con có kể chuyện lớn ngày mai hay không.", en: "How you react to today's small news decides whether you will hear tomorrow's big news.")
#lamngay1("Tập trước một câu đệm để dùng khi nghe tin sốc: Vậy hả, kể mẹ nghe thêm đi. Câu này mua cho ba mẹ mười giây để thở, và giữ cho con tiếp tục nói.", en: "Practise one filler sentence for shocking news: Really? Tell me more. It buys you ten seconds to breathe and keeps your child talking.")
#caunoi("Cảm ơn con đã kể cho mẹ nghe. Con nghĩ sao về chuyện đó?", en: "Thank you for telling me. What do you think about it?")
#tusoi(("Lần gần nhất con kể một chuyện khó nghe, nét mặt mình lúc đó ra sao?", "Có chuyện gì hồi đi học mình chưa từng dám kể với ba mẹ mình? Vì sao?",), en: ("The last time my child told me something hard to hear, what did my face look like?", "Was there something at school I never dared tell my own parents? Why?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 2: mang theo bên mình]
#doicau1((("Hôm nay học sao? Được mấy điểm?", "Hôm nay có chuyện gì vui hay chuyện gì chán không con?", "How was school? What marks did you get?", "Did anything fun or boring happen today?"), ("Có vậy mà cũng buồn. Chuyện nhỏ xíu.", "Chuyện đó làm con buồn nhiều vậy hả. Kể mẹ nghe.", "Sad over that? It's such a small thing.", "That made you really sad. Tell me about it."), ("Mẹ nói rồi mà không nghe, giờ thấy chưa.", "Chuyện ra vậy chắc con cũng không vui. Giờ con tính sao?", "I told you so and you didn't listen.", "That can't have felt good. What do you want to do now?"),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Nghe là dừng tay, quay người lại, và để im lặng kéo dài thêm vài giây. Con thường nói câu quan trọng nhất sau khoảng lặng đó.", "Mỗi ngày giữ mười phút không dạy, không nhắc, không sửa. Chỉ ở cạnh con và làm thứ con thích. Đó là tiền gửi vào tài khoản mà ba mẹ sẽ phải rút ra những lúc cần nói chuyện khó.", "Chuyện con kể riêng thì đừng đem kể với họ hàng, hàng xóm, hay đăng lên mạng. Một lần lộ là cửa đóng cả năm.",), en: ("Listening means stopping your hands, turning your body, and letting the silence last a few more seconds. Children often say the most important thing after that pause.", "Keep ten minutes a day with no teaching, reminding or correcting. Just be next to your child doing what they like. That is a deposit in the account you will draw on when a hard conversation is needed.", "What your child tells you in private should not be retold to relatives or neighbours, or posted online. One leak closes the door for a year.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày, mỗi bữa cơm tối cả nhà úp điện thoại vào một cái rổ. Mỗi người kể một chuyện vui và một chuyện chán trong ngày, ba mẹ kể trước. Không ai bình luận chuyện của ai, chỉ được hỏi thêm.",), mark: sym.star.filled, en: ("For seven days, at dinner, the whole family puts phones face down in a basket. Each person tells one good thing and one annoying thing from the day, parents first. Nobody comments on anyone's story; you may only ask for more.",))
