#import "../template.typ": *

#chapter-open(14, "Anh chị em trong nhà và chuyện công bằng", 14, "Con không cần được chia đều. Con cần được thương riêng.", "Ba mẹ nào cũng nói mình thương các con như nhau, và đứa con nào cũng có lúc tin chắc rằng mình bị thương ít hơn. Anh chị em là những người đầu tiên con phải chia sẻ thứ quý nhất đời mình: ba mẹ. Vì vậy chuyện giành đồ chơi, chuyện ai rửa chén, chuyện em mới sinh, đều không bao giờ chỉ là chuyện đó. Chương này bàn cách ba mẹ thôi làm quan tòa, và làm sao để mỗi đứa con đều thấy mình có một chỗ không ai lấy mất.", ("Hai đứa đánh nhau, đứa nào cũng nói tại nó trước", "Con nói ba mẹ thương em hơn", "Con nói ba mẹ không công bằng", "Đứa ngoan và đứa khó",), en: ("Brothers, sisters and what is fair", "Children do not need equal shares. They need to be loved individually.", "All parents say they love their children the same, and every child at some point is convinced they are loved less. Siblings are the first people with whom a child must share the most precious thing in their life: their parents. So a fight over a toy, who washes the dishes, a new baby: none of these is ever only about that. This chapter is about parents giving up the judge's seat, and about making sure each child has a place nobody can take.", ("Two children fighting, each saying the other started it", "Your child says you love the baby more", "Your child says you are unfair", "The good one and the difficult one",)))

#sec("Hai đứa đánh nhau, đứa nào cũng nói tại nó trước", en: "Two children fighting, each saying the other started it")
#boicanh("Tiếng hét từ phòng khách. Bé Su sáu tuổi khóc ré, thằng Bin chín tuổi mặt đỏ gay, cái điều khiển tivi nằm dưới đất. Mẹ chạy ra: Bin nói em cào con trước, Su nói anh giật của con.", en: "Screams from the living room. Six-year-old Su is wailing, nine-year-old Bin is red in the face, and the TV remote is on the floor. Mum runs in: Bin says she scratched me first, Su says he grabbed it from me.")
#phanxa("Bin! Con lớn rồi phải nhường em chứ! Lớn đầu mà đi ăn hiếp em. Xin lỗi em ngay!", "Bin nghe: mẹ luôn bênh em, lớn là có tội. Su nghe: cứ khóc to là thắng.", en: ("Bin! You're older, you should give way! A big boy picking on his little sister. Apologise now!", "Bin hears: Mum always takes her side; being older is a crime. Su hears: cry loudly and you win."))
#scene("Tình huống 14.1 · Thử nói cách khác")[
  #me("(Cầm cái điều khiển lên, đứng vào giữa.) Mẹ thấy hai đứa đang rất giận nhau. Có ai bị đau chỗ nào không? Bin, tay con có vết cào. Su, vai con đỏ.", en: "(Picks up the remote, steps between them.) I can see you are both very angry. Is anyone hurt? Bin, you have a scratch on your hand. Su, your shoulder is red.")
  #con("(Bin.) Nó cào con trước! Con đang coi mà nó nhào vô giật.", en: "(Bin.) She scratched me first! I was watching and she jumped in and grabbed it.")
  #me("Mẹ không có ở đây nên mẹ không biết ai trước, và mẹ không xử chuyện ai trước. Mẹ chỉ biết: đánh, cào thì không được, với cả hai. Giờ mỗi đứa ngồi một ghế, thở cho hết giận. Điều khiển mẹ giữ.", en: "I wasn't here, so I don't know who was first, and I'm not ruling on who was first. I only know this: hitting and scratching are not allowed, for either of you. Now each of you sits on a chair and breathes until the anger is out. I'll hold the remote.")
  #me("(Năm phút sau.) Giờ mỗi đứa nói một câu: con muốn gì. Không nói về đứa kia. Bin trước.", en: "(Five minutes later.) Now each of you says one sentence: what I want. Nothing about the other one. Bin first.")
  #con("(Bin.) Con muốn coi hết tập phim của con. Còn mười phút nữa.", en: "(Bin.) I want to finish my episode. Ten more minutes.")
  #me("Su muốn gì?", en: "Su, what do you want?")
  #con("(Su.) Con muốn coi hoạt hình. Anh Hai coi hoài à.", en: "(Su.) I want to watch cartoons. He's always watching.")
  #me("Vậy là có một cái tivi, hai người muốn coi hai thứ. Đây là bài toán của hai đứa, không phải của mẹ. Hai đứa bàn với nhau cách chia. Chừng nào có cách cả hai đều chịu thì tới lấy điều khiển. Mẹ ở trong bếp.", en: "So there is one TV and two people who want two things. This is your problem to solve, not mine. Talk to each other about how to share. When you have a way you both accept, come and get the remote. I'll be in the kitchen.")
  #con("(Bin, ba phút sau.) Tụi con bàn rồi. Con coi hết mười phút, rồi Su coi hai tập, mai Su được chọn trước.", en: "(Bin, three minutes later.) We've decided. I watch my ten minutes, then Su watches two episodes, and tomorrow Su chooses first.")
  #me("Su chịu không? Chịu hả. Vậy điều khiển đây. Mẹ thích cách hai đứa tự tính.", en: "Su, do you agree? You do. Then here's the remote. I like how you two worked that out yourselves.")
]
#hieusau1("Khi ba mẹ nhảy vào phân xử ai đúng ai sai, mỗi cuộc cãi nhau trở thành một phiên tòa mà giải thưởng là sự bênh vực của ba mẹ. Đứa thua oán, đứa thắng học cách diễn vai nạn nhân. Câu lớn phải nhường em đặc biệt nguy hiểm: nó dạy đứa lớn rằng tuổi tác là một cái tội, và dạy đứa nhỏ rằng yếu là có quyền. Vai trò hữu ích hơn của ba mẹ là người giữ an toàn và người điều phối: chặn bạo lực, để mỗi đứa nói nhu cầu của mình, rồi trả bài toán lại cho các con tự giải.", en: "When parents jump in to rule on right and wrong, every quarrel becomes a trial whose prize is the parent's backing. The loser resents; the winner learns to play the victim. The older one must give way is especially harmful: it teaches the older child that age is an offence and the younger that weakness is a right. A more useful role for parents is safety keeper and facilitator: stop violence, let each child state their need, and hand the problem back to them.")
#cotloi("Đừng làm quan tòa xử ai trước ai sau. Chặn đánh nhau, nghe mỗi đứa muốn gì, rồi trả bài toán về cho hai đứa.", en: "Do not be the judge of who started it. Stop the fighting, hear what each one wants, and hand the problem back to the two of them.")
#lamngay1("Lần tới các con cãi nhau mà không có bạo lực, thử không can thiệp trong ba phút. Nếu phải vào, chỉ nói: Mẹ thấy hai đứa có một vấn đề. Mẹ tin hai đứa tìm ra cách. Cần mẹ giúp thì gọi.", en: "Next time your children argue without violence, try not stepping in for three minutes. If you must, say only: I see you two have a problem. I trust you can find a way. Call me if you need help.")
#caunoi("Mẹ không xử ai trước ai sau. Hai đứa bàn với nhau, có cách cả hai cùng chịu thì nói mẹ.", en: "I'm not ruling on who started it. Talk to each other, and tell me when you have a way you both accept.")
#tusoi(("Trong nhà, mình thường bênh đứa nào theo phản xạ? Đứa kia có biết không?", "Hồi nhỏ mình là anh chị phải nhường, hay là em được bênh? Điều đó để lại gì trong mình?",), en: ("Which child do I side with by reflex? Does the other one know?", "As a child, was I the older one who had to give way, or the younger one who was defended? What did that leave in me?",))

#sec("Con nói ba mẹ thương em hơn", en: "Your child says you love the baby more")
#boicanh("Nhà mới có em bé ba tháng. Thằng Khôi bảy tuổi, trước giờ ngoan, bỗng đái dầm trở lại, hay nhõng nhẽo, có lần nhéo em. Tối đó nó nói, mắt ráo hoảnh: ba mẹ chỉ thương em thôi. Con là đồ thừa.", en: "There is a new three-month-old baby. Seven-year-old Khoi, always well behaved, has started wetting the bed again and whining, and once pinched the baby. That evening he says, dry-eyed: you only love the baby. I'm the spare one.")
#phanxa("Nói bậy! Ba mẹ thương hai đứa như nhau. Con lớn rồi phải biết thương em chứ, sao lại ganh với em?", "Mình buồn thật mà mẹ nói mình nói bậy. Ganh là xấu. Mình vừa bị thừa vừa là đứa xấu tính.", en: ("Nonsense! We love you both the same. You're big now; you should love your little brother, not be jealous of him.", "I really am sad and Mum says it's nonsense. Jealousy is bad. I am both the spare one and a nasty child."))
#scene("Tình huống 14.2 · Thử nói cách khác")[
  #me("(Đưa em cho ba bế, kéo Khôi vô lòng.) Con thấy mình như đồ thừa hả. Câu đó nghe buồn quá. Kể mẹ nghe, từ lúc có em, con thấy cái gì khác đi?", en: "(Hands the baby to Dad, pulls Khoi onto her lap.) You feel like the spare one. That is such a sad thing to feel. Tell me, since the baby came, what has changed for you?")
  #con("Mẹ không đọc truyện cho con nữa. Mẹ lúc nào cũng bế em. Con kêu mẹ thì mẹ nói suỵt, chờ chút. Mà mẹ chờ chút là quên luôn.", en: "You don't read me stories any more. You're always holding the baby. When I call you, you say shh, wait a bit. And then you forget.")
  #me("...Con nói đúng hết. Ba tháng nay mẹ suỵt con nhiều lắm. Không phải vì mẹ thương em hơn, mà vì em còn nhỏ xíu, chưa tự làm được gì, nên em lấy gần hết thời gian của mẹ. Nhưng con mất mẹ là mất thiệt, mẹ hiểu.", en: "...All of that is true. For three months I have shushed you a lot. Not because I love the baby more, but because he is tiny and can't do anything alone, so he takes nearly all my time. But you have truly lost me, I understand.")
  #con("Hồi chưa có em vui hơn.", en: "It was more fun before the baby.")
  #me("Ừ, hồi đó con có mẹ nguyên con. Nhớ hồi đó cũng không sao hết, con không xấu vì nghĩ vậy. Giờ mẹ làm vầy: mỗi tối tám giờ, ba giữ em, mẹ là của riêng Khôi hai mươi phút. Đọc truyện, hay làm gì con muốn. Em có khóc ba cũng lo, mẹ không chạy ra.", en: "Yes, back then you had all of me. It's all right to miss that; you're not bad for thinking it. Here is what I'll do: every evening at eight, Dad takes the baby and I am Khoi's alone for twenty minutes. Stories, or whatever you like. Even if the baby cries, Dad will handle it; I won't run out.")
  #con("Thiệt hả? Tối nào cũng có?", en: "Really? Every evening?")
  #me("Tối nào cũng có. Mình gọi là giờ của Khôi. Mẹ ghi lên lịch luôn.", en: "Every evening. We'll call it Khoi time. I'll write it on the calendar.")
  #con("Vậy tối nay đọc cuốn khủng long.", en: "Then tonight we read the dinosaur book.")
  #me("Cuốn khủng long. Mà nè, mẹ kể con nghe một bí mật: hồi con bằng em, mẹ cũng bế con suốt ngày y như vầy. Để mẹ lấy hình cho con coi.", en: "The dinosaur book. And let me tell you a secret: when you were his size, I held you all day just like this. Let me get the photos to show you.")
]
#hieusau1("Với đứa trẻ, có em là mất đi vị trí duy nhất trong lòng ba mẹ, một mất mát lớn không kém gì người lớn bị thay thế. Những hành vi thụt lùi như đái dầm, nhõng nhẽo, nói ngọng lại là cách con nói con cũng cần được chăm như em. Phủ nhận cảm xúc bằng câu ba mẹ thương như nhau không thuyết phục được ai, vì con đang đếm bằng số phút, và con đếm đúng. Điều chữa được là thừa nhận sự thật, cho phép con có cảm xúc lẫn lộn về em, và dành một khoảng thời gian riêng, đều đặn, được bảo vệ khỏi mọi gián đoạn.", en: "For a child, a new sibling means losing the only-one place in their parents' hearts, a loss as great as an adult being replaced. Regressions like bed-wetting, whining or baby talk are the child's way of saying I need looking after too. Denying the feeling with we love you the same convinces nobody, because the child is counting in minutes, and counting correctly. What heals is admitting the truth, allowing mixed feelings about the baby, and setting aside regular, protected time that nothing interrupts.")
#cotloi("Đừng nói ba mẹ thương hai đứa như nhau. Hãy cho mỗi đứa một khoảng thời gian chỉ có riêng nó với ba mẹ, đều đặn, không ai chen vô.", en: "Do not say we love you both the same. Give each child a time that belongs to them alone with a parent, regularly, with nobody else in it.")
#lamngay1("Đặt cho mỗi đứa con một giờ riêng mười lăm tới hai mươi phút với ba hoặc mẹ, có tên, có giờ cố định, ghi lên lịch. Trong giờ đó con chọn làm gì, và điện thoại của ba mẹ ở phòng khác.", en: "Give each child fifteen to twenty minutes of their own with Mum or Dad, with a name and a fixed time, written on the calendar. In that time the child chooses the activity, and your phone is in another room.")
#caunoi("Con nhớ hồi chưa có em cũng không sao hết. Tối nay tám giờ, mẹ là của riêng con.", en: "It's all right to miss the time before the baby. Tonight at eight, I am yours alone.")
#tusoi(("Tuần vừa rồi mình có bao nhiêu phút ở riêng với từng đứa con?", "Khi con ganh với em, mình nghe ra con hư hay con đang nhớ mình?",), en: ("How many minutes did I spend alone with each child this past week?", "When my child is jealous of a sibling, do I hear naughty or missing me?",))

#sec("Con nói ba mẹ không công bằng", en: "Your child says you are unfair")
#boicanh("Con bé Hạnh lớp 10 phải mười giờ có mặt ở nhà. Anh Hai nó, sinh viên năm nhất, đi tới mười hai giờ. Em Út lớp 3 thì không phải rửa chén. Hạnh bùng lên trong bữa cơm: nhà này cái gì cũng bất công với con! Anh Hai thì được hết, Út thì khỏi làm gì!", en: "Hanh, in grade 10, must be home by ten. Her older brother, a first-year student, may stay out until midnight. The youngest, in grade 3, never washes dishes. At dinner Hanh bursts out: everything in this house is unfair to me! He's allowed everything and the little one does nothing!")
#phanxa("Không có so đo! Anh con là con trai, lớn rồi. Em còn nhỏ. Con là con gái, ở giữa, phải biết điều.", "Mình bị thiệt vì là con gái và vì đứng giữa, hai thứ mình không chọn được. Nói ra thì bị gọi là so đo.", en: ("No keeping score! Your brother is a boy and grown up. Your sister is small. You are a girl, in the middle, and should know better.", "I lose out because I am a girl and in the middle, two things I did not choose. If I say so, I am keeping score."))
#scene("Tình huống 14.3 · Thử nói cách khác")[
  #ba("Hạnh nói bất công. Ba muốn nghe cho rõ, từng chuyện một. Chuyện giờ về trước đi.", en: "Hanh says unfair. I want to hear it clearly, one thing at a time. Curfew first.")
  #con("Anh Hai đi tới mười hai giờ, con mười giờ phải về. Hồi anh Hai lớp 10 ảnh cũng được đi tới mười một giờ, mẹ nói vậy.", en: "He can be out until midnight and I have to be back at ten. And when he was in grade 10 he was allowed until eleven; Mum said so.")
  #ba("(Nhìn mẹ. Mẹ gật.) ...Vậy là cùng tuổi đó mà con bị siết hơn anh một tiếng. Ba chưa bao giờ để ý. Ba nghĩ lý do là ba lo cho con gái nhiều hơn. Lo thì thật, nhưng với con thì nó thành bất công, ba hiểu.", en: "(Looks at Mum. She nods.) ...So at the same age you've been held an hour tighter than he was. I never noticed. I think the reason is that I worry more about a daughter. The worry is real, but for you it has become unfairness; I see that.")
  #con("Con đâu có đi đâu bậy bạ. Con đi sinh hoạt câu lạc bộ, về là về.", en: "I don't go anywhere bad. I go to club meetings and come straight home.")
  #ba("Ba biết. Vậy sửa chuyện này: giờ về của con bằng anh Hai hồi lớp 10, mười một giờ vào tối thứ bảy, có điều kiện y như ba đặt cho anh: báo chỗ, bắt máy, có người đi cùng về. Còn chuyện rửa chén?", en: "I know. So we fix this: your curfew matches his in grade 10, eleven on Saturday nights, with exactly the conditions I set for him: tell us where, answer your phone, come home with someone. Now, the dishes?")
  #con("Út không làm gì hết. Con rửa suốt.", en: "The little one does nothing. I always wash up.")
  #ba("Út tám tuổi chưa rửa chén cho sạch được, nhưng Út làm được việc của tám tuổi: dọn bàn, lau bàn, phơi khăn. Từ mai chia lại. Nhà mình không chia đều, vì ba đứa ba tuổi khác nhau. Nhưng ai cũng có phần, theo sức mình. Hạnh coi vậy được chưa?", en: "At eight she can't wash dishes properly yet, but she can do an eight-year-old's jobs: clear the table, wipe it, hang the towels. From tomorrow we re-divide. We don't divide equally in this house, because the three of you are three different ages. But everyone has a share, according to their strength. Is that all right, Hanh?")
  #con("Dạ được. ...Con tưởng ba sẽ la con so đo.", en: "Yes. ...I thought you'd tell me off for keeping score.")
  #ba("Con nói đúng thì ba nghe. Lần sau thấy chỗ nào lệch, con cứ nói, đừng để dồn tới lúc nổ.", en: "When you're right, I listen. Next time something seems lopsided, say so; don't let it build until it explodes.")
]
#hieusau1("Trẻ con có cái cân công bằng cực nhạy, và các em thường đúng nhiều hơn ba mẹ muốn thừa nhận. Công bằng không có nghĩa là giống hệt nhau: con khác tuổi có quyền và việc khác nhau. Nhưng lý do khác biệt phải nói ra được, và phải dựa trên tuổi tác, mức độ trách nhiệm, chứ không dựa trên giới tính hay thứ tự sinh. Đứa con ở giữa và con gái hay là người gánh phần thiệt mà không ai nhận ra. Chịu nghe lời khiếu nại của con và sửa khi con đúng dạy con một điều lớn: lên tiếng một cách đàng hoàng thì có kết quả.", en: "Children have an extremely sensitive scale for fairness, and they are right more often than parents like to admit. Fair does not mean identical: children of different ages have different rights and duties. But the reasons must be explainable, and based on age and responsibility, not on sex or birth order. Middle children and daughters often carry the short end without anyone noticing. Hearing a child's complaint and correcting course when they are right teaches something big: speaking up properly gets results.")
#cotloi("Công bằng không phải là chia đều. Công bằng là mỗi đứa được theo đúng tuổi và sức của mình, và ba mẹ giải thích được vì sao.", en: "Fair is not equal shares. Fair is each child treated according to their age and strength, with parents able to explain why.")
#lamngay1("Viết ra quyền lợi và việc nhà của từng đứa con, đặt cạnh nhau. Tự hỏi với mỗi chỗ khác biệt: lý do là tuổi và sức, hay vì nó là con gái, là con lớn, là đứa dễ sai? Chỗ nào không giải thích được thì sửa.", en: "Write out each child's privileges and chores side by side. For every difference ask: is the reason age and ability, or because she is a girl, he is the eldest, this one is easiest to order about? Whatever you cannot explain, change.")
#caunoi("Con thấy chỗ nào lệch thì cứ nói. Con nói đúng thì ba sửa.", en: "If something seems lopsided, say so. If you're right, I'll fix it.")
#tusoi(("Trong nhà mình, con trai và con gái có đang được đối xử khác nhau ở chỗ nào mà mình chưa từng gọi tên?", "Đứa con nào trong nhà ít đòi hỏi nhất? Có phải vì nó đủ rồi, hay vì nó đã thôi hy vọng?",), en: ("Where are sons and daughters in our home treated differently in ways I have never named?", "Which child asks for the least? Is it because they have enough, or because they have stopped hoping?",))

#sec("Đứa ngoan và đứa khó", en: "The good one and the difficult one")
#boicanh("Nhà có hai chị em. Chị Thảo lớp 8 học giỏi, ngăn nắp, họ hàng ai cũng khen. Em Trân lớp 6 học trung bình, hay quên, nóng tính. Ở nhà hay nghe câu: sao con không được như chị? Dạo này Trân càng lúc càng lì, còn nói: đằng nào con cũng là đứa hư trong nhà mà.", en: "Two sisters. Thao, in grade 8, is clever, tidy, praised by every relative. Tran, in grade 6, is an average student, forgetful, hot-tempered. At home the line is often heard: why can't you be like your sister? Lately Tran is more and more stubborn and says: I'm the bad one in this family anyway.")
#phanxa("Chị con có ai nhắc đâu mà vẫn tự giác. Con thì nói hoài không nghe. Học chị con một chút coi!", "Vai đứa ngoan có người lấy rồi. Mình chỉ còn vai đứa hư. Thì mình đóng cho tròn vai.", en: ("Nobody has to remind your sister and she manages herself. You never listen however often you're told. Learn something from her!", "The good-child role is taken. Only the bad-child role is left for me. So I'll play it properly."))
#scene("Tình huống 14.4 · Thử nói cách khác")[
  #me("(Chở Trân đi mua đồ, chỉ có hai mẹ con.) Hôm qua con nói con là đứa hư trong nhà. Mẹ nghe mà mẹ mất ngủ. Con nghĩ vậy thiệt hả?", en: "(Driving Tran to the shops, just the two of them.) Yesterday you said you're the bad one in the family. I lost sleep over that. Do you really think so?")
  #con("Thì đúng mà. Chị Thảo cái gì cũng giỏi. Con cái gì cũng không bằng.", en: "Well, it's true. Thao is good at everything. I'm worse at everything.")
  #me("Mẹ nghĩ mẹ là người làm con tin như vậy, vì mẹ hay đem chị ra nói. Mẹ xin lỗi. Mẹ so như vậy là sai, và từ giờ mẹ ngưng.", en: "I think I'm the one who made you believe it, because I keep bringing her up. I'm sorry. Comparing like that is wrong, and from now on I stop.")
  #con("Mẹ nói vậy chứ lát về mẹ lại nói.", en: "You say that, and when we get home you'll say it again.")
  #me("Có thể mẹ quen miệng. Mẹ nhờ con: lần nào mẹ lỡ nói sao không như chị, con giơ tay lên một cái, mẹ sẽ dừng. Mẹ nói thiệt.", en: "I might, out of habit. So I'm asking you: whenever I slip and say why can't you be like your sister, raise your hand and I will stop. I mean it.")
  #con("(Nghi ngờ.) ...Con giơ tay là mẹ dừng?", en: "(Doubtful.) ...I raise my hand and you stop?")
  #me("Dừng. Mà mẹ nói con nghe cái này, mẹ để ý lâu rồi chưa nói. Hôm bà ngoại bệnh, ai là người ngồi bóp chân cho bà cả buổi? Bữa con mèo bị kẹt, ai leo lên gỡ? Thằng cu Bi hàng xóm chỉ chịu chơi với ai? Con có cái mà chị Thảo không có: con thấy người khác đang cần gì, và con nhào vô liền.", en: "I stop. And let me tell you something I've noticed for a long time and never said. The day Grandma was ill, who sat rubbing her legs all afternoon? When the cat got stuck, who climbed up to free it? Which person is the only one the little boy next door will play with? You have something Thao doesn't: you see what someone needs and you jump right in.")
  #con("Mấy cái đó đâu có điểm.", en: "None of that gets marks.")
  #me("Không có điểm, nhưng ra đời người ta cần lắm. Chị Thảo giỏi kiểu của chị. Con giỏi kiểu của con. Mẹ không cần hai đứa Thảo. Mẹ cần một đứa Thảo và một đứa Trân.", en: "No marks, but out in the world it is badly needed. Thao is good in her way. You are good in yours. I don't need two Thaos. I need one Thao and one Tran.")
  #con("(Quay mặt ra đường, một lúc sau.) Mẹ mua cho con trà sữa đi.", en: "(Turns to the window; after a while.) Buy me a milk tea.")
  #me("Ừ. Mua luôn cho chị một ly, con chọn vị cho chị.", en: "All right. And one for your sister; you choose her flavour.")
]
#hieusau1("Trong gia đình, các vai thường được chia một cách vô thức: đứa giỏi, đứa ngoan, đứa lì, đứa hài. Khi một đứa đã chiếm vai con ngoan, đứa còn lại khó cạnh tranh nên chọn một vai khác để được nhìn thấy, kể cả vai xấu, vì bị la vẫn còn hơn bị bỏ qua. Mỗi lần so sánh là một lần đóng thêm con dấu vào vai đó. Điều gỡ được là ngừng so sánh, và chủ động chỉ ra điểm mạnh riêng, cụ thể, có bằng chứng của đứa con đang mang nhãn xấu. Đứa mang nhãn ngoan cũng cần được gỡ: nó đang gánh áp lực không được phép sai.", en: "In families, roles are handed out unconsciously: the clever one, the good one, the stubborn one, the funny one. Once one child holds the good-child role, the other finds it hard to compete and takes another role in order to be seen, even a bad one, because being scolded still beats being overlooked. Every comparison stamps that role deeper. What undoes it is ending comparison and actively pointing out the specific, evidenced strengths of the child carrying the bad label. The child with the good label needs freeing too: they carry the pressure of never being allowed to fail.")
#cotloi("Mỗi đứa con cần một chỗ đứng riêng mà không phải giành với ai. Ba mẹ không cần hai đứa giống nhau. Ba mẹ cần mỗi đứa là chính nó.", en: "Each child needs a place of their own that they need not fight a sibling for. You do not need two alike. You need each to be themselves.")
#lamngay1("Viết ra ba điểm mạnh riêng của từng đứa con, loại điểm mạnh không có trong học bạ. Tuần này nói cho mỗi đứa nghe một điểm, riêng với nó, kèm một việc cụ thể làm bằng chứng.", en: "Write three strengths for each child, the kind that never appear on a report card. This week tell each child one of them, privately, with a specific incident as evidence.")
#caunoi("Mẹ không cần con giống chị. Mẹ cần một đứa là chị, và một đứa là con.", en: "I don't need you to be like your sister. I need one of her and one of you.")
#tusoi(("Mỗi đứa con trong nhà đang mang cái nhãn gì? Ai dán nó lên?", "Đứa con ngoan của mình có đang sợ làm ba mẹ thất vọng không?",), en: ("What label does each child in our home carry? Who put it there?", "Is my good child afraid of disappointing us?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 14: mang theo bên mình]
#doicau1((("Con lớn phải nhường em.", "Đồ này của con, con có quyền không cho. Em muốn mượn thì em hỏi.", "You're older, give way to the little one.", "This is yours and you may say no. If your sister wants to borrow it, she asks."), ("Ba mẹ thương hai đứa như nhau.", "Ba mẹ thương con theo cách của riêng con. Không ai thay được chỗ của con.", "We love you both the same.", "We love you in your own way. Nobody can take your place."), ("Sao con không được như chị?", "Con có cái hay của con. Hôm nay mẹ thấy con làm việc này.", "Why can't you be like your sister?", "You have your own strengths. Today I saw you do this."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Đừng bắt đứa lớn làm cha mẹ thay. Trông em một lúc là giúp việc nhà. Chịu trách nhiệm về em là việc của ba mẹ.", "Đồ riêng là đồ riêng. Con có quyền giữ một số thứ không phải chia. Chỉ đứa trẻ được quyền giữ mới học được niềm vui cho đi.", "Không khen đứa này để răn đứa kia, không kể tội đứa này với đứa kia. Chuyện của mỗi đứa nói riêng với nó.",), en: ("Do not make the older child a substitute parent. Minding a sibling for a while is helping at home. Being responsible for the sibling is the parents' job.", "What is personal is personal. A child may keep some things they do not have to share. Only a child allowed to keep can learn the joy of giving.", "Do not praise one child to warn another, or tell one child's faults to another. Each child's matters are discussed with that child alone.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày, mỗi ngày một đứa con có mười lăm phút riêng với ba hoặc mẹ, xoay vòng. Cuối tuần cả nhà làm một việc chung mà các con phải hợp tác mới xong: nấu một bữa, dọn một góc nhà, ráp một bộ xếp hình lớn.",), mark: sym.star.filled, en: ("For seven days, one child each day gets fifteen minutes alone with Mum or Dad, in rotation. At the weekend the family does one job the children must cooperate on: cook a meal, tidy a corner, build a large puzzle.",))
