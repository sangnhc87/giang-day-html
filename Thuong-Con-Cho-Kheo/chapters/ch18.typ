#import "../template.typ": *

#chapter-open(18, "Khi ba mẹ sai: xin lỗi con và làm lại", 18, "Con không cần ba mẹ hoàn hảo. Con cần ba mẹ biết quay lại sau khi làm con đau.", "Đọc tới đây, hẳn có nhiều lúc ba mẹ thấy nhói: mình đã từng nói đúng những câu trong khung đỏ, có khi mới hôm qua. Đừng dùng cuốn sách này làm cây roi quất mình. Không có ba mẹ nào không sai. Thứ phân biệt một gia đình ấm với một gia đình lạnh không phải là số lần va chạm, mà là sau mỗi lần va chạm có ai quay lại nối hay không. Chương cuối này nói về việc nối lại: xin lỗi con cho đúng, sửa một thói quen cũ, và bắt đầu lại ngay cả khi con đã lớn.", ("Phạt oan con", "Lỡ nói một câu không rút lại được", "Nhận ra mình đang lặp lại y hệt ba mẹ mình", "Con đã lớn, liệu có còn kịp không",), en: ("When parents are wrong: apologising and starting again", "Children do not need perfect parents. They need parents who come back after hurting them.", "By now there have surely been moments that stung: you have said exactly the sentences in the red boxes, perhaps only yesterday. Do not use this book as a whip against yourself. No parent is never wrong. What separates a warm family from a cold one is not the number of clashes but whether, after each one, somebody comes back to reconnect. This last chapter is about reconnecting: apologising properly, changing an old habit, and starting again even when your child is nearly grown.", ("You punished your child unjustly", "You said something that cannot be taken back", "You realise you are repeating your own parents exactly", "Your child is nearly grown: is there still time?",)))

#sec("Phạt oan con", en: "You punished your child unjustly")
#boicanh("Tờ năm trăm ngàn trên bàn biến mất. Ba chắc chắn thằng Đạt lớp 6 lấy, vì chỉ có nó ở nhà. Nó chối, khóc, ba càng tin là nó lì, phạt quỳ một tiếng và cấm đi đá banh một tháng. Ba ngày sau mẹ giặt đồ, tờ tiền nằm trong túi quần của ba.", en: "A five-hundred-thousand-dong note disappears from the table. Dad is sure Dat, in grade 6, took it, because only he was home. Dat denies it and cries; Dad becomes more convinced he is being stubborn, makes him kneel for an hour and bans football for a month. Three days later Mum does the laundry: the note is in Dad's own trouser pocket.")
#phanxa("(Lặng lẽ cho con đi đá banh lại, mua cho nó ly trà sữa, coi như xong. Hoặc: Thì tại bình thường con hay nói dối nên ba mới nghi.)", "Ba sai mà ba không nói gì. Người lớn sai thì không phải xin lỗi. Hoặc: mình bị oan mà vẫn là lỗi của mình.", en: ("(Quietly lets him play football again and buys him a milk tea, as if that settles it. Or: Well, you often lie, so of course I suspected you.)", "Dad was wrong and says nothing. Adults who are wrong don't have to apologise. Or: I was wronged and it is still my fault."))
#scene("Tình huống 18.1 · Thử nói cách khác")[
  #ba("(Gọi con ra, ngồi ngang tầm, đặt tờ tiền lên bàn.) Đạt, mẹ tìm thấy tờ tiền trong túi quần của ba. Con không lấy. Ba đã phạt oan con.", en: "(Calls him over, sits at his level, puts the note on the table.) Dat, Mum found the note in my trouser pocket. You did not take it. I punished you unjustly.")
  #con("(Nhìn tờ tiền, môi run.) Con đã nói là con không lấy mà.", en: "(Looks at the note, lips trembling.) I told you I didn't take it.")
  #ba("Con nói ba lần. Con khóc. Mà ba không tin. Ba bắt con quỳ, ba gọi con là đồ lì. Ba sai hoàn toàn. Ba xin lỗi con.", en: "You said it three times. You cried. And I didn't believe you. I made you kneel; I called you stubborn. I was completely wrong. I am sorry.")
  #con("(Khóc òa.) Con quỳ mà con ức lắm. Con không làm mà ba không tin con.", en: "(Sobs.) I knelt there and it was so unfair. I didn't do it and you didn't believe me.")
  #ba("Bị oan mà còn bị phạt, không ai tin, ba không tưởng tượng nổi con ức cỡ nào. Con cứ nói hết ra, ba nghe.", en: "Wronged, punished, and believed by nobody: I can't imagine how that felt. Say all of it; I'm listening.")
  #con("Ba lúc nào cũng nghĩ là con. Cái gì mất cũng hỏi con trước.", en: "You always think it's me. Whenever something goes missing you ask me first.")
  #ba("...Ừ. Con nói đúng. Ba hay nghĩ xấu cho con trước. Cái đó ba phải sửa, không phải chỉ lần này. Từ giờ, chưa có bằng chứng thì ba không kết tội, và con nói không là ba tin trước đã.", en: "...Yes. You're right. I tend to think the worst of you first. That is something I must change, and not just this once. From now on, without evidence I don't accuse, and when you say no I believe you first.")
  #con("Ba nói thiệt không?", en: "Do you mean it?")
  #ba("Ba nói thiệt, và con có quyền nhắc ba nếu ba quên. Chuyện cấm đá banh hủy ngay hôm nay. Còn một tiếng con quỳ thì ba không trả lại được. Ba chỉ làm được một việc: chủ nhật này ba đi coi con đá, cả trận. Và ba sẽ nói với mẹ, với bà nội là ba đã phạt oan con, để không ai còn nghĩ con lấy.", en: "I mean it, and you have the right to remind me if I forget. The football ban ends today. The hour you spent kneeling I cannot give back. I can only do one thing: this Sunday I'll come and watch you play, the whole match. And I'll tell Mum and Grandma that I punished you unjustly, so nobody still thinks you took it.")
  #con("(Lau nước mắt.) Ba nói với bà nội luôn nha. Bà cũng la con.", en: "(Wipes his eyes.) Tell Grandma too. She scolded me as well.")
  #ba("Tối nay ba nói, trước mặt con.", en: "Tonight, in front of you.")
]
#hieusau1("Bị phạt oan là một trong những trải nghiệm trẻ nhớ lâu nhất, vì nó đánh vào niềm tin rằng thế giới công bằng và ba mẹ là người bảo vệ mình. Bù đắp bằng quà hay sự dễ dãi mà không nói lời xin lỗi để lại bài học rằng kẻ mạnh không cần nhận sai. Một lời xin lỗi thật có bốn phần: nói rõ mình đã làm gì, công nhận con đã cảm thấy thế nào, không kèm lời bào chữa, và nói mình sẽ làm gì khác đi. Thêm một phần nữa hay bị quên: trả lại danh dự cho con trước những người đã biết chuyện. Ba mẹ xin lỗi không mất uy. Uy thật tới từ việc con thấy ba mẹ công bằng với cả chính mình.", en: "Being punished unjustly is among the things children remember longest, because it strikes at the belief that the world is fair and parents are protectors. Making up for it with treats or leniency but no spoken apology leaves the lesson that the powerful need not admit fault. A real apology has four parts: say exactly what you did, acknowledge how the child felt, add no excuse, and say what you will do differently. One more part is often forgotten: restoring the child's good name with everyone who knew. Apologising does not cost a parent authority. Real authority comes from a child seeing that their parent is fair, even towards themselves.")
#cotloi("Xin lỗi con cho đủ bốn phần: ba đã làm gì, con đã thấy sao, không bào chữa, và từ nay ba làm khác thế nào. Rồi trả lại danh dự cho con trước những người đã biết.", en: "Apologise in four parts: what I did, how you felt, no excuses, and what I will do differently. Then restore your child's good name with everyone who knew.")
#lamngay1("Nghĩ lại một lần mình đã sai với con mà chưa từng xin lỗi, dù chuyện đã cũ. Tối nay nói với con: Có chuyện này ba mẹ nghĩ lại thấy mình sai. Ba mẹ xin lỗi con. Không kèm chữ nhưng, không kèm lời giải thích.", en: "Think of a time you wronged your child and never apologised, however long ago. Tonight say: There is something I've thought over and I was wrong. I am sorry. No but, no explanation.")
#caunoi("Ba đã phạt oan con. Ba sai hoàn toàn. Ba xin lỗi con.", en: "I punished you unjustly. I was completely wrong. I am sorry.")
#tusoi(("Hồi nhỏ, ba mẹ mình có bao giờ xin lỗi mình không? Nếu có, mình thấy sao? Nếu không, mình đã ước gì?", "Khi có chuyện, mình thường nghĩ tốt hay nghĩ xấu về con trước?",), en: ("Did my own parents ever apologise to me? If so, how did it feel? If not, what did I wish for?", "When something happens, do I tend to think well or badly of my child first?",))

#sec("Lỡ nói một câu không rút lại được", en: "You said something that cannot be taken back")
#boicanh("Trong cơn giận vì con bé Hương lớp 9 cãi lại, mẹ buột miệng: biết vậy hồi đó tao đừng đẻ mày ra! Hương sững người, mặt trắng bệch, quay đi không nói một lời. Ba ngày nay nó lễ phép, ngoan một cách lạ lùng, và không nhìn vào mắt mẹ.", en: "Furious because Huong, in grade 9, argued back, Mum blurts out: if I'd known, I'd never have given birth to you! Huong goes rigid and white and turns away without a word. For three days she has been strangely polite and obedient, and has not looked Mum in the eye.")
#phanxa("(Coi như chưa nói gì. Hoặc: Mẹ giận quá thì nói vậy thôi chứ có gì đâu, con để bụng làm chi.)", "Lúc giận người ta nói thật. Mẹ đã ước mình đừng có mặt. Mình sẽ ngoan, không làm phiền, để mẹ khỏi hối hận thêm.", en: ("(Acts as if nothing was said. Or: I was angry and it just came out; it's nothing, why hold on to it?)", "People tell the truth when they are angry. Mum wished I did not exist. I will be good and no trouble, so she regrets it less."))
#scene("Tình huống 18.2 · Thử nói cách khác")[
  #me("(Vô phòng con, ngồi xuống, giọng nghẹn.) Hương, ba ngày nay mẹ không ngủ được vì câu mẹ nói hôm đó. Câu mẹ nói đừng đẻ con ra.", en: "(Goes into her room, sits down, voice catching.) Huong, I haven't slept for three days because of what I said. That I shouldn't have given birth to you.")
  #con("(Nhìn xuống sách.) Con không sao. Mẹ khỏi nói.", en: "(Eyes on her book.) I'm fine. You don't need to say anything.")
  #me("Con có sao. Mẹ thấy con không nhìn mẹ ba ngày nay. Mẹ mà nghe mẹ mình nói câu đó, chắc mẹ đau tới già. Mẹ không xin con quên. Mẹ xin con nghe mẹ nói sự thật.", en: "You're not fine. I've seen you not look at me for three days. If my mother had said that to me, I think it would hurt until I was old. I'm not asking you to forget it. I'm asking you to hear the truth.")
  #con("(Im lặng, tay siết cây bút.)", en: "(Silent, gripping her pen.)")
  #me("Câu đó là câu ác nhất mẹ từng nói trong đời, và nó không thật. Sự thật là ngày sinh con, mẹ nằm nhìn con cả đêm không dám ngủ vì sợ chớp mắt con biến mất. Sự thật là hôm đó mẹ giận, mẹ muốn làm con đau cho bằng mẹ đang đau, nên mẹ chọn câu nặng nhất. Người lớn mà làm vậy là hèn. Mẹ xin lỗi con.", en: "That was the cruellest sentence I have ever spoken, and it is not true. The truth is that on the day you were born I lay looking at you all night, afraid to sleep in case I blinked and you were gone. The truth is that I was angry that day and wanted to hurt you as much as I was hurting, so I chose the heaviest thing I could say. For an adult to do that is cowardly. I am sorry.")
  #con("(Nước mắt rớt xuống trang sách.) Con nghĩ mẹ nói thật. Con nghĩ tại con hư quá nên mẹ hối hận.", en: "(Tears falling on the page.) I thought you meant it. I thought I'd been so bad that you regretted me.")
  #me("(Ôm con.) Không. Chưa có một ngày nào mẹ hối hận vì có con. Con cãi mẹ, con hư, con làm gì đi nữa, mẹ cũng không đổi con lấy bất cứ thứ gì. Mẹ chỉ hối hận vì cái miệng của mẹ.", en: "(Holds her.) No. There has not been one day I regretted having you. Argue with me, misbehave, do anything at all, and I would still not trade you for anything. The only thing I regret is my own mouth.")
  #con("Mấy ngày nay con không dám làm gì sai hết. Con sợ mẹ ghét con thêm.", en: "These few days I didn't dare do anything wrong. I was scared you'd hate me more.")
  #me("Con không cần ngoan để được mẹ thương. Con cứ cãi, cứ sai như thường, mẹ vẫn thương. Còn mẹ, mẹ hứa với con một điều cụ thể: lúc nào giận tới mức sắp nói bậy, mẹ sẽ đi ra khỏi phòng. Nếu mẹ lỡ nói câu nào làm con đau, con nói mẹ biết liền, đừng ôm ba ngày như vầy.", en: "You do not have to be good to be loved by me. Argue and get things wrong as usual; I still love you. And I promise you one specific thing: when I am angry enough to say something terrible, I will leave the room. If I ever say something that hurts you, tell me straight away; don't carry it for three days like this.")
]
#hieusau1("Những câu nói trong cơn giận, đừng đẻ mày ra, tao không có đứa con như mày, đi đâu thì đi, được trẻ tiếp nhận như sự thật bị lộ ra, không phải như lời nói lúc nóng. Đứa trẻ đột nhiên ngoan ngoãn sau một câu như vậy không phải đã hiểu chuyện. Nó đang sợ, và đang cố xứng đáng để được ở lại. Im lặng coi như chưa có gì khiến câu nói đó nằm lại trong con hàng chục năm. Nhắc lại đúng câu mình đã nói, gọi đúng tên nó là sai, nói ra sự thật ngược lại bằng một chi tiết cụ thể, và cam kết một hành động thay thế cho lần sau: đó là cách duy nhất để gỡ.", en: "Things said in anger, I should never have had you, you're no child of mine, go wherever you like, are received by children as the truth slipping out, not as heat-of-the-moment words. A child who suddenly becomes obedient after such a sentence has not understood. They are afraid, and trying to earn the right to stay. Silence leaves the sentence lodged in the child for decades. Repeating exactly what you said, naming it as wrong, stating the opposite truth with a concrete detail, and committing to a different action next time: that is the only way to undo it.")
#cotloi("Một câu nói ác trong lúc giận không tự phai đi. Nó chỉ được gỡ khi ba mẹ quay lại, nhắc đúng câu đó, và nói rõ: nó không thật, mẹ sai.", en: "A cruel sentence spoken in anger does not fade by itself. It is undone only when the parent comes back, repeats it exactly, and says clearly: it was not true; I was wrong.")
#lamngay1("Nếu trong quá khứ mình đã từng nói với con một câu như vậy, hôm nay là ngày quay lại, dù chuyện đã xảy ra từ mười năm trước. Con vẫn nhớ. Nói: Có một câu mẹ từng nói làm con đau. Nó không thật. Mẹ xin lỗi.", en: "If you once said something like that to your child, today is the day to go back, even if it was ten years ago. Your child still remembers. Say: There is something I once said that hurt you. It was not true. I am sorry.")
#caunoi("Câu đó không thật. Chưa có một ngày nào mẹ hối hận vì có con.", en: "That sentence was not true. There has not been one day I regretted having you.")
#tusoi(("Có câu nào ba mẹ mình nói trong lúc giận mà mình còn mang tới hôm nay không?", "Con mình có đang ngoan vì yên tâm, hay ngoan vì sợ?",), en: ("Is there something my parents said in anger that I still carry today?", "Is my child well behaved because they feel secure, or because they are afraid?",))

#sec("Nhận ra mình đang lặp lại y hệt ba mẹ mình", en: "You realise you are repeating your own parents exactly")
#boicanh("Ba đang la thằng Tín lớp 4 vì làm đổ sữa, giọng gằn từng tiếng. Giữa chừng ba khựng lại: câu mình vừa nói, giọng mình vừa gằn, ánh mắt co rúm của thằng nhỏ. Y hệt ông nội ngày xưa và chính ba hồi tám tuổi. Ba từng thề sẽ không bao giờ như ông.", en: "Dad is scolding Tin, in grade 4, for spilling milk, grinding out each word. Mid-sentence he stops: the words he just used, the tone, the boy's shrinking eyes. Exactly Grandpa years ago, and himself at eight. He had sworn never to be like his father.")
#phanxa("(Gạt đi: hồi xưa ông nội còn dữ hơn, mình vậy là hiền rồi. Rồi tiếp tục la.)", "Con nghe y điều ba từng nghe hồi nhỏ: mình là thứ phiền phức, và người lớn thì đáng sợ.", en: ("(Brushes it aside: Grandpa was far harsher; this is mild. And carries on scolding.)", "The child hears exactly what Dad heard as a boy: I am a nuisance, and adults are frightening."))
#scene("Tình huống 18.3 · Thử nói cách khác")[
  #ba("(Dừng lại giữa câu. Im vài giây. Ngồi xuống.) Tín, ba ngưng. Ba đang la con y như ông nội la ba hồi ba bằng tuổi con.", en: "(Stops mid-sentence. Silent for a few seconds. Sits down.) Tin, I'm stopping. I am scolding you exactly the way Grandpa scolded me when I was your age.")
  #con("(Vẫn còn sợ, lí nhí.) Ông nội cũng la ba hả?", en: "(Still scared, in a small voice.) Grandpa scolded you too?")
  #ba("La dữ lắm. Có lần ba làm đổ nồi canh, ông la ba cả buổi, ba trốn ra sau chuồng gà ngồi khóc. Lúc đó ba sợ ông lắm, và ba thấy mình là đồ bỏ.", en: "Very hard. Once I spilled a pot of soup and he scolded me all afternoon; I hid behind the chicken coop and cried. I was so afraid of him then, and I felt like rubbish.")
  #con("...Lúc nãy con cũng sợ ba.", en: "...I was scared of you just now.")
  #ba("(Nghẹn.) Ba biết. Ba nhìn mắt con là ba biết, vì đó là mắt của ba hồi đó. Ba xin lỗi Tín. Đổ sữa là chuyện nhỏ xíu, lau là xong. Cái giọng lúc nãy không phải vì con hư. Nó là cái giọng cũ trong người ba, lúc mệt nó tự bật ra.", en: "(Chokes.) I know. I saw it in your eyes, because those were my eyes back then. I'm sorry, Tin. Spilled milk is tiny; we wipe it up and that's that. That tone just now was not because you were bad. It is an old voice inside me, and when I'm tired it switches itself on.")
  #con("Vậy ba có ghét ông nội không?", en: "So do you hate Grandpa?")
  #ba("Không. Ông thương ba, nhưng ông chỉ biết có một cách, cách ông cố dạy ông. Ba lớn lên ba mới hiểu. Mà hiểu rồi thì ba muốn dừng nó ở đời ba, không đưa tiếp cho con. Con giúp ba được không?", en: "No. He loved me, but he knew only one way, the way his father taught him. I understood that when I grew up. And having understood, I want it to stop with me, not be handed on to you. Will you help me?")
  #con("Giúp sao ba?", en: "How?")
  #ba("Lúc nào ba bắt đầu gằn giọng, con nói: ba ơi, giọng ông nội. Ba nghe là ba dừng. Ba có thể chưa dừng được liền mọi lần, nhưng ba sẽ tập.", en: "Whenever I start grinding out my words, say: Dad, Grandpa's voice. When I hear that, I'll stop. I may not manage every time straight away, but I'll practise.")
  #con("(Cười bẽn lẽn.) Ba ơi, giọng ông nội.", en: "(A shy smile.) Dad, Grandpa's voice.")
  #ba("Ừ, y vậy đó. Giờ đi lấy khăn, hai cha con lau sữa.", en: "Yes, exactly like that. Now get a cloth and we'll wipe up the milk together.")
]
#hieusau1("Cách chúng ta làm ba mẹ khi căng thẳng thường không tới từ những gì mình đọc, mà từ những gì mình đã nhận hồi nhỏ. Lúc mệt và giận, não chạy theo đường mòn cũ nhất, dù mình đã thề sẽ làm khác. Đó không phải là số phận. Người nhìn ra được khuôn mẫu của mình, kể lại được tuổi thơ mình một cách mạch lạc, có cả phần đau lẫn phần hiểu cho ba mẹ mình, là người có khả năng dừng được vòng lặp. Dừng lại giữa câu la, gọi tên nó, là bước lớn nhất. Và những lần ba mẹ quay lại sửa sau khi lỡ lời cũng dạy con điều mà thế hệ trước chưa kịp dạy: sai thì quay lại.", en: "How we parent under stress usually comes not from what we have read but from what we received as children. Tired and angry, the brain runs down its oldest path, however firmly we swore to do otherwise. That is not fate. People who can see their own pattern and tell the story of their childhood coherently, both the pain and an understanding of their parents, are the ones able to break the cycle. Stopping in mid-scolding and naming it is the biggest step. And each time a parent comes back to repair after a slip, the child learns what the previous generation had no chance to teach: when you are wrong, come back.")
#cotloi("Mình không chọn được cách mình đã được nuôi. Nhưng mình chọn được thứ gì dừng lại ở đời mình và thứ gì được trao tiếp cho con.", en: "We do not choose how we were raised. But we choose what stops with us and what is passed on to our children.")
#lamngay1("Viết ra giấy hai cột. Cột một: ba điều ba mẹ mình đã làm mà mình muốn giữ lại cho con. Cột hai: ba điều mình muốn dừng ở đời mình. Đọc lại tờ giấy này mỗi khi thấy mình sắp gằn giọng.", en: "Write two columns. One: three things my parents did that I want to keep for my child. Two: three things I want to end with me. Read the page again whenever you feel your voice starting to grind.")
#caunoi("Cái giọng lúc nãy không phải vì con hư. Nó là thói quen cũ của ba, và ba đang tập bỏ.", en: "That tone just now was not because you were bad. It is an old habit of mine, and I am practising letting it go.")
#tusoi(("Lúc giận con, mình nghe thấy giọng của ai trong giọng của mình?", "Điều gì ba mẹ mình đã làm rất tốt mà mình muốn con mình cũng nhận được?",), en: ("When I am angry with my child, whose voice do I hear in mine?", "What did my parents do very well that I want my child to receive too?",))

#sec("Con đã lớn, liệu có còn kịp không", en: "Your child is nearly grown: is there still time?")
#boicanh("Con trai mười bảy tuổi, sang năm đi học xa. Mẹ đọc tới đây và nhận ra mười mấy năm qua mình đã la nhiều hơn nghe, so sánh nhiều hơn khen. Hai mẹ con giờ nói chuyện như hai người thuê chung nhà: ăn chưa, tiền học đóng chưa. Mẹ tự hỏi: muộn rồi phải không?", en: "Her son is seventeen and leaves home to study next year. Mum reads this far and realises that for more than a decade she has scolded more than listened and compared more than praised. The two of them now talk like housemates: have you eaten, are the fees paid. She wonders: it's too late, isn't it?")
#phanxa("(Không nói gì, vì ngại, vì nghĩ con lớn rồi nó tự hiểu lòng ba mẹ. Hoặc bù lại bằng tiền và đồ đạc.)", "Con không tự hiểu. Con chỉ có những gì đã nghe. Và con sẽ mang khoảng cách này theo khi rời nhà.", en: ("(Says nothing, out of awkwardness, thinking he's grown and will understand how we feel. Or makes up for it with money and things.)", "A child does not understand automatically. A child has only what was said. And he will carry this distance with him when he leaves."))
#scene("Tình huống 18.4 · Thử nói cách khác")[
  #me("(Một buổi tối, mang trái cây vô phòng con. Đứng lóng ngóng một lúc.) Khoa, mẹ có chuyện muốn nói, mà mẹ không quen nói kiểu này, con ráng nghe nha.", en: "(One evening, brings fruit to his room. Stands awkwardly for a moment.) Khoa, I want to say something, and I'm not used to talking this way, so bear with me.")
  #con("(Tháo tai nghe, hơi cảnh giác.) Chuyện gì mẹ? Con có làm gì đâu.", en: "(Takes off his earphones, slightly wary.) What is it? I haven't done anything.")
  #me("Con không làm gì hết. Là mẹ. Sang năm con đi rồi, mẹ ngồi nghĩ lại. Mười mấy năm nay mẹ la con nhiều quá. Mẹ so con với anh Tuấn nhà bác Ba suốt. Mẹ ít khi nào ngồi nghe con nói cho hết.", en: "You haven't. It's me. You're leaving next year and I've been thinking back. All these years I've scolded you too much. I've compared you with your cousin Tuan endlessly. I've rarely sat and listened to you to the end.")
  #con("(Ngạc nhiên, im lặng.)", en: "(Surprised, silent.)")
  #me("Mẹ làm vậy vì mẹ lo, mẹ sợ con thua người ta. Nhưng lo kiểu đó chắc làm con mệt lắm. Mẹ xin lỗi con. Mẹ không biết cách nào khác, giờ mẹ mới đang học.", en: "I did it out of worry; I was afraid you'd fall behind others. But that kind of worrying must have worn you out. I'm sorry. I didn't know another way; I'm only learning now.")
  #con("...Sao tự nhiên mẹ nói vậy?", en: "...Why are you suddenly saying this?")
  #me("Tại mẹ sợ con đi rồi mà mẹ chưa kịp nói. Có một điều mẹ chưa bao giờ nói ra miệng: mẹ tự hào về con. Không phải vì điểm. Vì con tự đi xe buýt đi học từ lớp 6 không một lần than. Vì hồi ba bệnh, con lặng lẽ nấu cơm cả tháng. Mẹ thấy hết, mà mẹ chỉ biết nói chuyện con chưa làm được.", en: "Because I'm afraid you'll leave before I've said it. There is something I have never said aloud: I am proud of you. Not for marks. Because you've taken the bus to school alone since grade 6 without one complaint. Because when Dad was ill, you quietly cooked for a month. I saw all of it, and all I ever talked about was what you hadn't done.")
  #con("(Quay mặt đi, giọng khàn.) Con tưởng mẹ không thấy mấy cái đó.", en: "(Turns his face away, voice rough.) I thought you didn't see those things.")
  #me("Mẹ thấy. Mẹ dở chỗ không nói. Mẹ không mong một bữa mà bù được mười bảy năm. Mẹ chỉ xin con một năm còn lại này, mỗi tuần cho mẹ một buổi cà phê với con. Con nói gì mẹ nghe đó, mẹ hứa không dạy.", en: "I saw. My failing was not saying so. I don't expect one evening to make up for seventeen years. I'm only asking for this last year: one coffee a week with you. Whatever you say, I'll listen, and I promise not to lecture.")
  #con("(Im lâu.) ...Sáng chủ nhật. Mà mẹ đừng có rủ tới quán của mấy cô bạn mẹ.", en: "(A long pause.) ...Sunday mornings. But don't take me to your friends' cafes.")
  #me("Quán con chọn. Mẹ trả tiền.", en: "Your choice of cafe. I pay.")
]
#hieusau1("Mối quan hệ giữa ba mẹ và con không đóng lại ở tuổi nào cả. Người ta vẫn hàn gắn với ba mẹ mình ở tuổi ba mươi, năm mươi, và một lời nhìn nhận muộn vẫn có sức chữa lành rất lớn, vì đứa con ở tuổi nào cũng vẫn chờ nó. Điều làm lời nói muộn có giá trị là sự cụ thể: nói rõ mình đã làm gì, nói rõ mình đã nhìn thấy điều gì tốt ở con mà chưa từng nói ra. Đừng trông con đáp lại nồng nhiệt ngay. Một đứa trẻ quen với khoảng cách cần thời gian để tin rằng thay đổi này là thật, và sự đều đặn của ba mẹ sau đó mới là câu trả lời.", en: "The relationship between parents and children does not close at any age. People still mend things with their parents at thirty and at fifty, and a late acknowledgement still has great healing power, because a child of any age is still waiting for it. What gives late words their value is being specific: saying exactly what you did, and exactly what good you saw in your child and never mentioned. Do not expect a warm response at once. A child used to distance needs time to believe the change is real, and the parent's steadiness afterwards is the real answer.")
#cotloi("Không có tuổi nào của con là quá muộn để ba mẹ nói: mẹ đã sai chỗ này, và mẹ đã luôn thấy điều tốt này ở con. Con ở tuổi nào cũng vẫn đang chờ câu đó.", en: "No age is too late for a parent to say: I was wrong about this, and I have always seen this good in you. At any age, your child is still waiting for that sentence.")
#lamngay1("Viết cho con một lá thư tay, ngắn thôi, gồm ba ý: một điều ba mẹ tiếc đã làm, ba điều cụ thể ba mẹ thấy và quý ở con mà chưa từng nói, và một lời mời làm chung một việc mỗi tuần. Để thư trên bàn con. Không hỏi con đọc chưa.", en: "Write your child a short handwritten letter with three things: one thing you regret doing, three specific things you see and value in them and have never said, and an invitation to do one thing together each week. Leave it on their desk. Do not ask whether they have read it.")
#caunoi("Có một điều mẹ chưa bao giờ nói ra miệng: mẹ tự hào về con, và mẹ thấy hết những gì con đã làm.", en: "There is something I have never said aloud: I am proud of you, and I saw everything you did.")
#tusoi(("Điều gì tốt ở con mà mình đã thấy từ lâu nhưng chưa bao giờ nói thành lời?", "Nếu ngày mai con rời nhà, mình muốn câu cuối cùng con nghe từ mình là câu gì?",), en: ("What good in my child have I seen for a long time and never put into words?", "If my child left home tomorrow, what would I want the last sentence they heard from me to be?",))

#v(1.6em, weak: true)
#heading(level: 2, numbering: none, outlined: false)[Cuối chương 18: mang theo bên mình]
#doicau1((("Ba mẹ làm vậy cũng vì thương con thôi.", "Ba mẹ thương con, nhưng cách ba mẹ làm đã khiến con đau. Ba mẹ xin lỗi.", "We only did it because we love you.", "We love you, but the way we did it hurt you. We are sorry."), ("Mẹ xin lỗi, nhưng tại con cũng...", "Mẹ xin lỗi. (Dừng ở đó. Chuyện của con để lúc khác nói.)", "I'm sorry, but you also...", "I'm sorry. (Stop there. Your child's part can wait for another time.)"), ("Con lớn rồi tự hiểu lòng ba mẹ.", "Mẹ nói ra để con khỏi phải đoán: mẹ thương con, và mẹ tự hào về con.", "You're grown now; you understand how we feel.", "I'm saying it so you don't have to guess: I love you, and I am proud of you."),))
#listbox1("BA MẸ GHI NHỚ  ·  KEEP IN MIND", rgb("1E293B"), softbg, ("Va chạm rồi nối lại quan trọng hơn không bao giờ va chạm. Mỗi lần ba mẹ quay lại sau khi sai, sợi dây với con chắc thêm một chút.", "Xin lỗi con không kèm quà, không kèm chữ nhưng, không đòi con tha thứ ngay. Con có quyền còn giận thêm một lúc.", "Tha thứ cho chính mình. Ba mẹ đã làm điều tốt nhất mình biết vào lúc đó. Giờ biết thêm thì làm khác đi. Dằn vặt không giúp gì cho con, thay đổi mới giúp.",), en: ("Clashing and then reconnecting matters more than never clashing. Each time you come back after being wrong, the bond with your child grows a little stronger.", "Apologise without gifts, without but, and without demanding instant forgiveness. Your child has the right to stay angry a while longer.", "Forgive yourself. You did the best you knew at the time. Now you know more, so do differently. Tormenting yourself does nothing for your child; changing does.",))
#listbox1("THỬ THÁCH 7 NGÀY CHO CẢ NHÀ  ·  A 7-DAY FAMILY CHALLENGE", teal, rgb("F0FDFA"), ("Bảy ngày cuối của cuốn sách: mỗi ngày chọn một câu trong các khung Một câu để dành nói với con mà mình thấy khó nói nhất, và nói nó ra. Bảy câu, bảy ngày. Con có thể không đáp lại. Cứ nói.",), mark: sym.star.filled, en: ("The last seven days of this book: each day choose, from the A line to keep ready boxes, the sentence you find hardest to say, and say it. Seven sentences, seven days. Your child may not respond. Say it anyway.",))
